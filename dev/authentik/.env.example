# Copy to .env (git-ignored) and fill in every value before `docker compose up -d`.
# `openssl rand -base64 36 | tr -d '\n'` makes a good secret.

# Authentik's own secrets.
AUTHENTIK_SECRET_KEY=
PG_PASS=

# The bootstrap admin, akadmin, signs in to http://localhost:9000 with this
# password. The token is an API token for akadmin that check.sh uses.
AUTHENTIK_BOOTSTRAP_PASSWORD=
AUTHENTIK_BOOTSTRAP_TOKEN=
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@example.com

# The shared dev password every seeded person (ceo@example.com,
# noor.haddad@example.com, ...) signs in with.
DEV_USER_PASSWORD=

# The Goal Tracker application's client secret; its client ID is goal-tracker.
GOAL_TRACKER_OIDC_CLIENT_SECRET=

# The API token Goal Tracker's directory sync reads people and their managers
# with (GOAL_TRACKER_DIRECTORY_TOKEN in the app too). It belongs to a service
# account that can only view users.
GOAL_TRACKER_DIRECTORY_TOKEN=
