package web

import "github.com/zachthieme/goal-tracker/internal/domain"

// The Highlight editor adds Highlights as + → Note → Save (CONTEXT.md:
// Highlight). Its markup is an upgrade: the server renders the plain rows
// that work without script, and highlightEditorScript turns them, within one
// [data-highlight-editor] container, into finished items and an editor, so
// the server never needs to know whether script ran. In the Check-in form,
// saving an item records nothing: an item is hidden inputs under the names
// the rows post, sent with the form around it. On the Goal page, whose Draft
// Highlights have no form around them, an editor opened by an add button or
// an item carrying a data-hl-url saves to the server there at once instead
// (draftHighlightSection).

// highlightAddKinds are the Highlight kinds, one add button each, in the
// order the buttons show.
var highlightAddKinds = []string{domain.HighlightInsight, domain.HighlightAccomplishment, domain.HighlightMiss}

// highlightAddButtons are + Insight, + Accomplishment and + Miss, each opening
// the editor for a new Highlight of its kind, under testID and class. They
// only work with script, so they show only once it has run. A copy outside the
// editor's container names, as controls, the element holding the container
// (the Check-in page's add bar): it stands for the container's own buttons,
// and is disabled with them.
templ highlightAddButtons(testID, class, controls string) {
	<div class="hl-add hl-js-only">
		for _, kind := range highlightAddKinds {
			<button
				type="button"
				data-testid={ testID }
				data-kind={ kind }
				data-highlight-add
				class={ class }
				if controls != "" {
					aria-controls={ controls }
				}
			>{ "+ " + kind }</button>
		}
	</div>
}

// highlightEditorTemplate is the editor script clones to write or edit one
// Highlight: a heading, a Draft's line, the Kind (a hidden input set by the
// add button, or a select where the Kind can change), the Note, and Save and
// Cancel, or Remove for a Draft with nothing to go back to. Script names its
// fields as the rows' are named, so an editor still open at submit is sent
// like an item. Its ie- classes are the shared look (itemEditorStyles);
// hl-editor, like an item's hl-item, is how the script finds it.
templ highlightEditorTemplate() {
	<template id="highlight-editor">
		<div data-testid="highlight-editor" class="ie-editor hl-editor" role="group">
			<h3 class="ie-editor-head" data-hl-heading></h3>
			<p class="hl-draft muted small" data-hl-draft>Draft · logged by <span data-hl-logged-by></span></p>
			<input type="hidden" data-hl-kind-hidden/>
			<label data-hl-kind-select>
				Kind
				<select>
					@highlightKindOptions("")
				</select>
			</label>
			<label>
				Note
				<textarea data-hl-note></textarea>
			</label>
			<div class="ie-actions">
				<button type="button" class="btn sm" data-hl-save>Save</button>
				<button type="button" class="btn quiet sm" data-hl-cancel>Cancel</button>
				<button type="button" class="btn quiet sm" data-hl-remove>Remove</button>
			</div>
		</div>
	</template>
}

// highlightItemTemplate is a saved Highlight as script shows it: its kind and
// note as the Goal page's highlightList shows a Highlight, a Draft's line, and
// Edit and Remove.
templ highlightItemTemplate() {
	<template id="highlight-item">
		<div data-testid="highlight-item" class="ie-item hl-item">
			<p class="hl-item-text"><strong data-testid="highlight-item-kind"></strong>: <span data-testid="highlight-item-note"></span></p>
			<p class="hl-draft muted small" data-hl-draft>Draft · logged by <span data-hl-logged-by></span></p>
			<div class="ie-actions">
				<button type="button" class="btn quiet sm" data-hl-edit>Edit</button>
				<button type="button" class="btn quiet sm" data-hl-remove>Remove</button>
			</div>
		</div>
	</template>
}

// highlightKindOptions are a Highlight kind select's options, None first, with
// selected picked.
templ highlightKindOptions(selected string) {
	<option value="" selected?={ selected == "" }>None</option>
	<option value={ domain.HighlightInsight } selected?={ selected == domain.HighlightInsight }>Insight</option>
	<option value={ domain.HighlightAccomplishment } selected?={ selected == domain.HighlightAccomplishment }>Accomplishment</option>
	<option value={ domain.HighlightMiss } selected?={ selected == domain.HighlightMiss }>Miss</option>
}

// highlightEditorStyles lay out the editor and its items, in the look every
// item editor shares (itemEditorStyles). What only script can drive
// (.hl-js-only) shows once script has marked the container data-hl-js, and what
// script replaces (.hl-no-js), and the summary of a <details> the container
// sits in, hide then.
templ highlightEditorStyles() {
	@itemEditorStyles()
	<style>
		[data-highlight-editor]:not([data-hl-js]) .hl-js-only{display:none}
		[data-hl-js] .hl-no-js,details:has(>[data-hl-js])>summary{display:none}
		.hl-head{font-size:18px}
		.hl-add{display:flex;flex-wrap:wrap;gap:8px}
		.hl-items{display:flex;flex-direction:column;gap:8px}
		.hl-items:empty{display:none}
		.hl-item-text{white-space:pre-wrap}
		.hl-draft[hidden]{display:none}
	</style>
}

// itemEditorStyles are the look of an item editor, the + → fields → Save
// pattern the Highlight editor and the New goal form's Milestone and Metric
// editors share: the editor's box (.ie-editor), its heading
// (.ie-editor-head), its Save and Cancel row (.ie-actions), and a saved
// item's row (.ie-item) with its Edit and Remove. Each page lays out its own
// fields inside.
templ itemEditorStyles() {
	<style>
		.ie-item,.ie-editor{display:flex;flex-direction:column;gap:8px;border:1px solid var(--color-border);border-radius:var(--radius-md);padding:12px 16px;background:var(--color-surface)}
		.ie-item p{margin:0}
		.ie-editor-head{margin:0;font-size:15px;font-weight:600;line-height:1.4;color:var(--color-ink)}
		.ie-editor [hidden]{display:none}
		.ie-actions{display:flex;flex-wrap:wrap;gap:8px}
	</style>
}

// highlightEditorScript upgrades each [data-highlight-editor] container not
// yet upgraded, so it runs again on a form or block htmx swaps back in. It
// shows the container's <details> open without its summary, drops Add
// another and the blank rows, and turns each row with a note into an item,
// or into an open editor when the row holds an error or a note with no kind (a
// Draft logged without one). An add button opens an editor for its kind above
// the items; Save, enabled once the Note (and, where the select shows, the
// Kind) is set, makes it an item at the end of the list, so the Highlights are
// sent in the order written. Edit swaps an item for an editor in place, with
// the Kind select, and Cancel swaps it back. Remove drops an item, keeping a
// Draft's draft_highlight_id so the Check-in discards it. One editor is open
// at a time: the add and Edit buttons are disabled while one is, as is any
// copy of an add button outside the container that stands for it (the
// Check-in page's add bar, through aria-controls), and so is a saved item's
// server-side Remove, whose swap would lose the open editor.
//
// A Highlight with a url saves to the server instead (the Goal page's Draft
// Highlights): Save posts its kind and note there with htmx and swaps the
// container for the one the server answers with. The container's items are
// then the server's, each an .hl-item carrying its url, kind and note, which
// gains an Edit unless the container is marked data-hl-no-edit (a Done or
// Cancelled Goal's Draft Highlights, which can't be edited); one marked
// data-hl-refused, a refused edit, opens as an
// editor again with what was typed and the reason, as does a log form the
// server rendered open. A [data-hl-js-label] control takes that label. The
// container's data-kind-optional lets Save go without a Kind, and its
// data-hl-noun names what an editor with the Kind select is of, in its
// heading.
templ highlightEditorScript() {
	<script>
		(function () {
			var editorTemplate = document.getElementById("highlight-editor");
			var itemTemplate = document.getElementById("highlight-item");
			if (!editorTemplate || !itemTemplate) return;
			document.querySelectorAll("[data-highlight-editor]:not([data-hl-js])").forEach(upgrade);

			function upgrade(box) {
				// The mark is an attribute: htmx settles a swapped-in container
				// that has the old one's id by giving it the old class for a
				// moment, then its own, so a class would be lost. The hl-js
				// class is for page styles keyed on it.
				box.setAttribute("data-hl-js", "");
				box.classList.add("hl-js");
				var details = box.closest("details");
				if (details) details.open = true;
				var scope = box.closest("form") || box;
				var list = box.querySelector("[data-hl-items]");
				var addAnother = box.querySelector("button[name=add_highlight]");
				if (addAnother) addAnother.remove();
				var kindOptional = box.hasAttribute("data-kind-optional");
				var noun = box.getAttribute("data-hl-noun") || "Highlight";
				var noEdit = box.hasAttribute("data-hl-no-edit");
				box.querySelectorAll("[data-hl-js-label]").forEach(function (b) {
					b.textContent = b.getAttribute("data-hl-js-label");
				});
				box.querySelectorAll("[data-testid=checkin-highlight-row]").forEach(function (row) {
					var h = fromRow(row);
					var error = row.querySelector("[role=alert]");
					row.remove();
					if (h.draftID && (!h.keep || !h.note.trim())) {
						list.appendChild(removedDraft(h.draftID));
					} else if (error || (h.note.trim() && !h.kind)) {
						var editor = openEditor(h, { select: true, error: error });
						list.appendChild(editor);
					} else if (h.note.trim()) {
						list.appendChild(item(h));
					}
				});
				box.querySelectorAll(".hl-item[data-hl-url]").forEach(function (saved) {
					saved.hl = { url: saved.getAttribute("data-hl-url"), kind: saved.getAttribute("data-hl-kind"), note: saved.getAttribute("data-hl-note") };
					if (!noEdit) {
						var edit = document.createElement("button");
						edit.type = "button";
						edit.className = "btn quiet sm";
						edit.setAttribute("data-hl-edit", "");
						edit.textContent = "Edit";
						var actions = saved.querySelector("[data-hl-actions]") || saved;
						actions.prepend(edit);
					}
					if (saved.hasAttribute("data-hl-refused")) {
						var typed = { url: saved.hl.url, kind: saved.getAttribute("data-hl-typed-kind"), note: saved.getAttribute("data-hl-typed-note") };
						saved.replaceWith(openEditor(typed, { select: true, restore: saved, error: saved.querySelector("[role=alert]") }));
					}
				});
				var opened = box.querySelector("[data-open-form]");
				var openedForm = opened && opened.querySelector("form[action]");
				if (openedForm) {
					var logged = {
						url: openedForm.getAttribute("action"),
						kind: openedForm.querySelector("[name=kind]").value,
						note: openedForm.querySelector("[name=note]").value,
					};
					var reason = opened.querySelector("[role=alert]");
					opened.remove();
					list.prepend(openEditor(logged, { select: true, isNew: true, error: reason }));
				}
				refresh();

				function fromRow(row) {
					var id = row.querySelector("input[name=draft_highlight_id]");
					if (!id) {
						return {
							kind: row.querySelector("[name=highlight_kind]").value,
							note: row.querySelector("[name=highlight_note]").value,
						};
					}
					var by = row.querySelector('[name="draft_highlight_logged_by_' + id.value + '"]');
					return {
						draftID: id.value,
						keep: row.querySelector("input[name=draft_highlight_keep]").checked,
						kind: row.querySelector('[name="draft_highlight_kind_' + id.value + '"]').value,
						note: row.querySelector('[name="draft_highlight_note_' + id.value + '"]').value,
						loggedBy: by ? by.value : "",
					};
				}

				// fields are a Highlight's names, as the rows post them.
				function fields(h) {
					if (h.url) return { kind: "kind", note: "note" };
					if (!h.draftID) return { kind: "highlight_kind", note: "highlight_note" };
					return { kind: "draft_highlight_kind_" + h.draftID, note: "draft_highlight_note_" + h.draftID };
				}

				function hidden(name, value) {
					var input = document.createElement("input");
					input.type = "hidden";
					input.name = name;
					input.value = value;
					return input;
				}

				// draftInputs say which Draft Highlight an item or editor is and
				// that it is kept.
				function draftInputs(el, h) {
					if (!h.draftID) return;
					el.appendChild(hidden("draft_highlight_id", h.draftID));
					el.appendChild(hidden("draft_highlight_keep", h.draftID));
					el.appendChild(hidden("draft_highlight_logged_by_" + h.draftID, h.loggedBy || ""));
				}

				function draftLine(el, h) {
					var line = el.querySelector("[data-hl-draft]");
					line.hidden = !h.draftID;
					line.querySelector("[data-hl-logged-by]").textContent = h.loggedBy || "";
				}

				// removedDraft is what a removed Draft leaves: its id, not kept,
				// so the Check-in discards it.
				function removedDraft(id) {
					return hidden("draft_highlight_id", id);
				}

				function item(h) {
					var el = itemTemplate.content.firstElementChild.cloneNode(true);
					el.hl = h;
					el.querySelector('[data-testid="highlight-item-kind"]').textContent = h.kind;
					el.querySelector('[data-testid="highlight-item-note"]').textContent = h.note;
					draftLine(el, h);
					var names = fields(h);
					draftInputs(el, h);
					el.appendChild(hidden(names.kind, h.kind));
					el.appendChild(hidden(names.note, h.note));
					return el;
				}

				// openEditor is an editor for h. With opts.select it shows the
				// Kind select, else the kind is the hidden h.kind. opts.restore
				// is the item Cancel puts back; opts.isNew marks one an add
				// button opened; opts.error is a reason to show under the Note.
				function openEditor(h, opts) {
					var el = editorTemplate.content.firstElementChild.cloneNode(true);
					el.hl = h;
					el.restore = opts.restore || null;
					el.isNew = !!opts.isNew;
					var heading = el.querySelector("[data-hl-heading]");
					if (opts.isNew) heading.textContent = "New " + (opts.select ? noun : h.kind);
					else if (opts.restore) heading.textContent = "Edit " + noun;
					else heading.textContent = h.draftID ? "Draft Highlight" : "Highlight";
					draftLine(el, h);
					var names = fields(h);
					draftInputs(el, h);
					var kindHidden = el.querySelector("[data-hl-kind-hidden]");
					var kindLabel = el.querySelector("[data-hl-kind-select]");
					if (opts.select) {
						kindHidden.remove();
						var select = kindLabel.querySelector("select");
						select.name = names.kind;
						select.value = h.kind || "";
					} else {
						kindLabel.remove();
						kindHidden.name = names.kind;
						kindHidden.value = h.kind;
					}
					var note = el.querySelector("[data-hl-note]");
					note.name = names.note;
					note.value = h.note || "";
					if (opts.error) note.parentElement.after(opts.error);
					// A Draft with no item to go back to is kept or removed;
					// anything else can be cancelled.
					var keepOrRemove = !!h.draftID && !el.restore;
					el.querySelector("[data-hl-cancel]").hidden = keepOrRemove;
					el.querySelector("[data-hl-remove]").hidden = !keepOrRemove;
					return el;
				}

				function editorValues(el) {
					var kind = el.querySelector("select[name], input[data-hl-kind-hidden]");
					return {
						url: el.hl.url,
						draftID: el.hl.draftID,
						keep: true,
						loggedBy: el.hl.loggedBy,
						kind: kind.value,
						note: el.querySelector("[data-hl-note]").value,
					};
				}

				function ready(el) {
					var v = editorValues(el);
					return v.note.trim() !== "" && (kindOptional || v.kind !== "");
				}

				// send saves a Highlight to the server at its url and swaps the
				// container for what the server answers with: the items as saved, or the editor again
				// with why it was refused. Focus then goes where it would after
				// a Save here: to the editor still open, the edited item's Edit,
				// or the first add button.
				function send(el, v) {
					el.querySelector("[data-hl-save]").disabled = true;
					var target = box.id ? "#" + box.id : null;
					htmx.ajax("POST", v.url, { source: el, target: target || box, swap: "outerHTML", values: { kind: v.kind, note: v.note } }).then(function () {
						var swapped = target && document.querySelector(target);
						if (!swapped) return;
						var edited = '.hl-item[data-hl-url="' + v.url + '"] [data-hl-edit]';
						focus(swapped.querySelector(".hl-editor [data-hl-note]") || swapped.querySelector(edited) || swapped.querySelector("[data-highlight-add]"));
					});
				}

				// addButtons are the container's add buttons, and the copies
				// outside it that stand for them: those whose aria-controls
				// names an element holding the container.
				function addButtons() {
					var own = Array.prototype.slice.call(scope.querySelectorAll("[data-highlight-add]"));
					document.querySelectorAll("[data-highlight-add][aria-controls]").forEach(function (b) {
						var controlled = document.getElementById(b.getAttribute("aria-controls"));
						if (controlled && controlled.contains(box) && own.indexOf(b) < 0) own.push(b);
					});
					return own;
				}

				function refresh() {
					var open = box.querySelector(".hl-editor") !== null;
					addButtons().forEach(function (b) {
						b.disabled = open;
					});
					box.querySelectorAll("[data-hl-edit]").forEach(function (b) {
						b.disabled = open;
					});
					box.querySelectorAll("[data-hl-actions] [type=submit]").forEach(function (b) {
						b.disabled = open;
					});
					box.querySelectorAll(".hl-editor").forEach(function (el) {
						el.querySelector("[data-hl-save]").disabled = !ready(el);
					});
				}

				function firstAdd() {
					return scope.querySelector("[data-highlight-add]");
				}

				function focus(el) {
					if (el) el.focus();
				}

				box.addEventListener("input", refresh);
				box.addEventListener("change", refresh);
				scope.addEventListener("click", function (e) {
					var add = e.target.closest("[data-highlight-add]");
					if (add && !add.disabled) {
						var kind = add.getAttribute("data-kind");
						var editor = openEditor({ kind: kind || "", note: "", url: add.getAttribute("data-hl-url") }, { isNew: true, select: !kind });
						list.prepend(editor);
						refresh();
						focus(editor.querySelector("[data-hl-note]"));
						return;
					}
					if (!box.contains(e.target)) return;
					var el = e.target.closest(".hl-editor, .hl-item");
					if (!el) return;
					if (e.target.closest("[data-hl-save]")) {
						if (!ready(el)) return;
						var values = editorValues(el);
						if (values.url) {
							send(el, values);
							return;
						}
						var saved = item(values);
						if (el.isNew) {
							el.remove();
							list.appendChild(saved);
						} else {
							el.replaceWith(saved);
						}
						refresh();
						focus(saved.querySelector("[data-hl-edit]"));
					} else if (e.target.closest("[data-hl-cancel]")) {
						if (el.restore) {
							el.replaceWith(el.restore);
							refresh();
							focus(el.restore.querySelector("[data-hl-edit]"));
						} else {
							el.remove();
							refresh();
							focus(firstAdd());
						}
					} else if (e.target.closest("[data-hl-edit]")) {
						var editing = openEditor(el.hl, { select: true, restore: el });
						el.replaceWith(editing);
						refresh();
						focus(editing.querySelector("[data-hl-note]"));
					} else if (e.target.closest("[data-hl-remove]")) {
						if (el.hl.draftID) el.replaceWith(removedDraft(el.hl.draftID));
						else el.remove();
						refresh();
						focus(firstAdd());
					}
				});
			}
		})();
	</script>
}
