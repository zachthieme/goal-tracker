package web

import (
	"fmt"
	"slices"
	"strconv"
	"strings"
	"time"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// checkinFormData is the state the Check-in form renders from: the Goal it posts
// to, the Health picked and the status and Path to Green as typed, the previous
// Check-in's answers shown as ghost text, and an optional validation error shown
// next to the field it is about.
type checkinFormData struct {
	GoalID         int64
	Health         string
	Status         string
	PathToGreen    string
	PathTargetDate string
	// PathTargetDateReason is the reason, as typed, for moving the back-to-
	// Green date later than the latest Check-in's, a Date Slip (CONTEXT.md:
	// Date Slip). Its field shows only when it is needed; see pathReasonShown.
	PathTargetDateReason string
	// AsksForHelp is the Path to Green's "Ask for help" box: ticked
	// while the Goal's ask is open, so carrying it forward takes no effort,
	// or as posted. AskAddressee is whom an ask would go to, nil for no one
	// above the Owner (CONTEXT.md: Ask for help).
	AsksForHelp  bool
	AskAddressee *domain.Account
	// RolledUp is the Goal's Rolled-up Health, shown in the form so the Owner can
	// see the worst among the Goal's Active children while setting their Health
	// (ADR-0003). Explanation is the Owner's reason for a difference, required
	// only when their Health differs from the Rolled-up Health.
	RolledUp    domain.RolledUpHealth
	Explanation string
	// RunOffGreen is how long the Goal has been Yellow or Red, noted beside
	// the Path to Green's heading (CONTEXT.md: Run off Green).
	RunOffGreen domain.RunOffGreen
	// Metrics are the Goal's Metrics, one reading input each (CONTEXT.md: a
	// Metric's current value is recorded at each Check-in). Readings holds each
	// input's value as typed, keyed by Metric ID, so an error re-render keeps
	// it; a fresh form's are empty.
	Metrics  []domain.Metric
	Readings map[int64]string
	// Previous is what the Goal's latest Check-in said, shown as ghost text in
	// the fields that start empty; nothing in it is submitted.
	Previous checkinPreviousAnswers
	// DraftHighlights are the rows offered from the Goal's pending Draft
	// Highlights, oldest first, as typed (CONTEXT.md: Draft Highlight); they
	// come before the rest. Highlights are the Highlight rows as typed, blank
	// ones included (CONTEXT.md: Highlight). The form shows at least one of
	// these.
	DraftHighlights []highlightFormData
	Highlights      []highlightFormData
	// Dates are the delivery date and Milestone changes the reader is making
	// (CONTEXT.md: a Check-in carries Date Slips and Milestone changes).
	Dates checkinDatesFormData
	// Lifecycle is the Lifecycle change the reader is making, if any
	// (CONTEXT.md: Lifecycle).
	Lifecycle lifecycleFormData
	Error     checkinError
	// OffTarget are the Metrics off target when a Green was submitted
	// unconfirmed, or kept through Add another on a form that warned: the form
	// warns about them, flagged at its top, and offers to save the Green
	// anyway (CONTEXT.md: Check-in). A confirmed form shows no warning.
	OffTarget []domain.OffTargetMetric
	// OffTargetConfirmed is set once the Owner has pressed Save as Green
	// anyway: while Green is picked, a re-rendered form carries the
	// confirmation, so the next submit counts as confirmed and the form shows
	// no warning.
	OffTargetConfirmed bool
	// Overdue is set when the form starts on a Goal whose No change is
	// refused for an overdue Milestone: the dates and Milestones section
	// opens, so the Owner can move it, mark it Done or remove it.
	Overdue bool
	// OpenDates is set when the page was opened with ?open=dates, from a
	// Schedule conflict's Fix: the dates and Milestones section opens.
	OpenDates bool
	// Shown is the clock the form shows its dates against.
	Shown displayDates
}

// checkinError is a Check-in validation message and the field it is about,
// named as the form names the field's input (e.g. "explanation"), so the form
// shows the message next to that field. An empty Field is an error about the
// Check-in as a whole, shown at the top of the form.
type checkinError struct {
	Field   string
	Message string
}

// lifecycleFormData is the Check-in form's Lifecycle fields as typed. Current is
// the Goal's Lifecycle: an Active Goal may go On Hold, be marked Done, or be
// Cancelled; an On Hold Goal may be resumed or Cancelled. To is empty to leave
// the Lifecycle alone.
type lifecycleFormData struct {
	Current string
	To      string
	Reason  string
	Outcome string
}

// checkinDatesFormData is the Check-in form's date and Milestone fields as
// typed. Dated is true for a Dated Goal, whose delivery date the form can move;
// Milestones holds a row per Planned Milestone, and NewMilestones the rows the
// reader is adding.
type checkinDatesFormData struct {
	Dated bool
	// CurrentDeliveryDate is the Goal's delivery date before this Check-in, so
	// the form can tell whether the reader moved it.
	CurrentDeliveryDate string
	DeliveryDate        string
	DeliveryDateReason  string
	Milestones          []milestoneFormRow
	NewMilestones       []newMilestoneFormRow
}

// milestoneFormRow is one Planned Milestone's fields in the Check-in form: its
// date (a change records a Date Slip needing DateReason) and its status (Removed
// needs RemovedReason).
type milestoneFormRow struct {
	Milestone     domain.Milestone
	Date          string
	DateReason    string
	Status        string
	RemovedReason string
}

// newMilestoneFormRow is a Milestone the reader is adding in the Check-in.
type newMilestoneFormRow struct {
	Name string
	Date string
}

// planned reports whether the row leaves its Milestone Planned.
func (row milestoneFormRow) planned() bool {
	return row.Status == "" || row.Status == domain.MilestonePlanned
}

// highlightFormData is one Highlight row in the Check-in form: its kind (empty
// for none) and note. A row with a blank note flags nothing. A row offered
// from a Draft Highlight names it by DraftID, says whether its Keep box is
// ticked, and carries who logged it, by name, for the Highlight editor's
// "Draft · logged by" line.
type highlightFormData struct {
	Kind     string
	Note     string
	DraftID  int64
	Keep     bool
	LoggedBy string
}

// checkinPreviousAnswers are the Goal's latest Check-in's status, Path to Green,
// target date and explanation, and each Metric's latest reading keyed by Metric
// ID, as the form shows them. A field with no previous value is empty.
type checkinPreviousAnswers struct {
	Status         string
	PathToGreen    string
	PathTargetDate string
	Explanation    string
	Readings       map[int64]string
}

// checkinPreviousFrom gathers the answers to show as ghost text from the Goal's
// latest Check-in, nil when there is none, and its Metrics' readings over time.
func checkinPreviousFrom(latest *domain.Checkin, trends []metricTrend) checkinPreviousAnswers {
	var p checkinPreviousAnswers
	if latest != nil {
		p.Status = latest.Status
		p.PathToGreen = latest.PathToGreen
		p.PathTargetDate = fmtDate(latest.PathTargetDate)
		p.Explanation = latest.Explanation
	}
	p.Readings = make(map[int64]string, len(trends))
	for _, t := range trends {
		if n := len(t.Readings); n > 0 {
			p.Readings[t.Metric.ID] = fmtNum(t.Readings[n-1].Value)
		}
	}
	return p
}

// checkinGhostText shows previous as a field's placeholder, or no placeholder
// when there is no previous value.
func checkinGhostText(previous string) templ.Attributes {
	if previous == "" {
		return nil
	}
	return templ.Attributes{"placeholder": previous}
}

// pathTargetLastID names the hint beside the Back to Green by input that shows
// the previous target date: a date input can't show a placeholder.
func (d checkinFormData) pathTargetLastID() string {
	return fmt.Sprintf("checkin-path-target-last-%d", d.GoalID)
}

// pathTargetLastAttrs describe the Back to Green by input by its "Last time"
// hint, when there is one, and carry that date as data-last for
// showPathReasonScript to compare against.
func (d checkinFormData) pathTargetLastAttrs() templ.Attributes {
	if d.Previous.PathTargetDate == "" {
		return nil
	}
	return templ.Attributes{"aria-describedby": d.pathTargetLastID(), "data-last": d.Previous.PathTargetDate}
}

// pathReasonShown reports whether the form shows its "Reason for moving it
// later" field: when the date typed is later than the latest Check-in's (both
// ISO dates, so they compare as text), when a reason is typed, or when the
// form's error is about it. Without script, this is the only rule.
func (d checkinFormData) pathReasonShown() bool {
	return (d.PathTargetDate != "" && d.Previous.PathTargetDate != "" && d.PathTargetDate > d.Previous.PathTargetDate) ||
		strings.TrimSpace(d.PathTargetDateReason) != "" ||
		d.Error.Field == "path_target_date_reason"
}

// draftHighlightRows are the rows offering each of drafts, oldest first, each
// ticked to keep, with its kind and note as logged.
func draftHighlightRows(drafts []domain.DraftHighlight) []highlightFormData {
	out := make([]highlightFormData, 0, len(drafts))
	for _, d := range drafts {
		out = append(out, highlightFormData{Kind: d.Kind, Note: d.Note, DraftID: d.ID, Keep: true, LoggedBy: d.LoggedBy.Label()})
	}
	return out
}

// reading returns a Metric's reading as typed.
func (d checkinFormData) reading(metricID int64) string {
	return d.Readings[metricID]
}

// readingRowLine is the line under a Metric's name in the form: its unit,
// baseline, target and target date, and its last reading when it has one
// ("per week · 100 → 500 by Jul 2 · last 135.5").
func (d checkinFormData) readingRowLine(m domain.Metric) string {
	line := fmt.Sprintf("%s · %s → %s by %s", m.Unit, fmtNum(m.Baseline), fmtNum(m.Target), d.Shown.date(m.TargetDate))
	if last := d.Previous.Readings[m.ID]; last != "" {
		line += " · last " + last
	}
	return line
}

// readingProgress is how far a Metric's last reading has come from its
// baseline toward its target, from 0 to 1 whichever way the Metric moves, and
// false when there is no last reading or the baseline is the target.
func (d checkinFormData) readingProgress(m domain.Metric) (float64, bool) {
	last, err := strconv.ParseFloat(d.Previous.Readings[m.ID], 64)
	if err != nil || m.Target == m.Baseline {
		return 0, false
	}
	return min(max((last-m.Baseline)/(m.Target-m.Baseline), 0), 1), true
}

// about reports whether the error is about one of the named fields or a field
// in its family: "milestone" covers every milestone_*_<id> field.
func (e checkinError) about(fields ...string) bool {
	for _, f := range fields {
		if e.Field == f || strings.HasPrefix(e.Field, f+"_") {
			return true
		}
	}
	return false
}

// highlightRows are the Highlight rows the form shows: those typed, or one
// empty row when there are none.
func (d checkinFormData) highlightRows() []highlightFormData {
	if len(d.Highlights) == 0 {
		return []highlightFormData{{}}
	}
	return d.Highlights
}

// highlightOpen reports whether the Highlight section renders open: it holds
// the error, offers Draft Highlights, the reader added a row, or flagged or
// wrote something.
func (d checkinFormData) highlightOpen() bool {
	if d.Error.about("highlight") || len(d.DraftHighlights) > 0 || len(d.Highlights) > 1 {
		return true
	}
	for _, row := range d.Highlights {
		if row.Kind != "" || strings.TrimSpace(row.Note) != "" {
			return true
		}
	}
	return false
}

// highlightSummary is the Highlight section's summary line, naming the kinds
// flagged, if any, in the rows kept.
func (d checkinFormData) highlightSummary() string {
	var kinds []string
	for _, row := range append(slices.Clone(d.DraftHighlights), d.Highlights...) {
		if row.Kind != "" && (row.DraftID == 0 || row.Keep) {
			kinds = append(kinds, row.Kind)
		}
	}
	if len(kinds) == 0 {
		return "Flag a highlight (optional)"
	}
	return "Flag a highlight · " + strings.Join(kinds, ", ")
}

// offTargetWarned reports whether the form warns that a Metric is off target:
// a Green was submitted unconfirmed while one is, and the Owner hasn't
// confirmed it since.
func (d checkinFormData) offTargetWarned() bool {
	return len(d.OffTarget) > 0 && !d.OffTargetConfirmed
}

// datesOpen reports whether the dates and Milestones section renders open: it
// holds the error, the reader changed something in it, a Milestone in it is
// overdue, or the page was opened with ?open=dates.
func (d checkinFormData) datesOpen() bool {
	return d.OpenDates || d.Overdue || d.Error.about("delivery_date", "milestone", "new_milestone") || d.Dates.changed()
}

// changed reports whether any date or Milestone field differs from the Goal's
// current state.
func (d checkinDatesFormData) changed() bool {
	if d.Dated && (d.DeliveryDate != d.CurrentDeliveryDate || strings.TrimSpace(d.DeliveryDateReason) != "") {
		return true
	}
	for _, row := range d.Milestones {
		if row.Date != fmtDate(row.Milestone.TargetDate) || !row.planned() ||
			strings.TrimSpace(row.DateReason) != "" || strings.TrimSpace(row.RemovedReason) != "" {
			return true
		}
	}
	return len(d.NewMilestones) > 0
}

// summary is the dates and Milestones section's summary line: the delivery
// date as dates shows it and how many Milestones are still Planned, as the
// form stands.
func (d checkinDatesFormData) summary(dates displayDates) string {
	parts := []string{"Change dates or milestones"}
	if d.Dated && d.DeliveryDate != "" {
		parts = append(parts, "delivers "+dates.dateText(d.DeliveryDate))
	}
	planned := 0
	for _, row := range d.Milestones {
		if row.planned() {
			planned++
		}
	}
	switch planned {
	case 0:
	case 1:
		parts = append(parts, "1 planned milestone")
	default:
		parts = append(parts, fmt.Sprintf("%d planned milestones", planned))
	}
	return strings.Join(parts, " · ")
}

// lifecycleChoice is one Lifecycle the form offers: the value posted and its
// label.
type lifecycleChoice struct {
	To    string
	Label string
}

// choices are the Lifecycles the form offers from the Goal's current one: an
// Active Goal may stay Active, go On Hold, be marked Done, or be Cancelled; an
// On Hold Goal may be resumed or Cancelled.
func (d lifecycleFormData) choices() []lifecycleChoice {
	if d.Current == domain.LifecycleOnHold {
		return []lifecycleChoice{
			{domain.LifecycleActive, "Resume (Active)"},
			{domain.LifecycleCancelled, "Cancel"},
		}
	}
	return []lifecycleChoice{
		{"", "Keep Active"},
		{domain.LifecycleOnHold, "Put On Hold"},
		{domain.LifecycleDone, "Mark Done"},
		{domain.LifecycleCancelled, "Cancel"},
	}
}

// defaultTo is the Lifecycle the form picks by default: leave an Active Goal
// alone, resume an On Hold one.
func (d lifecycleFormData) defaultTo() string {
	if d.Current == domain.LifecycleOnHold {
		return domain.LifecycleActive
	}
	return ""
}

// lifecycleOpen reports whether the Lifecycle section renders open: it holds
// the error, or the reader picked another Lifecycle or wrote a reason or
// outcome.
func (d checkinFormData) lifecycleOpen() bool {
	l := d.Lifecycle
	return d.Error.about("lifecycle", "outcome") || l.To != l.defaultTo() ||
		strings.TrimSpace(l.Reason) != "" || strings.TrimSpace(l.Outcome) != ""
}

// summary is the Lifecycle section's summary line, naming the change picked.
func (d lifecycleFormData) summary() string {
	title := "Pause, finish, or cancel this goal"
	if d.Current == domain.LifecycleOnHold {
		title = "Resume or cancel this goal"
	}
	switch d.To {
	case "":
		return title + " · stays Active"
	case domain.LifecycleActive:
		return title + " · resumes"
	default:
		return title + " · " + d.To
	}
}

// checkinFormFromLatest starts the Check-in form from a Goal's latest Check-in:
// its Health picked, Green when there is none, and the status, Path to Green,
// explanation and readings empty, with the latest Check-in's answers and each
// Metric's latest reading shown as ghost text, so a full Check-in is written
// fresh (CONTEXT.md: Check-in). Its "Ask for help" box starts ticked
// while the Goal's ask is open, so closing it is a deliberate act. It also carries the Rolled-up Health so the
// form can show it beside the Owner's Health, and the Goal's current delivery
// date and Planned Milestones so the Owner can move or close them. While a
// Milestone is overdue it picks no Health over a latest Green, as a slip is
// never hidden behind a Green (CONTEXT.md: Date Slip), and opens the dates and
// Milestones section: the Check-in may still be Green once it moves the
// Milestone, marks it Done or removes it.
func checkinFormFromLatest(v goalView) checkinFormData {
	g := v.Goal
	d := checkinFormData{GoalID: g.ID, Health: domain.HealthGreen, RolledUp: v.RolledUp, RunOffGreen: v.RunOffGreen, Metrics: v.Metrics, Shown: v.dates()}
	d.AsksForHelp = v.Ask != nil
	d.AskAddressee = v.AskAddressee
	if latest := v.LatestCheckin; latest != nil {
		d.Health = latest.Health
	}
	d.Overdue = v.NoChangeOverdue
	if d.Overdue && d.Health == domain.HealthGreen {
		d.Health = ""
	}
	d.Previous = checkinPreviousFrom(v.LatestCheckin, v.Trends)
	d.DraftHighlights = draftHighlightRows(v.DraftHighlights)
	d.Lifecycle.Current = g.Lifecycle
	if g.Lifecycle == domain.LifecycleOnHold {
		// An On Hold Goal's Check-in resumes or Cancels it; resuming is the
		// common case, so it is preselected.
		d.Lifecycle.To = domain.LifecycleActive
	}
	d.Dates.Dated = g.Kind == domain.GoalDated
	d.Dates.DeliveryDate = fmtDate(g.DeliveryDate)
	d.Dates.CurrentDeliveryDate = d.Dates.DeliveryDate
	for _, m := range v.Milestones {
		if m.Status == domain.MilestonePlanned {
			d.Dates.Milestones = append(d.Dates.Milestones, milestoneFormRow{
				Milestone: m,
				Date:      fmtDate(m.TargetDate),
				Status:    domain.MilestonePlanned,
			})
		}
	}
	return d
}

// checkinSection is the Goal page's Latest status card: the Goal's current
// Health with its Run off Green, status, and Path to Green from its latest
// Check-in, any open Ask for
// help with whom it asks, its Rolled-up Health and any explanation of the
// difference, and who wrote the Check-in and when (CONTEXT.md: Check-in, Ask
// for help, Rolled-up Health).
templ checkinSection(v goalView) {
	{{ g := v.Goal }}
	<section data-testid="goal-checkins" class="card gp-card">
		@checkinStyles()
		<h3>Latest status</h3>
		if g.Lifecycle != domain.LifecycleActive && g.Lifecycle != domain.LifecycleProposed {
			<p data-testid="goal-no-health" class="muted">{ fmt.Sprintf("A %s Goal has no Health.", g.Lifecycle) }</p>
			if v.LatestCheckin != nil {
				<p data-testid="goal-status">{ v.LatestCheckin.Status }</p>
				@checkinByline(*v.LatestCheckin, v.dates())
			}
		} else if v.LatestCheckin != nil {
			@statusCells(v)
			<p data-testid="goal-status">{ v.LatestCheckin.Status }</p>
			if v.LatestCheckin.PathToGreen != "" {
				<p data-testid="goal-path-to-green">
					<strong>Path to Green:</strong> { v.LatestCheckin.PathToGreen } — back to Green by { v.dates().date(v.LatestCheckin.PathTargetDate) }
				</p>
			}
			if v.Ask != nil {
				<p data-testid="goal-ask-for-help">
					<strong>Asks for help</strong>
					if v.Ask.Addressee != nil {
						{ "of " }
						@person(*v.Ask.Addressee)
						// templ renders this line break as the one space before Answer.
					} else {
						{ "· no one above the Owner" }
					}
					<a href="#comments">Answer</a>
				</p>
			}
			if v.LatestCheckin.Explanation != "" {
				<p data-testid="goal-rollup-explanation">
					<strong>Why this differs from the Rolled-up Health:</strong> { v.LatestCheckin.Explanation }
				</p>
			}
			@checkinByline(*v.LatestCheckin, v.dates())
		} else {
			if g.Lifecycle == domain.LifecycleProposed {
				<p data-testid="goal-no-health" class="muted">A Proposed Goal has no Health until it is Active.</p>
			} else {
				<p data-testid="goal-no-health" class="muted">No Check-ins yet.</p>
			}
			if v.RolledUp.Present || v.RolledUp.StaleChildren > 0 {
				<p>
					if v.RolledUp.Present {
						<strong>Rolled-up Health:</strong> <span data-testid="goal-rollup-health">{ v.RolledUp.Health }</span>
						<span class="muted">(worst among Active children)</span>
					}
					@rolledUpStale(v.RolledUp)
				</p>
			}
		}
	</section>
}

// statusCells open the Latest status card: a row of cells, each a small label
// over a value. The Owner's Health is always there, with its Run off Green
// beside it while it has one ("Red · 5 wks"); the Rolled-up Health, with
// its Stale-children count, only when the Goal has Active children; and the
// Back to Green date only when there is a Path to Green.
templ statusCells(v goalView) {
	{{ c := v.LatestCheckin }}
	<dl data-testid="goal-status-cells" class="gp-cells">
		<div data-testid="goal-health-cell" class="gp-cell">
			<dt class="label">Owner's Health</dt>
			<dd>
				<span class={ "badge", healthClass(c.Health) }><span class="dot"></span><span data-testid="goal-health">{ c.Health }</span></span>
				if v.RunOffGreen.Running() {
					<span data-testid="goal-run-off-green" class="muted small">{ "· " + v.RunOffGreen.Label() }</span>
				}
			</dd>
		</div>
		if v.RolledUp.Present || v.RolledUp.StaleChildren > 0 {
			<div data-testid="goal-rollup-cell" class="gp-cell">
				<dt class="label">Rolled-up Health</dt>
				<dd>
					if v.RolledUp.Present {
						<span class={ "badge", healthClass(v.RolledUp.Health) } title="Worst among Active children"><span class="dot"></span><span data-testid="goal-rollup-health">{ v.RolledUp.Health }</span></span>
					} else {
						<span class="muted">—</span>
					}
					@rolledUpStale(v.RolledUp)
				</dd>
			</div>
		}
		if c.PathToGreen != "" {
			<div data-testid="goal-back-to-green-cell" class="gp-cell">
				<dt class="label">Back to Green by</dt>
				<dd>@slippedDates(c.PathTargetDate, v.pathPriorDates(), v.dates(), "back-to-green-slips")</dd>
			</div>
		}
	</dl>
}

// checkinByline says who wrote a Check-in and when, and whom a Delegate wrote
// it for (CONTEXT.md: each Check-in records who wrote it).
templ checkinByline(c domain.Checkin, dates displayDates) {
	<p class="muted small">
		@person(c.Author)
		if c.Author.ID != c.Owner.ID {
			{ " for " }
			@person(c.Owner)
		}
		{ " · " + dates.dayOf(c.CreatedAt) }
	</p>
}

// noChangeCheckinButton records a Check-in repeating the Goal's previous values
// in one click (CONTEXT.md: Check-in). Its button takes class, so the Goal
// page's header can show it quiet beside the primary Check in. A refusal comes
// back as a whole page; htmx won't swap one with an error status (a 403, 404
// or 500), so swapErrorPageScript swaps it in.
templ noChangeCheckinButton(goalID int64, label, class string) {
	<form
		data-testid="no-change-checkin"
		hx-post={ fmt.Sprintf("/goals/%d/checkins/no-change", goalID) }
		hx-target="body"
		hx-on:htmx:response-error={ swapErrorPageScript }
		method="post"
		action={ templ.SafeURL(fmt.Sprintf("/goals/%d/checkins/no-change", goalID)) }
	>
		<button type="submit" class={ class }>{ label }</button>
	</form>
}

// checkinPage is the Check-in on its own page, reached from the Goal page by
// the Owner or a Delegate: a breadcrumb back to the Goal, then a header with
// the title, a line saying which week it is, the Goal's cadence and its last
// Check-in, and, at its right, the one-click No change when there is a
// previous Check-in to repeat; then the form, showing the latest Check-in's
// answers as ghost text. Where a No change would be refused, the header says
// why in place of its button. A refusal in the form's error, such as why a No
// change couldn't be recorded, shows at the top of the form, and the header
// then leaves the reason to it. Beside the form, or between the header and the
// form on a narrow screen, a column gives the context for checking in: what
// the latest Check-in said, the Goal's children (the Goal page's "Contributed
// to by" list, read-only, so the Owner sees which set the Rolled-up Health),
// and the Goal's dates (checkinContextDates). On a phone it keeps only the
// children, as the form's ghost text already shows the latest answers.
templ checkinPage(current *domain.Account, v goalView, form checkinFormData) {
	{{ g := v.Goal }}
	@layout("Check in · "+g.Title, current) {
		@checkinStyles()
		<div class="checkin-page">
			<nav class="small muted" aria-label="Breadcrumb">
				<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a> › Check in
			</nav>
			<div class="checkin-head">
				<div>
					<h1>Check in</h1>
					<p data-testid="checkin-page-meta" class="muted">{ v.checkinPageMeta() }</p>
				</div>
				if g.Lifecycle == domain.LifecycleActive && v.LatestCheckin != nil {
					<div data-testid="no-change-card" class="checkin-no-change">
						<span class="muted">{ "Nothing changed since " + v.dates().dayOf(v.LatestCheckin.CreatedAt) + "?" }</span>
						if v.NoChangeRefusal == "" {
							@noChangeCheckinButton(g.ID, "No change", "btn")
						} else if form.Error.Message == "" || form.Error.Field != "" {
							<p data-testid="no-change-unavailable" class="muted">{ v.NoChangeRefusal }</p>
						}
					</div>
				}
			</div>
			<aside data-testid="checkin-context" class="checkin-context">
				if c := v.LatestCheckin; c != nil {
					<section data-testid="checkin-last-time" class="checkin-context-last">
						<h3 class="label">{ "Last time · " + v.dates().dayOf(c.CreatedAt) }</h3>
						if c.Health != "" || c.PathToGreen != "" {
							<p class="checkin-context-health">
								if c.Health != "" {
									<span class={ "badge", healthClass(c.Health) }><span class="dot"></span>{ c.Health }</span>
								}
								if c.PathToGreen != "" {
									<span class="muted">{ "back to Green by " + v.dates().date(c.PathTargetDate) }</span>
								}
							</p>
						}
						<p data-testid="checkin-last-status" class="checkin-last-status">{ c.Status }</p>
					</section>
				}
				if len(v.Children) > 0 {
					<section data-testid="checkin-children" class="checkin-context-children">
						<h3>Contributed to by</h3>
						@linkList(g, nil, v.Children, v.LinkHealth, "no-children", "")
					</section>
				}
				<section data-testid="checkin-context-dates" class="checkin-context-dates">
					<h3 class="label">Dates</h3>
					<p>{ checkinContextDates(g, v.Milestones, v.dates()) }</p>
				</section>
			</aside>
			if g.Lifecycle == domain.LifecycleActive || g.Lifecycle == domain.LifecycleOnHold {
				@checkinForm(form)
			} else {
				@checkinFieldError(form.Error, "")
				<p data-testid="goal-no-health">{ fmt.Sprintf("A %s Goal takes no Check-ins.", g.Lifecycle) }</p>
			}
		</div>
	}
}

// checkinPageMeta is the line under the Check-in page's title: the week it is,
// named by its Monday in the org's timezone as History's week headings are
// ("Week of Oct 19"), how often the Goal checks in, and the day of its latest
// Check-in when it has one.
func (v goalView) checkinPageMeta() string {
	dates := v.dates()
	y, m, d := v.Now.In(dates.Loc).Date()
	today := time.Date(y, m, d, 0, 0, 0, 0, dates.Loc)
	monday := today.AddDate(0, 0, -((int(today.Weekday()) + 6) % 7))
	parts := []string{"Week of " + dates.date(monday)}
	if days := v.Goal.CadenceDays; days == 1 {
		parts = append(parts, "checks in every day")
	} else {
		parts = append(parts, fmt.Sprintf("checks in every %d days", days))
	}
	if v.LatestCheckin != nil {
		parts = append(parts, "last check-in "+dates.dayOf(v.LatestCheckin.CreatedAt))
	}
	return strings.Join(parts, " · ")
}

// checkinContextDates is the Check-in page's Dates line: the Goal's kind, with
// its delivery date when Dated ("Not yet Dated or Ongoing", as the Goal page
// says, when it is neither), then its Planned Milestones and the earliest of
// them, "Delivers Jul 2 · 2 planned Milestones, next Beta Apr 2". It marks no
// slipped or overdue date: the form's dates section does that.
func checkinContextDates(g domain.Goal, milestones []domain.Milestone, dates displayDates) string {
	kind := "Not yet Dated or Ongoing"
	switch g.Kind {
	case domain.GoalDated:
		kind = "Dated"
		if !g.DeliveryDate.IsZero() {
			kind = "Delivers " + dates.date(g.DeliveryDate)
		}
	case domain.GoalOngoing:
		kind = "Ongoing"
	}
	if len(milestones) == 0 {
		return kind + " · no Milestones"
	}
	var next *domain.Milestone
	planned := 0
	for i, m := range milestones {
		if m.Status != domain.MilestonePlanned {
			continue
		}
		planned++
		if next == nil || m.TargetDate.Before(next.TargetDate) {
			next = &milestones[i]
		}
	}
	switch planned {
	case 0:
		return kind + " · no planned Milestones"
	case 1:
		return fmt.Sprintf("%s · 1 planned Milestone, next %s %s", kind, next.Name, dates.date(next.TargetDate))
	}
	return fmt.Sprintf("%s · %d planned Milestones, next %s %s", kind, planned, next.Name, dates.date(next.TargetDate))
}

// checkinFormRefused is the Goal's Check-in form, started from its latest
// Check-in, with a refusal shown at the top.
func checkinFormRefused(v goalView, refusal string) checkinFormData {
	d := checkinFormFromLatest(v)
	d.Error = checkinError{Message: refusal}
	return d
}

// checkinUnavailablePage says, inside the normal page, why the Check-in
// couldn't be reached: the Goal doesn't exist, or the reader may not check in
// on it.
templ checkinUnavailablePage(current *domain.Account, title, message string) {
	@layout(title, current) {
		<div class="message-page">
			<h1>{ title }</h1>
			<p data-testid="checkin-unavailable">{ message }</p>
			<p><a href="/home">Back to Home</a></p>
		</div>
	}
}

// checkinForm is the Owner's Check-in form. It posts with htmx and targets
// itself, so a validation error re-renders it in place with the message next to
// the field it is about. Health, status, and readings are always shown; the
// Highlight, dates and Milestones, and Lifecycle each sit in a collapsed
// section that opens when it holds an error or a value the reader typed; with
// script, the Highlight editor (highlighteditor.templ) upgrades the Highlight
// section into add buttons, an editor and items. The
// Path to Green asks for a reason for moving its back-to-Green date only once
// the date is later than the latest Check-in's (see pathReasonShown). The form
// ends with its submit bar, which sticks to the window's bottom while the form
// runs past it: Cancel and Submit check-in beside a summary of what the
// Check-in will record, empty until checkinSummaryScript fills it.
templ checkinForm(d checkinFormData) {
	<form
		data-testid="checkin-form"
		id="checkin-form"
		class="checkin-form"
		hx-post={ fmt.Sprintf("/goals/%d/checkins", d.GoalID) }
		hx-target="#checkin-form"
		hx-swap="outerHTML"
		hx-on:htmx:confirm={ confirmCancelScript }
		method="post"
		action={ templ.SafeURL(fmt.Sprintf("/goals/%d/checkins", d.GoalID)) }
	>
		// Enter presses a form's first submit, so it submits the Check-in, not
		// Add another.
		<button type="submit" data-testid="checkin-default-submit" class="checkin-default-submit" tabindex="-1" aria-hidden="true">Submit check-in</button>
		@checkinStyles()
		@checkinFieldError(d.Error, "")
		if d.offTargetWarned() {
			<p data-testid="checkin-off-target-notice" class="checkin-off-target-notice alert y">
				A Metric is off target, so a Green needs confirming. <a href="#checkin-off-target">See below</a>
			</p>
		}
		<section class="checkin-section">
			<div class="checkin-section-head">
				<h2>How is it going?</h2>
			</div>
			<fieldset data-testid="checkin-health" class="health-toggle">
				<legend class="sr-only">Health</legend>
				for _, health := range []string{domain.HealthGreen, domain.HealthYellow, domain.HealthRed} {
					<label class={ "badge", healthClass(health) }>
						<input type="radio" name="health" value={ health } checked?={ d.Health == health }/>
						<span class="dot"></span>{ health }
					</label>
				}
			</fieldset>
			@checkinFieldError(d.Error, "health")
			<label>
				What changed since the last check-in?
				<textarea name="status" required { checkinGhostText(d.Previous.Status)... }>{ d.Status }</textarea>
			</label>
			@checkinFieldError(d.Error, "status")
			if d.RolledUp.Present {
				<div class="checkin-rollup">
					<p data-testid="checkin-form-rollup">
						<span class="muted">Rolled-up Health:</span>
						<span class={ "badge", healthClass(d.RolledUp.Health) }><span class="dot"></span>{ d.RolledUp.Health }</span>
						if count := d.RolledUp.CountLine(); count != "" {
							<span class="muted">{ count }</span>
						}
					</p>
					<label>
						<span>Why is your Health different? <span class="hint">Required while it differs from the Rolled-up Health</span></span>
						<textarea name="explanation" data-testid="checkin-explanation" { checkinGhostText(d.Previous.Explanation)... }>{ d.Explanation }</textarea>
					</label>
					@checkinFieldError(d.Error, "explanation")
				</div>
			}
		</section>
		<fieldset data-testid="path-to-green-field" class={ "path-to-green", templ.KV("has-error", d.Error.Field == "path_to_green" || d.Error.Field == "path_target_date_reason") }>
			<legend class="checkin-section-head">
				<h2>Path to Green</h2>
				<span class="hint">
					Required while Yellow or Red
					if d.RunOffGreen.Running() {
						{ " · " + d.RunOffGreen.Label() + " off Green" }
					}
				</span>
			</legend>
			<label>
				Plan
				<textarea name="path_to_green" { checkinGhostText(d.Previous.PathToGreen)... }>{ d.PathToGreen }</textarea>
			</label>
			<div class="checkin-path-target">
				<label>
					Back to Green by
					<input type="date" name="path_target_date" value={ d.PathTargetDate } hx-on:input={ showPathReasonScript } { d.pathTargetLastAttrs()... }/>
				</label>
				if d.Previous.PathTargetDate != "" {
					<span data-testid="checkin-path-target-last" id={ d.pathTargetLastID() } class="hint">Last time: { d.Shown.dateText(d.Previous.PathTargetDate) }</span>
					<span class="hint">A later date asks why.</span>
				}
			</div>
			@checkinFieldError(d.Error, "path_to_green")
			<label data-testid="checkin-path-target-reason" hidden?={ !d.pathReasonShown() }>
				Reason for moving it later
				<textarea name="path_target_date_reason">{ d.PathTargetDateReason }</textarea>
			</label>
			@checkinFieldError(d.Error, "path_target_date_reason")
			// person's own button can't sit inside a label, so the addressee
			// shows by name alone.
			<label class="checkin-ask">
				<input type="checkbox" name="asks_for_help" value="1" data-testid="checkin-asks-for-help" checked?={ d.AsksForHelp }/>
				<strong>Ask for help</strong>
				if d.AskAddressee != nil {
					<span data-testid="checkin-ask-addressee" class="hint">
						{ "· goes to " }
						@personPlain(*d.AskAddressee)
					</span>
				}
			</label>
			if d.AskAddressee == nil {
				<span data-testid="checkin-ask-addressee" class="hint">No one is above the Owner to ask. It still shows on Risks and in Reports.</span>
			}
		</fieldset>
		if len(d.Metrics) > 0 {
			<fieldset data-testid="checkin-readings" class="checkin-readings">
				<legend class="checkin-section-head">
					<h2>Metrics</h2>
					<span class="hint">Record each Metric's current value</span>
				</legend>
				for _, m := range d.Metrics {
					<div class="checkin-metric">
						<div class="checkin-metric-about">
							<span class="checkin-metric-name">{ m.Name }</span>
							<span class="hint">{ d.readingRowLine(m) }</span>
							if progress, ok := d.readingProgress(m); ok {
								<progress class="checkin-metric-progress" aria-hidden="true" max="1" value={ fmtNum(progress) }></progress>
							}
						</div>
						<label class="checkin-metric-input">
							<input
								aria-label={ m.Name + " current value" }
								type="number"
								step="any"
								name={ readingField(m.ID) }
								value={ d.reading(m.ID) }
								{ checkinGhostText(d.Previous.Readings[m.ID])... }
							/>
						</label>
						@checkinFieldError(d.Error, readingField(m.ID))
					</div>
				}
			</fieldset>
		}
		<div class="checkin-more-group">
			<details data-testid="checkin-highlight-section" class="checkin-more" open?={ d.highlightOpen() }>
				<summary>{ d.highlightSummary() }</summary>
				<div data-testid="checkin-highlights" class="checkin-highlights" data-highlight-editor>
					<h2 class="hl-js-only hl-head">Highlights</h2>
					@highlightAddButtons()
					<div class="hl-items" data-hl-items></div>
					for i, row := range d.DraftHighlights {
						@checkinDraftHighlightRow(i+1, row, d.Error)
					}
					for i, row := range d.highlightRows() {
						@checkinHighlightRow(len(d.DraftHighlights)+i+1, row, d.Error)
					}
					<button type="submit" name="add_highlight" value="1" formnovalidate class="btn quiet">Add another</button>
				</div>
			</details>
			// The editor's parts sit in the form, so an htmx re-render brings
			// them back and upgrades the rows again.
			@highlightEditorStyles()
			@highlightEditorTemplate()
			@highlightItemTemplate()
			@highlightEditorScript()
			<details data-testid="checkin-dates-section" class="checkin-more" open?={ d.datesOpen() }>
				<summary>{ d.Dates.summary(d.Shown) }</summary>
				@checkinDateFields(d.Dates, d.Error)
			</details>
			<details data-testid="checkin-lifecycle-section" class="checkin-more" open?={ d.lifecycleOpen() }>
				<summary>{ d.Lifecycle.summary() }</summary>
				@checkinLifecycleFields(d.Lifecycle, d.Error)
			</details>
		</div>
		if d.offTargetWarned() {
			@checkinOffTargetWarning(d.OffTarget, d.Shown)
		}
		if d.OffTargetConfirmed && d.Health == domain.HealthGreen {
			<input type="hidden" name="off_target_confirmed" value="1"/>
		}
		@checkinSummaryScript()
		<div data-testid="checkin-submit-bar" class="checkin-submit-bar">
			<div data-testid="checkin-summary" class="checkin-summary" aria-live="polite"></div>
			<a class="btn quiet" href={ templ.SafeURL(fmt.Sprintf("/goals/%d", d.GoalID)) }>Cancel</a>
			<button type="submit" class="btn primary">Submit check-in</button>
		</div>
	</form>
}

// checkinSummaryScript fills the submit bar's summary with what the Check-in
// will record, as the form stands: the Health picked, as its badge, unless the
// Lifecycle picked takes the Goal out of Active and so records none; "Path to
// Green" while Yellow or Red has a Plan; how many Metrics have a reading; how
// many Highlights have a note or are kept Drafts; "dates changed" when the
// dates section would change anything (checkinDatesFormData.changed, each
// date's current value read from its data-current); and the Lifecycle change.
// It counts fields by name, not by markup, so it holds when a section's
// markup changes, and runs again on every input and change, and whenever
// script adds or removes anything in the form outside the bar, such as a
// Highlight item. It isn't behind a once handle, so it runs again on the form
// an htmx re-render swaps in; on the first load, the bar after it isn't parsed
// yet, so it waits for the page.
templ checkinSummaryScript() {
	<script>
		(function () {
			if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", start);
			else start();

			function start() {
				var form = document.getElementById("checkin-form");
				var bar = form && form.querySelector("[data-testid=checkin-submit-bar]");
				var summary = bar && bar.querySelector("[data-testid=checkin-summary]");
				if (!summary) return;
				var shown = null;
				render();
				form.addEventListener("input", render);
				form.addEventListener("change", render);
				new MutationObserver(function (changes) {
					if (changes.some(function (c) { return !bar.contains(c.target); })) render();
				}).observe(form, { childList: true, subtree: true });

				function all(selector) {
					return Array.prototype.slice.call(form.querySelectorAll(selector));
				}

				function typed(el) {
					return el.value.trim() !== "";
				}

				function count(n, noun) {
					return n === 1 ? "1 " + noun : n + " " + noun + "s";
				}

				function datesChanged() {
					return all("input[data-current]").some(function (el) { return el.value.trim() !== el.getAttribute("data-current"); }) ||
						all("select[name^=milestone_status_]").some(function (el) { return el.value !== "" && el.value !== "Planned"; }) ||
						all("[name=delivery_date_reason], [name^=milestone_date_reason_], [name^=milestone_removed_reason_], [name=new_milestone_name], [name=new_milestone_date]").some(typed);
				}

				function render() {
					var health = form.querySelector("input[name=health]:checked");
					var lifecycle = form.querySelector("input[name=lifecycle]:checked");
					var to = lifecycle ? lifecycle.value : "";
					var parts = [];
					if (health && (to === "" || to === "Active")) parts.push({ health: health.value });
					if (health && (health.value === "Yellow" || health.value === "Red") && all("[name=path_to_green]").some(typed)) parts.push("Path to Green");
					var readings = all("input[name^=reading_]").filter(typed).length;
					if (readings) parts.push(count(readings, "Metric"));
					var highlights = all("[name=highlight_note]").filter(typed).length +
						all("[name=draft_highlight_keep]").filter(function (el) { return el.type !== "checkbox" || el.checked; }).length;
					if (highlights) parts.push(count(highlights, "Highlight"));
					if (datesChanged()) parts.push("dates changed");
					if (to) parts.push("→ " + to);
					var key = JSON.stringify(parts);
					if (key === shown) return;
					shown = key;
					summary.replaceChildren();
					parts.forEach(function (part, i) {
						if (i) summary.appendChild(document.createTextNode(" · "));
						summary.appendChild(typeof part === "string" ? text(part) : badge(part.health));
					});
				}

				function text(s) {
					var span = document.createElement("span");
					span.textContent = s;
					return span;
				}

				function badge(health) {
					var span = document.createElement("span");
					span.className = "badge " + ({ Green: "g", Yellow: "y", Red: "r" }[health] || "lc");
					var dot = document.createElement("span");
					dot.className = "dot";
					span.appendChild(dot);
					span.appendChild(document.createTextNode(health));
					return span;
				}
			}
		})();
	</script>
}

// checkinOffTargetWarning asks the Owner to confirm a Green while Metrics are
// off target, naming each with its reading and target. Save as Green anyway
// submits the form as typed, confirmed and as Green; the Owner can instead
// change the Health, which hides the warning, and submit. Pressing Enter in a
// field doesn't confirm a first warning: Enter presses the form's first
// submit, the hidden plain Submit check-in. But a form already confirmed stays
// confirmed (off_target_confirmed), so Enter on it saves the Green. The hidden
// off_target_warned lets Add another warn again.
templ checkinOffTargetWarning(missed []domain.OffTargetMetric, shown displayDates) {
	<section data-testid="checkin-off-target" id="checkin-off-target" class="checkin-off-target" role="alert">
		<input type="hidden" name="off_target_warned" value="1"/>
		<p><strong>A Metric is off target. Is the Goal still Green?</strong></p>
		<ul>
			for _, o := range missed {
				<li>{ offTargetSentence(o, shown) }</li>
			}
		</ul>
		<p>Change the Health and submit, or confirm it's Green.</p>
		<button type="submit" name="confirm_off_target" value="1" class="btn">Save as Green anyway</button>
	</section>
}

// checkinHighlightRow is the nth Highlight row (counting from 1): a kind and
// a note. A blank note flags nothing; a note needs a kind, and that error
// shows in the row.
templ checkinHighlightRow(n int, row highlightFormData, e checkinError) {
	<fieldset data-testid="checkin-highlight-row">
		<legend data-testid="checkin-highlight-legend">{ fmt.Sprintf("Highlight %d", n) }</legend>
		<label>
			Kind
			<select name="highlight_kind">
				@highlightKindOptions(row.Kind)
			</select>
		</label>
		<label>
			Note
			<textarea name="highlight_note">{ row.Note }</textarea>
		</label>
		@checkinFieldError(e, fmt.Sprintf("highlight_%d", n))
	</fieldset>
}

// checkinDraftHighlightRow is the nth Highlight row (counting from 1) offered
// from a pending Draft Highlight: a Keep box, ticked by default, then its kind
// and note to edit. Its fields carry the Draft Highlight's id — a hidden
// field, the Keep box's value and the kind's and note's names — so the server
// pairs them by id, an unticked box posting nothing (CONTEXT.md: Draft
// Highlight).
templ checkinDraftHighlightRow(n int, row highlightFormData, e checkinError) {
	{{ id := fmt.Sprint(row.DraftID) }}
	<fieldset data-testid="checkin-highlight-row" class="checkin-draft-row">
		<legend data-testid="checkin-highlight-legend">{ fmt.Sprintf("Highlight %d · Draft", n) }</legend>
		<input type="hidden" name="draft_highlight_id" value={ id }/>
		<input type="hidden" name={ "draft_highlight_logged_by_" + id } value={ row.LoggedBy }/>
		<label class="checkin-keep">
			<input type="checkbox" name="draft_highlight_keep" value={ id } checked?={ row.Keep }/>
			Keep
		</label>
		<label>
			Kind
			<select name={ "draft_highlight_kind_" + id }>
				@highlightKindOptions(row.Kind)
			</select>
		</label>
		<label>
			Note
			<textarea name={ "draft_highlight_note_" + id }>{ row.Note }</textarea>
		</label>
		@checkinFieldError(e, fmt.Sprintf("highlight_%d", n))
	</fieldset>
}

// confirmCancelScript asks the reader to confirm before a Check-in that
// Cancels the Goal is sent; declining stops the htmx request.
var confirmCancelScript = templ.ComponentScript{Call: fmt.Sprintf(
	"if (this.querySelector('input[name=lifecycle][value=%s]:checked') && !confirm('Cancel this Goal? It will take no more Check-ins.')) event.preventDefault()",
	domain.LifecycleCancelled,
)}

// showPathReasonScript shows the Path to Green's "Reason for moving it later"
// field while the Back to Green by date is later than the latest Check-in's,
// its data-last, and hides it otherwise. It looks only within its own form, so
// it works where a page holds several.
var showPathReasonScript = templ.ComponentScript{Call: "var r = this.form.querySelector('[data-testid=checkin-path-target-reason]'); if (r) r.hidden = !(this.value && this.dataset.last && this.dataset.last < this.value)"}

// swapErrorPageScript swaps an error page into the body, whatever its status
// (a refusal's 403 or 404, a failure's 500), as htmx does for the refusals it
// swaps itself; htmx 2 swaps no error status by default.
var swapErrorPageScript = templ.ComponentScript{Call: "htmx.swap('body', event.detail.xhr.responseText, {swapStyle: 'innerHTML'})"}

// checkinStylesOnce renders the Check-in form's styles once per page, as the
// Check-in page asks for them twice: checkinPage calls checkinStyles, and so
// does the checkinForm inside it, which needs its own call because
// renderCheckinFormError and renderCheckinFormAgain render it alone for htmx
// swaps.
var checkinStylesOnce = templ.NewOnceHandle()

// checkinStyles lays out the Check-in form. The Path to Green hides while Green
// is picked, by CSS alone, unless it holds a validation error, and the
// off-target warning and its notice hide while Green isn't; their fields stay
// in the form either way, so the server's validation is what decides.
templ checkinStyles() {
	@checkinStylesOnce.Once() {
		<style>
			.gp-cells{display:flex;flex-wrap:wrap;gap:12px 32px;margin:0}
			.gp-cell{display:flex;flex-direction:column;gap:4px}
			.gp-cell dd{margin:0;display:flex;align-items:center;gap:4px;flex-wrap:wrap}
			.checkin-page{max-width:1112px;width:100%;margin:0 auto;display:grid;grid-template-columns:minmax(0,760px) minmax(240px,320px);gap:16px 32px;align-items:start}
			.checkin-head{display:flex;justify-content:space-between;align-items:flex-end;flex-wrap:wrap;gap:12px 24px}
			.checkin-head>div{min-width:0}
			.checkin-head p{margin:4px 0 0}
			.checkin-no-change{display:flex;align-items:center;flex-wrap:wrap;gap:8px 12px}
			.checkin-no-change form, .checkin-no-change p{margin:0}
			.checkin-page>*{grid-column:1}
			.checkin-page>nav,.checkin-page>.checkin-head{grid-column:1/-1}
			.checkin-page>.checkin-context{grid-column:2;grid-row:3}
			.checkin-context{display:flex;flex-direction:column;gap:20px;position:sticky;top:24px;align-self:start;max-height:calc(100vh - 48px);overflow-y:auto}
			.checkin-context>section{display:flex;flex-direction:column;gap:8px}
			.checkin-context>section+section{border-top:1px solid var(--color-border);padding-top:20px}
			.checkin-context>.checkin-context-children{gap:12px}
			.checkin-context p{margin:0}
			.checkin-context-health{display:flex;align-items:center;flex-wrap:wrap;gap:4px 8px}
			.checkin-last-status{font-size:14px;color:var(--color-ink-muted);overflow-wrap:anywhere}
			.checkin-context-dates p{font-size:14px;color:var(--color-ink)}
			@media (max-width:900px){.checkin-page{display:flex;flex-direction:column}.checkin-context{position:static;max-height:none;overflow-y:visible}}
			@media (max-width:600px){.checkin-context-last,.checkin-context-dates{display:none}.checkin-context>.checkin-context-children{border-top:none;padding-top:0}.checkin-context:not(:has(.checkin-context-children)){display:none}}
			.checkin-form{display:flex;flex-direction:column;gap:40px}
			.checkin-default-submit{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);padding:0;border:0}
			.checkin-form .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;padding:0;border:0}
			.checkin-form fieldset{border:none;padding:0;margin:0;min-width:0;display:flex;flex-direction:column;gap:8px}
			.checkin-section, .checkin-form>fieldset{display:flex;flex-direction:column;gap:16px}
			.checkin-section-head{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px;padding:0}
			legend.checkin-section-head{width:100%;margin-bottom:16px}
			.checkin-section-head h2{font-family:var(--font-display);font-size:22px;font-weight:700;line-height:1.3}
			@media (max-width:600px){.checkin-section-head h2{font-size:20px}}
			.checkin-form legend{font-weight:600;font-size:14px;padding:0}
			.checkin-form label{display:flex;flex-direction:column;gap:8px;font-weight:600;font-size:14px}
			.checkin-form .hint{font-size:14px;color:var(--color-ink-muted)}
			.checkin-form label textarea, .checkin-form label input, .checkin-form label select{font-weight:400}
			.checkin-form label[hidden]{display:none}
			.health-toggle{flex-direction:row!important;flex-wrap:wrap;gap:12px!important}
			.health-toggle label.badge{flex:1;flex-direction:row;justify-content:center;align-items:center;font-size:15px;height:56px;padding:0 12px;border:2px solid currentColor;border-radius:var(--radius-lg);cursor:pointer}
			.health-toggle label.badge .dot{width:12px;height:12px}
			.health-toggle input{position:absolute;opacity:0;pointer-events:none}
			.health-toggle label.badge:not(:has(input:checked)){background:var(--color-surface);border-color:var(--color-border-strong)}
			.health-toggle label:has(input:focus-visible){outline:2px solid var(--color-focus);outline-offset:2px}
			.checkin-form:has(input[name=health][value=Green]:checked) .path-to-green:not(.has-error){display:none}
			.checkin-rollup{background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:16px;display:flex;flex-direction:column;gap:12px}
			.checkin-rollup p{margin:0}
			.checkin-path-target{display:flex;flex-wrap:wrap;align-items:flex-end;gap:8px 16px}
			.checkin-path-target>.hint{padding-bottom:8px}
			.checkin-form>fieldset.checkin-readings{gap:0}
			.checkin-metric{display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:8px 16px;padding:16px 0;border-top:1px solid var(--color-border)}
			.checkin-metric:last-child{border-bottom:1px solid var(--color-border)}
			.checkin-metric-about{flex:1 1 200px;min-width:0;display:flex;flex-direction:column;gap:4px}
			.checkin-metric-name{font-weight:600}
			.checkin-metric-progress{appearance:none;display:block;width:100%;max-width:240px;height:6px;margin-top:4px;border:none;border-radius:var(--radius-full);background:var(--color-border);overflow:hidden}
			.checkin-metric-progress::-webkit-progress-bar{background:var(--color-border)}
			.checkin-metric-progress::-webkit-progress-value{background:var(--color-primary-strong)}
			.checkin-metric-progress::-moz-progress-bar{background:var(--color-primary-strong)}
			.checkin-metric-input{flex:none}
			.checkin-metric-input input{width:120px;font-family:var(--font-mono);text-align:right}
			.checkin-metric>[data-testid=checkin-error]{flex-basis:100%;margin:0}
			.checkin-more-group{display:flex;flex-direction:column;gap:12px}
			.checkin-more{background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);padding:0 24px}
			.checkin-more>summary{font-weight:600}
			.checkin-more>summary::after{content:"▸";color:var(--color-ink-muted)}
			.checkin-more[open]>summary::after{content:"▾"}
			.checkin-more[open]{padding-bottom:16px}
			.checkin-more fieldset{border:none;padding:0;background:none}
			.checkin-more fieldset>legend{display:none}
			.checkin-highlights{display:flex;flex-direction:column;gap:16px}
			.checkin-more .checkin-highlights fieldset>legend{display:block;padding:0;font-size:13px;color:var(--color-ink-muted)}
			.checkin-highlights>button{align-self:flex-start}
			.checkin-more:has(>.hl-js){padding-top:16px}
			.checkin-form .checkin-keep, .checkin-form .checkin-ask{flex-direction:row;align-items:center}
			.checkin-form .checkin-ask{flex-wrap:wrap;font-weight:400}
			.ms-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1.2fr) minmax(0,1fr);gap:8px 12px;align-items:start}
			.ms-row{display:contents}
			.ms-name{font-weight:600;align-self:center}
			.ms-reasons{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:8px 12px;padding-bottom:8px;border-bottom:1px solid var(--color-border)}
			.ms-reasons textarea,.checkin-more textarea[name=delivery_date_reason]{min-height:40px}
			.lifecycle-choices{display:flex;flex-wrap:wrap;gap:8px 16px}
			.lifecycle-choices label{flex-direction:row;align-items:center;font-weight:500}
			.checkin-off-target{border:1px solid var(--color-border);border-radius:var(--radius-md);padding:12px 16px;background:var(--health-y-bg)}
			.checkin-off-target p,.checkin-off-target ul{margin:0 0 8px}
			.checkin-form:not(:has(input[name=health][value=Green]:checked)) .checkin-off-target, .checkin-form:not(:has(input[name=health][value=Green]:checked)) .checkin-off-target-notice{display:none}
			.checkin-submit-bar{position:sticky;bottom:0;z-index:10;background:var(--color-surface);border-top:1px solid var(--color-border);padding:12px 16px;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
			.checkin-summary{flex:1;color:var(--color-ink-2);font-size:14px}
			.checkin-summary>*{white-space:nowrap}
			.checkin-submit-bar .btn{flex:none}
			.checkin-submit-bar .btn.primary{height:44px}
			html:has(.checkin-submit-bar){scroll-padding-bottom:80px}
			@media (max-width:600px){.checkin-submit-bar .btn.quiet{display:none}.checkin-summary{font-size:13px}.checkin-submit-bar .btn.primary{height:48px}}
			.checkin-history{list-style:none;padding:0;margin:0}
			.checkin-history li{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid var(--color-border)}
		</style>
	}
}

// checkinDateFields lets the Owner move the delivery date, move, finish, or
// remove Planned Milestones, and add new ones, the Milestones laid out as a
// grid of name, date, and status. Every date change needs a reason and is kept
// as a Date Slip; moving the delivery date later rules out Green (CONTEXT.md:
// Date Slip, Milestone). Each date input carries the Goal's current date as
// data-current, so checkinSummaryScript can tell a changed one.
templ checkinDateFields(d checkinDatesFormData, e checkinError) {
	<fieldset data-testid="checkin-dates">
		<legend>Dates and Milestones</legend>
		if d.Dated {
			<label>
				Delivery date
				<input type="date" name="delivery_date" value={ d.DeliveryDate } data-current={ d.CurrentDeliveryDate }/>
			</label>
			@checkinFieldError(e, "delivery_date")
			<label>
				Reason (required if the delivery date changes)
				<textarea name="delivery_date_reason">{ d.DeliveryDateReason }</textarea>
			</label>
			@checkinFieldError(e, "delivery_date_reason")
		}
		<div class="ms-grid">
			<span class="label">Milestone</span>
			<span class="label">Date</span>
			<span class="label">Status</span>
			for _, row := range d.Milestones {
				{{ id := row.Milestone.ID }}
				<div data-testid="checkin-milestone" class="ms-row">
					<span class="ms-name">{ row.Milestone.Name }</span>
					<div>
						<label>
							<input type="date" name={ fmt.Sprintf("milestone_date_%d", id) } value={ row.Date } aria-label={ "Date of " + row.Milestone.Name } data-current={ fmtDate(row.Milestone.TargetDate) }/>
						</label>
						@checkinFieldError(e, fmt.Sprintf("milestone_date_%d", id))
					</div>
					<div>
						<label>
							<select name={ fmt.Sprintf("milestone_status_%d", id) } aria-label={ "Status of " + row.Milestone.Name }>
								<option value={ domain.MilestonePlanned } selected?={ row.planned() }>Planned</option>
								<option value={ domain.MilestoneDone } selected?={ row.Status == domain.MilestoneDone }>Done</option>
								<option value={ domain.MilestoneRemoved } selected?={ row.Status == domain.MilestoneRemoved }>Removed</option>
							</select>
						</label>
					</div>
					<div class="ms-reasons">
						<div>
							<label>
								<span class="hint">Reason, if the date changes</span>
								<textarea name={ fmt.Sprintf("milestone_date_reason_%d", id) }>{ row.DateReason }</textarea>
							</label>
							@checkinFieldError(e, fmt.Sprintf("milestone_date_reason_%d", id))
						</div>
						<div>
							<label>
								<span class="hint">Reason, if Removed</span>
								<textarea name={ fmt.Sprintf("milestone_removed_reason_%d", id) }>{ row.RemovedReason }</textarea>
							</label>
							@checkinFieldError(e, fmt.Sprintf("milestone_removed_reason_%d", id))
						</div>
					</div>
				</div>
			}
			for i, row := range append(d.NewMilestones, newMilestoneFormRow{}) {
				<div data-testid="checkin-new-milestone" class="ms-row">
					<label>
						<input type="text" name="new_milestone_name" value={ row.Name } placeholder="Add a Milestone" aria-label="New Milestone name"/>
					</label>
					<div>
						<label>
							<input type="date" name="new_milestone_date" value={ row.Date } aria-label="New Milestone date"/>
						</label>
						@checkinFieldError(e, fmt.Sprintf("new_milestone_%d", i))
					</div>
					<span class="ms-name hint">New</span>
				</div>
			}
		</div>
	</fieldset>
}

// checkinLifecycleFields lets the Owner change the Goal's Lifecycle in the
// Check-in. On Hold and Cancelled need a reason; Done needs a one-line outcome
// and a final value for every Metric (the readings above). A Check-in that
// takes the Goal out of Active records no Health (CONTEXT.md: Lifecycle).
templ checkinLifecycleFields(d lifecycleFormData, e checkinError) {
	<fieldset data-testid="checkin-lifecycle-fields">
		<legend>Lifecycle</legend>
		<div class="lifecycle-choices" role="radiogroup" aria-label="Lifecycle">
			for _, c := range d.choices() {
				<label>
					<input type="radio" name="lifecycle" value={ c.To } checked?={ d.To == c.To }/>
					{ c.Label }
				</label>
			}
		</div>
		@checkinFieldError(e, "lifecycle")
		<label>
			Reason (required for On Hold or Cancelled)
			<textarea name="lifecycle_reason">{ d.Reason }</textarea>
		</label>
		@checkinFieldError(e, "lifecycle_reason")
		if d.Current != domain.LifecycleOnHold {
			<label>
				Outcome, in one line (required for Done, with a final value for every Metric)
				<input type="text" name="outcome" value={ d.Outcome }/>
			</label>
			@checkinFieldError(e, "outcome")
		}
	</fieldset>
}

// checkinFieldError shows the form's validation message when it is about the
// named field. One about no field, shown at the top of the form, is styled as
// an error, like the import page's error flash.
templ checkinFieldError(e checkinError, field string) {
	if e.Message != "" && e.Field == field {
		if field == "" {
			<p data-testid="checkin-error" class="alert r" role="alert">{ e.Message }</p>
		} else {
			<p data-testid="checkin-error" role="alert">{ e.Message }</p>
		}
	}
}
