package web

import (
	"fmt"
	"strings"
	"time"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// checkinFormData is the state the Check-in form renders from: the Goal it posts
// to, the prefilled Health, status, and Path to Green, and an optional
// validation error shown next to the field it is about.
type checkinFormData struct {
	GoalID         int64
	Health         string
	Status         string
	PathToGreen    string
	PathTargetDate string
	// RolledUp is the Goal's Rolled-up Health, shown in the form so the Owner can
	// see the worst among their Active children while setting their own Health
	// (ADR-0003). Explanation is the Owner's reason for a difference, required
	// only when their Health differs from the Rolled-up Health.
	RolledUp    domain.RolledUpHealth
	Explanation string
	// Metrics are the Goal's Metrics, one reading input each (CONTEXT.md: a
	// Metric's current value is recorded at each Check-in). Readings holds each
	// input's value, keyed by Metric ID: the Metric's latest reading on a fresh
	// form, or what the reader typed so an error re-render keeps it.
	Metrics  []domain.Metric
	Readings map[int64]string
	// Highlight is the optional Highlight the reader flagged (CONTEXT.md:
	// Highlight). Its Kind is empty when nothing was flagged.
	Highlight highlightFormData
	// Dates are the delivery date and Milestone changes the reader is making
	// (CONTEXT.md: a Check-in carries Date Slips and Milestone changes).
	Dates checkinDatesFormData
	// Lifecycle is the Lifecycle change the reader is making, if any
	// (CONTEXT.md: Lifecycle).
	Lifecycle lifecycleFormData
	Error     checkinError
}

// checkinError is a Check-in validation message and the field it is about,
// named as the form names the field's input (e.g. "explanation"), so the form
// shows the message next to that field. An empty Field is an error about the
// Check-in as a whole, shown at the top of the form.
type checkinError struct {
	Field   string
	Message string
}

// lifecycleFormData is the Check-in form's Lifecycle fields as typed. Current is
// the Goal's Lifecycle: an Active Goal may go On Hold, be marked Done, or be
// Cancelled; an On Hold Goal may be resumed or Cancelled. To is empty to leave
// the Lifecycle alone.
type lifecycleFormData struct {
	Current string
	To      string
	Reason  string
	Outcome string
}

// checkinDatesFormData is the Check-in form's date and Milestone fields as
// typed. Dated is true for a Dated Goal, whose delivery date the form can move;
// Milestones holds a row per Planned Milestone, and NewMilestones the rows the
// reader is adding.
type checkinDatesFormData struct {
	Dated bool
	// CurrentDeliveryDate is the Goal's delivery date before this Check-in, so
	// the form can tell whether the reader moved it.
	CurrentDeliveryDate string
	DeliveryDate        string
	DeliveryDateReason  string
	Milestones          []milestoneFormRow
	NewMilestones       []newMilestoneFormRow
}

// milestoneFormRow is one Planned Milestone's fields in the Check-in form: its
// date (a change records a Date Slip needing DateReason) and its status (Removed
// needs RemovedReason).
type milestoneFormRow struct {
	Milestone     domain.Milestone
	Date          string
	DateReason    string
	Status        string
	RemovedReason string
}

// newMilestoneFormRow is a Milestone the reader is adding in the Check-in.
type newMilestoneFormRow struct {
	Name string
	Date string
}

// planned reports whether the row leaves its Milestone Planned.
func (row milestoneFormRow) planned() bool {
	return row.Status == "" || row.Status == domain.MilestonePlanned
}

// highlightFormData is the Check-in form's optional Highlight: its kind (empty
// for none) and note.
type highlightFormData struct {
	Kind string
	Note string
}

// reading returns the value to prefill a Metric's reading input with.
func (d checkinFormData) reading(metricID int64) string {
	if d.Readings == nil {
		return ""
	}
	return d.Readings[metricID]
}

// about reports whether the error is about one of the named fields or a field
// in its family: "milestone" covers every milestone_*_<id> field.
func (e checkinError) about(fields ...string) bool {
	for _, f := range fields {
		if e.Field == f || strings.HasPrefix(e.Field, f+"_") {
			return true
		}
	}
	return false
}

// highlightOpen reports whether the Highlight section renders open: it holds
// the error, or the reader flagged or wrote something.
func (d checkinFormData) highlightOpen() bool {
	return d.Error.about("highlight") || d.Highlight.Kind != "" || strings.TrimSpace(d.Highlight.Note) != ""
}

// highlightSummary is the Highlight section's summary line, naming the kind
// flagged, if any.
func (d checkinFormData) highlightSummary() string {
	if d.Highlight.Kind == "" {
		return "Flag a highlight (optional)"
	}
	return "Flag a highlight · " + d.Highlight.Kind
}

// datesOpen reports whether the dates and Milestones section renders open: it
// holds the error, or the reader changed something in it.
func (d checkinFormData) datesOpen() bool {
	return d.Error.about("delivery_date", "milestone", "new_milestone") || d.Dates.changed()
}

// changed reports whether any date or Milestone field differs from the Goal's
// current state.
func (d checkinDatesFormData) changed() bool {
	if d.Dated && (d.DeliveryDate != d.CurrentDeliveryDate || strings.TrimSpace(d.DeliveryDateReason) != "") {
		return true
	}
	for _, row := range d.Milestones {
		if row.Date != fmtDate(row.Milestone.TargetDate) || !row.planned() ||
			strings.TrimSpace(row.DateReason) != "" || strings.TrimSpace(row.RemovedReason) != "" {
			return true
		}
	}
	return len(d.NewMilestones) > 0
}

// summary is the dates and Milestones section's summary line: the delivery
// date and how many Milestones are still Planned, as the form stands.
func (d checkinDatesFormData) summary() string {
	parts := []string{"Change dates or milestones"}
	if d.Dated && d.DeliveryDate != "" {
		parts = append(parts, "delivers "+shortDate(d.DeliveryDate))
	}
	planned := 0
	for _, row := range d.Milestones {
		if row.planned() {
			planned++
		}
	}
	switch planned {
	case 0:
	case 1:
		parts = append(parts, "1 planned milestone")
	default:
		parts = append(parts, fmt.Sprintf("%d planned milestones", planned))
	}
	return strings.Join(parts, " · ")
}

// shortDate renders a form date as "Dec 12", or as typed when it isn't a date.
func shortDate(raw string) string {
	t, err := time.Parse(dateLayout, raw)
	if err != nil {
		return raw
	}
	return t.Format("Jan 2")
}

// lifecycleChoice is one Lifecycle the form offers: the value posted and its
// label.
type lifecycleChoice struct {
	To    string
	Label string
}

// choices are the Lifecycles the form offers from the Goal's current one: an
// Active Goal may stay Active, go On Hold, be marked Done, or be Cancelled; an
// On Hold Goal may be resumed or Cancelled.
func (d lifecycleFormData) choices() []lifecycleChoice {
	if d.Current == domain.LifecycleOnHold {
		return []lifecycleChoice{
			{domain.LifecycleActive, "Resume (Active)"},
			{domain.LifecycleCancelled, "Cancel"},
		}
	}
	return []lifecycleChoice{
		{"", "Keep Active"},
		{domain.LifecycleOnHold, "Put On Hold"},
		{domain.LifecycleDone, "Mark Done"},
		{domain.LifecycleCancelled, "Cancel"},
	}
}

// defaultTo is the Lifecycle the form picks by default: leave an Active Goal
// alone, resume an On Hold one.
func (d lifecycleFormData) defaultTo() string {
	if d.Current == domain.LifecycleOnHold {
		return domain.LifecycleActive
	}
	return ""
}

// lifecycleOpen reports whether the Lifecycle section renders open: it holds
// the error, or the reader picked another Lifecycle or wrote a reason or
// outcome.
func (d checkinFormData) lifecycleOpen() bool {
	l := d.Lifecycle
	return d.Error.about("lifecycle", "outcome") || l.To != l.defaultTo() ||
		strings.TrimSpace(l.Reason) != "" || strings.TrimSpace(l.Outcome) != ""
}

// summary is the Lifecycle section's summary line, naming the change picked.
func (d lifecycleFormData) summary() string {
	title := "Pause, finish, or cancel this goal"
	if d.Current == domain.LifecycleOnHold {
		title = "Resume or cancel this goal"
	}
	switch d.To {
	case "":
		return title + " · stays Active"
	case domain.LifecycleActive:
		return title + " · resumes"
	default:
		return title + " · " + d.To
	}
}

// checkinFormFromLatest prefills the Check-in form from a Goal's latest Check-in,
// or with a fresh Green form when there is none (CONTEXT.md: the form is
// pre-filled from the latest Check-in), and each Metric's reading with its latest
// value, blank for a Metric not yet read. It also carries the Rolled-up Health so
// the form can show it beside the Owner's Health, and the Goal's current
// delivery date and Planned Milestones so the Owner can move or close them.
func checkinFormFromLatest(v goalView) checkinFormData {
	g := v.Goal
	d := checkinFormData{GoalID: g.ID, Health: domain.HealthGreen, RolledUp: v.RolledUp, Metrics: v.Metrics}
	if latest := v.LatestCheckin; latest != nil {
		d.Health = latest.Health
		d.Status = latest.Status
		d.PathToGreen = latest.PathToGreen
		d.PathTargetDate = fmtDate(latest.PathTargetDate)
		d.Explanation = latest.Explanation
	}
	d.Readings = make(map[int64]string, len(v.Trends))
	for _, t := range v.Trends {
		if n := len(t.Readings); n > 0 {
			d.Readings[t.Metric.ID] = fmtNum(t.Readings[n-1].Value)
		}
	}
	d.Lifecycle.Current = g.Lifecycle
	if g.Lifecycle == domain.LifecycleOnHold {
		// An On Hold Goal's Check-in resumes or Cancels it; resuming is the
		// common case, so it is preselected.
		d.Lifecycle.To = domain.LifecycleActive
	}
	d.Dates.Dated = g.Kind == domain.GoalDated
	d.Dates.DeliveryDate = fmtDate(g.DeliveryDate)
	d.Dates.CurrentDeliveryDate = d.Dates.DeliveryDate
	for _, m := range v.Milestones {
		if m.Status == domain.MilestonePlanned {
			d.Dates.Milestones = append(d.Dates.Milestones, milestoneFormRow{
				Milestone: m,
				Date:      fmtDate(m.TargetDate),
				Status:    domain.MilestonePlanned,
			})
		}
	}
	return d
}

// checkinSection shows a Goal's current Health, status, and Path to Green (from
// its latest Check-in), a link to the Check-in page and a one-click "no change"
// button, and the immutable Check-in history. canCheckin is true for whoever may
// write a Check-in — the Owner or a Delegate (CONTEXT.md: Check-in, Delegate).
templ checkinSection(v goalView, canCheckin bool) {
	{{ g := v.Goal }}
	<section data-testid="goal-checkins">
		@checkinStyles()
		<h2>Check-ins</h2>
		if g.Lifecycle != domain.LifecycleActive && g.Lifecycle != domain.LifecycleProposed {
			<p data-testid="goal-no-health">{ fmt.Sprintf("A %s Goal has no Health.", g.Lifecycle) }</p>
			if v.LatestCheckin != nil {
				<p data-testid="goal-status">{ v.LatestCheckin.Status }</p>
			}
		} else if v.LatestCheckin != nil {
			<p>
				<strong>Current Health:</strong>
				<span class={ "badge", healthClass(v.LatestCheckin.Health) }><span class="dot"></span><span data-testid="goal-health">{ v.LatestCheckin.Health }</span></span>
				if v.RolledUp.Present {
					· <strong>Rolled-up Health:</strong> <span data-testid="goal-rollup-health">{ v.RolledUp.Health }</span>
					<span>(worst among Active children)</span>
				}
				@rolledUpStale(v.RolledUp)
			</p>
			<p data-testid="goal-status">{ v.LatestCheckin.Status }</p>
			if v.LatestCheckin.PathToGreen != "" {
				<p data-testid="goal-path-to-green">
					<strong>Path to Green:</strong> { v.LatestCheckin.PathToGreen } — back to Green by { fmtDate(v.LatestCheckin.PathTargetDate) }
				</p>
			}
			if v.LatestCheckin.Explanation != "" {
				<p data-testid="goal-rollup-explanation">
					<strong>Why this differs from the Rolled-up Health:</strong> { v.LatestCheckin.Explanation }
				</p>
			}
		} else {
			if g.Lifecycle == domain.LifecycleProposed {
				<p data-testid="goal-no-health">A Proposed Goal has no Health until it is Active.</p>
			} else {
				<p data-testid="goal-no-health">No Check-ins yet.</p>
			}
			if v.RolledUp.Present || v.RolledUp.StaleChildren > 0 {
				<p>
					if v.RolledUp.Present {
						<strong>Rolled-up Health:</strong> <span data-testid="goal-rollup-health">{ v.RolledUp.Health }</span>
						<span>(worst among Active children)</span>
					}
					@rolledUpStale(v.RolledUp)
				</p>
			}
		}
		<h3>Check-in history</h3>
		<ul class="checkin-history" data-testid="checkin-history">
			if len(v.Checkins) == 0 {
				<li data-testid="no-checkins">No Check-ins yet.</li>
			}
			for _, c := range v.Checkins {
				<li data-testid="checkin">
					<span class="muted small">{ c.CreatedAt.Format("2006-01-02 15:04") }</span>
					if c.Health != "" {
						<span class={ "badge", healthClass(c.Health) }><span class="dot"></span>{ c.Health }</span>
					}
					<span>{ c.Status }</span>
					if c.LifecycleChange.Changed() {
						<span data-testid="checkin-lifecycle">
							{ fmt.Sprintf(" — Lifecycle: %s → %s", c.LifecycleChange.From, c.LifecycleChange.To) }
							if c.LifecycleChange.Reason != "" {
								{ ": " + c.LifecycleChange.Reason }
							}
							if c.LifecycleChange.Outcome != "" {
								{ " — Outcome: " + c.LifecycleChange.Outcome }
							}
						</span>
					}
					if c.PathToGreen != "" {
						<span>— Path to Green: { c.PathToGreen } (by { fmtDate(c.PathTargetDate) })</span>
					}
					<span class="muted small">— by { c.Author.Email }, owner { c.Owner.Email }</span>
				</li>
			}
		</ul>
	</section>
}

// noChangeCheckinButton records a Check-in repeating the Goal's previous values
// in one click (CONTEXT.md: Check-in).
templ noChangeCheckinButton(goalID int64, label string) {
	<form
		data-testid="no-change-checkin"
		hx-post={ fmt.Sprintf("/goals/%d/checkins/no-change", goalID) }
		hx-target="body"
		method="post"
		action={ templ.SafeURL(fmt.Sprintf("/goals/%d/checkins/no-change", goalID)) }
	>
		<button type="submit" class="btn">{ label }</button>
	</form>
}

// checkinPage is the Check-in on its own page, reached from the Goal page by
// the Owner or a Delegate: a breadcrumb back to the Goal, then the one-click
// "no change" card when there is a previous Check-in to repeat, then the form,
// prefilled from the latest Check-in.
templ checkinPage(current *domain.Account, v goalView) {
	{{ g := v.Goal }}
	@layout("Check in · "+g.Title, current) {
		@checkinStyles()
		<div class="checkin-page">
			<nav class="small muted" aria-label="Breadcrumb">
				<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a> › Check in
			</nav>
			<h1>Check in</h1>
			if g.Lifecycle == domain.LifecycleActive && v.LatestCheckin != nil {
				<div data-testid="no-change-card" class="card">
					<div>
						<h2>{ "Nothing changed since " + v.LatestCheckin.CreatedAt.Format("Jan 2") + "?" }</h2>
						<p class="muted">Records the same Health and status with today's date.</p>
					</div>
					@noChangeCheckinButton(g.ID, "No change")
				</div>
			}
			if g.Lifecycle == domain.LifecycleActive || g.Lifecycle == domain.LifecycleOnHold {
				@checkinForm(checkinFormFromLatest(v))
			} else {
				<p data-testid="goal-no-health">{ fmt.Sprintf("A %s Goal takes no Check-ins.", g.Lifecycle) }</p>
			}
		</div>
	}
}

// checkinForm is the Owner's Check-in form. It posts with htmx and targets
// itself, so a validation error re-renders it in place with the message next to
// the field it is about. Health, status, and readings are always shown; the
// Highlight, dates and Milestones, and Lifecycle each sit in a collapsed
// section that opens when it holds an error or a value the reader typed.
templ checkinForm(d checkinFormData) {
	<form
		id="checkin-form"
		class="checkin-form"
		data-testid="checkin-form"
		hx-post={ fmt.Sprintf("/goals/%d/checkins", d.GoalID) }
		hx-target="#checkin-form"
		hx-swap="outerHTML"
		hx-on:htmx:confirm={ confirmCancelScript }
		method="post"
		action={ templ.SafeURL(fmt.Sprintf("/goals/%d/checkins", d.GoalID)) }
	>
		@checkinStyles()
		@checkinFieldError(d.Error, "")
		<fieldset data-testid="checkin-health" class="health-toggle">
			<legend>Health</legend>
			for _, health := range []string{domain.HealthGreen, domain.HealthYellow, domain.HealthRed} {
				<label class={ "badge", healthClass(health) }>
					<input type="radio" name="health" value={ health } checked?={ d.Health == health }/>
					<span class="dot"></span>{ health }
				</label>
			}
		</fieldset>
		@checkinFieldError(d.Error, "health")
		<fieldset data-testid="path-to-green-field" class={ "path-to-green", templ.KV("has-error", d.Error.Field == "path_to_green") }>
			<legend>Path to Green (required when Yellow or Red)</legend>
			<label>
				Plan
				<textarea name="path_to_green">{ d.PathToGreen }</textarea>
			</label>
			<label>
				Back to Green by
				<input type="date" name="path_target_date" value={ d.PathTargetDate }/>
			</label>
			@checkinFieldError(d.Error, "path_to_green")
		</fieldset>
		if d.RolledUp.Present {
			<p data-testid="checkin-form-rollup">
				Rolled-up Health: <strong>{ d.RolledUp.Health }</strong> — the worst among your Active children.
			</p>
			<label>
				Explanation (required if your Health differs from the Rolled-up Health)
				<textarea name="explanation" data-testid="checkin-explanation">{ d.Explanation }</textarea>
			</label>
			@checkinFieldError(d.Error, "explanation")
		}
		<label>
			<span>Status <span class="hint">what changed since the last check-in</span></span>
			<textarea name="status" required>{ d.Status }</textarea>
		</label>
		@checkinFieldError(d.Error, "status")
		if len(d.Metrics) > 0 {
			<fieldset data-testid="checkin-readings" class="checkin-readings">
				<legend>Metric readings</legend>
				for _, m := range d.Metrics {
					<label>
						<span>{ m.Name } <span class="hint">({ m.Unit }) — target { fmtNum(m.Target) }</span></span>
						<input
							type="number"
							step="any"
							name={ readingField(m.ID) }
							value={ d.reading(m.ID) }
						/>
					</label>
					@checkinFieldError(d.Error, readingField(m.ID))
				}
			</fieldset>
		}
		<details data-testid="checkin-highlight-section" class="checkin-more" open?={ d.highlightOpen() }>
			<summary>{ d.highlightSummary() }</summary>
			<fieldset data-testid="checkin-highlight">
				<legend>Highlight (optional)</legend>
				<label>
					Kind
					<select name="highlight_kind">
						<option value="" selected?={ d.Highlight.Kind == "" }>None</option>
						<option value={ domain.HighlightInsight } selected?={ d.Highlight.Kind == domain.HighlightInsight }>Insight</option>
						<option value={ domain.HighlightAccomplishment } selected?={ d.Highlight.Kind == domain.HighlightAccomplishment }>Accomplishment</option>
						<option value={ domain.HighlightMiss } selected?={ d.Highlight.Kind == domain.HighlightMiss }>Miss</option>
					</select>
				</label>
				@checkinFieldError(d.Error, "highlight_kind")
				<label>
					Note
					<textarea name="highlight_note">{ d.Highlight.Note }</textarea>
				</label>
				@checkinFieldError(d.Error, "highlight_note")
			</fieldset>
		</details>
		<details data-testid="checkin-dates-section" class="checkin-more" open?={ d.datesOpen() }>
			<summary>{ d.Dates.summary() }</summary>
			@checkinDateFields(d.Dates, d.Error)
		</details>
		<details data-testid="checkin-lifecycle-section" class="checkin-more" open?={ d.lifecycleOpen() }>
			<summary>{ d.Lifecycle.summary() }</summary>
			@checkinLifecycleFields(d.Lifecycle, d.Error)
		</details>
		<div class="checkin-submit">
			<a class="btn quiet" href={ templ.SafeURL(fmt.Sprintf("/goals/%d", d.GoalID)) }>Cancel</a>
			<button type="submit" class="btn primary">Submit check-in</button>
		</div>
	</form>
}

// confirmCancelScript asks the reader to confirm before a Check-in that
// Cancels the Goal is sent; declining stops the htmx request.
var confirmCancelScript = templ.ComponentScript{Call: fmt.Sprintf(
	"if (this.querySelector('input[name=lifecycle][value=%s]:checked') && !confirm('Cancel this Goal? It will take no more Check-ins.')) event.preventDefault()",
	domain.LifecycleCancelled,
)}

// checkinStylesOnce renders the Check-in form's styles once per page, however
// many forms the page carries (the Delegates page has one per Goal).
var checkinStylesOnce = templ.NewOnceHandle()

// checkinStyles lays out the Check-in form. The Path to Green hides while Green
// is picked, by CSS alone, unless it holds a validation error; its fields stay
// in the form either way, so the server's validation is what decides.
templ checkinStyles() {
	@checkinStylesOnce.Once() {
		<style>
			.checkin-page{max-width:760px;width:100%;margin:0 auto;display:flex;flex-direction:column;gap:16px}
			.checkin-page .card{padding:16px 20px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
			.checkin-page .card form{margin:0}
			.checkin-form{display:flex;flex-direction:column;gap:16px}
			.checkin-form fieldset{border:1px solid #E2E3DE;border-radius:8px;padding:12px 16px;margin:0;display:flex;flex-direction:column;gap:8px;background:#fff}
			.checkin-form legend{font-weight:600;font-size:13px;padding:0 4px}
			.checkin-form label{display:flex;flex-direction:column;gap:6px;font-weight:600;font-size:13px}
			.health-toggle{flex-direction:row!important;flex-wrap:wrap;gap:12px!important;border:none!important;padding:0!important;background:none!important}
			.health-toggle legend{padding:0;margin-bottom:6px}
			.health-toggle label.badge{flex:1;flex-direction:row;justify-content:center;align-items:center;font-size:15px;height:48px;padding:0 20px;border:2px solid transparent;cursor:pointer;opacity:.7}
			.health-toggle label.badge .dot{width:12px;height:12px}
			.health-toggle input{position:absolute;opacity:0;pointer-events:none}
			.health-toggle label:has(input:checked){border-color:currentColor;opacity:1}
			.health-toggle label:has(input:focus-visible){outline:2px solid #24519E;outline-offset:1px}
			.checkin-form:has(input[name=health][value=Green]:checked) .path-to-green:not(.has-error){display:none}
			.checkin-form:has(input[name=health][value=Yellow]:checked) .path-to-green{background:#FDF6E3}
			.checkin-form:has(input[name=health][value=Red]:checked) .path-to-green{background:#FCEEEC}
			.checkin-readings label{flex-direction:row;align-items:center;justify-content:space-between;gap:12px}
			.checkin-readings input{width:160px}
			.checkin-more{background:#fff;border:1px solid #E2E3DE;border-radius:8px;padding:0 16px}
			.checkin-more>summary{font-weight:600}
			.checkin-more>summary::after{content:"▸";color:#5A606B}
			.checkin-more[open]>summary::after{content:"▾"}
			.checkin-more[open]{padding-bottom:16px}
			.checkin-more fieldset{border:none;padding:0;background:none}
			.checkin-more fieldset>legend{display:none}
			.ms-grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(0,1.2fr) minmax(0,1fr);gap:8px 12px;align-items:start}
			.ms-grid>.ms-head{font-size:12px;font-weight:600;color:#5A606B}
			.ms-row{display:contents}
			.ms-name{font-weight:600;align-self:center}
			.ms-reasons{grid-column:1/-1;display:grid;grid-template-columns:1fr 1fr;gap:8px 12px;padding-bottom:8px;border-bottom:1px solid #EEEFEA}
			.ms-reasons textarea,.checkin-more textarea[name=delivery_date_reason]{min-height:40px}
			.lifecycle-choices{display:flex;flex-wrap:wrap;gap:8px 16px}
			.lifecycle-choices label{flex-direction:row;align-items:center;font-weight:500}
			.checkin-submit{display:flex;justify-content:flex-end;gap:12px}
			.checkin-history{list-style:none;padding:0;margin:0}
			.checkin-history li{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:8px 0;border-bottom:1px solid #EEEFEA}
			.checkin-actions{display:flex;gap:12px;align-items:center}
			.checkin-actions form{margin:0}
		</style>
	}
}

// checkinDateFields lets the Owner move the delivery date, move, finish, or
// remove Planned Milestones, and add new ones, the Milestones laid out as a
// grid of name, date, and status. Every date change needs a reason and is kept
// as a Date Slip; moving the delivery date later rules out Green (CONTEXT.md:
// Date Slip, Milestone).
templ checkinDateFields(d checkinDatesFormData, e checkinError) {
	<fieldset data-testid="checkin-dates">
		<legend>Dates and Milestones</legend>
		if d.Dated {
			<label>
				Delivery date
				<input type="date" name="delivery_date" value={ d.DeliveryDate }/>
			</label>
			@checkinFieldError(e, "delivery_date")
			<label>
				Reason (required if the delivery date changes)
				<textarea name="delivery_date_reason">{ d.DeliveryDateReason }</textarea>
			</label>
			@checkinFieldError(e, "delivery_date_reason")
		}
		<div class="ms-grid">
			<span class="ms-head">Milestone</span>
			<span class="ms-head">Date</span>
			<span class="ms-head">Status</span>
			for _, row := range d.Milestones {
				{{ id := row.Milestone.ID }}
				<div data-testid="checkin-milestone" class="ms-row">
					<span class="ms-name">{ row.Milestone.Name }</span>
					<div>
						<label>
							<input type="date" name={ fmt.Sprintf("milestone_date_%d", id) } value={ row.Date } aria-label={ "Date of " + row.Milestone.Name }/>
						</label>
						@checkinFieldError(e, fmt.Sprintf("milestone_date_%d", id))
					</div>
					<div>
						<label>
							<select name={ fmt.Sprintf("milestone_status_%d", id) } aria-label={ "Status of " + row.Milestone.Name }>
								<option value={ domain.MilestonePlanned } selected?={ row.planned() }>Planned</option>
								<option value={ domain.MilestoneDone } selected?={ row.Status == domain.MilestoneDone }>Done</option>
								<option value={ domain.MilestoneRemoved } selected?={ row.Status == domain.MilestoneRemoved }>Removed</option>
							</select>
						</label>
					</div>
					<div class="ms-reasons">
						<div>
							<label>
								<span class="hint">Reason, if the date changes</span>
								<textarea name={ fmt.Sprintf("milestone_date_reason_%d", id) }>{ row.DateReason }</textarea>
							</label>
							@checkinFieldError(e, fmt.Sprintf("milestone_date_reason_%d", id))
						</div>
						<div>
							<label>
								<span class="hint">Reason, if Removed</span>
								<textarea name={ fmt.Sprintf("milestone_removed_reason_%d", id) }>{ row.RemovedReason }</textarea>
							</label>
							@checkinFieldError(e, fmt.Sprintf("milestone_removed_reason_%d", id))
						</div>
					</div>
				</div>
			}
			for i, row := range append(d.NewMilestones, newMilestoneFormRow{}) {
				<div data-testid="checkin-new-milestone" class="ms-row">
					<label>
						<input type="text" name="new_milestone_name" value={ row.Name } placeholder="Add a Milestone" aria-label="New Milestone name"/>
					</label>
					<div>
						<label>
							<input type="date" name="new_milestone_date" value={ row.Date } aria-label="New Milestone date"/>
						</label>
						@checkinFieldError(e, fmt.Sprintf("new_milestone_%d", i))
					</div>
					<span class="ms-name hint">New</span>
				</div>
			}
		</div>
	</fieldset>
}

// checkinLifecycleFields lets the Owner change the Goal's Lifecycle in the
// Check-in. On Hold and Cancelled need a reason; Done needs a one-line outcome
// and a final value for every Metric (the readings above). A Check-in that
// takes the Goal out of Active records no Health (CONTEXT.md: Lifecycle).
templ checkinLifecycleFields(d lifecycleFormData, e checkinError) {
	<fieldset data-testid="checkin-lifecycle-fields">
		<legend>Lifecycle</legend>
		<div class="lifecycle-choices" role="radiogroup" aria-label="Lifecycle">
			for _, c := range d.choices() {
				<label>
					<input type="radio" name="lifecycle" value={ c.To } checked?={ d.To == c.To }/>
					{ c.Label }
				</label>
			}
		</div>
		@checkinFieldError(e, "lifecycle")
		<label>
			Reason (required for On Hold or Cancelled)
			<textarea name="lifecycle_reason">{ d.Reason }</textarea>
		</label>
		@checkinFieldError(e, "lifecycle_reason")
		if d.Current != domain.LifecycleOnHold {
			<label>
				Outcome, in one line (required for Done, with a final value for every Metric)
				<input type="text" name="outcome" value={ d.Outcome }/>
			</label>
			@checkinFieldError(e, "outcome")
		}
	</fieldset>
}

// checkinFieldError shows the form's validation message when it is about the
// named field.
templ checkinFieldError(e checkinError, field string) {
	if e.Message != "" && e.Field == field {
		<p data-testid="checkin-error" role="alert">{ e.Message }</p>
	}
}
