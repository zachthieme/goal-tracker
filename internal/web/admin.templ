package web

import (
	"fmt"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// adminPage gathers the Admin tools: a card per tool, then the Ownerless Goals
// waiting for an Admin to reassign them (CONTEXT.md: Ownerless), then the
// Departed people an Admin can mark returned (CONTEXT.md: Departed).
templ adminPage(current *domain.Account, ownerless []domain.Goal, departed []domain.Account) {
	@layout("Admin", current) {
		@adminStyles()
		<header class="page-head">
			<div>
				<h1>Admin</h1>
				<p class="muted">The tools only an Admin uses.</p>
			</div>
		</header>
		<nav class="ad-tools" aria-label="Admin tools">
			@adminTool("admin-dimensions", "/dimensions", "Dimensions", "Define the Dimensions Goals are tagged with")
			@adminTool("admin-fields", "/fields", "Fields", "Define the Fields typed on a Goal to describe it")
			@adminTool("admin-imports", "/imports", "Import goals", "Load Goals from a CSV or XLSX spreadsheet")
			@adminTool("admin-definition-log", "/definition-log", "Definition log", "Every change to the Dimensions and Fields, with who made it and when")
		</nav>
		<section data-testid="admin-ownerless" class="ad-section">
			<div>
				<h2>Ownerless Goals</h2>
				<p class="muted">Goals whose Owner has left the org, waiting for an Admin to reassign them on the Goal's page.</p>
			</div>
			<div class="card">
				if len(ownerless) == 0 {
					<p data-testid="admin-ownerless-empty" class="muted">No Goals are waiting for reassignment.</p>
				} else {
					<table>
						<thead>
							<tr><th>Goal</th><th>Former Owner</th><th>Lifecycle</th></tr>
						</thead>
						<tbody>
							for _, g := range ownerless {
								<tr data-testid="admin-ownerless-goal">
									<td><a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a></td>
									<td>
										@person(g.Owner)
									</td>
									<td><span class="badge lc">{ g.Lifecycle }</span></td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
		</section>
		<section data-testid="admin-departed" class="ad-section">
			<div>
				<h2>Departed people</h2>
				<p class="muted">People who have left the org. Mark someone returned to let them sign in and act again.</p>
			</div>
			<div class="card">
				if len(departed) == 0 {
					<p data-testid="admin-departed-empty" class="muted">Nobody has left the org.</p>
				} else {
					<table>
						<thead>
							<tr><th>Person</th><th><span class="sr-only">Action</span></th></tr>
						</thead>
						<tbody>
							for _, a := range departed {
								<tr data-testid="admin-departed-person">
									<td>
										@person(a)
									</td>
									<td class="ad-action">
										<form method="post" action={ templ.SafeURL(fmt.Sprintf("/accounts/%d/return", a.ID)) } onsubmit={ confirmScript(confirmReturnPerson) }>
											<button type="submit" class="btn sm">Mark returned…</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
		</section>
	}
}

// confirmReturnPerson is what an Admin confirms before marking a Departed
// person returned from the Admin page, where they may own no Goals at all.
const confirmReturnPerson = "Mark this person returned? They can sign in and act again, and any Goals they still own stop being Ownerless. Goals reassigned while they were away stay with their new Owners."

// adminTool is a card linking to one Admin tool, saying what it's for.
templ adminTool(testID, href, label, blurb string) {
	<a data-testid={ testID } class="card ad-tool" href={ templ.SafeURL(href) }>
		<h3>{ label }</h3>
		<p class="muted">{ blurb }</p>
	</a>
}

// adminStyles are the Admin page's own rules on top of app.css.
templ adminStyles() {
	<style>
		.ad-tools{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
		.ad-tool{padding:24px;display:flex;flex-direction:column;gap:8px}
		.ad-section{display:flex;flex-direction:column;gap:12px}
		.ad-action{text-align:right}
		.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
		@media (max-width:900px){.ad-tools{grid-template-columns:1fr}}
	</style>
}
