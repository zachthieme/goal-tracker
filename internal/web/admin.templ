package web

import (
	"fmt"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// adminPage gathers the Admin tools: a row per tool, then the directory sync
// when the app has one (nil, it shows nothing), then set-password links with
// password sign-in (nil, it shows nothing), then the Admins, then the
// Ownerless Goals waiting for an Admin to reassign them (CONTEXT.md:
// Ownerless), then the Departed people an Admin can mark returned (CONTEXT.md:
// Departed). It sits in the flat frame: its title in the page header, and
// every part a plain section of rows, its forms included (DESIGN.md §
// Direction).
templ adminPage(current *domain.Account, dirSync *directorySyncView, links *passwordLinksView, admins adminsSectionView, ownerless []domain.Goal, departed []domain.Account) {
	@framedLayout("Admin", current, pageHeader(pageHead{Title: "Admin"})) {
		@adminStyles()
		<p class="muted">The tools only an Admin uses.</p>
		<nav class="ad-tools" aria-label="Admin tools">
			@adminTool("admin-dimensions", "/dimensions", "Dimensions", "Define the Dimensions Goals are tagged with")
			@adminTool("admin-fields", "/fields", "Fields", "Define the Fields typed on a Goal to describe it")
			@adminTool("admin-imports", "/imports", "Import goals", "Load Goals from a CSV or XLSX spreadsheet")
			@adminTool("admin-definition-log", "/definition-log", "Definition log", "Every change to the Dimensions and Fields, with who made it and when")
		</nav>
		if dirSync != nil {
			@adminDirectorySync(*dirSync)
		}
		if links != nil {
			@adminPasswordLinks(*links)
		}
		@adminAdmins(current.ID, admins)
		<section data-testid="admin-ownerless" class="ad-section">
			<div>
				<h2>Ownerless Goals</h2>
				<p class="muted">Goals whose Owner has left the company, waiting for an Admin to reassign them on the Goal's page.</p>
			</div>
			if len(ownerless) == 0 {
				<p data-testid="admin-ownerless-empty" class="muted">No Goals are waiting for reassignment.</p>
			} else {
				<div class="table-scroll">
					<table>
						<thead>
							<tr><th>Goal</th><th>Former Owner</th><th>Lifecycle</th></tr>
						</thead>
						<tbody>
							for _, g := range ownerless {
								<tr data-testid="admin-ownerless-goal">
									<td><a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a></td>
									<td>
										@person(g.Owner)
									</td>
									<td><span class="badge lc">{ g.Lifecycle }</span></td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
		<section data-testid="admin-departed" class="ad-section">
			<div>
				<h2>Departed people</h2>
				<p class="muted">People who have left the company. Mark someone returned to let them sign in and act again.</p>
			</div>
			if len(departed) == 0 {
				<p data-testid="admin-departed-empty" class="muted">No departed people.</p>
			} else {
				<div class="table-scroll">
					<table>
						<thead>
							<tr><th>Person</th><th><span class="sr-only">Action</span></th></tr>
						</thead>
						<tbody>
							for _, a := range departed {
								<tr data-testid="admin-departed-person">
									<td>
										@person(a)
									</td>
									<td class="ad-action">
										<form method="post" action={ templ.SafeURL(fmt.Sprintf("/accounts/%d/return", a.ID)) } onsubmit={ confirmScript(confirmReturnPerson) }>
											<button type="submit" class="btn sm">Mark returned…</button>
										</form>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
		</section>
	}
}

// confirmReturnPerson is what an Admin confirms before marking a Departed
// person returned from the Admin page, where they may own no Goals at all.
const confirmReturnPerson = "Mark this person returned? They can sign in and act again, and any Goals they still own stop being Ownerless. Goals reassigned while they were away stay with their new Owners."

// confirmRemoveAdmin is what an Admin confirms before taking the Admin role
// from another Admin.
const confirmRemoveAdmin = "Remove this person’s Admin role? They keep their account and their Goals."

// adminAdmins lists every Admin, with Remove Admin… on each but the viewer's
// own row, as no Admin can take the role from themselves (CONTEXT.md: Admin),
// then makes a person an Admin by email; or says why it didn't.
templ adminAdmins(viewerID int64, v adminsSectionView) {
	<section data-testid="admin-admins" id="admin-admins" class="ad-section">
		<div>
			<h2>Admins</h2>
			<p class="muted">Admins define Dimensions and Fields, reassign Ownerless Goals and use this page.</p>
		</div>
		<div class="ad-links">
			<table>
				<thead>
					<tr><th>Person</th><th><span class="sr-only">Action</span></th></tr>
				</thead>
				<tbody>
					for _, a := range v.Admins {
						<tr data-testid="admin-admin-person">
							<td>
								@person(a)
							</td>
							<td class="ad-action">
								if a.ID == viewerID {
									<span class="muted">you</span>
								} else {
									<form method="post" action={ templ.SafeURL(fmt.Sprintf("/admin/admins/%d/remove", a.ID)) } onsubmit={ confirmScript(confirmRemoveAdmin) }>
										<button type="submit" class="btn sm">Remove Admin…</button>
									</form>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
			<form class="ad-link-form" method="post" action="/admin/admins">
				<label class="field">
					<span>Email</span>
					<input type="email" name="email" value={ v.Email } required/>
				</label>
				<button type="submit" class="btn">Make Admin</button>
			</form>
			if v.Refusal != "" {
				<p data-testid="admin-admins-error" class="ad-error" role="alert">{ v.Refusal }</p>
			}
		</div>
	</section>
}

// adminDirectorySync shows when the directory sync last ran and how it went,
// with Sync now to run it at once (ADR 0008).
templ adminDirectorySync(v directorySyncView) {
	<section data-testid="admin-directory-sync" class="ad-section">
		<div>
			<h2>Directory sync</h2>
			<p class="muted">People and their Managers come from the company's directory, synced at startup and then hourly.</p>
		</div>
		<div class="ad-sync">
			if !v.Ran {
				<p data-testid="admin-directory-sync-status">Not synced yet.</p>
			} else if v.Err != "" {
				<p data-testid="admin-directory-sync-status">Last sync, { v.At }, failed: { v.Err }</p>
			} else {
				<p data-testid="admin-directory-sync-status">{ fmt.Sprintf("Last synced %s. Read %s.", v.At, directorySyncPeople(v.People)) }</p>
			}
			<form method="post" action="/admin/directory-sync" onsubmit={ syncingScript }>
				<button type="submit" class="btn sm">Sync now</button>
			</form>
		</div>
	</section>
}

// adminPasswordLinks issues a set-password link for an email, and shows the
// one just issued, whole, this once, with when it expires; or why it wasn't.
templ adminPasswordLinks(v passwordLinksView) {
	<section data-testid="admin-password-links" class="ad-section">
		<div>
			<h2>Set-password links</h2>
			<p class="muted">A person sets or resets their password through a link only an Admin can issue. Issuing one for an email with no account creates the account.</p>
		</div>
		<div class="ad-links">
			<form class="ad-link-form" method="post" action="/admin/password-links">
				<label class="field">
					<span>Email</span>
					<input type="email" name="email" value={ v.Email } required/>
				</label>
				<button type="submit" class="btn">Issue link</button>
			</form>
			if v.Refusal != "" {
				<p data-testid="admin-password-link-error" class="ad-error" role="alert">{ v.Refusal }</p>
			}
			if v.Link != "" {
				<div data-testid="admin-password-link" class="ad-link">
					<p>Set-password link for <strong>{ v.Email }</strong>, expires { v.Expires }:</p>
					<input type="text" class="ad-link-url" value={ v.Link } readonly aria-label="Set-password link" onfocus="this.select()"/>
					<p class="muted">Send this to the person. It works once and expires in 72 hours.</p>
				</div>
			}
		</div>
	</section>
}

// adminTool is a row linking to one Admin tool, saying what it's for.
templ adminTool(testID, href, label, blurb string) {
	<a data-testid={ testID } class="ad-tool" href={ templ.SafeURL(href) }>
		<h3>{ label }</h3>
		<p class="muted">{ blurb }</p>
	</a>
}

// adminStyles are the Admin page's own rules on top of app.css.
templ adminStyles() {
	<style>
		.ad-tools{display:flex;flex-direction:column;border-top:1px solid var(--color-border)}
		.ad-tool{display:grid;grid-template-columns:200px minmax(0,1fr);align-items:center;gap:16px;min-height:44px;padding:10px 0;border-bottom:1px solid var(--color-border);box-sizing:border-box;color:var(--color-ink-2)}
		.ad-tool:hover{text-decoration:none;color:var(--color-ink-2)}
		.ad-tool h3{font-weight:500}
		.ad-tool:hover h3{color:var(--color-primary-strong);text-decoration:underline}
		.ad-section{display:flex;flex-direction:column;gap:12px}
		.ad-section table{border-top:1px solid var(--color-border)}
		.ad-section th{background:none;padding:8px 12px}
		.ad-section td{padding:10px 12px}
		.ad-section th:first-child,.ad-section td:first-child{padding-left:0}
		.ad-section th:last-child,.ad-section td:last-child{padding-right:0}
		.ad-section tr:last-child td{border-bottom:1px solid var(--color-border)}
		.ad-action{text-align:right}
		.ad-sync{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:12px 0;border-top:1px solid var(--color-border);border-bottom:1px solid var(--color-border)}
		.ad-links{display:flex;flex-direction:column;gap:16px}
		.ad-link-form{display:flex;align-items:flex-end;gap:12px;max-width:560px}
		.ad-link-form .field{flex:1}
		.ad-link{display:flex;flex-direction:column;gap:8px}
		.ad-link p{margin:0}
		.ad-link-url{width:100%;font-variant-numeric:tabular-nums}
		.ad-error{color:var(--color-danger-ink);margin:0}
		.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
		@media (max-width:600px){.ad-tool{grid-template-columns:1fr;gap:2px}.ad-link-form{flex-wrap:wrap}.ad-link-form .field{flex:1 1 100%;min-width:0}}
	</style>
}
