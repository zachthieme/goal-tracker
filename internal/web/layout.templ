package web

import (
	"context"
	"strconv"
	"strings"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

type pathKey struct{}

// withPath records the request path so the top bar can mark the current page
// without every page passing it along.
func withPath(ctx context.Context, path string) context.Context {
	return context.WithValue(ctx, pathKey{}, path)
}

// onSection reports whether the request is at href or a page below it.
func onSection(ctx context.Context, href string) bool {
	path, _ := ctx.Value(pathKey{}).(string)
	return path == href || strings.HasPrefix(path, href+"/")
}

type needsYouKey struct{}

// withNeedsYou records how many things need the signed-in person, so the top
// bar's Home item can count them without every page passing it along.
func withNeedsYou(ctx context.Context, n int) context.Context {
	return context.WithValue(ctx, needsYouKey{}, n)
}

// needsYou is how many things need the signed-in person, 0 when uncounted.
func needsYou(ctx context.Context) int {
	n, _ := ctx.Value(needsYouKey{}).(int)
	return n
}

type risksKey struct{}

// withRisks records how many Goals the Risks page flags, so the top bar's Risks
// item can count them without every page passing it along.
func withRisks(ctx context.Context, n int) context.Context {
	return context.WithValue(ctx, risksKey{}, n)
}

// risks is how many Goals the Risks page flags, 0 when uncounted.
func risks(ctx context.Context) int {
	n, _ := ctx.Value(risksKey{}).(int)
	return n
}

type mentionsKey struct{}

// withoutHover renders a page that has no hover to show an email on — the Print
// view — so each person it shows is introduced as Name (email) at their first
// mention and shown by Name after that (CONTEXT.md: Name).
func withoutHover(ctx context.Context) context.Context {
	return context.WithValue(ctx, mentionsKey{}, &domain.Mentions{})
}

// mentions is the page's record of whom it has introduced, nil on a page with
// hover.
func mentions(ctx context.Context) *domain.Mentions {
	m, _ := ctx.Value(mentionsKey{}).(*domain.Mentions)
	return m
}

// fontsURL loads DESIGN.md's faces (Plus Jakarta Sans, Inter, JetBrains Mono);
// the font stacks in app.css fall back to system fonts when it can't be reached.
const fontsURL = "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@500&family=Plus+Jakarta+Sans:wght@600;700&display=swap"

// layout is the shared page chrome. htmx drives the in-place create-Goal swap.
templ layout(title string, current *domain.Account) {
	<!DOCTYPE html>
	<html
		lang="en"
		if t := currentTheme(ctx); t != themeSystem {
			data-theme={ string(t) }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Goal Tracker</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href={ fontsURL }/>
			<link rel="stylesheet" href={ stylesheetURL }/>
			<script src="https://unpkg.com/htmx.org@2.0.3" crossorigin="anonymous"></script>
			@disclosure()
		</head>
		<body>
			<nav class="nav">
				<a class="brand" href="/goals">Goal Tracker</a>
				if current != nil {
					<div class="navitems">
						@navItem("/home", "nav-home", "Home", needsYou(ctx))
						@navItem("/risks", "nav-risks", "Risks", risks(ctx))
						@navItem("/reports", "nav-reports", "Reports", 0)
						if current.IsAdmin {
							@navItem("/admin", "nav-admin", "Admin", 0)
						}
					</div>
					<div class="me">
						<span data-testid="current-user" class="who">
							{ "Signed in as " }
							@person(*current)
							if current.IsAdmin {
								{ " (Admin)" }
							}
						</span>
						<form method="post" action="/signout">
							<button type="submit" class="btn quiet sm">Sign out</button>
						</form>
					</div>
				}
			</nav>
			<main class="page">
				{ children... }
			</main>
		</body>
	</html>
}

// navItem is a top-bar link, marked current when the request is in its section,
// with a count of what's there for the reader when it's above zero.
templ navItem(href, testID, label string, count int) {
	if onSection(ctx, href) {
		<a data-testid={ testID } class="navitem on" aria-current="page" href={ templ.SafeURL(href) }>
			{ label }
			@navCount(count)
		</a>
	} else {
		<a data-testid={ testID } class="navitem" href={ templ.SafeURL(href) }>
			{ label }
			@navCount(count)
		</a>
	}
}

templ navCount(count int) {
	if count > 0 {
		<span class="count">{ strconv.Itoa(count) }</span>
	}
}

// person shows someone by their Name, or their email's local part until they
// have one, so people who share a Name can be told apart (CONTEXT.md: Name):
// the Name is a button that expands their email inline beside it on a click,
// tap, Enter or Space, and collapses it again, with the email on hover too.
// Every page shows people through it; a page without hover (withoutHover)
// introduces them as Name (email) instead.
templ person(a domain.Account) {
	if m := mentions(ctx); m != nil {
		<span class="person" title={ a.Email }>{ m.Of(a) }</span>
	} else {
		<span class="person"><button type="button" class="disclose" aria-expanded="false" title={ a.Email }>{ a.Label() }</button><span class="person-email" hidden>{ a.Email }</span></span>
	}
}

// personPlain shows someone by Name with their email on hover only. It is for
// the few places a person sits inside another control (a button, a label),
// where person's own button can't nest; each such place shows the same person
// through person nearby.
templ personPlain(a domain.Account) {
	<span class="person" title={ a.Email }>{ a.Label() }</span>
}

// disclosure opens and closes every .disclose button's expansion: the element
// its aria-controls names, or else the element right after it. A button
// already answers Enter, Space, a click and a tap, so one click handler covers
// them all, and listening on the document reaches content htmx swaps in.
templ disclosure() {
	<script>
		document.addEventListener("click", function (e) {
			var b = e.target.closest && e.target.closest("button.disclose");
			if (!b) return;
			var id = b.getAttribute("aria-controls");
			var target = id ? document.getElementById(id) : b.nextElementSibling;
			if (!target) return;
			var open = b.getAttribute("aria-expanded") !== "true";
			b.setAttribute("aria-expanded", open ? "true" : "false");
			target.hidden = !open;
		});
	</script>
}
