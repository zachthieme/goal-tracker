package web

import (
	"context"
	"fmt"
	"strconv"
	"strings"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

type pathKey struct{}

// withPath records the request path so the sidebar can mark the current page
// without every page passing it along.
func withPath(ctx context.Context, path string) context.Context {
	return context.WithValue(ctx, pathKey{}, path)
}

// onSection reports whether the request is at href or a page below it.
func onSection(ctx context.Context, href string) bool {
	path, _ := ctx.Value(pathKey{}).(string)
	return path == href || strings.HasPrefix(path, href+"/")
}

type needsYouKey struct{}

// withNeedsYou records how many things need the signed-in person, so the
// sidebar's Home item can count them without every page passing it along.
func withNeedsYou(ctx context.Context, n int) context.Context {
	return context.WithValue(ctx, needsYouKey{}, n)
}

// needsYou is how many things need the signed-in person, 0 when uncounted.
func needsYou(ctx context.Context) int {
	n, _ := ctx.Value(needsYouKey{}).(int)
	return n
}

type followUpsKey struct{}

// withFollowUps records how many Goals the Follow-ups page flags, so the sidebar's Follow-ups
// item can count them without every page passing it along.
func withFollowUps(ctx context.Context, n int) context.Context {
	return context.WithValue(ctx, followUpsKey{}, n)
}

// followUps is how many Goals the Follow-ups page flags, 0 when uncounted.
func followUps(ctx context.Context) int {
	n, _ := ctx.Value(followUpsKey{}).(int)
	return n
}

type mentionsKey struct{}

// withoutHover renders a page that has no hover to show an email on — the Print
// view — so each person it shows is introduced as Name (email) at their first
// mention and shown by Name after that (CONTEXT.md: Name).
func withoutHover(ctx context.Context) context.Context {
	return context.WithValue(ctx, mentionsKey{}, &domain.Mentions{})
}

// mentions is the page's record of whom it has introduced, nil on a page with
// hover.
func mentions(ctx context.Context) *domain.Mentions {
	m, _ := ctx.Value(mentionsKey{}).(*domain.Mentions)
	return m
}

type orgPeopleKey struct{}

// withOrgPeople records the people directly under the signed-in person by
// Manager, so the sidebar's My org can list them without every page passing
// them along.
func withOrgPeople(ctx context.Context, people []domain.Account) context.Context {
	return context.WithValue(ctx, orgPeopleKey{}, people)
}

// orgPeople is the people directly under the signed-in person, none when
// unread.
func orgPeople(ctx context.Context) []domain.Account {
	people, _ := ctx.Value(orgPeopleKey{}).([]domain.Account)
	return people
}

// initials is the one or two letters a person's avatar shows: the first
// letters of their Name's first and last words, or of their label when it is
// one word.
func initials(a domain.Account) string {
	words := strings.Fields(a.Label())
	if len(words) == 0 {
		return ""
	}
	first := []rune(words[0])[:1]
	if len(words) == 1 {
		return strings.ToUpper(string(first))
	}
	last := []rune(words[len(words)-1])[:1]
	return strings.ToUpper(string(first) + string(last))
}

// layout is the shared page chrome with no page header: the page's own head
// stays in its content. htmx drives the in-place create-Goal swap.
templ layout(title string, current *domain.Account) {
	@framedLayout(title, current, nil) {
		{ children... }
	}
}

// framedLayout is the shared page chrome. A signed-in page sits in the flat
// frame: the sidebar, then the content column, which opens with header, the
// page's 48px header strip, when it has one (DESIGN.md § System: The
// frame). A signed-out page has no sidebar and centres its content.
templ framedLayout(title string, current *domain.Account, header templ.Component) {
	<!DOCTYPE html>
	<html
		lang="en"
		if t := currentTheme(ctx); t != themeSystem {
			data-theme={ string(t) }
		}
	>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title } · Goal Tracker</title>
			<link rel="stylesheet" href={ stylesheetURL }/>
			<script src={ htmxURL }></script>
			@disclosure()
		</head>
		if current != nil {
			<body class="framed">
				<div class="frame">
					@sidebar(*current)
					<div class="frame-content">
						if header != nil {
							@header
						}
						<main class="page">
							{ children... }
						</main>
					</div>
				</div>
			</body>
		} else {
			<body class="signed-out">
				<header class="signed-out-bar">
					@brand()
					<details data-testid="theme-picker" class="theme">
						<summary class="btn quiet sm">Theme</summary>
						@themeMenu("theme-menu theme-float")
					</details>
				</header>
				<main class="page">
					{ children... }
				</main>
			</body>
		}
	</html>
}

// pageHead is what a page's header strip shows: its title, under its parent
// page as a breadcrumb when Parent is set, and an optional muted count.
type pageHead struct {
	Parent, ParentHref string
	Title              string
	Count              string
}

// pageHeader is a page's 48px header strip, for framedLayout's header: the
// title or breadcrumb and count at the left, and the page's actions, its
// children, at the right (DESIGN.md § Page header).
templ pageHeader(h pageHead) {
	<div class="page-header">
		<div class="ph-title">
			if h.Parent != "" {
				<a class="ph-parent" href={ templ.SafeURL(h.ParentHref) }>{ h.Parent }</a>
				<span class="ph-sep" aria-hidden="true">›</span>
			}
			<h1>{ h.Title }</h1>
			if h.Count != "" {
				<span class="ph-count">{ h.Count }</span>
			}
		</div>
		<div class="ph-actions">
			{ children... }
		</div>
	</div>
}

// brand is the app's name with its teal mark, linking Home.
templ brand() {
	<a class="brand" href="/home"><span class="brand-mark" aria-hidden="true"></span>Goal Tracker</a>
}

// sidebar is the signed-in page's left column: the app's name, Search, the
// nav with its counts, My org for someone with people under them, and the
// person's menu at its foot (DESIGN.md § Sidebar). At phone width
// it is a 48px strip whose Menu opens the rest as a sheet; the sheet is
// .sb-body, shown by the Menu <details> beside it, so it needs no script.
templ sidebar(current domain.Account) {
	<header class="sidebar">
		@brand()
		if n := needsYou(ctx); n > 0 {
			<a class="sb-strip-home" href="/home"><span class="sr-only">Home </span><span class="count needs-you">{ strconv.Itoa(n) }</span></a>
		}
		<details class="sb-menu">
			<summary class="btn sm">Menu</summary>
		</details>
		<div class="sb-body">
			<form class="sb-search" method="get" action="/goals" role="search">
				<label class="sr-only" for="sb-search-q">Search Goals</label>
				<input id="sb-search-q" type="search" name="q" placeholder="Search"/>
			</form>
			<nav class="navitems" aria-label="Main">
				@navItem("/home", "nav-home", "Home", needsYou(ctx), "count needs-you")
				@navItem("/goals", "nav-goals", "Goals", 0, "count")
				@navItem("/follow-ups", "nav-follow-ups", "Follow-ups", followUps(ctx), "count")
				@navItem("/reports", "nav-reports", "Reports", 0, "count")
				if current.IsAdmin {
					@navItem("/admin", "nav-admin", "Admin", 0, "count")
				}
			</nav>
			if people := orgPeople(ctx); len(people) > 0 {
				<section data-testid="sidebar-org" class="sb-org" aria-labelledby="sb-org-head">
					<h2 id="sb-org-head" class="sb-head">My org</h2>
					<ul>
						for _, p := range people {
							<li><a data-testid="sidebar-org-person" class="sb-org-person" href={ templ.SafeURL(fmt.Sprintf("/goals?org=%d", p.ID)) } title={ p.Email }>{ p.Label() }</a></li>
						}
					</ul>
				</section>
			}
			<details data-testid="person-menu" class="sb-person">
				<summary>
					<span class="avatar" aria-hidden="true">{ initials(current) }</span>
					<span class="sb-person-name">
						@personPlain(current)
					</span>
				</summary>
				<div class="sb-person-menu">
					<p data-testid="current-user" class="who">
						{ "Signed in as " }
						@person(current)
						if current.IsAdmin {
							{ " (Admin)" }
						}
					</p>
					@themeMenu("theme-menu")
					<form method="post" action="/signout">
						<button type="submit" class="btn quiet sm sb-signout">Sign out</button>
					</form>
				</div>
			</details>
		</div>
	</header>
}

// navItem is a sidebar link with its icon, marked current when the request is
// in its section, with a count of what's there for the reader when it's above
// zero. countClass styles the count: Home's needs-you pill, or every other
// item's plain one.
templ navItem(href, testID, label string, count int, countClass string) {
	if onSection(ctx, href) {
		<a data-testid={ testID } class="navitem on" aria-current="page" href={ templ.SafeURL(href) }>
			@navIcon(href)
			{ label }
			@navCount(count, countClass)
		</a>
	} else {
		<a data-testid={ testID } class="navitem" href={ templ.SafeURL(href) }>
			@navIcon(href)
			{ label }
			@navCount(count, countClass)
		</a>
	}
}

// navIcon is the 16px stroke icon beside the nav item at href.
templ navIcon(href string) {
	<svg class="navicon" viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
		switch href {
			case "/home":
				<path d="M2.5 7.5 8 3l5.5 4.5V13.5H10v-4H6v4H2.5z"></path>
			case "/goals":
				<circle cx="8" cy="8" r="5.5"></circle>
				<circle cx="8" cy="8" r="2"></circle>
			case "/follow-ups":
				<path d="M3.5 14.5v-12M3.5 3h8.5l-1.75 3L12 9H3.5"></path>
			case "/reports":
				<path d="M4 1.5h5.5L12 4v10.5H4zM9.5 1.5V4H12M6 8h4M6 11h4"></path>
			default:
				<path d="M8 1.5 13 3.5v4c0 3-2.2 5.3-5 7-2.8-1.7-5-4-5-7v-4z"></path>
		}
	</svg>
}

templ navCount(count int, class string) {
	if count > 0 {
		<span class={ class }>{ strconv.Itoa(count) }</span>
	}
}

// themeMenu is the Theme choices: System, Light and Dark, the current one
// marked, each a plain form post, so they work without script. The choice
// comes back to this page. A signed-in page shows them in the person's menu;
// a signed-out page in a Theme disclosure of their own.
templ themeMenu(class string) {
	<form data-testid="theme-menu" class={ class } method="post" action="/theme" aria-label="Theme">
		<p class="sb-head" aria-hidden="true">Theme</p>
		<input type="hidden" name="return" value={ themeReturn(ctx) }/>
		for _, c := range themeChoices {
			<button
				data-testid={ "theme-" + string(c.theme) }
				type="submit"
				class="theme-choice"
				name="theme"
				value={ string(c.theme) }
				if c.theme == currentTheme(ctx) {
					aria-current="true"
				}
			>{ c.label }</button>
		}
	</form>
}

// toast is the one-time notice the page shown straight after an action
// carries: what was done, and an Undo button that posts to Undo with Fields as
// hidden inputs. The server renders it only on that page (takeUndo), so there
// is no timer and no script; leaving or reloading drops it. Every Undo in the
// app uses it (DESIGN.md: Toast).
type toast struct {
	Message string
	Undo    string
	Fields  []toastField
}

// toastField is a hidden input a toast's Undo form posts.
type toastField struct {
	Name, Value string
}

// toastNotice renders t fixed to the bottom of the window, above the page
// content, announced politely to assistive technology; nothing when t is nil.
templ toastNotice(t *toast) {
	if t != nil {
		<aside data-testid="toast" class="toast" role="status" aria-label="Notice">
			<p>{ t.Message }</p>
			<form method="post" action={ templ.SafeURL(t.Undo) }>
				for _, f := range t.Fields {
					<input type="hidden" name={ f.Name } value={ f.Value }/>
				}
				<button type="submit" class="btn sm">Undo</button>
			</form>
		</aside>
	}
}

// person shows someone by their Name, or their email's local part until they
// have one, so people who share a Name can be told apart (CONTEXT.md: Name):
// the Name is a button that expands their email inline beside it on a click,
// tap, Enter or Space, and collapses it again, with the email on hover too.
// Every page shows people through it; a page without hover (withoutHover)
// introduces them as Name (email) instead.
templ person(a domain.Account) {
	if m := mentions(ctx); m != nil {
		<span class="person" title={ a.Email }>{ m.Of(a) }</span>
	} else {
		<span class="person"><button type="button" class="disclose" aria-expanded="false" title={ a.Email }>{ a.Label() }</button><span class="person-email" hidden>{ a.Email }</span></span>
	}
}

// personPlain shows someone by Name with their email on hover only. It is for
// the few places a person sits inside another control (a button, a label),
// where person's own button can't nest; each such place shows the same person
// through person nearby.
templ personPlain(a domain.Account) {
	<span class="person" title={ a.Email }>{ a.Label() }</span>
}

// disclosure opens and closes every .disclose button's expansion: the element
// its aria-controls names, or else the element right after it. A button
// already answers Enter, Space, a click and a tap, so one click handler covers
// them all, and listening on the document reaches content htmx swaps in.
templ disclosure() {
	<script>
		document.addEventListener("click", function (e) {
			var b = e.target.closest && e.target.closest("button.disclose");
			if (!b) return;
			var id = b.getAttribute("aria-controls");
			var target = id ? document.getElementById(id) : b.nextElementSibling;
			if (!target) return;
			var open = b.getAttribute("aria-expanded") !== "true";
			b.setAttribute("aria-expanded", open ? "true" : "false");
			target.hidden = !open;
		});
	</script>
}
