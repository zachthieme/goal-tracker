package web

import (
	"fmt"
	"strconv"
	"time"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// followUpsPage answers "which Goals are in trouble, and how badly?" in the
// flat frame (DESIGN.md § Follow-ups): a header strip titled Follow-ups with
// how many Goals need attention and "What each signal means" beside it, the
// filters, a row of plain blocks counting each group of signals, Not Green
// and then by who acts, then a full-bleed list of the flagged Goals, one row
// each, most urgent first, narrowed to one group when the address asks for it.
// The filters scope it all to some Goals; #follow-ups-body is what a change of
// scope swaps, with the header out of band beside it. With no Goal left to
// show, #follow-ups-body says so in one line in place of the groups and the
// list, and the header holds no count; for an Admin, the groups follow it
// while the company has a Goal that Needs an Admin.
templ followUpsPage(current *domain.Account, v followUpsPageView) {
	@framedLayout("Follow-ups", current, followUpsHeader(v)) {
		@followUpsStyles()
		@followUpsFilters(v)
		<div id="follow-ups-body" class="rk-body">
			if shown := v.Shown(); len(shown) == 0 {
				<p data-testid="follow-ups-empty" class="muted rk-empty">
					{ v.Empty() }
					if v.OffersShowEverything() {
						<a href={ v.ShowEverythingURL() }>Show everything</a>
					}
				</p>
				if v.CardsWhenEmpty() {
					@followUpCardsView(v)
				}
			} else {
				@followUpCardsView(v)
				if v.Group != "" {
					<p class="rk-show-all"><a data-testid="follow-ups-show-all" href={ v.ShowAllURL() }>Show all</a></p>
				}
				@followUpsTable(current, v.Today, v.Here(), shown)
			}
		</div>
	}
}

// followUpsHeader is the page's header strip: its title, with how many Goals
// need attention beside it and "What each signal means" at its right while
// any Goal is shown. The filters swap it out of band, by its id, so its count
// follows their scope.
templ followUpsHeader(v followUpsPageView) {
	<div id="follow-ups-head" class="page-header rk-head">
		<div class="ph-title">
			<h1>Follow-ups</h1>
			if len(v.Shown()) > 0 {
				<p data-testid="follow-ups-attention" class="ph-count"><strong>{ strconv.Itoa(v.attentionCount()) }</strong> { v.attention() }</p>
			}
		</div>
		if len(v.Shown()) > 0 {
			<div class="ph-actions">
				@followUpsMeanings()
			</div>
		}
	</div>
}

// followUpsMeanings is a button opening, through a native popover and no script,
// what each of the Follow-ups page's signals means.
templ followUpsMeanings() {
	<button type="button" data-testid="follow-ups-meanings" class="btn sm" popovertarget="follow-ups-meanings">What each signal means</button>
	<div id="follow-ups-meanings" popover class="rk-pop rk-defs">
		<dl>
			for _, d := range followUpDefinitions {
				<dt>{ d.Name }</dt>
				<dd>{ d.Means }</dd>
			}
		</dl>
	</div>
}

// followUpsFilters scopes the Follow-ups page by its Scope (Everyone, Mine or an
// Org), and to the Goals with a value of each Dimension, one select per
// offered Dimension named for it, each a filter chip as on the Goal list: a
// Dimension's reads "Team: any", or its key before the value once one is
// chosen ("Team: Platform"), filled while set. It is submitted as a GET so the scope lives in the
// address, carrying the page's group along. Under htmx it applies itself on a change, as the Goal list's
// filter bar does, swapping in only #follow-ups-body so the form keeps its focus,
// and pushes the address; hx-history="false" makes Back load the earlier
// address afresh rather than a snapshot whose selects would come back
// unchosen. The header's count goes with the swap, selected out of band.
templ followUpsFilters(v followUpsPageView) {
	<form
		method="get"
		action="/follow-ups"
		data-testid="follow-ups-filters"
		class="rk-filters"
		hx-get="/follow-ups"
		hx-trigger="submit, change"
		hx-target="#follow-ups-body"
		hx-select="#follow-ups-body"
		hx-select-oob="#follow-ups-head"
		hx-swap="outerHTML"
		hx-push-url="true"
		hx-sync="this:replace"
		hx-history="false"
	>
		if v.Group != "" {
			<input type="hidden" name="group" value={ v.Group }/>
		}
		@pageScopeChip("follow-ups-scope", v.Org)
		for _, d := range v.Dimensions {
			<label class="filter-chip">
				<span class="chip-key chip-key-set" aria-hidden="true">{ d.Name + ":" }</span>
				<select data-testid="follow-ups-value" data-dimension={ d.Name } name="value" aria-label={ d.Name }>
					<option value="" selected?={ v.valueIn(d.ID).ID == 0 }>{ d.Name + ": any" }</option>
					for _, dv := range d.Values {
						<option value={ strconv.FormatInt(dv.ID, 10) } selected?={ v.valueIn(d.ID).ID == dv.ID }>{ followUpValueLabel(dv) }</option>
					}
				</select>
			</label>
		}
		<noscript><button type="submit" class="btn">Apply</button></noscript>
	</form>
}

// followUpCardsView is the page's group summaries, in the page's order: a row
// of plain blocks between hairlines, not cards.
templ followUpCardsView(v followUpsPageView) {
	<nav data-testid="follow-ups-groups" class="rk-groups" aria-label="Follow-ups by who acts">
		for _, c := range v.Cards() {
			@followUpCardView(c)
		}
	</nav>
}

// followUpCardView is one group's summary: its name, how many Goals it holds,
// and a chip per signal that flags one, linking to the page filtered to the
// group. A group holding none is muted, saying so, linking nowhere.
templ followUpCardView(c followUpCard) {
	if c.Count == 0 {
		<div data-testid={ "follow-ups-group-" + c.Key } class="rk-group rk-zero">
			<span class="rk-group-name">{ c.Name }</span>
			<span>{ c.Blank }</span>
		</div>
	} else {
		@followUpCardLink(c)
	}
}

// followUpCardLink is a group's summary when it holds Goals.
templ followUpCardLink(c followUpCard) {
	<a data-testid={ "follow-ups-group-" + c.Key } href={ c.Href } class="rk-group" { c.Attrs()... }>
		<span class="rk-group-name">{ c.Name }</span>
		<span class="num">{ strconv.Itoa(c.Count) }</span>
		<span class="rk-chips">
			for _, sig := range c.Signals {
				<span data-testid="follow-up-signal" data-kind={ sig.Anchor } class={ followUpChipClass(sig.Anchor) }>{ sig.Name + " · " + strconv.Itoa(sig.Count) }</span>
			}
		</span>
	</a>
}

// followUpsTable is the flagged Goals, one row each, most urgent first: a
// full-bleed list, scrolling sideways inside itself should it outgrow the
// page. A Fix that posts returns to here, the page's address.
templ followUpsTable(current *domain.Account, today time.Time, here string, rows []followUpGoalRow) {
	<div class="rk-list">
		<table id="follow-ups-table" class="rk-table" data-testid="follow-ups-table">
			<thead>
				<tr><th>Health</th><th>Goal</th><th>Owner</th><th aria-label="Next step"></th></tr>
			</thead>
			<tbody>
				for _, r := range rows {
					@followUpRow(current, today, here, r)
				}
			</tbody>
		</table>
		for _, d := range followUpDefinitionsIn(rows) {
			<div id={ followUpMeansID(d.Kind) } popover class="rk-pop rk-means"><strong>{ d.Name }</strong> { d.Means }</div>
		}
	</div>
}

// followUpRow is one flagged Goal: its Health, with its Run off Green on a Not
// Green row ("Red · 5 wks"), its title with a chip per signal
// that flags it, then on a Not Green row whose back-to-Green date slipped in
// its Run off Green a tag reading it as a Milestone's slipped date does
// ("Back to Green Oct 3 ~~Sep 12~~ (3)"), which isn't a signal; its Owner
// ("You" for the viewer's own), and a cell for its fix: a link, a form
// posting back to here, or a disabled button saying why it can't be used.
templ followUpRow(current *domain.Account, today time.Time, here string, r followUpGoalRow) {
	<tr data-testid="follow-up-row">
		<td class="rk-health">
			@healthBadge("follow-up-health", r.Health)
			if r.RunOffGreen.Running() {
				<span data-testid="follow-up-run-off-green" class="muted small">{ "· " + r.RunOffGreen.Label() }</span>
			}
		</td>
		<td data-testid="follow-up-goal" class="rk-goal">
			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", r.Goal.ID)) }>{ r.Goal.Title }</a>
			<span class="rk-chips">
				for _, sig := range r.Signals {
					@followUpChip(today, r.Goal, sig)
				}
				if len(r.PathPriorDates) > 0 {
					<span data-testid="follow-up-back-to-green" class="rk-tag">
						{ "Back to Green " }
						@slippedDates(r.PathTargetDate, r.PathPriorDates, displayDates{Now: today, Loc: today.Location()}, "follow-up-back-to-green-slips")
					</span>
				}
			</span>
		</td>
		<td data-testid="follow-up-owner" class="rk-owner">
			if r.Goal.Owner.ID == current.ID {
				You
			} else {
				@person(r.Goal.Owner)
			}
		</td>
		<td data-testid="follow-up-fix" class="rk-fix">
			if r.Fix.Disabled {
				<button type="button" class="btn sm" disabled>{ r.Fix.Label }</button>
			} else if r.Fix.Post {
				<form data-testid="nudge" method="post" action={ templ.SafeURL(r.Fix.Href) } class="inline-form">
					<input type="hidden" name="return" value={ here }/>
					<button type="submit" class="btn sm">{ r.Fix.Label }</button>
				</form>
			} else if r.Fix.Primary {
				<a class="btn primary sm" href={ templ.SafeURL(r.Fix.Href) }>{ r.Fix.Label }</a>
			} else {
				<a class="btn sm" href={ templ.SafeURL(r.Fix.Href) }>{ r.Fix.Label }</a>
			}
		</td>
	</tr>
}

// followUpChip says why a signal flags g. Red and Yellow, Not Green's signals,
// take no chip: the row's Health badge says so already. An Ask for help names
// whom it asks, or says no one is above the Owner. Each chip's words are a
// followUpTip opening what its signal means; a chip holding a person or a link
// keeps them after its followUpTip, since a button can't hold them. A chip
// that shows its signal's plain name reads it with followUpName.
templ followUpChip(today time.Time, g domain.Goal, sig followUpSignal) {
	switch sig.Kind {
		case "red", "yellow":
		case "asks-for-help":
			<span data-testid="follow-up-signal" data-kind="asks-for-help" class="rk-tag">
				if sig.Person != nil {
					@followUpTip(sig.Kind, followUpName(sig.Kind))
					{ "of " }@person(*sig.Person)
				} else {
					@followUpTip(sig.Kind, followUpName(sig.Kind)+" · no one above the Owner")
				}
			</span>
		case "checkin-overdue":
			<span data-testid="follow-up-signal" data-kind="checkin-overdue" class="badge st">
				@followUpTip(sig.Kind, followUpName(sig.Kind)+" · "+plural(sig.Days, "day")+", checks in "+cadenceInWords(g.CadenceDays))
			</span>
		case "path-overdue":
			<span data-testid="follow-up-signal" data-kind="path-overdue" class="badge st">
				@followUpTip(sig.Kind, "Path to Green "+plural(sig.Days, "day")+" overdue")
			</span>
		case "milestone-overdue":
			<span data-testid="follow-up-signal" data-kind="milestone-overdue" class="badge st">
				@followUpTip(sig.Kind, "Milestone "+plural(sig.Days, "day")+" overdue")
			</span>
		case "action-item-overdue":
			<span data-testid="follow-up-signal" data-kind="action-item-overdue" class="badge st">
				@followUpTip(sig.Kind, "Action Item "+plural(sig.Days, "day")+" overdue")
			</span>
		case "ownerless":
			<span data-testid="follow-up-signal" data-kind="ownerless" class="badge ol">
				@followUpTip(sig.Kind, followUpName(sig.Kind))
			</span>
		case "unlinked":
			<span data-testid="follow-up-signal" data-kind="unlinked" class="rk-tag">
				@followUpTip(sig.Kind, followUpName(sig.Kind)+" · no parent Goal, not Top-level")
			</span>
		case "schedule-conflicts":
			<span data-testid="follow-up-signal" data-kind="schedule-conflicts" class="rk-tag">
				@followUpTip(sig.Kind, "Schedule conflict")
				{ fmt.Sprintf(" · due %s, %s after its parent ", showDate(g.DeliveryDate, today, today.Location()), followUpDays(sig.Days)) }@goalRef(*sig.Related)
			</span>
		case "halted-parents":
			<span data-testid="follow-up-signal" data-kind="halted-parents" class="rk-tag">
				@followUpTip(sig.Kind, "Parent "+sig.Related.Lifecycle)
				{ " · " }@goalRef(*sig.Related)
			</span>
	}
}

// followUpTip is a toggletip: a button reading label that opens, with no script,
// the popover followUpsTable holds saying what the signal of kind means, and that
// takes the meaning as its description.
templ followUpTip(kind, label string) {
	<button type="button" class="rk-tip" popovertarget={ followUpMeansID(kind) } aria-describedby={ followUpMeansID(kind) }>{ label }</button>
}

// followUpsStyles are the Follow-ups page's own rules on top of app.css. The
// page is one full-bleed surface (DESIGN.md § Follow-ups): its sections run
// edge to edge between hairlines, padded --rk-pad from the content column's
// sides as the header strip is. The header strip wraps rather than overflow a
// phone. The filters sit in a bar under it, app.css's filter chips spaced as
// the Goal list's filter bar, then the group summaries as a row of plain
// blocks between hairlines, five across, two per row where the page
// is narrower or a phone's, the current one marked by a teal rule along its
// foot, an empty one muted. The list has muted column labels, 44px rows on
// hairlines, the Goal's column taking the slack so the Owner and the Fix sit
// at the right. Its chips: the outlined neutral chip the structural signals
// take, a .tag with the badges' small radius, the buttons naming the chips'
// signals, and the popovers saying what they mean, never wider than the
// window. A Health with its Run off Green and an Owner's name keep to one
// line. Below 600px each list row stacks: the Goal cell, ordered first though
// it comes second in the HTML, then Health and Owner on one line, then the
// Fix, and the full list of what each signal means stacks each name over its
// meaning.
templ followUpsStyles() {
	<style>
		.page{--rk-pad:28px;max-width:none;padding:0 0 64px;gap:0}
		.rk-head{flex-wrap:wrap;column-gap:16px;padding-block:8px}
		.rk-head .ph-title{flex-wrap:wrap;column-gap:12px}
		.rk-head .ph-count{margin:0;white-space:normal}
		.rk-body{display:flex;flex-direction:column}
		.rk-empty{padding:24px var(--rk-pad)}
		.rk-filters{display:flex;align-items:center;gap:8px;flex-wrap:wrap;min-width:0;max-width:100%;padding:12px var(--rk-pad);border-bottom:1px solid var(--color-border);box-sizing:border-box}
		.rk-groups{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));border-bottom:1px solid var(--color-border)}
		.rk-group{display:flex;flex-direction:column;align-items:flex-start;gap:4px;min-width:0;padding:16px 20px;color:var(--color-ink-2);font-size:13px}
		.rk-group:first-child{padding-left:var(--rk-pad)}
		.rk-group:last-child{padding-right:var(--rk-pad)}
		.rk-group+.rk-group{border-left:1px solid var(--color-border)}
		.rk-group-name{font-weight:500;color:var(--color-ink)}
		.rk-group .num{font-size:24px;font-weight:600;line-height:1.2;color:var(--color-ink)}
		.rk-group .rk-chips{margin-top:4px;gap:4px}
		.rk-group .rk-tag,.rk-group .badge{white-space:normal}
		a.rk-group{transition:background var(--dur-fast) var(--ease-out)}
		a.rk-group:hover{color:var(--color-ink-2);background:var(--color-row-hover);text-decoration:none}
		a.rk-group:focus-visible{outline-offset:-2px}
		.rk-group[aria-current]{background:var(--color-row-hover);box-shadow:inset 0 -2px 0 var(--color-primary-strong)}
		.rk-zero{color:var(--color-ink-muted)}
		.rk-zero .rk-group-name{color:inherit}
		.rk-show-all{padding:12px var(--rk-pad)}
		.rk-chips{display:flex;flex-wrap:wrap;gap:8px}
		.rk-list{overflow-x:auto}
		.rk-table th{height:32px;padding:4px 12px;background:none;box-sizing:border-box}
		.rk-table td{height:44px;padding:8px 12px;box-sizing:border-box}
		.rk-table th:first-child,.rk-table td:first-child{padding-left:var(--rk-pad)}
		.rk-table th:last-child,.rk-table td:last-child{padding-right:var(--rk-pad)}
		.rk-table tbody tr:hover{background:var(--color-row-hover)}
		.rk-table tbody tr:last-child td{border-bottom:1px solid var(--color-border)}
		.rk-table .rk-goal{width:100%}
		.rk-goal>a{color:var(--color-ink);font-weight:500}
		.rk-goal .badge{white-space:normal}
		td .rk-chips{margin-top:4px;gap:4px 8px}
		.rk-table .rk-owner{white-space:nowrap}
		.rk-table .rk-health{white-space:nowrap}
		.rk-table .rk-fix{text-align:right}
		.rk-tip{font:inherit;color:inherit;background:none;border:0;padding:0;margin:0;cursor:pointer;text-align:inherit;text-decoration:underline dotted;text-underline-offset:3px}
		.rk-pop{box-sizing:border-box;max-width:min(360px,calc(100vw - 32px));max-height:calc(100dvh - 32px);overflow:auto;padding:12px 16px;border:1px solid var(--color-border-strong);border-radius:var(--radius-md);background:var(--color-surface);color:var(--color-ink);font-size:14px;line-height:20px;box-shadow:var(--shadow-pop)}
		.rk-defs{max-width:min(560px,calc(100vw - 32px))}
		@supports (position-area:block-end){@media (min-width:601px){.rk-means{margin:4px 0;position-area:block-end span-inline-end;position-try-fallbacks:flip-inline,flip-block,flip-block flip-inline}}}
		.rk-defs dl{margin:0;display:grid;grid-template-columns:max-content 1fr;gap:4px 16px}
		.rk-defs dt{font-weight:600}
		.rk-defs dd{margin:0}
		.rk-tag{display:inline-flex;align-items:center;flex-wrap:wrap;gap:4px;padding:0 8px;border-radius:var(--radius-sm);color:var(--color-ink);font-size:13px;line-height:20px;border:1px solid var(--color-border-strong)}
		@media (max-width:1151px){.rk-groups{grid-template-columns:repeat(2,minmax(0,1fr))}.rk-group+.rk-group{border-left:0}.rk-group:nth-child(odd){padding-left:var(--rk-pad)}.rk-group:nth-child(even){padding-right:var(--rk-pad);border-left:1px solid var(--color-border)}.rk-group:nth-child(n+3){border-top:1px solid var(--color-border)}.rk-group:last-child:nth-child(odd){grid-column:1/-1}}
		@media (max-width:900px){.page{--rk-pad:16px}}
		@media (max-width:600px){.rk-table thead{display:none}.rk-table tr{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:4px 12px;padding:12px var(--rk-pad);border-bottom:1px solid var(--color-border)}.rk-table td{display:block;height:auto;padding:0;border-bottom:none}.rk-table td:first-child,.rk-table td:last-child,.rk-table tbody tr:last-child td{padding:0;border-bottom:none}.rk-table .rk-goal{order:-1;grid-column:1/-1;width:auto}.rk-table .rk-owner{white-space:normal}.rk-table .rk-fix{grid-column:1/-1;margin-top:4px;text-align:left}.rk-defs dl{grid-template-columns:minmax(0,1fr);gap:0}.rk-defs dd{margin-bottom:8px}}
	</style>
}
