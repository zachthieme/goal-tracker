package web

import (
	"fmt"
	"slices"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// reportBuilderPage builds a Report Definition, new or saved (CONTEXT.md:
// Report Definition): its name and introduction, and what's in it, the Goals
// matching rules or the Goals the author picks, never those linked to some
// other Goal (ADR 0007). A saved one's id goes with the form, so the rail
// reads against its baseline. Under its breadcrumb strip it is one centred
// column of plain sections: the title, the inputs, the Matches rail, and Save
// report last (DESIGN.md § Report builder).
templ reportBuilderPage(current *domain.Account, v reportBuilderView) {
	@framedLayout(v.title(), current, reportBuilderHeader(v)) {
		@reportStyles()
		@reportBuilderStyles()
		<div class="rb-layout">
			<h1>{ v.title() }</h1>
			<form
				data-testid="report-builder"
				class="rb-form"
				method="post"
				action={ templ.SafeURL(v.action()) }
			>
				// Enter presses a form's first submit, so it saves, not Add rule.
				<button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">Save report</button>
				if v.ID != 0 {
					<input type="hidden" name="id" value={ fmt.Sprint(v.ID) }/>
				}
				if problems := v.unplaced(); len(problems) > 0 {
					<div data-testid="builder-problems" class="rb-problems" role="alert">
						<p><strong>The report wasn't saved.</strong></p>
						<ul>
							for _, p := range problems {
								<li>{ p.Message }</li>
							}
						</ul>
					</div>
				}
				// The rail's post comes from the inputs, not the form: htmx
				// validates a form it posts, so an empty Name, which Save
				// requires, would halt every refresh.
				<div
					data-testid="report-builder-inputs"
					class="rb-inputs"
					hx-post="/reports/new/matches"
					hx-include="closest form"
					hx-trigger="change[target.type!='search'], input[target.type!='search'] delay:400ms"
					hx-target={ "#" + reportMatchesID }
					hx-swap="outerHTML"
					hx-sync="this:replace"
				>
					<label class="field">
						<span>Name</span>
						<input type="text" name="name" value={ v.Name } required/>
						@reportBuilderError(v, domain.ReportInputName)
					</label>
					<label class="field">
						<span>Introduction</span>
						<textarea name="introduction">{ v.Introduction }</textarea>
					</label>
					<fieldset data-testid="report-mode" class="rb-mode">
						<legend>What's in this report</legend>
						<div class="rb-segments">
							<label><input type="radio" name="mode" value={ domain.ReportModeRules } checked?={ v.Mode != domain.ReportModePicked }/>Goals matching rules</label>
							<label><input type="radio" name="mode" value={ domain.ReportModePicked } checked?={ v.Mode == domain.ReportModePicked }/>Goals I pick</label>
						</div>
						@reportBuilderError(v, domain.ReportInputMode)
					</fieldset>
					<section data-testid="report-rules" class="rb-rules">
						<h2>Rules <span class="hint">— a Goal must meet every rule, and any of a rule's values</span></h2>
						for i, row := range v.rows() {
							@reportRuleRowInputs(v, i, row)
						}
						@reportRuleValueTemplates(v.Attributes)
						@reportBuilderError(v, domain.ReportInputRules)
						if v.StartNote != "" {
							<p data-testid="rules-start-note" class="small muted">{ v.StartNote }</p>
						}
						<div><button type="submit" name="do" value="add-rule" class="btn quiet sm rb-add" formnovalidate>+ Add rule</button></div>
						<p data-testid="rules-hint" class="small muted">
							A rule can check a Dimension value, the Owner or whose org they're in, the Lifecycle, the Health, or whether the Goal is Top-level. To let Owners opt their own Goals in, an Admin can add a Dimension such as "In report"; you still decide with Leave out.
						</p>
						@reportGoalPicker(v, inputInclude, "Also include", alsoIncludeHelp, v.Include)
						@reportGoalPicker(v, inputExclude, "Leave out", leaveOutHelp, v.Exclude)
					</section>
					<section data-testid="report-picked" class="rb-picked">
						@reportGoalPicker(v, inputPicked, "Goals I pick", "", v.Picked)
					</section>
					if len(v.Fields) > 0 {
						<details data-testid="report-fields-to-show" class="rb-fields" open?={ len(v.FieldIDs) > 0 || v.bad(domain.ReportInputFields) != "" }>
							<summary class="btn quiet sm">+ Fields to show</summary>
							<fieldset data-testid="report-field-choice">
								<legend>Fields <span class="hint">— shown beside each Goal that has a value</span></legend>
								for _, f := range v.Fields {
									<label>
										<input type="checkbox" name={ inputShowField } value={ fmt.Sprint(f.ID) } checked?={ slices.Contains(v.FieldIDs, f.ID) }/>
										{ f.Name }
									</label>
								}
							</fieldset>
							@reportBuilderError(v, domain.ReportInputFields)
						</details>
					}
				</div>
				<div class="rb-actions">
					<button type="submit" class="btn primary">Save report</button>
					<button type="submit" name="do" value="show-matches" class="btn rb-no-js" formnovalidate>Show matches</button>
				</div>
			</form>
			@reportMatchesRail(v.Matches)
		</div>
		@reportBuilderScript()
	}
}

// reportBuilderHeader is the builder's header strip: its breadcrumb, Reports ›
// New, or Reports › the definition as saved › Edit, the last crumb the page
// itself.
templ reportBuilderHeader(v reportBuilderView) {
	<header class="page-header">
		<nav class="ph-title" aria-label="Breadcrumb">
			<a class="ph-parent" href="/reports">Reports</a>
			<span class="ph-sep" aria-hidden="true">›</span>
			if v.ID != 0 {
				<a class="ph-parent rp-crumb" href={ templ.SafeURL(v.draft()) }>{ v.Saved }</a>
				<span class="ph-sep" aria-hidden="true">›</span>
				<span class="rp-crumb" aria-current="page">Edit</span>
			} else {
				<span class="rp-crumb" aria-current="page">New</span>
			}
		</nav>
	</header>
}

// reportMatchesID is the rail's id, which the builder's inputs swap as they
// are typed.
const reportMatchesID = "report-matches"

// reportMatchesRail is the builder's rail: a flat list of the Goals the
// definition as typed would select, by title, each with its Health or, with
// none yet, its Lifecycle, and "added" beside one only Also include selects.
// Past the first railLength, it counts the rest and those left out.
//
//nolint:contextcheck // templ hands its closures Render's ctx in a struct field, which contextcheck can't follow
templ reportMatchesRail(m reportMatches) {
	<aside data-testid="report-matches" id={ reportMatchesID } class="rb-rail" aria-live="polite">
		if m.NeedsRule {
			<h2>Matches</h2>
			<p data-testid="matches-need-rule" class="muted">Add a rule to see matching Goals.</p>
		} else {
			<h2 data-testid="matches-count">{ "Matches " + plural(m.Count, "Goal") }</h2>
			<ul class="rb-match-list">
				for _, g := range m.Shown {
					<li data-testid="match">
						if g.Health != "" {
							@healthChip("match-badge", g.Health)
						} else {
							<span data-testid="match-badge" class="badge lc">{ g.Goal.Lifecycle }</span>
						}
						<span class="rb-match-title">{ g.Goal.Title }</span>
						if g.Added {
							<span data-testid="match-added" class="muted small">added</span>
						}
					</li>
				}
			</ul>
			if more := m.more(); more != "" {
				<p data-testid="matches-more" class="muted small">{ more }</p>
			}
		}
		<p class="muted small">A flat list, not a tree. Whether one Goal feeds another doesn't decide what's in the report.</p>
	</aside>
}

// reportRuleRowInputs is the i-th rule row: what it tests, its operator, the
// values it tests for, and its ×. A row testing an attribute shows only that
// attribute's values: radios under "is", which takes one, and checkboxes
// under "is any of" and "is not". A row testing nothing yet shows every
// attribute's values as checkboxes, each attribute's under its label, so
// without script a value can be chosen with the attribute; script empties
// it, and fills a row's values from reportRuleValueTemplates as its
// attribute changes. A Top-level row tests no values, so it offers only "is
// Top-level" and "is not Top-level". The × submits the form without the
// row; with script it removes the row in place.
templ reportRuleRowInputs(v reportBuilderView, i int, row reportRuleRow) {
	<div data-testid="report-rule" class="rb-rule" data-rule>
		<select data-testid="rule-attribute" name={ ruleRowInput(i, "attribute") } aria-label="What the rule tests">
			<option value="">Choose…</option>
			for _, a := range v.Attributes {
				if row.offers(a) {
					<option value={ a.Key } selected?={ a.Key == row.Attribute } data-retired?={ a.Retired }>{ a.Label }</option>
				}
			}
		</select>
		<select data-testid="rule-op" name={ ruleRowInput(i, "op") } aria-label="Operator">
			for _, op := range ruleOps(row.Attribute) {
				<option value={ op[0] } selected?={ op[0] == row.Op }>{ op[1] }</option>
			}
		</select>
		{{ groups := row.valueGroups(v.Attributes) }}
		<fieldset data-testid="rule-values" class="rb-values" hidden?={ len(groups) == 0 }>
			<legend class="sr-only">Values</legend>
			<div class="rb-value-list" data-rule-values>
				if row.Attribute != "" {
					for _, g := range groups {
						for _, val := range g.Values {
							@reportRuleValue(ruleRowInput(i, "value"), row.valueInputType(), val, slices.Contains(row.Values, val.Value))
						}
					}
				} else {
					for _, g := range groups {
						<fieldset data-testid="rule-value-group" class="rb-value-group">
							<legend>{ g.Label }</legend>
							for _, val := range g.Values {
								@reportRuleValue(ruleRowInput(i, "value"), row.valueInputType(), val, slices.Contains(row.Values, val.Value))
							}
						</fieldset>
					}
				}
			</div>
		</fieldset>
		<button type="submit" name={ inputRemoveRule } value={ fmt.Sprint(i) } class="btn rb-remove" formnovalidate aria-label="Remove rule" title="Remove rule">×</button>
		@reportBuilderError(v, domain.RuleInput(i))
	</div>
}

// reportRuleValue is one value a rule row can test for, as a radio or a
// checkbox (kind) named name, labelled with the value; a template's carries
// no name, as script gives it its row's.
templ reportRuleValue(name, kind string, val ruleValue, checked bool) {
	<label class="rb-value">
		if name != "" {
			<input type={ kind } name={ name } value={ val.Value } checked?={ checked }/>
		} else {
			<input type={ kind } value={ val.Value }/>
		}
		<span>{ val.Label }</span>
	</label>
}

// reportRuleValueTemplates are, outside every rule row, the values script
// fills a row with when its attribute changes: one inert <template> per
// attribute a new row may test, holding the values it offers one. A Retired
// attribute has none: only a row that already tests it offers it, and script
// keeps that row's own.
templ reportRuleValueTemplates(attributes []ruleAttribute) {
	for _, a := range attributes {
		if values := (reportRuleRow{}).offeredValues(a); !a.Retired && len(values) > 0 {
			<template data-rule-values-for={ a.Key }>
				for _, val := range values {
					@reportRuleValue("", "checkbox", val, false)
				}
			</template>
		}
	}
}

// reportBuilderError is why input was refused, beside it, if it was.
templ reportBuilderError(v reportBuilderView, input string) {
	if bad := v.bad(input); bad != "" {
		<span data-testid="input-error" id={ input + "-error" } class="rb-input-error">{ bad }</span>
	}
}

// alsoIncludeHelp says what the builder's Also include list does.
const alsoIncludeHelp = "Goals to add by hand, even if they don't meet the rules."

// leaveOutHelp says what the builder's Leave out list does.
const leaveOutHelp = "Goals to drop, even if they meet the rules."

// reportGoalPicker picks Goals at any level for one of the builder's lists,
// list naming it. Each Goal in the list is a chip holding its id; script
// searches the Goals the list offers (reportRuleSelection.offers) by title as
// it is typed, sending the whole form so the search reads the rules and both
// lists as they stand, picking a result adds its chip and empties the search
// box, and × removes one. Without script a multiple select offers the same
// Goals, for the rules as last posted, and a chip's Remove checkbox takes its
// Goal out. Leave out with no complete rule offers nothing and says to add
// one. A non-empty help explains the list behind a help button after the
// legend.
templ reportGoalPicker(v reportBuilderView, list, legend, help string, chosen []domain.Goal) {
	<fieldset data-testid={ list + "-picker" } class="rb-picker" data-goal-picker={ list }>
		<legend>{ legend }</legend>
		if help != "" {
			<button type="button" class="disclose help explain" aria-expanded="false" aria-controls={ list + "-help" } title={ help }>{ "What does " + legend + " do?" }</button>
			<p id={ list + "-help" } class="explain" hidden>{ help }</p>
		}
		<ul data-testid={ list + "-chips" } id={ list + "-chips" } class="rb-chips">
			for _, g := range chosen {
				@reportGoalChip(list, g)
			}
		</ul>
		<div class="rb-js-only">
			<input
				type="search"
				name={ goalSearchInput(list) }
				placeholder="Search any Goal by title"
				autocomplete="off"
				aria-label={ "Search Goals: " + legend }
				aria-controls={ list + "-results" }
				hx-get={ "/reports/goals/search?list=" + list }
				hx-trigger="input changed delay:300ms, search"
				hx-target={ "#" + list + "-results" }
				hx-swap="innerHTML"
				hx-sync="this:replace"
				hx-include="closest form"
				data-goal-search
			/>
			<ul data-testid={ list + "-results" } id={ list + "-results" } class="rb-results" aria-live="polite"></ul>
		</div>
		<label class="field rb-no-js">
			<span>Pick Goals <span class="hint">— hold Ctrl or ⌘ for several</span></span>
			<select data-testid={ list + "-select" } name={ list } multiple>
				for _, g := range v.Offers[list] {
					<option value={ fmt.Sprint(g.ID) }>{ g.Title }</option>
				}
			</select>
			if list == inputExclude && v.LeaveOutNeedsRule {
				<span data-testid="goal-search-needs-rule" class="muted small">{ leaveOutNeedsRule }</span>
			}
		</label>
		@reportBuilderError(v, list)
	</fieldset>
}

// leaveOutNeedsRule is what Leave out says when there is no complete rule
// yet, so nothing for it to drop.
const leaveOutNeedsRule = "Add a rule first: Leave out drops Goals the rules select."

// reportGoalSearchResults are a picker's search matches, each a button that
// picks it beside the <template> of the chip picking it adds to list. With
// needsRule, Leave out has no rule to drop Goals from, and says so.
//
//nolint:contextcheck // templ hands its closures Render's ctx in a struct field, which contextcheck can't follow
templ reportGoalSearchResults(list string, matches []domain.Goal, needsRule bool) {
	if needsRule {
		<li data-testid="goal-search-needs-rule" class="muted small">{ leaveOutNeedsRule }</li>
	} else if len(matches) == 0 {
		<li class="muted small">No Goals match.</li>
	}
	for _, g := range matches {
		<li data-testid="report-goal-result">
			<button type="button" class="rb-result" data-pick>
				<span data-testid="report-goal-result-title">{ g.Title }</span>
				<span class="muted small">{ g.Owner.Label() }</span>
			</button>
			<template>
				@reportGoalChip(list, g)
			</template>
		</li>
	}
}

// reportBuilderScript turns the builder to script: each rule row offers only
// its attribute's operators and values, filled from reportRuleValueTemplates
// as the attribute changes, as radios under "is" and checkboxes otherwise;
// + Add rule adds a blank row in place and × removes one; each picker
// searches in place of its no-script select, adding a chip when a result is
// picked and removing one at its ×; and each refreshes the rail.
templ reportBuilderScript() {
	<script>
		(function () {
			var form = document.querySelector('[data-testid="report-builder"]');
			if (!form) return;
			var inputs = form.querySelector('[data-testid="report-builder-inputs"]');
			form.classList.add("rb-js");
			var ops = {
				values: [["is", "is"], ["is any of", "is any of"], ["is not", "is not"]],
				"top-level": [["is", "is Top-level"], ["is not", "is not Top-level"]],
				org: [["is", "is in the org of"], ["is any of", "is in the org of any of"], ["is not", "is not in the org of"]]
			};
			function attributeOf(row) { return row.querySelector('[data-testid="rule-attribute"]'); }
			function listOf(row) { return row.querySelector("[data-rule-values]"); }
			function narrowOps(row) {
				var attribute = attributeOf(row).value;
				var op = row.querySelector('[data-testid="rule-op"]');
				var chosen = op.value;
				op.textContent = "";
				(ops[attribute] || ops.values).forEach(function (o) {
					op.add(new Option(o[1], o[0], false, o[0] === chosen));
				});
			}
			// setKind makes the row's values radios under "is", keeping only
			// the first chosen, and checkboxes otherwise, keeping every one.
			function setKind(row) {
				var radio = row.querySelector('[data-testid="rule-op"]').value === "is";
				var values = Array.from(listOf(row).querySelectorAll("input"));
				var chosen = values.map(function (input) { return input.checked; });
				var kept = false;
				values.forEach(function (input, i) {
					input.type = radio ? "radio" : "checkbox";
					input.checked = chosen[i] && !(radio && kept);
					if (input.checked) kept = true;
				});
			}
			// fill gives the row its attribute's values alone: those it was
			// rendered with when it tests that attribute again, so a Retired
			// value it holds stays, or else its attribute's template's.
			function fill(row) {
				var attribute = attributeOf(row).value;
				var list = listOf(row);
				var name = attributeOf(row).name.replace(/\.attribute$/, ".value");
				var source = null;
				if (attribute && attribute === row.renderedAttribute) {
					source = row.renderedValues;
				} else if (attribute) {
					var template = form.querySelector('template[data-rule-values-for="' + attribute + '"]');
					source = template && template.content;
				}
				list.textContent = "";
				if (source) list.appendChild(source.cloneNode(true));
				list.querySelectorAll("input").forEach(function (input) { input.name = name; });
				list.closest('[data-testid="rule-values"]').hidden = !list.querySelector("input");
			}
			function rowsOf() { return Array.from(form.querySelectorAll("[data-rule]")); }
			rowsOf().forEach(function (row) {
				narrowOps(row);
				var attribute = attributeOf(row).value;
				if (attribute) {
					row.renderedAttribute = attribute;
					row.renderedValues = document.createDocumentFragment();
					Array.from(listOf(row).children).forEach(function (n) { row.renderedValues.appendChild(n.cloneNode(true)); });
				}
				fill(row);
			});
			// A blank row to add, from the first: what it tests and its
			// values cleared, and no Retired attribute offered.
			var blank = rowsOf()[0].cloneNode(true);
			blank.querySelectorAll('[data-testid="input-error"]').forEach(function (n) { n.remove(); });
			blank.querySelectorAll("option[data-retired]").forEach(function (o) { o.remove(); });
			var next = rowsOf().reduce(function (max, row) {
				return Math.max(max, parseInt(attributeOf(row).name.replace(/^rules\[(\d+)\].*$/, "$1"), 10) + 1);
			}, 0);
			var add = form.querySelector('button[name="do"][value="add-rule"]');
			function addRule() {
				var row = blank.cloneNode(true);
				var i = next++;
				attributeOf(row).name = "rules[" + i + "].attribute";
				attributeOf(row).value = "";
				row.querySelector('[data-testid="rule-op"]').name = "rules[" + i + "].op";
				row.querySelector('button[name="remove-rule"]').value = String(i);
				var rows = rowsOf();
				var last = rows[rows.length - 1];
				if (last) last.after(row); else add.closest("div").before(row);
				narrowOps(row);
				row.querySelector('[data-testid="rule-op"]').selectedIndex = 0;
				fill(row);
				attributeOf(row).focus();
				inputs.dispatchEvent(new Event("change"));
			}
			form.addEventListener("change", function (e) {
				var row = e.target.closest("[data-rule]");
				if (!row) return;
				if (e.target.matches('[data-testid="rule-attribute"]')) {
					narrowOps(row);
					fill(row);
					setKind(row);
				} else if (e.target.matches('[data-testid="rule-op"]')) {
					setKind(row);
				}
			});
			form.addEventListener("click", function (e) {
				if (e.target.closest('button[name="do"][value="add-rule"]')) {
					e.preventDefault();
					addRule();
					return;
				}
				var remove = e.target.closest('button[name="remove-rule"]');
				if (!remove) return;
				e.preventDefault();
				var row = remove.closest("[data-rule]");
				var rows = rowsOf();
				var after = rows[rows.indexOf(row) + 1];
				row.remove();
				if (after) attributeOf(after).focus(); else add.focus();
				inputs.dispatchEvent(new Event("change"));
			});
			form.querySelectorAll("[data-goal-picker] .rb-no-js select").forEach(function (select) {
				select.disabled = true;
			});
			form.addEventListener("keydown", function (e) {
				if (e.key === "Enter" && e.target.matches("[data-goal-search]")) e.preventDefault();
			});
			form.addEventListener("click", function (e) {
				var picker = e.target.closest("[data-goal-picker]");
				if (!picker) return;
				var pick = e.target.closest("[data-pick]");
				if (pick) {
					var result = pick.closest("li");
					picker.querySelector(".rb-chips").appendChild(result.querySelector("template").content.firstElementChild.cloneNode(true));
					result.remove();
					var search = picker.querySelector("[data-goal-search]");
					search.value = "";
					search.focus();
					inputs.dispatchEvent(new Event("change"));
					return;
				}
				var remove = e.target.closest("[data-remove-chip]");
				if (remove) {
					remove.closest("li").remove();
					picker.querySelector("[data-goal-search]").focus();
					inputs.dispatchEvent(new Event("change"));
				}
			});
		})();
	</script>
}

// reportGoalChip is a Goal in one of the builder's lists: its hidden id, its
// title, and the × that removes it. Without script, its Remove checkbox takes
// it out of the list on the builder's next submit.
templ reportGoalChip(list string, g domain.Goal) {
	<li data-testid={ list + "-chip" } class="rb-chip">
		<input type="hidden" name={ list } value={ fmt.Sprint(g.ID) }/>
		<span>{ g.Title }</span>
		<label class="rb-no-js small"><input type="checkbox" name={ removeChip(list) } value={ fmt.Sprint(g.ID) }/> Remove</label>
		<button type="button" class="btn rb-remove rb-js-only" data-remove-chip aria-label={ "Remove " + g.Title } title={ "Remove " + g.Title }>×</button>
	</li>
}

// reportBuilderStyles are the builder's own rules on top of app.css and the
// Reports pages'. The page is one centred column: the form and its inputs
// let their sections into it, so the Matches rail, outside the form, can sit
// between the inputs and the form's Save report.
templ reportBuilderStyles() {
	<style>
		.rb-layout{width:100%;max-width:720px;margin:0 auto;display:flex;flex-direction:column;gap:24px}
		.rb-form{display:contents}
		.rb-inputs{display:contents}
		.rb-rules,.rb-picked,.rb-rail{border-top:1px solid var(--color-border);padding-top:24px}
		.rb-rail{order:1;display:flex;flex-direction:column;gap:12px}
		.rb-rail p{margin:0}
		.rb-match-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
		.rb-match-list>li{display:flex;align-items:center;gap:8px;min-width:0;min-height:40px;padding:4px 0;border-bottom:1px solid var(--color-border);box-sizing:border-box}
		.rb-match-list>li:first-child{border-top:1px solid var(--color-border)}
		.rb-match-title{flex:1;min-width:0;color:var(--color-ink);font-weight:500}
		.rb-form fieldset{border:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;min-width:0}
		.rb-form legend{font-weight:600;padding:0 0 8px}
		.rb-segments{display:inline-flex;align-self:flex-start;border:1px solid var(--color-border-strong);border-radius:var(--radius-md);overflow:hidden}
		.rb-segments label{position:relative;padding:8px 16px;cursor:pointer;display:flex;align-items:center;gap:8px}
		@supports selector(:has(*)){
			.rb-segments input{position:absolute;opacity:0;pointer-events:none}
			.rb-segments label:has(input:checked){background:var(--color-ink);color:var(--color-surface)}
			.rb-segments label:has(input:focus-visible){outline:2px solid var(--color-focus);outline-offset:-2px}
			.rb-form:has(input[name=mode][value=picked]:checked) .rb-rules{display:none}
			.rb-form:has(input[name=mode][value=rules]:checked) .rb-picked{display:none}
		}
		.rb-chips{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0;padding:0}
		.rb-chips:empty{display:none}
		.rb-chip{display:inline-flex;align-items:center;gap:8px;padding:0 0 0 12px;border:1px solid var(--color-border);border-radius:999px}
		.rb-remove{width:40px;padding:0;border-color:var(--color-border-strong);font-size:20px;font-weight:400;line-height:1}
		.rb-chip .rb-remove{border-radius:999px}
		@media (pointer:coarse){.rb-remove{min-width:44px}}
		.rb-form select[multiple]{width:100%;min-height:8em}
		.rb-rules,.rb-picked{display:flex;flex-direction:column;gap:12px}
		.rb-rule{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-start}
		.rb-values{flex:1 1 240px;min-width:0;max-height:14em;overflow:auto;border:1px solid var(--color-border-strong);border-radius:var(--radius-md);padding:4px 8px;box-sizing:border-box}
		.rb-form .rb-values{display:block}
		.rb-form .rb-values[hidden]{display:none}
		.rb-value-list{display:flex;flex-direction:column}
		.rb-form .rb-value-group{gap:0;padding:4px 0}
		.rb-form .rb-value-group>legend{font-size:var(--text-secondary);color:var(--color-ink-2);padding:0 0 4px}
		.rb-value{display:flex;align-items:center;gap:8px;min-height:32px;cursor:pointer}
		@media (pointer:coarse){.rb-value{min-height:44px}}
		.rb-input-error{display:block;flex-basis:100%;font-size:var(--text-secondary);color:var(--color-danger-ink)}
		.rb-problems{border:1px solid var(--color-danger-ink);border-radius:var(--radius-md);padding:12px 16px;color:var(--color-danger-ink)}
		.rb-problems p,.rb-problems ul{margin:0}
		.rb-fields>summary{align-self:flex-start;border:1px dashed var(--color-border-strong)}
		.rb-fields fieldset{margin-top:12px}
		.rb-actions{order:2;display:flex;gap:8px;flex-wrap:wrap}
		.rb-form:not(.rb-js) .rb-js-only{display:none}
		.rb-form:not(.rb-js) .rb-chip{padding:4px 12px}
		.rb-form.rb-js .rb-no-js{display:none}
		.rb-picker input[type=search]{width:100%}
		.rb-picker>.help{align-self:flex-start}
		.rb-results{list-style:none;margin:4px 0 0;padding:0;display:flex;flex-direction:column}
		.rb-result{display:flex;gap:8px;width:100%;text-align:left;background:none;border:none;padding:4px 8px;cursor:pointer}
	</style>
}
