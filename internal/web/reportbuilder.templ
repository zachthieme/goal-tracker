package web

import (
	"fmt"
	"slices"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// reportBuilderPage builds a Report Definition, new or saved (CONTEXT.md:
// Report Definition): its name and introduction, and what's in it, the Goals
// matching rules or the Goals the author picks, never those linked to some
// other Goal (ADR 0007). A saved one's id goes with the form, so the rail
// reads against its baseline.
templ reportBuilderPage(current *domain.Account, v reportBuilderView) {
	@layout(v.title(), current) {
		@reportStyles()
		@reportBuilderStyles()
		<div class="page-head">
			<p class="small muted">
				<a href="/reports">Reports</a>{ " / " }
				if v.ID != 0 {
					<a href={ templ.SafeURL(v.draft()) }>{ v.Saved }</a>{ " / " }Edit
				} else {
					New
				}
			</p>
			<h1>{ v.title() }</h1>
		</div>
		<div class="rb-layout">
			<form
				data-testid="report-builder"
				class="card rb-form"
				method="post"
				action={ templ.SafeURL(v.action()) }
			>
				// Enter presses a form's first submit, so it saves, not Add rule.
				<button type="submit" class="sr-only" tabindex="-1" aria-hidden="true">Save report</button>
				if v.ID != 0 {
					<input type="hidden" name="id" value={ fmt.Sprint(v.ID) }/>
				}
				if problems := v.unplaced(); len(problems) > 0 {
					<div data-testid="builder-problems" class="rb-problems" role="alert">
						<p><strong>The report wasn't saved.</strong></p>
						<ul>
							for _, p := range problems {
								<li>{ p.Message }</li>
							}
						</ul>
					</div>
				}
				// The rail's post comes from the inputs, not the form: htmx
				// validates a form it posts, so an empty Name, which Save
				// requires, would halt every refresh.
				<div
					data-testid="report-builder-inputs"
					class="rb-inputs"
					hx-post="/reports/new/matches"
					hx-include="closest form"
					hx-trigger="change[target.type!='search'], input[target.type!='search'] delay:400ms"
					hx-target={ "#" + reportMatchesID }
					hx-swap="outerHTML"
					hx-sync="this:replace"
				>
					<label class="field">
						<span>Name</span>
						<input type="text" name="name" value={ v.Name } required/>
						@reportBuilderError(v, domain.ReportInputName)
					</label>
					<label class="field">
						<span>Introduction</span>
						<textarea name="introduction">{ v.Introduction }</textarea>
					</label>
					<fieldset data-testid="report-mode" class="rb-mode">
						<legend>What's in this report</legend>
						<div class="rb-segments">
							<label><input type="radio" name="mode" value={ domain.ReportModeRules } checked?={ v.Mode != domain.ReportModePicked }/>Goals matching rules</label>
							<label><input type="radio" name="mode" value={ domain.ReportModePicked } checked?={ v.Mode == domain.ReportModePicked }/>Goals I pick</label>
						</div>
						@reportBuilderError(v, domain.ReportInputMode)
					</fieldset>
					<section data-testid="report-rules" class="rb-rules">
						<h2 class="label">Rules <span class="hint">— a Goal must meet every rule, and any of a rule's values</span></h2>
						for i, row := range v.rows() {
							@reportRuleRowInputs(v, i, row)
						}
						@reportBuilderError(v, domain.ReportInputRules)
						<div><button type="submit" name="do" value="add-rule" class="btn quiet sm rb-add" formnovalidate>+ Add rule</button></div>
						<p data-testid="rules-hint" class="small muted">
							Rules can test any Dimension, Owner, Lifecycle, Health or Top-level. An Admin can create a Dimension such as "In report" so Owners tag their own Goals in; you still decide what's in through Leave out.
						</p>
						@reportGoalPicker(v, inputInclude, "Also include", v.Include)
						@reportGoalPicker(v, inputExclude, "Leave out", v.Exclude)
					</section>
					<section data-testid="report-picked" class="rb-picked">
						@reportGoalPicker(v, inputPicked, "Goals I pick", v.Picked)
					</section>
					if len(v.Fields) > 0 {
						<details data-testid="report-fields-to-show" class="rb-fields" open?={ len(v.FieldIDs) > 0 || v.bad(domain.ReportInputFields) != "" }>
							<summary class="btn quiet sm">+ Fields to show</summary>
							<fieldset data-testid="report-field-choice">
								<legend>Fields <span class="hint">— shown beside each Goal that has a value</span></legend>
								for _, f := range v.Fields {
									<label>
										<input type="checkbox" name={ inputShowField } value={ fmt.Sprint(f.ID) } checked?={ slices.Contains(v.FieldIDs, f.ID) }/>
										{ f.Name }
									</label>
								}
							</fieldset>
							@reportBuilderError(v, domain.ReportInputFields)
						</details>
					}
				</div>
				<div class="rb-actions">
					<button type="submit" class="btn primary">Save report</button>
					<button type="submit" name="do" value="show-matches" class="btn rb-no-js" formnovalidate>Show matches</button>
				</div>
			</form>
			@reportMatchesRail(v.Matches)
		</div>
		@reportBuilderScript()
	}
}

// reportMatchesID is the rail's id, which the builder's inputs swap as they
// are typed.
const reportMatchesID = "report-matches"

// reportMatchesRail is the builder's rail: a flat list of the Goals the
// definition as typed would select, by title, each with its Health or, with
// none yet, its Lifecycle, and "added" beside one only Also include selects.
// Past the first railLength, it counts the rest and those left out.
templ reportMatchesRail(m reportMatches) {
	<aside data-testid="report-matches" id={ reportMatchesID } class="card rb-rail" aria-live="polite">
		if m.NeedsRule {
			<h2 class="label">Matches</h2>
			<p data-testid="matches-need-rule" class="muted">Add a rule to see matching Goals.</p>
		} else {
			<h2 data-testid="matches-count" class="label">{ "Matches " + plural(m.Count, "Goal") }</h2>
			<ul class="rb-match-list">
				for _, g := range m.Shown {
					<li data-testid="match">
						if g.Health != "" {
							<span data-testid="match-badge" class={ "badge", healthClass(g.Health) }><span class="dot"></span>{ g.Health }</span>
						} else {
							<span data-testid="match-badge" class="badge lc">{ g.Goal.Lifecycle }</span>
						}
						<span class="rb-match-title">{ g.Goal.Title }</span>
						if g.Added {
							<span data-testid="match-added" class="muted small">added</span>
						}
					</li>
				}
			</ul>
			if more := m.more(); more != "" {
				<p data-testid="matches-more" class="muted small">{ more }</p>
			}
		}
		<p class="muted small">A flat list, not a tree. Whether one Goal feeds another doesn't decide what's in the report.</p>
	</aside>
}

// reportRuleRowInputs is the i-th rule row: what it tests, its operator, and
// the values it tests for, one group per attribute, which script narrows to the
// chosen attribute's. A Top-level row tests no values, so it offers only "is
// Top-level" and "is not Top-level", but still carries every attribute's
// values, hidden by script, so switching it to another attribute offers that
// attribute's. Before script runs, a style hides a Top-level row's values, so
// without script it offers only the two operators. The × submits the form
// without the row.
templ reportRuleRowInputs(v reportBuilderView, i int, row reportRuleRow) {
	<div data-testid="report-rule" class="rb-rule" data-rule data-top-level?={ row.Attribute == domain.RuleTopLevel }>
		<select data-testid="rule-attribute" name={ ruleRowInput(i, "attribute") } aria-label="What the rule tests">
			<option value="">Choose…</option>
			for _, a := range v.Attributes {
				if row.offers(a) {
					<option value={ a.Key } selected?={ a.Key == row.Attribute }>{ a.Label }</option>
				}
			}
		</select>
		<select data-testid="rule-op" name={ ruleRowInput(i, "op") } aria-label="Operator">
			for _, op := range ruleOps(row.Attribute) {
				<option value={ op[0] } selected?={ op[0] == row.Op }>{ op[1] }</option>
			}
		</select>
		<select data-testid="rule-values" name={ ruleRowInput(i, "value") } multiple aria-label="Values">
			for _, a := range v.Attributes {
				if values := row.offeredValues(a); len(values) > 0 && row.offers(a) {
					<optgroup label={ a.Label } data-attribute={ a.Key }>
						for _, val := range values {
							<option value={ val.Value } selected?={ slices.Contains(row.Values, val.Value) }>{ val.Label }</option>
						}
					</optgroup>
				}
			}
		</select>
		<button type="submit" name={ inputRemoveRule } value={ fmt.Sprint(i) } class="btn quiet sm" formnovalidate aria-label="Remove rule" title="Remove rule">×</button>
		@reportBuilderError(v, domain.RuleInput(i))
	</div>
}

// reportBuilderError is why input was refused, beside it, if it was.
templ reportBuilderError(v reportBuilderView, input string) {
	if bad := v.bad(input); bad != "" {
		<span data-testid="input-error" id={ input + "-error" } class="rb-input-error">{ bad }</span>
	}
}

// reportGoalPicker picks Goals at any level for one of the builder's lists,
// list naming it. Each Goal in the list is a chip holding its id; script
// searches every Goal by title as it is typed, picking a result adds its chip
// and empties the search box, and × removes one. Without script a multiple select offers every Goal not
// already in the list, and a chip's Remove checkbox takes its Goal out.
templ reportGoalPicker(v reportBuilderView, list, legend string, chosen []domain.Goal) {
	<fieldset data-testid={ list + "-picker" } class="rb-picker" data-goal-picker={ list }>
		<legend>{ legend }</legend>
		<ul data-testid={ list + "-chips" } id={ list + "-chips" } class="rb-chips">
			for _, g := range chosen {
				@reportGoalChip(list, g)
			}
		</ul>
		<div class="rb-js-only">
			<input
				type="search"
				name="q"
				placeholder="Search any Goal by title"
				autocomplete="off"
				aria-label={ "Search Goals: " + legend }
				aria-controls={ list + "-results" }
				hx-get={ "/reports/goals/search?list=" + list }
				hx-trigger="input changed delay:300ms, search"
				hx-target={ "#" + list + "-results" }
				hx-swap="innerHTML"
				hx-sync="this:replace"
				hx-include={ "#" + list + "-chips" }
				data-goal-search
			/>
			<ul data-testid={ list + "-results" } id={ list + "-results" } class="rb-results" aria-live="polite"></ul>
		</div>
		<label class="field rb-no-js">
			<span>Pick Goals <span class="hint">— hold Ctrl or ⌘ for several</span></span>
			<select data-testid={ list + "-select" } name={ list } multiple>
				for _, g := range v.Goals {
					if !slices.ContainsFunc(chosen, func(c domain.Goal) bool { return c.ID == g.ID }) {
						<option value={ fmt.Sprint(g.ID) }>{ g.Title }</option>
					}
				}
			</select>
		</label>
		@reportBuilderError(v, list)
	</fieldset>
}

// reportGoalSearchResults are a picker's search matches, each a button that
// picks it beside the <template> of the chip picking it adds to list.
templ reportGoalSearchResults(list string, matches []domain.Goal) {
	if len(matches) == 0 {
		<li class="muted small">No Goals match.</li>
	}
	for _, g := range matches {
		<li data-testid="report-goal-result">
			<button type="button" class="rb-result" data-pick>
				<span>{ g.Title }</span>
				<span class="muted small">{ g.Owner.Label() }</span>
			</button>
			<template>
				@reportGoalChip(list, g)
			</template>
		</li>
	}
}

// reportBuilderScript turns the builder to script: each rule row offers only
// its attribute's values and operators, each picker searches in place of its
// no-script select, adding a chip when a result is picked and removing one at
// its ×, and either refreshes the rail.
templ reportBuilderScript() {
	<script>
		(function () {
			var form = document.querySelector('[data-testid="report-builder"]');
			if (!form) return;
			var inputs = form.querySelector('[data-testid="report-builder-inputs"]');
			form.classList.add("rb-js");
			var ops = {
				values: [["is", "is"], ["is any of", "is any of"], ["is not", "is not"]],
				"top-level": [["is", "is Top-level"], ["is not", "is not Top-level"]],
				chain: [["is", "is in the Chain of"], ["is any of", "is in the Chain of any of"], ["is not", "is not in the Chain of"]]
			};
			function narrow(row) {
				var attribute = row.querySelector('[data-testid="rule-attribute"]').value;
				var op = row.querySelector('[data-testid="rule-op"]');
				var values = row.querySelector('[data-testid="rule-values"]');
				var wanted = ops[attribute] || ops.values;
				var chosen = op.value;
				op.textContent = "";
				wanted.forEach(function (o) {
					op.add(new Option(o[1], o[0], false, o[0] === chosen));
				});
				if (!values) return;
				values.hidden = attribute === "top-level" || attribute === "";
				values.querySelectorAll("optgroup").forEach(function (group) {
					var mine = group.getAttribute("data-attribute") === attribute;
					group.hidden = !mine;
					group.disabled = !mine;
					if (!mine) group.querySelectorAll("option").forEach(function (o) { o.selected = false; });
				});
			}
			form.querySelectorAll("[data-rule]").forEach(narrow);
			form.addEventListener("change", function (e) {
				if (e.target.matches('[data-testid="rule-attribute"]')) narrow(e.target.closest("[data-rule]"));
			});
			form.querySelectorAll("[data-goal-picker] .rb-no-js select").forEach(function (select) {
				select.disabled = true;
			});
			form.addEventListener("keydown", function (e) {
				if (e.key === "Enter" && e.target.matches("[data-goal-search]")) e.preventDefault();
			});
			form.addEventListener("click", function (e) {
				var picker = e.target.closest("[data-goal-picker]");
				if (!picker) return;
				var pick = e.target.closest("[data-pick]");
				if (pick) {
					var result = pick.closest("li");
					picker.querySelector(".rb-chips").appendChild(result.querySelector("template").content.firstElementChild.cloneNode(true));
					result.remove();
					var search = picker.querySelector("[data-goal-search]");
					search.value = "";
					search.focus();
					inputs.dispatchEvent(new Event("change"));
					return;
				}
				var remove = e.target.closest("[data-remove-chip]");
				if (remove) {
					remove.closest("li").remove();
					picker.querySelector("[data-goal-search]").focus();
					inputs.dispatchEvent(new Event("change"));
				}
			});
		})();
	</script>
}

// reportGoalChip is a Goal in one of the builder's lists: its hidden id, its
// title, and the × that removes it. Without script, its Remove checkbox takes
// it out of the list on the builder's next submit.
templ reportGoalChip(list string, g domain.Goal) {
	<li data-testid={ list + "-chip" } class="rb-chip">
		<input type="hidden" name={ list } value={ fmt.Sprint(g.ID) }/>
		<span>{ g.Title }</span>
		<label class="rb-no-js small"><input type="checkbox" name={ removeChip(list) } value={ fmt.Sprint(g.ID) }/> Remove</label>
		<button type="button" class="btn quiet sm rb-js-only" data-remove-chip aria-label={ "Remove " + g.Title } title={ "Remove " + g.Title }>×</button>
	</li>
}

// reportBuilderStyles are the builder's own rules on top of app.css and the
// Reports pages'.
templ reportBuilderStyles() {
	<style>
		.rb-layout{display:grid;grid-template-columns:minmax(0,760px) 320px;gap:24px;align-items:start}
		.rb-form{padding:24px;display:flex;flex-direction:column;gap:16px}
		.rb-inputs{display:contents}
		.rb-rail{position:sticky;top:24px;padding:24px;display:flex;flex-direction:column;gap:12px}
		.rb-rail p{margin:0}
		.rb-match-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
		.rb-match-list>li{display:flex;align-items:center;gap:8px;min-width:0}
		.rb-match-title{flex:1;min-width:0}
		@media (max-width:1140px){
			.rb-layout{grid-template-columns:minmax(0,1fr)}
			.rb-rail{position:static}
		}
		.rb-form fieldset{border:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;min-width:0}
		.rb-form legend{font-weight:600;padding:0 0 8px}
		.rb-segments{display:inline-flex;align-self:flex-start;border:1px solid var(--color-border-strong);border-radius:var(--radius-md);overflow:hidden}
		.rb-segments label{position:relative;padding:8px 16px;cursor:pointer;display:flex;align-items:center;gap:8px}
		@supports selector(:has(*)){
			.rb-segments input{position:absolute;opacity:0;pointer-events:none}
			.rb-segments label:has(input:checked){background:var(--color-ink);color:var(--color-surface)}
			.rb-segments label:has(input:focus-visible){outline:2px solid var(--color-focus);outline-offset:-2px}
			.rb-form:has(input[name=mode][value=picked]:checked) .rb-rules{display:none}
			.rb-form:has(input[name=mode][value=rules]:checked) .rb-picked{display:none}
		}
		.rb-chips{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0;padding:0}
		.rb-chips:empty{display:none}
		.rb-chip{display:inline-flex;align-items:center;gap:8px;padding:4px 4px 4px 12px;border:1px solid var(--color-border);border-radius:999px}
		.rb-form select[multiple]{width:100%;min-height:8em}
		.rb-rules,.rb-picked{display:flex;flex-direction:column;gap:12px}
		.rb-rule{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-start}
		.rb-rule select[multiple]{flex:1 1 240px;width:auto}
		.rb-input-error{display:block;flex-basis:100%;font-size:13px;color:var(--color-danger-ink)}
		.rb-problems{border:1px solid var(--color-danger-ink);border-radius:var(--radius-md);padding:12px 16px;color:var(--color-danger-ink)}
		.rb-problems p,.rb-problems ul{margin:0}
		.rb-fields>summary{align-self:flex-start;border:1px dashed var(--color-border-strong)}
		.rb-fields fieldset{margin-top:12px}
		.rb-actions{display:flex;gap:8px;flex-wrap:wrap}
		.rb-form:not(.rb-js) .rb-js-only{display:none}
		.rb-form.rb-js .rb-no-js{display:none}
		.rb-form:not(.rb-js) [data-top-level] [data-testid="rule-values"]{display:none}
		.rb-picker input[type=search]{width:100%}
		.rb-results{list-style:none;margin:4px 0 0;padding:0;display:flex;flex-direction:column}
		.rb-result{display:flex;gap:8px;width:100%;text-align:left;background:none;border:none;padding:4px 8px;cursor:pointer}
	</style>
}
