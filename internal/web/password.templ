package web

// setPasswordPage is the page a set-password link opens: the sign-in column,
// naming whose password it sets, with the password typed twice. A refused
// password shows the reason above the fields.
//
//nolint:contextcheck // templ hands its closures Render's ctx in a struct field, which contextcheck can't follow
templ setPasswordPage(emailAddr, token, failure string) {
	@layout("Set your password", nil) {
		@signInStyles()
		@signInColumn() {
			<form data-testid="set-password-card" class="si-form" method="post" action="/set-password">
				<h1>Set your password</h1>
				<p class="muted">For <strong data-testid="set-password-email">{ emailAddr }</strong>. At least 12 characters.</p>
				if failure != "" {
					<p data-testid="set-password-error" class="si-error" role="alert">{ failure }</p>
				}
				<input type="hidden" name="token" value={ token }/>
				<input type="hidden" name="email" value={ emailAddr } autocomplete="username"/>
				<label class="field">
					<span>New password</span>
					<input type="password" name="password" required minlength="12" autocomplete="new-password" autofocus/>
				</label>
				<label class="field">
					<span>New password again</span>
					<input type="password" name="confirm" required minlength="12" autocomplete="new-password"/>
				</label>
				<button type="submit" class="btn primary">Set password</button>
			</form>
		}
	}
}

// setPasswordNoticePage is the set-password page when the link can't be used:
// the column, saying why.
//
//nolint:contextcheck // templ hands its closures Render's ctx in a struct field, which contextcheck can't follow
templ setPasswordNoticePage(message string) {
	@layout("Set your password", nil) {
		@signInStyles()
		@signInColumn() {
			<div data-testid="set-password-card" class="si-form">
				<h1>Set your password</h1>
				<p data-testid="set-password-error" class="si-error" role="alert">{ message }</p>
			</div>
		}
	}
}
