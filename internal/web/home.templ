package web

import (
	"fmt"
	"strconv"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// homePage is the signed-in person's week: the Goals to check in on, and what
// else is waiting on them.
templ homePage(current *domain.Account, v homeView) {
	@layout("Home", current) {
		@homeStyles()
		<header data-testid="home-head" class="page-head">
			<div>
				<h1>Your week</h1>
				<p data-testid="home-summary" class="muted">{ thingsNeedYou(v.NeedsYou()) }</p>
			</div>
			<a class="btn primary" href="/goals/new">New goal</a>
		</header>
		<div class="grid-main-aside">
			<div class="hm-col">
				<section data-testid="home-needs-you" class="card hm-card">
					<h3>Needs you</h3>
					if v.NeedsYou() == 0 {
						<p data-testid="home-caught-up" class="muted">You're all caught up.</p>
					}
					if len(v.Due) > 0 {
						<div class="hm-group">
							<h4 class="label">Check-ins due</h4>
							<ul data-testid="home-due" class="hm-list">
								for _, g := range v.Due {
									@dueRow(g)
								}
							</ul>
						</div>
					}
					if len(v.Requests) > 0 {
						<div class="hm-group">
							<h4 class="label">Requests</h4>
							<ul data-testid="home-requests" class="hm-list">
								for _, req := range v.Requests {
									switch  {
										case req.Link != nil:
											@linkRequestRow(*req.Link)
										case req.Suggestion != nil:
											@suggestionRequestRow(*req.Suggestion)
										default:
											@handoffRequestRow(*req.Handoff)
									}
								}
							</ul>
						</div>
					}
				</section>
			</div>
			<aside class="hm-col">
				<section data-testid="home-your-goals" class="card hm-card">
					<h3>Your goals</h3>
					if v.Green + v.Yellow + v.Red > 0 {
						@healthBar(v)
					}
					<p class="hm-counts">
						@healthCountTile("home-count-green", domain.HealthGreen, v.Green)
						@healthCountTile("home-count-yellow", domain.HealthYellow, v.Yellow)
						@healthCountTile("home-count-red", domain.HealthRed, v.Red)
					</p>
					if len(v.AtRisk) > 0 {
						<ul class="hm-list hm-compact">
							for _, g := range v.AtRisk {
								<li>
									<span class={ "badge", healthClass(g.Health) }><span class="dot"></span>{ g.Health }</span>
									<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.Goal.ID)) }>{ g.Goal.Title }</a>
								</li>
							}
						</ul>
					}
					<a href="/goals">All your goals →</a>
				</section>
				if v.Delegated > 0 {
					<a data-testid="home-delegate-link" href="/delegates">
						Goals delegated to you
						<span class="num">{ strconv.Itoa(v.Delegated) }</span>
						{ " →" }
					</a>
				}
			</aside>
		</div>
		@toastNotice(v.Toast)
	}
}

// dueRow is one Goal to check in on: its Health, why it's listed, and the
// one-click No change beside the Check in link to the Goal's Check-in page.
templ dueRow(g domain.PersonalGoal) {
	<li data-testid="home-due-goal">
		<div class="hm-what">
			<span data-testid="home-due-health" class={ "badge", healthClass(g.Health) }>
				<span class="dot"></span>
				if g.Health == "" {
					No Health yet
				} else {
					{ g.Health }
				}
			</span>
			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.Goal.ID)) }>{ g.Goal.Title }</a>
			if g.Freshness.Stale {
				<span data-testid="home-due-stale" class="badge st">Stale</span>
			}
			if g.AsDelegate {
				<span data-testid="home-due-for" class="tag">
					{ "for " }
					@person(g.Goal.Owner)
				</span>
			}
			<p class="muted small">{ dueReason(g) }</p>
		</div>
		<div class="hm-actions">
			if g.CheckedIn {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/checkins/no-change", g.Goal.ID)) } class="inline-form">
					<button type="submit" class="btn sm">No change</button>
				</form>
			}
			<a data-testid="home-due-checkin" class="btn primary sm" href={ templ.SafeURL(fmt.Sprintf("/goals/%d/checkin", g.Goal.ID)) }>Check in</a>
		</div>
	</li>
}

// linkRequestRow is a link request waiting on the person as the parent's Owner.
templ linkRequestRow(l domain.Link) {
	<li data-testid="home-request">
		<div class="hm-what">
			<span class="badge lc">Link request</span>
			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", l.Child.ID)) }>{ l.Child.Title }</a>
			<span class="muted">
				{ "(" }
				@person(l.Child.Owner)
				{ ") wants to contribute to" }
			</span>
			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", l.Parent.ID)) }>{ l.Parent.Title }</a>
		</div>
		<div class="hm-actions">
			@rejectAccept(fmt.Sprintf("/links/%d", l.ID))
		</div>
	</li>
}

// handoffRequestRow is a Handoff waiting on the person as the proposed new
// Owner. Accepting one whose Goal has Delegates means choosing which to keep,
// so in place of Accept it offers Review, leading to the Pending handoffs page
// where that choice is made.
templ handoffRequestRow(ho domain.Handoff) {
	<li data-testid="home-request">
		<div class="hm-what">
			<span class="badge lc">Handoff</span>
			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", ho.Goal.ID)) }>{ ho.Goal.Title }</a>
			<span class="muted">
				@person(ho.From)
				{ " wants to hand this Goal to you" }
			</span>
		</div>
		<div class="hm-actions">
			if len(ho.KeepableDelegates) > 0 {
				@rejectButton(fmt.Sprintf("/handoffs/%d", ho.ID))
				<a data-testid="home-request-review" class="btn sm" href="/handoffs">Review</a>
			} else {
				@rejectAccept(fmt.Sprintf("/handoffs/%d", ho.ID))
			}
		</div>
	</li>
}

// acceptReject is the pair of buttons deciding a pending request at base. Reject
// sends at once; the page then offers Undo in a toast.
templ acceptReject(base string) {
	<form method="post" action={ templ.SafeURL(base + "/accept") } class="inline-form">
		<button type="submit" class="btn primary sm">Accept</button>
	</form>
	<form method="post" action={ templ.SafeURL(base + "/reject") } class="inline-form">
		<button type="submit" class="btn danger sm">Reject</button>
	</form>
}

// rejectAccept is Home's pair of buttons deciding a pending request at base:
// Reject as a text button, then Accept outlined. Reject sends at once; Home
// then offers Undo in a toast.
templ rejectAccept(base string) {
	@rejectButton(base)
	<form method="post" action={ templ.SafeURL(base + "/accept") } class="inline-form">
		<button type="submit" class="btn sm">Accept</button>
	</form>
}

// rejectButton rejects the pending request at base at once, returning to Home.
templ rejectButton(base string) {
	<form method="post" action={ templ.SafeURL(base + "/reject") } class="inline-form">
		<input type="hidden" name="from" value={ fromHome }/>
		<button type="submit" class="btn quiet sm">Reject</button>
	</form>
}

// healthBar draws the person's Active Goals by Health as one segmented bar, a
// unit for each Goal, Green then Yellow then Red. It counts Goals, not Metrics
// (ADR 0003). The count tiles beneath it label each segment so the bar reads
// without colour, and its label says the same to assistive technology.
templ healthBar(v homeView) {
	<div data-testid="home-health-bar" class="hm-bar" role="img" aria-label={ healthBarLabel(v) }>
		for range v.Green {
			<span class="g"></span>
		}
		for range v.Yellow {
			<span class="y"></span>
		}
		for range v.Red {
			<span class="r"></span>
		}
	</div>
}

// healthCountTile counts the person's Active Goals at one Health.
templ healthCountTile(testID, health string, count int) {
	<span class={ "badge", healthClass(health) }>
		<span class="dot"></span>
		{ health }
		<span data-testid={ testID } class="num">{ strconv.Itoa(count) }</span>
	</span>
}

// homeStyles are Home's own rules on top of app.css: each card stacks its title
// over a list of ruled rows, and a row puts what it's about on the left and its
// actions on the right, wrapping the actions underneath when the card is narrow.
templ homeStyles() {
	<style>
		.hm-col{display:flex;flex-direction:column;gap:20px;min-width:0}
		.hm-card{display:flex;flex-direction:column;gap:12px}
		.hm-list{list-style:none;margin:0;padding:0}
		.hm-list:empty{display:none}
		.hm-list>li{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;padding:12px 0;border-top:1px solid var(--color-border)}
		.hm-list>li:first-child{border-top:none;padding-top:0}
		.hm-list>li:last-child{padding-bottom:0}
		.hm-compact>li{gap:4px 8px;padding:8px 0}
		.hm-what{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;flex:1 1 240px;min-width:0}
		.hm-what>p{flex-basis:100%}
		.hm-what>a,.hm-compact a{font-weight:500}
		.hm-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-left:auto}
		.hm-actions form{margin:0}
		.hm-counts{display:flex;flex-wrap:wrap;gap:8px}
		.hm-bar{display:flex;height:12px;border-radius:var(--radius-full);overflow:hidden}
		.hm-bar>span{flex:1 1 0;min-width:2px}
		.hm-bar>.g{background:var(--health-g-ink)}
		.hm-bar>.y{background:var(--health-y-ink)}
		.hm-bar>.r{background:var(--health-r-ink)}
		.hm-bar>.g+.y,.hm-bar>.g+.r,.hm-bar>.y+.r{margin-left:4px}
		.hm-group{display:flex;flex-direction:column;gap:8px}
		.hm-group>h4{margin:0}
	</style>
}
