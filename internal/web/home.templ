package web

import (
	"fmt"
	"strconv"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// homePage is the signed-in person's week: the Goals to check in on, and what
// else is waiting on them. It is one surface with no card: under the page
// header's "Home" and its New goal, the page title, Your week, over today's
// date and Your goals, then Needs you, the page's job, My org and Your Yellow
// or Red goals as sections of ruled rows (DESIGN.md § Home).
templ homePage(current *domain.Account, v homeView) {
	@framedLayout("Home", current, homePageHeader()) {
		@homeStyles()
		<header data-testid="home-head" class="hm-head">
			<h1>Your week</h1>
			<p class="hm-date"><time datetime={ homeTodayISO(v.Dates) }>{ homeToday(v.Dates) }</time></p>
			@homeYourGoals(v)
		</header>
		<div class="hm-col">
			<section data-testid="home-needs-you" class="hm-section">
				<h2 data-testid="home-needs-you-heading">
					@homeHeading("Needs you", v.NeedsYou())
				</h2>
				if v.NeedsYou() == 0 {
					<p data-testid="home-caught-up" class="muted">You're all caught up.</p>
				}
				if len(v.Due) > 0 {
					<div class="hm-group">
						<h3 class="hm-group-head">Check-ins due</h3>
						<ul data-testid="home-due" class="hm-list">
							for _, g := range v.Due {
								@dueRow(g, g.CheckedIn && !v.NoChangeRefused[g.Goal.ID])
							}
						</ul>
					</div>
				}
				if len(v.Asks) > 0 {
					<div class="hm-group">
						<h3 class="hm-group-head">Asks for help</h3>
						<ul data-testid="home-asks" class="hm-list">
							for _, a := range v.Asks {
								@askRow(a)
							}
						</ul>
					</div>
				}
				if len(v.ActionItems) > 0 {
					<div class="hm-group">
						<h3 class="hm-group-head">Action Items</h3>
						<ul data-testid="home-action-items" class="hm-list">
							for _, l := range v.ActionItems {
								@actionItemRow(l)
							}
						</ul>
					</div>
				}
				if len(v.Requests) > 0 {
					<div class="hm-group">
						<h3 class="hm-group-head">Requests</h3>
						<ul data-testid="home-requests" class="hm-list">
							for _, req := range v.Requests {
								switch  {
									case req.Link != nil:
										@linkRequestRow(*req.Link)
									case req.Suggestion != nil:
										@suggestionRequestRow(*req.Suggestion)
									default:
										@handoffRequestRow(*req.Handoff)
								}
							}
						</ul>
					</div>
				}
			</section>
			if v.Org != nil {
				@homeOrgSection(*v.Org)
			}
			if len(v.AtRisk) > 0 {
				<section data-testid="home-not-green" class="hm-section">
					<h2>
						@homeHeading("Your Yellow or Red goals", len(v.AtRisk))
					</h2>
					<ul class="hm-list">
						for _, g := range v.AtRisk {
							<li>
								<div class="hm-what">
									@healthChipWith("home-goal-health", g.Health, g.Health, homeAsOfClass(g))
									<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.Goal.ID)) }>{ g.Goal.Title }</a>
									if asOf := healthAsOf(g); asOf != "" {
										<span data-testid="home-goal-as-of" class="hm-meta">{ asOf }</span>
									}
								</div>
							</li>
						}
					</ul>
				</section>
			}
		</div>
		@toastNotice(v.Toast)
	}
}

// homePageHeader is Home's header strip: "Home", with New goal as its primary
// action at the right.
templ homePageHeader() {
	@pageHeader(pageHead{Title: "Home"}) {
		<a class="btn primary hm-btn" href="/goals/new">New goal</a>
	}
}

// homeYourGoals is the page title's Your goals line: the Health distribution
// bar of the Goals the person Owns, their counts by Health, and the links on to
// the Goals they own or help with and, when there are any, those they're a
// Delegate on.
templ homeYourGoals(v homeView) {
	<div data-testid="home-your-goals" class="hm-summary">
		<span>Your goals:</span>
		if v.Green + v.Yellow + v.Red > 0 {
			@healthBar(v)
		}
		<p>
			<span data-testid="home-count-green">{ strconv.Itoa(v.Green) }</span>
			{ " " + domain.HealthGreen + " · " }
			<span data-testid="home-count-yellow">{ strconv.Itoa(v.Yellow) }</span>
			{ " " + domain.HealthYellow + " · " }
			<span data-testid="home-count-red">{ strconv.Itoa(v.Red) }</span>
			{ " " + domain.HealthRed + " · " }
			<a href="/goals?org=mine">Goals you own or help with →</a>
			if v.Delegated > 0 {
				{ " · " }
				<a data-testid="home-delegate-link" href="/delegates">
					Goals delegated to you
					<span class="num">{ strconv.Itoa(v.Delegated) }</span>
					{ " →" }
				</a>
			}
		</p>
	</div>
}

// homeOrgSection is the My org section, a plain section on the canvas: counts and
// people, never Goals. The total line is plain text, set apart from the pills
// and chips counting each person's Org, and each person's row, their initials,
// Name and counts, is one link to their Org on Goals; the section ends with
// links on to the whole Org's Goals and Follow-ups for the detail.
templ homeOrgSection(org homeOrg) {
	<section data-testid="home-org" class="hm-section">
		<h2>
			@homeHeading("My org", len(org.Flagged))
		</h2>
		if org.Total.Any() {
			<p data-testid="home-org-total">
				for i, b := range homeOrgBadges(org.Total) {
					if i > 0 {
						{ " · " }
					}
					<span data-testid="home-org-count" data-kind={ b.Kind }>{ b.Label }</span>
				}
			</p>
			<ul class="hm-list">
				for _, p := range org.Flagged {
					<li data-testid="home-org-person">
						<a data-testid="home-org-person-link" class="hm-org-row" href={ templ.SafeURL(fmt.Sprintf("/goals?org=%d", p.Person.ID)) }>
							<span class="avatar hm-avatar" aria-hidden="true">{ initials(p.Person) }</span>
							<span class="hm-org-name">
								@personPlain(p.Person)
							</span>
							if p.Person.Departed {
								<span data-testid="home-org-departed" class="badge lc">departed</span>
							}
							@homeOrgCounts(p.Counts)
						</a>
					</li>
				}
			</ul>
			if org.Clear > 0 {
				<p data-testid="home-org-clear" class="muted">{ othersAllClear(org.Clear) }</p>
			}
		} else {
			<p data-testid="home-org-all-clear" class="muted">Everyone in My org is all clear.</p>
		}
		<p>
			<a data-testid="home-org-goals-link" href={ templ.SafeURL(fmt.Sprintf("/goals?org=%d", org.ViewerID)) }>My org on Goals →</a>
			{ " · " }
			<a data-testid="home-org-follow-ups-link" href={ templ.SafeURL(fmt.Sprintf("/follow-ups?org=%d", org.ViewerID)) }>My org on Follow-ups →</a>
		</p>
	</section>
}

// homeHeading is a section heading's text: its name, then its count in muted
// text, with no count when it is zero.
templ homeHeading(name string, n int) {
	if n > 0 {
		{ name }
		<span class="hm-count">{ strconv.Itoa(n) }</span>
	} else {
		{ name }
	}
}

// homeOrgCounts badges each of a My org row's counts that has anything,
// labelled to read without colour, Red, then Path to Green overdue, Check-in
// overdue and Yellow, the Red and Yellow counts with their Health's shape.
templ homeOrgCounts(c domain.SignalCounts) {
	for _, b := range homeOrgBadges(c) {
		<span data-testid="home-org-count" data-kind={ b.Kind } class={ "badge", b.Class }>
			if b.Kind == "red" || b.Kind == "yellow" {
				<span class="dot"></span>
			}
			{ b.Label }
		</span>
	}
}

// dueRow is one Goal to check in on: its Health pill, edged in a dash when
// Check-in overdue, then its title, then a meta line of how long since its
// last Check-in and how often one is due, its Check-in overdue mark and, for a
// Delegate, whose Goal it is. When noChange says one would be recorded, the
// one-click No change sits beside the Check in link to the Goal's Check-in
// page at the row's right.
templ dueRow(g domain.PersonalGoal, noChange bool) {
	<li data-testid="home-due-goal">
		<div class="hm-what">
			if g.Health == "" {
				<span data-testid="home-due-health" class="badge lc">No Health yet</span>
			} else {
				@healthChipWith("home-due-health", g.Health, g.Health, homeAsOfClass(g))
			}
			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.Goal.ID)) }>{ g.Goal.Title }</a>
			<p data-testid="home-due-status" class="hm-meta">
				<span class="hm-phrase">{ homeDueAge(g) }</span>
				{ "·" }
				<span class="hm-phrase">{ homeDueCadence(g.Freshness) }</span>
				if g.Freshness.CheckinOverdue {
					<span data-testid="home-due-checkin-overdue" class="badge st">Check-in overdue</span>
				}
				if g.AsDelegate {
					<span data-testid="home-due-for" class="tag">
						{ "for " }
						@person(g.Goal.Owner)
					</span>
				}
			</p>
		</div>
		<div class="hm-actions">
			if noChange {
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/checkins/no-change", g.Goal.ID)) } class="inline-form">
					<button type="submit" class="btn sm">No change</button>
				</form>
			}
			<a data-testid="home-due-checkin" class="btn primary sm" href={ templ.SafeURL(fmt.Sprintf("/goals/%d/checkin", g.Goal.ID)) }>Check in</a>
		</div>
	</li>
}

// askRow is an open Ask for help addressed to the person: the Goal's Health,
// its title leading to the Comments to answer on, and the Owner who asked
// (CONTEXT.md: Ask for help).
templ askRow(a domain.AskForHelp) {
	<li data-testid="home-ask">
		<div class="hm-what">
			@healthChip("", a.Health)
			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d#comments", a.Goal.ID)) }>{ a.Goal.Title }</a>
			<p class="hm-meta">
				{ "from " }
				@person(a.Goal.Owner)
			</p>
		</div>
	</li>
}

// actionItemRow is an open Action Item the person owns: what it asks, leading
// to it on its Goal's page or its publication, flagged when overdue, with its
// Report, the Goal it is about, if any, and when it is due, and the Close that
// returns to Home.
templ actionItemRow(l domain.ActionItemListing) {
	<li data-testid="home-action-item">
		<div class="hm-what">
			<span class="badge lc">Action Item</span>
			<a href={ templ.SafeURL(homeActionItemPath(l.Item)) }>{ l.Item.Text }</a>
			if l.Overdue {
				<span data-testid="home-action-item-overdue" class="badge r">Overdue</span>
			}
			<span class="hm-meta">{ homeActionItemPlace(l) }</span>
		</div>
		<div class="hm-actions">
			@closeActionItemForm(l.Item, "/home")
		</div>
	</li>
}

// linkRequestRow is a link request waiting on the person as the parent's Owner.
templ linkRequestRow(l domain.Link) {
	<li data-testid="home-request">
		<div class="hm-what">
			<span class="badge lc">Link request</span>
			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", l.Child.ID)) }>{ l.Child.Title }</a>
			<span class="muted">
				{ "(" }
				@person(l.Child.Owner)) wants to contribute to
			</span>
			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", l.Parent.ID)) }>{ l.Parent.Title }</a>
		</div>
		<div class="hm-actions">
			@rejectAccept(fmt.Sprintf("/links/%d", l.ID))
		</div>
	</li>
}

// handoffRequestRow is a Handoff waiting on the person as the proposed new
// Owner. Accepting one whose Goal has Delegates means choosing which to keep,
// so in place of Accept it offers Review, leading to the Pending handoffs page
// where that choice is made.
templ handoffRequestRow(ho domain.Handoff) {
	<li data-testid="home-request">
		<div class="hm-what">
			<span class="badge lc">Handoff</span>
			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", ho.Goal.ID)) }>{ ho.Goal.Title }</a>
			<span class="muted">
				@person(ho.From)
				{ "wants to hand this Goal to you" }
			</span>
		</div>
		<div class="hm-actions">
			if len(ho.KeepableDelegates) > 0 {
				@rejectButton(fmt.Sprintf("/handoffs/%d", ho.ID))
				<a data-testid="home-request-review" class="btn sm" href="/handoffs">Review</a>
			} else {
				@rejectAccept(fmt.Sprintf("/handoffs/%d", ho.ID))
			}
		</div>
	</li>
}

// acceptReject is the pair of buttons deciding a pending request at base. Reject
// sends at once; the page then offers Undo in a toast.
templ acceptReject(base string) {
	<form method="post" action={ templ.SafeURL(base + "/accept") } class="inline-form">
		<button type="submit" class="btn primary sm">Accept</button>
	</form>
	<form method="post" action={ templ.SafeURL(base + "/reject") } class="inline-form">
		<button type="submit" class="btn danger sm">Reject</button>
	</form>
}

// rejectAccept is Home's pair of buttons deciding a pending request at base:
// Reject as a text button, then Accept outlined. Reject sends at once; Home
// then offers Undo in a toast.
templ rejectAccept(base string) {
	@rejectButton(base)
	<form method="post" action={ templ.SafeURL(base + "/accept") } class="inline-form">
		<button type="submit" class="btn sm">Accept</button>
	</form>
}

// rejectButton rejects the pending request at base at once, returning to Home.
templ rejectButton(base string) {
	<form method="post" action={ templ.SafeURL(base + "/reject") } class="inline-form">
		<input type="hidden" name="from" value={ fromHome }/>
		<button type="submit" class="btn quiet sm">Reject</button>
	</form>
}

// healthBar draws the person's Active Goals by Health as one segmented bar, a
// unit for each Goal, Green then Yellow then Red. It counts Goals, not Metrics
// (ADR 0003). The counts beside it on the Your goals line label each segment
// so the bar reads without colour, and its label says the same to assistive
// technology.
templ healthBar(v homeView) {
	<div data-testid="home-health-bar" class="hm-bar" role="img" aria-label={ healthBarLabel(v) }>
		for range v.Green {
			<span class="g"></span>
		}
		for range v.Yellow {
			<span class="y"></span>
		}
		for range v.Red {
			<span class="r"></span>
		}
	</div>
}

// homeStyles are Home's own rules on top of app.css (DESIGN.md § Home).
// The page title stacks Your week over the date and the Your goals line. Each
// section stacks its h2, 13px at 600 with its count muted, over hairline-ruled
// rows at least 44px tall. A row puts what it's about on the left, led by a
// Health pill or a chip, the title, then a muted meta line, and its 30px
// actions on the right, wrapping underneath when the column is narrow.
templ homeStyles() {
	<style>
		.hm-head{display:flex;flex-direction:column;gap:8px;min-width:0}
		.hm-date{color:var(--color-ink-muted);font-size:var(--text-secondary)}
		.hm-summary{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;color:var(--color-ink-muted);font-size:var(--text-secondary)}
		.hm-col{display:flex;flex-direction:column;gap:32px;min-width:0}
		.hm-section{display:flex;flex-direction:column;gap:8px;min-width:0}
		.hm-section>h2{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px;font-size:var(--text-h2);line-height:1.4;font-weight:600;letter-spacing:normal}
		.hm-count{color:var(--color-ink-muted);font-weight:500;font-variant-numeric:tabular-nums}
		.hm-group{display:flex;flex-direction:column;gap:4px;margin-top:8px}
		.hm-group-head{font-size:var(--text-label);line-height:1.4;font-weight:500;color:var(--color-ink-muted);letter-spacing:normal;text-transform:none}
		.hm-list{list-style:none;margin:0;padding:0}
		.hm-list:empty{display:none}
		.hm-list>li{display:flex;flex-wrap:wrap;align-items:center;gap:4px 16px;min-height:44px;padding:4px 0;border-top:1px solid var(--color-border);box-sizing:border-box}
		.hm-list>li:last-child{border-bottom:1px solid var(--color-border)}
		.hm-what{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;flex:1 1 240px;min-width:0}
		.hm-what>a{font-size:var(--text-body);font-weight:500}
		.hm-what>p:not(.hm-meta){flex-basis:100%}
		.hm-meta{display:inline-flex;flex-wrap:wrap;align-items:center;gap:4px 8px;color:var(--color-ink-muted);font-size:var(--text-secondary)}
		.hm-phrase{white-space:nowrap}
		.hm-list .badge,.hm-list .tag{height:22px;padding:0 8px;gap:4px;border-radius:var(--radius-full);font-size:var(--text-label);font-weight:500;line-height:20px;box-sizing:border-box}
		.hm-list .badge.lc,.hm-list .tag{background:var(--color-chip-bg);color:var(--color-chip-ink);border:1px solid transparent}
		.hm-list .badge.as-of{border:1px dashed currentColor}
		.hm-list>li:has(>.hm-org-row){padding:0}
		.hm-org-row{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;flex:1 1 auto;min-width:0;min-height:44px;padding:4px 0;box-sizing:border-box;color:var(--color-ink)}
		.hm-org-row:hover{text-decoration:none;background:var(--color-row-hover)}
		.hm-org-name{font-size:var(--text-body);font-weight:500}
		.hm-org-row:hover .hm-org-name{text-decoration:underline}
		.hm-avatar{width:22px;height:22px;flex:none;font-size:10px}
		.hm-actions{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-left:auto}
		.hm-actions form{margin:0}
		.hm-actions .btn{height:30px;padding:0 12px;font-size:var(--text-secondary)}
		.hm-btn{height:30px;padding:0 12px;font-size:var(--text-secondary)}
		.rp-inline-form{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end}
		.rp-inline-form label{display:flex;flex-direction:column;gap:4px;font-size:var(--text-secondary);font-weight:600}
		.hm-bar{display:flex;flex:none;width:96px;height:8px;border-radius:var(--radius-full);overflow:hidden}
		.hm-bar>span{flex:1 1 0;min-width:2px}
		.hm-bar>.g{background:var(--health-g-mark)}
		.hm-bar>.y{background:var(--health-y-mark)}
		.hm-bar>.r{background:var(--health-r-mark)}
		.hm-bar>.g+.y,.hm-bar>.g+.r,.hm-bar>.y+.r{margin-left:4px}
	</style>
}
