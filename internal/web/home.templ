package web

import (
	"fmt"
	"strconv"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// homePage is the signed-in person's week: the Goals to check in on, and what
// else is waiting on them.
templ homePage(current *domain.Account, v homeView) {
	@layout("Home", current) {
		<header data-testid="home-head" class="page-head">
			<div>
				<h1>Your week</h1>
				<p data-testid="home-summary" class="muted">{ thingsNeedYou(v.NeedsYou()) }</p>
			</div>
			<a class="btn primary" href="/goals">New goal</a>
		</header>
		<div class="grid-main-aside">
			<div>
				<section data-testid="home-checkins" class="card">
					<h2>Check in on these</h2>
					if len(v.Due) == 0 {
						<p data-testid="home-due-empty" class="muted">You're all caught up.</p>
					}
					<ul data-testid="home-due">
						for _, g := range v.Due {
							@dueRow(g)
						}
					</ul>
				</section>
				<section data-testid="home-waiting-on-you" class="card">
					<h2>Waiting on you</h2>
					if len(v.PendingLinks) == 0 && len(v.PendingHandoffs) == 0 {
						<p data-testid="home-waiting-empty" class="muted">Nothing is waiting on you.</p>
					}
					<ul data-testid="home-waiting">
						for _, l := range v.PendingLinks {
							<li data-testid="home-pending-link">
								<span class="badge lc">Link request</span>
								<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", l.Child.ID)) }>{ l.Child.Title }</a>
								<span class="muted">
									{ "(" }
									@person(l.Child.Owner)
									{ ") wants to contribute to" }
								</span>
								<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", l.Parent.ID)) }>{ l.Parent.Title }</a>
								@acceptReject(fmt.Sprintf("/links/%d", l.ID), "Reject this link request?")
							</li>
						}
						for _, ho := range v.PendingHandoffs {
							<li data-testid="home-pending-handoff">
								<span class="badge lc">Handoff</span>
								<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", ho.Goal.ID)) }>{ ho.Goal.Title }</a>
								<span class="muted">
									@person(ho.From)
									{ " wants to hand this Goal to you" }
								</span>
								@handoffAcceptReject(ho)
							</li>
						}
					</ul>
				</section>
			</div>
			<aside>
				<section data-testid="home-your-goals" class="card">
					<h2>Your goals</h2>
					<p>
						@healthCountTile("home-count-green", domain.HealthGreen, v.Green)
						@healthCountTile("home-count-yellow", domain.HealthYellow, v.Yellow)
						@healthCountTile("home-count-red", domain.HealthRed, v.Red)
					</p>
					if len(v.AtRisk) > 0 {
						<ul>
							for _, g := range v.AtRisk {
								<li>
									<span class={ "badge", healthClass(g.Health) }><span class="dot"></span>{ g.Health }</span>
									<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.Goal.ID)) }>{ g.Goal.Title }</a>
								</li>
							}
						</ul>
					}
					<a href="/goals">All your goals →</a>
				</section>
				if len(v.Delegated) > 0 {
					<section data-testid="home-delegated" class="card">
						<h2>Delegated to you</h2>
						<ul>
							for _, g := range v.Delegated {
								<li>
									<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a>
									<span class="muted small">@person(g.Owner)</span>
								</li>
							}
						</ul>
						<a href="/delegates">Check in as a Delegate →</a>
					</section>
				}
			</aside>
		</div>
	}
}

// dueRow is one Goal to check in on: its Health, why it's listed, and the
// one-click No change beside the Check in link to the Goal page.
templ dueRow(g domain.PersonalGoal) {
	<li data-testid="home-due-goal">
		<span data-testid="home-due-health" class={ "badge", healthClass(g.Health) }>
			<span class="dot"></span>
			if g.Health == "" {
				No Health yet
			} else {
				{ g.Health }
			}
		</span>
		<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.Goal.ID)) }>{ g.Goal.Title }</a>
		if g.Freshness.Stale {
			<span data-testid="home-due-stale" class="badge st">Stale</span>
		}
		<p class="muted small">
			if g.AsDelegate {
				{ "Delegated to you by " }
				@person(g.Goal.Owner)
			} else {
				{ dueReason(g) }
			}
		</p>
		if g.CheckedIn {
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/checkins/no-change", g.Goal.ID)) } style="display:inline">
				<button type="submit" class="btn sm">No change</button>
			</form>
		}
		<a data-testid="home-due-checkin" class="btn primary sm" href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.Goal.ID)) }>Check in</a>
	</li>
}

// acceptReject is the pair of buttons deciding a pending request at base, the
// Reject asking for confirmation first.
templ acceptReject(base, confirmReject string) {
	<form method="post" action={ templ.SafeURL(base + "/accept") } style="display:inline">
		<button type="submit" class="btn primary sm">Accept</button>
	</form>
	<form method="post" action={ templ.SafeURL(base + "/reject") } style="display:inline" onsubmit={ confirmScript(confirmReject) }>
		<button type="submit" class="btn danger sm">Reject</button>
	</form>
}

// healthCountTile counts the person's Active Goals at one Health.
templ healthCountTile(testID, health string, count int) {
	<span class={ "badge", healthClass(health) }>
		<span class="dot"></span>
		{ health }
		<span data-testid={ testID } class="num">{ strconv.Itoa(count) }</span>
	</span>
}
