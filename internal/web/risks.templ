package web

import (
	"fmt"
	"strconv"
	"time"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// risksPage answers "which Goals are in trouble, and how badly?": how many
// Goals need attention, a card per group of signals by who acts, then one
// table row per flagged Goal, worst first, narrowed to one group when the
// address asks for it, and at the bottom what each signal means. The header's
// form and the Everyone | Mine | Chain toggle scope it all to some Goals; #risks-body
// is what a change of scope swaps. With no Goal left to show, #risks-body says
// so in one line in place of the count, the cards and the table.
templ risksPage(current *domain.Account, v risksPageView) {
	@layout("Risks", current) {
		@risksStyles()
		<header class="page-head">
			<h1>Risks</h1>
			if len(v.Dimensions) > 0 || v.Chain.Offered() {
				@risksFilters(v)
			}
		</header>
		<div id="risks-body" class="rk-body">
			if shown := v.Shown(); len(shown) == 0 {
				<div class="rk-head">
					<p data-testid="risks-empty" class="muted">
						{ v.Empty() }
						if v.Filtered() {
							<a href="/risks">Show everything</a>
						}
					</p>
					@risksScope(v)
				</div>
			} else {
				<div class="rk-head">
					<p data-testid="risks-attention" class="muted"><strong>{ strconv.Itoa(len(v.Rows)) }</strong> { v.attention() }</p>
					@risksScope(v)
				</div>
				<nav data-testid="risks-groups" class="rk-cards" aria-label="Risks by who acts">
					for _, c := range v.Cards() {
						@riskCardView(c)
					}
				</nav>
				if v.Group != "" {
					<p><a data-testid="risks-show-all" href={ v.ShowAllURL() }>Show all</a></p>
				}
				@risksTable(current, v.Today, v.Here(), shown)
			}
		</div>
		@risksDefinitions()
	}
}

// risksDefinitions says what each of the Risks page's signals means, folded
// away at the page's bottom.
templ risksDefinitions() {
	<details data-testid="risks-definitions" class="card rk-defs">
		<summary>What each risk means</summary>
		<dl>
			for _, d := range riskDefinitions {
				<dt>{ d.Name }</dt>
				<dd>{ d.Means }</dd>
			}
		</dl>
	</details>
}

// risksScope is the page's Everyone | Mine toggle, with My Chain for a viewer
// with anyone under them, and, scoped to anyone else's Chain, that Chain by
// whose it is, as the current choice.
templ risksScope(v risksPageView) {
	<nav class="rk-scope" aria-label="Scope">
		<a data-testid="risks-scope-everyone" class="btn quiet sm" href={ v.ScopeURL(riskPageScope{}) } { v.ScopeAttrs(riskPageScope{})... }>Everyone</a>
		<a data-testid="risks-scope-mine" class="btn quiet sm" href={ v.ScopeURL(riskPageScope{Mine: true}) } { v.ScopeAttrs(riskPageScope{Mine: true})... }>Mine</a>
		if v.Chain.OffersMine {
			<a data-testid="risks-scope-my-chain" class="btn quiet sm" href={ v.ScopeURL(v.MyChain()) } { v.ScopeAttrs(v.MyChain())... }>My Chain</a>
		}
		if v.Chain.Of != nil && (v.Chain.Of.ID != v.Chain.Viewer.ID || !v.Chain.OffersMine) {
			<a data-testid="risks-scope-chain" class="btn quiet sm" href={ v.ScopeURL(v.scope()) } aria-current="page">{ v.Chain.Name() }</a>
		}
	</nav>
}

// risksFilters scopes the Risks page to the Goals with a Dimension value, and
// to a Chain when anyone has a Manager, submitted as a GET so the scope lives
// in the address, carrying the page's group and Mine along; a Chain chosen
// takes over from Mine. Under htmx it applies itself on a change, as the Goal
// list's filter bar does, swapping in only #risks-body so the form keeps its
// focus, and pushes the address; hx-history="false" makes Back load the
// earlier address afresh rather than a snapshot whose select would come back
// unchosen. Mine is a link outside the form, inside #risks-body, so a swap
// keeps its address in step with the chosen value.
templ risksFilters(v risksPageView) {
	<form
		method="get"
		action="/risks"
		data-testid="risks-filters"
		class="rk-filters"
		hx-get="/risks"
		hx-trigger="submit, change"
		hx-target="#risks-body"
		hx-select="#risks-body"
		hx-swap="outerHTML"
		hx-push-url="true"
		hx-sync="this:replace"
		hx-history="false"
	>
		if v.Group != "" {
			<input type="hidden" name="group" value={ v.Group }/>
		}
		if v.Mine {
			<input type="hidden" name="mine" value="1"/>
		}
		if v.Chain.Offered() {
			@pageChainSelect("risks-chain", v.Chain)
		}
		if len(v.Dimensions) > 0 {
			<select data-testid="risks-value" name="value" aria-label="Dimension value">
				<option value="" selected?={ v.Value.ID == 0 }>Any value</option>
				for _, d := range v.Dimensions {
					<optgroup label={ d.Name }>
						for _, dv := range d.Values {
							<option value={ strconv.FormatInt(dv.ID, 10) } selected?={ v.Value.ID == dv.ID }>{ riskValueLabel(dv) }</option>
						}
					</optgroup>
				}
			</select>
		}
		<noscript><button type="submit" class="btn">Apply</button></noscript>
	</form>
}

// riskCardView is one group's summary card: its name, how many Goals it
// holds, and a chip per signal that flags one, linking to the page filtered to
// the group. A group holding none is a muted card saying so, linking nowhere.
templ riskCardView(c riskCard) {
	if c.Count == 0 {
		<div data-testid={ "risks-group-" + c.Key } class="card rk-card rk-zero">
			<span class="label">{ c.Name }</span>
			<span>{ c.Blank }</span>
		</div>
	} else {
		@riskCardLink(c)
	}
}

// riskCardLink is a group's card when it holds Goals.
templ riskCardLink(c riskCard) {
	<a data-testid={ "risks-group-" + c.Key } href={ c.Href } class="card rk-card" { c.Attrs()... }>
		<span class="label">{ c.Name }</span>
		<span class="num">{ strconv.Itoa(c.Count) }</span>
		<span class="rk-chips">
			for _, sig := range c.Signals {
				<span data-testid="risk-signal" data-kind={ sig.Anchor } class={ riskChipClass(sig.Anchor) }>{ sig.Name + " · " + strconv.Itoa(sig.Count) }</span>
			}
		</span>
	</a>
}

// risksTable is the flagged Goals, one row each, worst first. A Fix that
// posts returns to here, the page's address.
templ risksTable(current *domain.Account, today time.Time, here string, rows []riskGoalRow) {
	<div class="card">
		<table id="risks-table" class="rk-table" data-testid="risks-table">
			<thead>
				<tr><th>Health</th><th>Goal</th><th>Owner</th><th aria-label="Fix"></th></tr>
			</thead>
			<tbody>
				for _, r := range rows {
					@riskRow(current, today, here, r)
				}
			</tbody>
		</table>
	</div>
}

// riskRow is one flagged Goal: its Health, its title with a chip per signal
// that flags it, its Owner ("You" for the viewer's own), and a cell for its
// fix: a link, a form posting back to here, or a disabled button saying why
// it can't be used.
templ riskRow(current *domain.Account, today time.Time, here string, r riskGoalRow) {
	<tr data-testid="risk-row">
		<td class="rk-health">
			@healthBadge("risk-health", r.Health)
		</td>
		<td data-testid="risk-goal" class="rk-goal">
			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", r.Goal.ID)) }>{ r.Goal.Title }</a>
			<span class="rk-chips">
				for _, sig := range r.Signals {
					@riskChip(today, r.Goal, sig)
				}
			</span>
		</td>
		<td data-testid="risk-owner" class="rk-owner">
			if r.Goal.Owner.ID == current.ID {
				You
			} else {
				@person(r.Goal.Owner)
			}
		</td>
		<td data-testid="risk-fix" class="rk-fix">
			if r.Fix.Disabled {
				<button type="button" class="btn sm" disabled>{ r.Fix.Label }</button>
			} else if r.Fix.Post {
				<form data-testid="nudge" method="post" action={ templ.SafeURL(r.Fix.Href) } class="inline-form">
					<input type="hidden" name="return" value={ here }/>
					<button type="submit" class="btn sm">{ r.Fix.Label }</button>
				</form>
			} else if r.Fix.Primary {
				<a class="btn primary sm" href={ templ.SafeURL(r.Fix.Href) }>{ r.Fix.Label }</a>
			} else {
				<a class="btn sm" href={ templ.SafeURL(r.Fix.Href) }>{ r.Fix.Label }</a>
			}
		</td>
	</tr>
}

// riskChip says why a signal flags g.
templ riskChip(today time.Time, g domain.Goal, sig riskSignal) {
	switch sig.Kind {
		case "stale":
			<span data-testid="risk-signal" data-kind="stale" class="badge st">{ fmt.Sprintf("Stale · %dd on %dd", sig.Days, g.CadenceDays) }</span>
		case "path-overdue":
			<span data-testid="risk-signal" data-kind="path-overdue" class="badge st">{ fmt.Sprintf("Path to Green %dd overdue", sig.Days) }</span>
		case "ownerless":
			<span data-testid="risk-signal" data-kind="ownerless" class="badge ol">Ownerless</span>
		case "unaligned":
			<span data-testid="risk-signal" data-kind="unaligned" class="rk-tag">Unaligned · no parent Goal, not Top-level</span>
		case "schedule-conflicts":
			<span data-testid="risk-signal" data-kind="schedule-conflicts" class="rk-tag">
				{ fmt.Sprintf("Schedule conflict · due %s, %s after its parent ", riskDate(g.DeliveryDate, today), riskDays(sig.Days)) }@goalRef(*sig.Related)
			</span>
		case "halted-parents":
			<span data-testid="risk-signal" data-kind="halted-parents" class="rk-tag">
				{ "Parent " + sig.Related.Lifecycle + " · " }@goalRef(*sig.Related)
			</span>
	}
}

// risksStyles are the Risks page's own rules on top of app.css: the scope
// controls, the toggle styled as the Goal list's layout toggle, the summary
// cards, the chips under each Goal in the table, the outlined neutral chip
// the structural signals take: a .tag with the badges' small radius, and the
// definitions' disclosure. The Health chips' print-only shapes stay hidden, as
// on the report pages, and an Owner's name keeps to one line. Below 600px each
// table row stacks as a card, as the Reports list's do: the Goal cell, ordered
// first though it comes second in the HTML, then Health and Owner on one line,
// then the Fix.
templ risksStyles() {
	<style>
		.shape{display:none}
		.rk-body{display:flex;flex-direction:column;gap:inherit}
		.rk-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap}
		.rk-head p{margin:0}
		.rk-filters{display:flex;align-items:center;gap:8px}
		.rk-scope{display:inline-flex;gap:4px}
		.rk-scope a[aria-current=page]{background:var(--color-primary-subtle);color:var(--color-ink)}
		.rk-cards{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
		.rk-card{padding:16px;display:flex;flex-direction:column;gap:8px}
		.rk-card .num{font-size:24px}
		.rk-chips{display:flex;flex-wrap:wrap;gap:8px}
		.rk-zero{border:1px dashed var(--color-border-strong);color:var(--color-ink-muted)}
		td .rk-chips{margin-top:4px}
		.rk-table .rk-owner{white-space:nowrap}
		.rk-defs{padding:12px 16px}
		.rk-defs summary{cursor:pointer;font-weight:600}
		.rk-defs dl{margin:8px 0 0;display:grid;grid-template-columns:max-content 1fr;gap:4px 16px}
		.rk-defs dt{font-weight:600}
		.rk-defs dd{margin:0}
		.rk-tag{display:inline-flex;align-items:center;flex-wrap:wrap;gap:4px;padding:0 8px;border-radius:var(--radius-sm);color:var(--color-ink);font-size:13px;line-height:20px;border:1px solid var(--color-border-strong)}
		@media (max-width:900px){.rk-cards{grid-template-columns:minmax(0,1fr)}}
		@media (max-width:600px){.rk-table thead{display:none}.rk-table tr{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:4px 12px;padding:12px 16px;border-bottom:1px solid var(--color-border)}.rk-table tbody tr:last-child{border-bottom:none}.rk-table td{display:block;padding:0;border-bottom:none}.rk-table .rk-goal{order:-1;grid-column:1/-1}.rk-table .rk-owner{white-space:normal}.rk-table .rk-fix{grid-column:1/-1;margin-top:4px}}
	</style>
}
