package web

import (
	"fmt"
	"strconv"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// risksPage answers "what's going wrong?": a tile counting each problem type,
// then a section per type listing the Goals it flags, their Owners, and why.
templ risksPage(current *domain.Account, v risksView) {
	@layout("Risks", current) {
		@risksStyles()
		<header class="page-head">
			<div>
				<h1>Risks</h1>
				<p class="muted">What's going wrong: the Goals the signals flag that nobody reported.</p>
			</div>
		</header>
		<nav data-testid="risks-summary" class="rk-tiles" aria-label="Risks by type">
			for _, rt := range v.Types() {
				@riskTile(rt.Anchor, rt.Name, rt.Count)
			}
		</nav>
		@riskSection("stale", "Stale", "Active Goals whose last Check-in, or activation if they have none, is older than their cadence.", len(v.Stale)) {
			for _, gf := range v.Stale {
				@riskRow(gf.Goal) {
					{ staleSince(gf.Freshness) }
				}
			}
		}
		@riskSection("path-overdue", "Path to Green overdue", "Active Goals past their Path to Green's target date that still aren't Green.", len(v.OverduePaths)) {
			for _, gf := range v.OverduePaths {
				@riskRow(gf.Goal) {
					{ pathOverdue(gf.Freshness) }
				}
			}
		}
		@riskSection("ownerless", "Ownerless", "Active Goals whose Owner has left the org and hasn't been replaced.", len(v.Ownerless)) {
			for _, g := range v.Ownerless {
				@riskRow(g) {
					<span class="badge ol">Ownerless</span> its Owner has left the org and hasn't been replaced
				}
			}
		}
		@riskSection("unaligned", "Unaligned", "Active Goals that contribute to no other Goal and aren't Top-level.", len(v.Unaligned)) {
			for _, g := range v.Unaligned {
				@riskRow(g) {
					contributes to no other Goal and isn't Top-level
				}
			}
		}
		@riskSection("schedule-conflicts", "Schedule conflicts", "Goals due later than a Goal they contribute to.", len(v.ScheduleConflicts)) {
			for _, c := range v.ScheduleConflicts {
				@riskRow(c.Child) {
					due { fmtDate(c.Child.DeliveryDate) }, later than
					@goalRef(c.Parent)
					(due { fmtDate(c.Parent.DeliveryDate) }), which it contributes to
				}
			}
		}
		@riskSection("halted-parents", "Parent On Hold or Cancelled", "Goals contributing to a Goal that is On Hold or Cancelled.", len(v.HaltedParents)) {
			for _, hp := range v.HaltedParents {
				@riskRow(hp.Child) {
					contributes to
					@goalRef(hp.Parent)
					, which is <span class="badge lc">{ hp.Parent.Lifecycle }</span>
				}
			}
		}
		if empty := v.Empty(); len(empty) == len(v.Types()) {
			<p data-testid="risks-all-clear" class="muted">
				All clear: nothing in
				@riskNames(empty)
				.
			</p>
		} else if len(empty) > 0 {
			<p data-testid="risks-nothing-in" class="muted">
				Nothing in:
				@riskNames(empty)
			</p>
		}
	}
}

// riskNames lists the empty problem types by name, each carrying its section's
// anchor so a link to an empty section lands on its name.
templ riskNames(types []riskType) {
	for i, rt := range types {
		if i > 0 {
			{ ", " }
		}
		<span id={ rt.Anchor } class="rk-empty">{ rt.Name }</span>
	}
}

// riskTile counts one problem type and links down to its section.
templ riskTile(anchor, label string, count int) {
	<a data-testid={ "risks-tile-" + anchor } href={ templ.SafeURL("#" + anchor) } class="card rk-tile">
		<span class="label">{ label }</span>
		<span class="num">{ strconv.Itoa(count) }</span>
	</a>
}

// riskSection is one problem type: its heading, a line explaining it, and a
// table of the flagged Goals (its children, one riskRow each). A type with no
// Goals renders nothing here; the page names it in its "Nothing in" line.
templ riskSection(anchor, heading, explain string, count int) {
	if count > 0 {
		<section data-testid={ "risks-" + anchor } id={ anchor } class="rk-section">
			<div>
				<h2>{ heading }</h2>
				<p class="muted">{ explain }</p>
			</div>
			<div class="card">
				<table>
					<thead>
						<tr><th>Goal</th><th>Owner</th><th>Why it's flagged</th></tr>
					</thead>
					<tbody>
						{ children... }
					</tbody>
				</table>
			</div>
		</section>
	}
}

// riskRow is one flagged Goal: its title, its Owner, and why (its children).
templ riskRow(g domain.Goal) {
	<tr data-testid="risk-row">
		<td><a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a></td>
		<td>
			@person(g.Owner)
		</td>
		<td>
			{ children... }
		</td>
	</tr>
}

// risksStyles are the Risks page's own rules on top of app.css: the summary
// tiles and the section layout.
templ risksStyles() {
	<style>
		.rk-tiles{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:12px}
		.rk-tile{padding:16px;display:flex;flex-direction:column;gap:4px}
		.rk-tile:hover{border-color:var(--color-primary)}
		.rk-tile .num{font-size:24px}
		.rk-section,.rk-empty{scroll-margin-top:16px}
		.rk-empty{color:var(--color-ink);font-weight:500}
		.rk-section{display:flex;flex-direction:column;gap:12px}
		@media (max-width:900px){.rk-tiles{grid-template-columns:repeat(2,minmax(0,1fr))}}
	</style>
}
