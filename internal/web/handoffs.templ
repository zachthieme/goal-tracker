package web

import (
	"fmt"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// pendingHandoffsPage lists the Handoffs awaiting the current Account's decision
// as the proposed new Owner, a row each with accept and reject actions; Accept
// lists the Delegates to keep and Reject sends at once. A Handoff takes
// effect only once accepted (CONTEXT.md: Handoff). toast, when set, offers Undo
// for the Handoff just rejected. It sits in the flat frame: its title in the
// page header, and the Handoffs a plain section of hairline rows (DESIGN.md §
// Components: Sections).
//
//nolint:contextcheck // templ hands its closures Render's ctx in a struct field, which contextcheck can't follow
templ pendingHandoffsPage(current *domain.Account, pending []domain.Handoff, toast *toast) {
	@framedLayout("Pending handoffs", current, pageHeader(pageHead{Title: "Pending handoffs"})) {
		@pendingStyles()
		<section class="pd-section">
			<div>
				<h2>Handoffs to you</h2>
				<p class="muted">Goals someone wants to hand to you. Nothing changes hands until you accept.</p>
			</div>
			<ul data-testid="pending-handoffs" class="pd-list">
				if len(pending) == 0 {
					<li data-testid="no-pending-handoffs" class="pd-row muted">No pending handoffs.</li>
				}
				for _, ho := range pending {
					<li data-testid="pending-handoff" class="pd-row">
						<p class="pd-what">
							<span>
								<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", ho.Goal.ID)) }>{ ho.Goal.Title }</a>
								<span class="muted">
									{ "— " }
									@person(ho.From)
									{ "wants to hand this Goal to you" }
								</span>
							</span>
						</p>
						<div class="pd-actions">
							@handoffAcceptReject(ho)
						</div>
					</li>
				}
			</ul>
		</section>
		@toastNotice(toast)
	}
}

// handoffAcceptReject is a pending Handoff's Accept and Reject. The accept form
// lists the Goal's Delegates who aren't Departed, each with a keep box checked by
// default, so the new Owner chooses which to keep (CONTEXT.md: Delegate); it is a
// plain form POST. Reject sends at once and leaves the Delegates alone.
templ handoffAcceptReject(ho domain.Handoff) {
	@handoffStyles()
	<form method="post" action={ templ.SafeURL(fmt.Sprintf("/handoffs/%d/accept", ho.ID)) } class="inline-form">
		if len(ho.KeepableDelegates) > 0 {
			<fieldset data-testid="handoff-keep-delegates" class="handoff-keep">
				<legend class="muted small">Delegates to keep</legend>
				for _, d := range ho.KeepableDelegates {
					<label>
						<input type="checkbox" name="keep" value={ fmt.Sprint(d.ID) } checked/>
						{ " " }
						@personPlain(d)
					</label>
				}
			</fieldset>
		}
		<button type="submit" class="btn primary sm">Accept</button>
	</form>
	<form method="post" action={ templ.SafeURL(fmt.Sprintf("/handoffs/%d/reject", ho.ID)) } class="inline-form">
		<button type="submit" class="btn danger sm">Reject</button>
	</form>
}

// handoffStylesOnce renders the Handoff decision's styles once per page, however
// many pending Handoffs the page lists (Home and Pending handoffs both carry it).
var handoffStylesOnce = templ.NewOnceHandle()

// handoffStyles stacks the accept form's keep-Delegates boxes above its button.
templ handoffStyles() {
	@handoffStylesOnce.Once() {
		<style>
			.handoff-keep{border:0;padding:0;margin:0 0 8px;display:flex;flex-direction:column;gap:4px}
		</style>
	}
}

// handoffRefusedPage says, inside the normal page, that a Handoff decision was
// refused (refused, e.g. "Can't accept Handoff") and why, with a link back to
// the page the decision was on.
//
//nolint:contextcheck // templ hands its closures Render's ctx in a struct field, which contextcheck can't follow
templ handoffRefusedPage(current *domain.Account, refused, reason, back string) {
	@layout(refused, current) {
		<div class="message-page">
			<h1>{ refused }</h1>
			<p data-testid="handoff-refused">{ reason }</p>
			<p><a href={ templ.SafeURL(back) }>Back</a></p>
		</div>
	}
}
