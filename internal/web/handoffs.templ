package web

import (
	"fmt"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// pendingHandoffsPage lists the Handoffs awaiting the current Account's decision
// as the proposed new Owner, a card each with accept and reject actions; Accept
// lists the Delegates to keep and Reject asks for confirmation. A Handoff takes
// effect only once accepted (CONTEXT.md: Handoff).
templ pendingHandoffsPage(current *domain.Account, pending []domain.Handoff) {
	@layout("Pending handoffs", current) {
		@pendingStyles()
		<header class="page-head">
			<div>
				<h1>Pending handoffs</h1>
				<p class="muted">Goals someone wants to hand to you. Nothing changes hands until you accept.</p>
			</div>
		</header>
		<ul data-testid="pending-handoffs" class="pd-list">
			if len(pending) == 0 {
				<li data-testid="no-pending-handoffs" class="card pd-row muted">No pending handoffs.</li>
			}
			for _, ho := range pending {
				<li data-testid="pending-handoff" class="card pd-row">
					<p class="pd-what">
						<span>
							<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", ho.Goal.ID)) }>{ ho.Goal.Title }</a>
							<span class="muted">
								{ "— " }
								@person(ho.From)
								{ " wants to hand this Goal to you" }
							</span>
						</span>
					</p>
					<div class="pd-actions">
						@handoffAcceptReject(ho)
					</div>
				</li>
			}
		</ul>
	}
}

// handoffAcceptReject is a pending Handoff's Accept and Reject. The accept form
// lists the Goal's Delegates who aren't Departed, each with a keep box checked by
// default, so the new Owner chooses which to keep (CONTEXT.md: Delegate); it is a
// plain form POST. Reject asks for confirmation and leaves the Delegates alone.
templ handoffAcceptReject(ho domain.Handoff) {
	<form method="post" action={ templ.SafeURL(fmt.Sprintf("/handoffs/%d/accept", ho.ID)) } style="display:inline">
		if len(ho.KeepableDelegates) > 0 {
			<fieldset data-testid="handoff-keep-delegates" style="border:0;padding:0;margin:0 0 8px;display:flex;flex-direction:column;gap:4px">
				<legend class="muted small">Delegates to keep</legend>
				for _, d := range ho.KeepableDelegates {
					<label>
						<input type="checkbox" name="keep" value={ fmt.Sprint(d.ID) } checked/>
						{ " " }
						@person(d)
					</label>
				}
			</fieldset>
		}
		<button type="submit" class="btn primary sm">Accept</button>
	</form>
	<form method="post" action={ templ.SafeURL(fmt.Sprintf("/handoffs/%d/reject", ho.ID)) } style="display:inline" onsubmit={ confirmScript("Reject this Handoff?") }>
		<button type="submit" class="btn danger sm">Reject</button>
	</form>
}
