package web

import (
	"fmt"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// reportActionItems lists a Report's open Action Items at its top, soonest due
// first, each with its owner and due date (CONTEXT.md: Action Item). A
// publication lists them as they stood when it was published, marking any
// closed since; an owner reading it while the item is still open gets the
// form to close it.
templ reportActionItems(items []domain.ActionItem, d discussion) {
	if len(items) > 0 {
		<section data-testid="report-action-items">
			<h2>Open Action Items</h2>
			<ul class="card rp-list">
				for _, item := range items {
					<li data-testid="open-action-item">
						@actionItemSummary(item)
						if d.closedSince(item) {
							{ " " }<strong data-testid="action-item-closed-since">[Closed since]</strong>
						}
						if d.canClose(item) {
							@closeActionItemForm(item, d)
						}
					</li>
				}
			</ul>
		</section>
	}
}

// goalDiscussion is the discussion under one Goal's block in a published
// Report, a footer row: the comment count opens its threads, each with a reply
// form behind a Reply toggle, and a Comment button opens the form to start a
// new one. Everything is collapsed until the reader opens it, without JS. The
// Report's author may turn any comment into an Action Item.
templ goalDiscussion(goalID int64, d discussion) {
	if d.Pub != nil {
		<footer data-testid="goal-discussion" class="rp-discussion">
			if n := commentCount(d.Threads[goalID]); n > 0 {
				<details>
					<summary data-testid="comment-count">{ plural(n, "comment") }</summary>
					for _, t := range d.Threads[goalID] {
						<div data-testid="comment-thread" class="rp-thread">
							@comment(t.Comment, d, false)
							for _, reply := range t.Replies {
								@comment(reply, d, true)
							}
							<details data-testid="reply-toggle">
								<summary class="small">Reply</summary>
								<form data-testid="reply-form" class="rp-inline-form" method="post" action={ templ.SafeURL(fmt.Sprintf("/comments/%d/replies", t.Comment.ID)) }>
									<label>
										Reply
										<input type="text" name="body" required/>
									</label>
									<button type="submit" class="btn sm">Reply</button>
								</form>
							</details>
						</div>
					}
				</details>
			} else {
				<span data-testid="comment-count" class="small muted">No comments</span>
			}
			<details data-testid="comment-toggle">
				<summary class="btn sm">Comment</summary>
				<form data-testid="comment-form" class="rp-inline-form" method="post" action={ templ.SafeURL(publicationPath(*d.Pub) + "/comments") }>
					<input type="hidden" name="goal" value={ fmt.Sprintf("%d", goalID) }/>
					<label>
						Comment
						<input type="text" name="body" required/>
					</label>
					<button type="submit" class="btn primary sm">Comment</button>
				</form>
			</details>
		</footer>
	}
}

// comment is one comment in a thread — who wrote it, when, and what it says —
// indented when it is a reply. The Report's author gets the form to turn it
// into an Action Item, behind its own toggle.
templ comment(c domain.Comment, d discussion, reply bool) {
	<p data-testid="comment" class={ templ.KV("rp-reply", reply) }>
		<strong>
			@person(c.Author)
		</strong>
		<span class="small muted">{ " · " }{ fmtPublished(c.CreatedAt) }</span>
		<br/>
		{ c.Body }
	</p>
	if d.Author {
		<details data-testid="make-action-item" class={ templ.KV("rp-reply", reply) }>
			<summary class="small">Make action item</summary>
			<form data-testid="comment-action-item-form" class="rp-inline-form" method="post" action={ templ.SafeURL(publicationPath(*d.Pub) + "/action-items") }>
				<input type="hidden" name="comment" value={ fmt.Sprintf("%d", c.ID) }/>
				@actionItemFields(false)
				<button type="submit" class="btn sm">Make Action Item</button>
			</form>
		</details>
	}
}

// commentCount counts the comments in a Goal's threads, replies included.
func commentCount(threads []domain.Thread) int {
	n := 0
	for _, t := range threads {
		n += 1 + len(t.Replies)
	}
	return n
}

// plural says how many of a thing there are: "1 comment", "2 comments".
func plural(n int, noun string) string {
	if n == 1 {
		return "1 " + noun
	}
	return fmt.Sprintf("%d %ss", n, noun)
}

// publicationActionItems lists the Action Items raised on a publication, open
// or closed with the owner's note, and gives the Report's author the form to
// create one directly.
templ publicationActionItems(d discussion) {
	<section id="action-items" data-testid="publication-action-items">
		<h2>Action Items raised here</h2>
		<ul class="card rp-list">
			if len(d.Raised) == 0 {
				<li data-testid="no-action-items">None yet.</li>
			}
			for _, item := range d.Raised {
				<li data-testid="raised-action-item">
					@actionItemSummary(item)
					if item.Closed {
						{ " " }<strong>[Closed { fmtDate(item.ClosedAt) }]</strong>
						<span data-testid="action-item-note">— { item.ClosingNote }</span>
					}
					if d.canClose(item) {
						@closeActionItemForm(item, d)
					}
				</li>
			}
		</ul>
		if d.Author {
			<details>
				<summary class="btn sm">Add Action Item</summary>
				<form data-testid="action-item-form" class="rp-inline-form" method="post" action={ templ.SafeURL(publicationPath(*d.Pub) + "/action-items") }>
					@actionItemFields(true)
					<button type="submit" class="btn primary sm">Add Action Item</button>
				</form>
			</details>
		}
	</section>
}

// actionItemFields are the fields an Action Item is raised with: its owner by
// email and its due date, and its description — required when it is created
// directly, and otherwise defaulting to the comment's.
templ actionItemFields(textRequired bool) {
	<label>
		Action Item
		if textRequired {
			<input type="text" name="text" required/>
		} else {
			<input type="text" name="text" placeholder="Defaults to the comment"/>
		}
	</label>
	<label>
		Owner
		<input type="email" name="owner" required/>
	</label>
	<label>
		Due
		<input type="date" name="due" required/>
	</label>
}

// actionItemSummary is an Action Item on one line: what · who owns it · when
// it is due.
templ actionItemSummary(item domain.ActionItem) {
	{ item.Text }{ " · " }
	@person(item.Owner)
	{ " · due " }{ fmtDate(item.DueDate) }
}

// closeActionItemForm lets an Action Item's owner close it with a note, behind
// a small Close button.
templ closeActionItemForm(item domain.ActionItem, d discussion) {
	<details data-testid="close-toggle">
		<summary class="btn sm">Close</summary>
		<form data-testid="close-action-item" class="rp-inline-form" method="post" action={ templ.SafeURL(fmt.Sprintf("/action-items/%d/close", item.ID)) }>
			<input type="hidden" name="return" value={ d.Return }/>
			<label>
				Closing note
				<input type="text" name="note" required/>
			</label>
			<button type="submit" class="btn primary sm">Close</button>
		</form>
	</details>
}
