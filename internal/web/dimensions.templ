package web

import (
	"fmt"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// confirmRetireDimension is what Retire asks before retiring a whole Dimension.
const confirmRetireDimension = "Retire this Dimension? Goals that have its values keep them, and saved Reports still filter on them, but it is no longer offered for setting, filtering or grouping Goals."

// confirmMerge is what Merge asks before merging a Dimension value away.
const confirmMerge = "Merge this value? Its Goals and Report filters move to the chosen value, and this value is removed. This can't be undone."

// dimensionsPage lists every Dimension as a card of its values, whether a Goal
// takes one of them or several, whether its list is Fixed or Extendable, and
// whether it is required, and — for an Admin — the controls to define a Dimension and, behind each
// card's Edit toggle, to switch between one value and several and between a
// Fixed and an Extendable list, and to add, rename, and retire values
// (CONTEXT.md: Admin defines Dimensions; Fixed; Extendable). Retired values stay listed, struck through, and a
// Retired Dimension stays listed, flagged retired, without the Required mark
// or its control (CONTEXT.md: Retired). refusal, when
// set, names the Goals that kept a Dimension from switching to one value;
// toast, when set, offers Undo for the value just retired.
templ dimensionsPage(current *domain.Account, dims []domain.Dimension, refusal *domain.SeveralValuesError, toast *toast) {
	{{ admin := current != nil && current.IsAdmin }}
	@layout("Dimensions", current) {
		@dimensionsStyles()
		<header class="page-head">
			<div>
				<h1>Dimensions</h1>
				<p class="muted">The Dimensions Goals are tagged with, and their values.</p>
			</div>
		</header>
		if refusal != nil {
			@selectionRefusal(refusal)
		}
		@toastNotice(toast)
		if admin {
			<details data-testid="create-dimension">
				<summary class="btn primary">Define a Dimension</summary>
				<form class="card dm-card dm-new" method="post" action="/dimensions">
					<h3>Define a Dimension</h3>
					<label class="field">
						<span>Name</span>
						<input type="text" name="name" required/>
					</label>
					<label class="field">
						<span>Values <span class="hint">— comma-separated</span></span>
						<input type="text" name="values" required/>
					</label>
					<fieldset class="dm-selection">
						<legend>Each Goal takes</legend>
						<label><input type="radio" name="selection" value={ domain.SelectionOne } checked/> one value</label>
						<label><input type="radio" name="selection" value={ domain.SelectionSeveral }/> several values</label>
					</fieldset>
					<fieldset class="dm-selection">
						<legend>Its list is</legend>
						<label><input type="radio" name="list" value={ domain.ListFixed } checked/> Fixed — only Admins add values</label>
						<label><input type="radio" name="list" value={ domain.ListExtendable }/> Extendable — anyone setting a Goal's value can add one</label>
					</fieldset>
					<div>
						<button type="submit" class="btn primary">Create Dimension</button>
					</div>
				</form>
			</details>
		}
		<ul data-testid="dimensions" class="dm-list">
			if len(dims) == 0 {
				<li data-testid="no-dimensions" class="card dm-card muted">No Dimensions yet.</li>
			}
			for _, d := range dims {
				<li data-testid="dimension" class="card dm-card">
					<h3>
						{ d.Name }
						if d.Retired {
							<span data-testid="dimension-retired" class="muted small">retired</span>
						}
					</h3>
					<p data-testid="dimension-rules" class="muted small">
						Each Goal takes <span data-testid="dimension-selection">{ selectionLabel(d) }</span>
						{ " · " }
						<span data-testid="dimension-list">{ listLabel(d) }</span> list
						if d.Required && !d.Retired {
							{ " · " }
							<span data-testid="dimension-required">Required</span>
						}
					</p>
					@dimensionValues(d)
					if admin {
						@dimensionEdit(d)
					}
				</li>
			}
		</ul>
	}
}

// selectionRefusal says why a Dimension couldn't switch to one value, listing
// the Goals that still carry several of its values so an Admin can fix them.
templ selectionRefusal(refusal *domain.SeveralValuesError) {
	<section data-testid="selection-refusal" class="card dm-card" role="alert">
		<h3>{ refusal.Dimension } still takes several values</h3>
		<p>These Goals carry more than one { refusal.Dimension } value. Leave each with one, then try again.</p>
		<ul>
			for _, g := range refusal.Goals {
				<li><a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a></li>
			}
		</ul>
	</section>
}

// dimensionValues shows a Dimension's values as tags, retired ones struck
// through and muted.
templ dimensionValues(d domain.Dimension) {
	<ul class="dm-values">
		for _, v := range d.Values {
			<li data-testid="dimension-value">
				if v.Retired {
					<del class="tag muted">{ v.Value }</del>
					<span data-testid="retired" class="muted small">retired</span>
				} else {
					<span class="tag">{ v.Value }</span>
				}
			</li>
		}
	</ul>
}

// dimensionEdit is an Admin's Edit toggle on a Dimension card: a switch between
// one value and several per Goal, a switch between a Fixed and an Extendable
// list, a switch between required and optional (CONTEXT.md: Incomplete) —
// unless it is Retired, where required means nothing — then
// each value in the list's order with buttons to move it up or down,
// — while it is still in use — a rename form and a Retire button, and a form
// to merge it into another of the Dimension's values — or, once Retired, a
// Restore button — then a "sort alphabetically" action, a form to add a value,
// and a button to retire the whole Dimension, or restore it once Retired
// (CONTEXT.md: Retired). Retiring a value happens at once, and the page that
// follows offers Undo; retiring the Dimension and Merge ask for confirmation
// first.
templ dimensionEdit(d domain.Dimension) {
	<details class="dm-edit">
		<summary class="btn sm">Edit</summary>
		<form class="dm-row" method="post" action={ templ.SafeURL(fmt.Sprintf("/dimensions/%d/selection", d.ID)) }>
			if d.TakesSeveral() {
				<input type="hidden" name="selection" value={ domain.SelectionOne }/>
				<button type="submit" class="btn sm">Take one value per Goal</button>
			} else {
				<input type="hidden" name="selection" value={ domain.SelectionSeveral }/>
				<button type="submit" class="btn sm">Take several values per Goal</button>
			}
		</form>
		<form class="dm-row" method="post" action={ templ.SafeURL(fmt.Sprintf("/dimensions/%d/list", d.ID)) }>
			if d.Extendable() {
				<input type="hidden" name="list" value={ domain.ListFixed }/>
				<button type="submit" class="btn sm">Make the list Fixed</button>
			} else {
				<input type="hidden" name="list" value={ domain.ListExtendable }/>
				<button type="submit" class="btn sm">Make the list Extendable</button>
			}
		</form>
		if !d.Retired {
			<form class="dm-row" method="post" action={ templ.SafeURL(fmt.Sprintf("/dimensions/%d/required", d.ID)) }>
				if d.Required {
					<input type="hidden" name="required" value="0"/>
					<button type="submit" class="btn sm">Make it optional</button>
				} else {
					<input type="hidden" name="required" value="1"/>
					<button type="submit" class="btn sm">Make it required</button>
				}
			</form>
		}
		<ul class="dm-rows">
			for _, v := range d.Values {
				<li>
					@moveValue(v, domain.MoveUp, "↑")
					@moveValue(v, domain.MoveDown, "↓")
					if v.Retired {
						<del class="muted">{ v.Value }</del>
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/dimension-values/%d/restore", v.ID)) }>
							<button type="submit" class="btn sm">Restore</button>
						</form>
					} else {
						<form class="dm-row" method="post" action={ templ.SafeURL(fmt.Sprintf("/dimension-values/%d/rename", v.ID)) }>
							<input type="text" name="value" value={ v.Value } aria-label={ "Rename " + v.Value } required/>
							<button type="submit" class="btn sm">Rename</button>
						</form>
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/dimension-values/%d/retire", v.ID)) }>
							<button type="submit" class="btn danger sm">Retire</button>
						</form>
					}
					if len(d.Values) > 1 {
						@mergeValue(d, v)
					}
				</li>
			}
		</ul>
		<form class="dm-row" method="post" action={ templ.SafeURL(fmt.Sprintf("/dimensions/%d/sort", d.ID)) }>
			<button type="submit" class="btn sm">Sort alphabetically</button>
		</form>
		<form class="dm-row" method="post" action={ templ.SafeURL(fmt.Sprintf("/dimensions/%d/values", d.ID)) }>
			<input type="text" name="value" placeholder="New value" aria-label="Add a value" required/>
			<button type="submit" class="btn sm">Add value</button>
		</form>
		if d.Retired {
			<form class="dm-row" method="post" action={ templ.SafeURL(fmt.Sprintf("/dimensions/%d/restore", d.ID)) }>
				<button type="submit" class="btn sm">Restore this Dimension</button>
			</form>
		} else {
			<form class="dm-row" method="post" action={ templ.SafeURL(fmt.Sprintf("/dimensions/%d/retire", d.ID)) } onsubmit={ confirmScript(confirmRetireDimension) }>
				<button type="submit" class="btn danger sm">Retire this Dimension</button>
			</form>
		}
	</details>
}

// moveValue is the button that moves v one place up or down its Dimension's
// list, labelled by arrow.
templ moveValue(v domain.DimensionValue, direction, arrow string) {
	<form method="post" action={ templ.SafeURL(fmt.Sprintf("/dimension-values/%d/move", v.ID)) }>
		<input type="hidden" name="direction" value={ direction }/>
		<button type="submit" class="btn sm" aria-label={ "Move " + v.Value + " " + direction }>{ arrow }</button>
	</form>
}

// mergeValue is the form that merges v into another of d's values, chosen from
// a list of the rest (CONTEXT.md: Extendable — merging stays with Admins).
templ mergeValue(d domain.Dimension, v domain.DimensionValue) {
	<form class="dm-row" method="post" action={ templ.SafeURL(fmt.Sprintf("/dimension-values/%d/merge", v.ID)) } onsubmit={ confirmScript(confirmMerge) }>
		<select name="into" aria-label={ "Merge " + v.Value + " into" } required>
			for _, other := range d.Values {
				if other.ID != v.ID {
					<option value={ fmt.Sprintf("%d", other.ID) }>{ other.Value }</option>
				}
			}
		</select>
		<button type="submit" class="btn danger sm">Merge</button>
	</form>
}

// dimensionsStyles are the Dimensions page's own rules on top of app.css.
templ dimensionsStyles() {
	<style>
		.dm-list,.dm-values,.dm-rows{list-style:none;margin:0;padding:0}
		.dm-list{display:flex;flex-direction:column;gap:16px}
		.dm-card{padding:20px;display:flex;flex-direction:column;gap:12px}
		.dm-new{margin-top:12px}
		.dm-values{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
		.dm-values li{display:inline-flex;align-items:center;gap:8px}
		del.tag{border-style:dashed}
		.dm-edit summary{align-self:flex-start;width:max-content}
		.dm-rows{display:flex;flex-direction:column;gap:8px;margin:12px 0}
		.dm-rows li{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
		.dm-rows form{margin:0}
		.dm-row{display:flex;gap:8px;align-items:center;margin:0}
		.dm-selection{border:0;margin:0;padding:0;display:flex;gap:16px;flex-wrap:wrap}
		.dm-selection legend{padding:0;margin-bottom:4px}
	</style>
}
