package web

import "fmt"

// draftHighlightSection is the Goal page's Draft Highlights block, shown only
// to the Goal's Owner and Delegates (CONTEXT.md: Draft Highlight): the pending
// ones, oldest first, each with its kind, note, who logged it and when and a
// Delete, under a heading whose "+ Log a highlight" link opens the form to log
// another in place while the Goal still takes Check-ins. A refused log comes
// back with that form open, the reason in it and what was typed still in it.
// Once the Goal is Done or Cancelled the block is left out unless some are
// still pending.
//
// With script the block is a Highlight editor (highlightEditorScript) whose
// Saves post at once: "+ Log a highlight" is a button opening the editor at
// the top of the list, each Draft Highlight gains an Edit that opens it in
// place, and Delete, relabelled Remove, posts with htmx too. Each answers with
// the block to swap in, so the list is always the server's. The Kind is
// optional here, unlike at a Check-in. Once the Goal is Done or Cancelled the
// block is marked data-hl-no-edit, so its Draft Highlights gain no Edit: they
// can't be edited, only deleted.
templ draftHighlightSection(v goalView) {
	@draftHighlightBlock(v, draftHighlightRefusal{})
}

// draftHighlightBlock is draftHighlightSection with refused, a Save the
// Highlight editor sent that was refused, marked for the editor to open on
// again: a refused log is the log form open, and a refused edit marks its
// Draft Highlight with what was typed and the reason. Its id is the target
// the editor's htmx posts swap.
//
//nolint:contextcheck // templ hands its closures Render's ctx in a struct field, which contextcheck can't follow
templ draftHighlightBlock(v goalView, refused draftHighlightRefusal) {
	if v.CheckinRefusal == nil && (v.Permissions.LogDraftHighlight || len(v.DraftHighlights) > 0) {
		<section
			data-testid="goal-draft-highlights"
			id="draft-highlights"
			class="gp-block gp-section"
			data-highlight-editor
			data-kind-optional
			data-hl-noun="Draft Highlight"
			if !v.Permissions.LogDraftHighlight {
				data-hl-no-edit
			}
			hx-on:htmx:response-error={ swapErrorPageScript }
		>
			@groupHead(v, formDraftHighlight, "+ Log a highlight", "Log a highlight") {
				<h2>Draft Highlights</h2>
				if v.offers(formDraftHighlight) {
					<button type="button" data-testid="draft-highlight-add" data-highlight-add data-hl-url={ fmt.Sprintf("/goals/%d/draft-highlights", v.Goal.ID) } class="btn quiet sm hl-js-only">+ Log a highlight</button>
				}
			}
			<div class="hl-items dh-new" data-hl-items></div>
			if len(v.DraftHighlights) > 0 {
				<ul class="gp-list gp-rows">
					for _, d := range v.DraftHighlights {
						<li
							data-testid="draft-highlight"
							class="dh-item hl-item"
							data-hl-url={ fmt.Sprintf("/draft-highlights/%d", d.ID) }
							data-hl-kind={ d.Kind }
							data-hl-note={ d.Note }
							if refused.ID == d.ID {
								data-hl-refused
								data-hl-typed-kind={ refused.Kind }
								data-hl-typed-note={ refused.Note }
							}
						>
							<span>
								<strong>{ draftHighlightKind(d.Kind) }</strong>
								{ " " + d.Note }
							</span>
							<span class="muted small">
								@person(d.LoggedBy)
								{ "· " + v.dates().timestamp(d.CreatedAt) }
							</span>
							<form
								data-testid="delete-draft-highlight"
								method="post"
								action={ templ.SafeURL(fmt.Sprintf("/draft-highlights/%d/delete", d.ID)) }
								hx-post={ fmt.Sprintf("/draft-highlights/%d/delete", d.ID) }
								hx-target="#draft-highlights"
								hx-swap="outerHTML"
								data-hl-actions
							>
								<button type="submit" class="btn quiet sm" data-hl-js-label="Remove">Delete</button>
							</form>
							if refused.ID == d.ID {
								<p data-testid="form-error" class="alert r" role="alert">{ refused.Reason }</p>
							}
						</li>
					}
				</ul>
			}
			if v.opens(formDraftHighlight) {
				@openGoalForm(v, formDraftHighlight, "Log a Draft Highlight") {
					<p class="muted small">Log what's worth reporting as it happens. Your next Check-in offers each one to keep as a Highlight.</p>
					<form data-testid="log-draft-highlight" class="dh-form" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/draft-highlights", v.Goal.ID)) }>
						<label>
							Kind
							<select name="kind">
								@highlightKindOptions(v.FormInput.Get("kind"))
							</select>
						</label>
						<label>
							Note
							<textarea name="note" required autofocus>{ v.FormInput.Get("note") }</textarea>
						</label>
						<button type="submit" class="btn sm">Log Draft Highlight</button>
					</form>
				}
			}
			// The editor's parts sit in the block, so a swapped-in block brings
			// them back and upgrades itself again.
			@highlightEditorStyles()
			@highlightEditorTemplate()
			@highlightItemTemplate()
			@highlightEditorScript()
			<style>
				.dh-item{display:flex;flex-wrap:wrap;align-items:baseline;gap:4px 12px}
				.dh-item form{display:flex;gap:8px;margin:0 0 0 auto}
				.dh-form{display:flex;flex-direction:column;gap:8px;align-items:flex-start}
				.dh-form label{display:flex;flex-direction:column;gap:4px;font-weight:600;font-size:var(--text-secondary);align-self:stretch}
				.dh-new{margin:8px 0}
				[data-hl-js]>.gp-group-head>a{display:none}
			</style>
		</section>
	}
}

// draftHighlightKind is a Draft Highlight's kind as the page shows it: "No
// kind" for one logged without.
func draftHighlightKind(kind string) string {
	if kind == "" {
		return "No kind"
	}
	return kind
}
