package web

import "github.com/zachthieme/goal-tracker/internal/domain"

// notFoundPage says, inside the normal page, that there is nothing at the
// address asked for, with a link back to Home, or to sign in when no one is
// signed in (notFound).
templ notFoundPage(current *domain.Account) {
	@layout("Not found", current) {
		<div class="message-page">
			<h1>Not found</h1>
			<p data-testid="not-found">There's nothing here. It may have been removed, or the link may be wrong.</p>
			if current != nil {
				<p><a href="/home">Back to Home</a></p>
			} else {
				<p><a href="/signin">Sign in</a></p>
			}
		</div>
	}
}
