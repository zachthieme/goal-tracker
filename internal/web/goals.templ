package web

import (
	"fmt"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// goalsPage lists every Goal and offers the create-Goal form.
templ goalsPage(current *domain.Account, goals []domain.Goal) {
	@layout("Goals", current) {
		<h1>Goals</h1>
		<section>
			<h2>Propose a Goal</h2>
			<form hx-post="/goals" hx-target="#goal-list" hx-swap="outerHTML" method="post" action="/goals">
				<label>
					Title
					<input type="text" name="title" required/>
				</label>
				<label>
					So What
					<textarea name="so_what" required></textarea>
				</label>
				<button type="submit">Create Goal</button>
			</form>
		</section>
		@goalList(goals)
	}
}

// goalList is the htmx swap target: the Goal list on its own.
templ goalList(goals []domain.Goal) {
	<ul id="goal-list" data-testid="goal-list">
		if len(goals) == 0 {
			<li data-testid="no-goals">No Goals yet.</li>
		}
		for _, g := range goals {
			<li>
				<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a>
				<span> — { g.Lifecycle } — Owner { g.Owner.Email }</span>
			</li>
		}
	</ul>
}

// goalPage shows a single Goal on its own page, with its parents and children
// for navigation and, for its Owner, a form to request a new "contributes to"
// link.
templ goalPage(current *domain.Account, g domain.Goal, parents, children []domain.GoalLink, candidates []domain.Goal) {
	@layout(g.Title, current) {
		<article data-testid="goal">
			<h1 data-testid="goal-title">{ g.Title }</h1>
			<p><strong>Lifecycle:</strong> <span data-testid="goal-lifecycle">{ g.Lifecycle }</span></p>
			<p><strong>Owner:</strong> <span data-testid="goal-owner">{ g.Owner.Email }</span></p>
			<h2>So What</h2>
			<p data-testid="goal-so-what">{ g.SoWhat }</p>
		</article>
		<section data-testid="goal-parents">
			<h2>Contributes to</h2>
			@linkList(parents, "no-parents", "This Goal contributes to nothing yet.")
		</section>
		<section data-testid="goal-children">
			<h2>Contributed to by</h2>
			@linkList(children, "no-children", "Nothing contributes to this Goal yet.")
		</section>
		if current != nil && current.ID == g.Owner.ID {
			<section data-testid="request-link">
				<h2>Contribute this Goal to another</h2>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/links", g.ID)) }>
					<label>
						Parent Goal
						<select name="parent_id" required>
							for _, c := range candidates {
								<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Title }</option>
							}
						</select>
					</label>
					<label>
						Note (optional)
						<textarea name="note"></textarea>
					</label>
					<button type="submit">Request link</button>
				</form>
			</section>
		}
		<p><a href="/goals">Back to Goals</a></p>
	}
}

// linkList renders a Goal's parents or children as navigable links, each with a
// button to remove the connecting link. emptyTestID/emptyText render when there
// are none.
templ linkList(links []domain.GoalLink, emptyTestID, emptyText string) {
	<ul>
		if len(links) == 0 {
			<li data-testid={ emptyTestID }>{ emptyText }</li>
		}
		for _, l := range links {
			<li>
				<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", l.Goal.ID)) }>{ l.Goal.Title }</a>
				<span> — Owner { l.Goal.Owner.Email }</span>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/links/%d/remove", l.LinkID)) } style="display:inline">
					<button type="submit">Remove</button>
				</form>
			</li>
		}
	</ul>
}
