package web

import (
	"fmt"
	"time"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// goalsPage is the Goal list an exec scans in seconds: a header offering New
// goal, the filter bar, and the Goals as a table led by Health, problems first
// (CONTEXT.md: filter and group Goals).
templ goalsPage(current *domain.Account, view goalsListData) {
	@layout("Goals", current) {
		@goalsStyles()
		<header data-testid="goals-head" class="page-head">
			<div>
				<h1>Goals</h1>
				<p class="muted">Every goal in the org. Problems sort to the top.</p>
			</div>
			<details data-testid="propose-goal" class="gl-propose">
				<summary data-testid="new-goal" class="btn primary">New goal</summary>
				<form class="card" hx-post="/goals" hx-target="#goal-list" hx-swap="outerHTML" hx-on::after-request="if(event.detail.successful){this.reset();this.closest('details').open=false}" method="post" action="/goals">
					<h3>Propose a Goal</h3>
					<label class="field">
						<span>Title</span>
						<input type="text" name="title" required/>
					</label>
					<label class="field">
						<span>So What</span>
						<textarea name="so_what" required></textarea>
					</label>
					<button type="submit" class="btn primary">Create Goal</button>
				</form>
			</details>
		</header>
		@goalFilters(view)
		@goalList(view)
	}
}

// goalFilters is the filter bar — search, Health, Lifecycle, and Mine only —
// with the Dimension filters and Group by folded under More filters, all
// submitted as a GET so the chosen slice lives in the URL.
templ goalFilters(view goalsListData) {
	<form method="get" action="/goals" data-testid="goal-filters" class="gl-filters">
		<div class="gl-bar">
			<input data-testid="goal-search" type="search" name="q" value={ view.Filter.Query } placeholder="Search title or Owner" aria-label="Search Goals by title or Owner"/>
			<select data-testid="goal-health-filter" name="health" aria-label="Health">
				<option value="" selected?={ view.Filter.Health == "" }>Any Health</option>
				for _, hf := range healthFilters {
					<option value={ hf.Value } selected?={ view.Filter.Health == hf.Value }>
						if hf.Health == "" {
							No Health
						} else {
							{ hf.Health }
						}
					</option>
				}
			</select>
			<select data-testid="goal-lifecycle-filter" name="lifecycle" aria-label="Lifecycle">
				<option value="" selected?={ view.Filter.Lifecycle == "" }>Any Lifecycle</option>
				for _, lc := range lifecycleFilters {
					<option value={ lc } selected?={ view.Filter.Lifecycle == lc }>{ lc }</option>
				}
			</select>
			<label class="gl-mine">
				<input data-testid="goal-mine-filter" type="checkbox" name="mine" value="1" checked?={ view.Filter.Mine }/>
				Mine only
			</label>
			<button type="submit" class="btn">Apply</button>
			<a href="/goals" class="btn quiet">Clear</a>
		</div>
		if len(view.Dimensions) > 0 {
			<details data-testid="more-filters" open?={ view.moreFiltersSet() }>
				<summary>More filters</summary>
				for _, d := range view.Dimensions {
					<fieldset>
						<legend>{ d.Name }</legend>
						for _, v := range d.Values {
							<label>
								<input type="checkbox" name="value" value={ fmt.Sprintf("%d", v.ID) } checked?={ view.Selected[v.ID] }/>
								{ v.Value }
								if v.Retired {
									<span>(retired)</span>
								}
							</label>
						}
					</fieldset>
				}
				<label>
					Group by
					<select name="group">
						<option value="" selected?={ view.GroupID == 0 }>— none —</option>
						for _, d := range view.Dimensions {
							<option value={ fmt.Sprintf("%d", d.ID) } selected?={ view.GroupID == d.ID }>{ d.Name }</option>
						}
					</select>
				</label>
			</details>
		}
	</form>
}

// goalList is the htmx swap target: the Goal list as a table led by Health,
// flat or with a section per value of the grouping Dimension.
templ goalList(view goalsListData) {
	<div id="goal-list" data-testid="goal-list" class="card">
		<table>
			<thead>
				<tr><th>Health</th><th>Goal</th><th>Owner</th><th>Due</th><th>Last check-in</th><th>Dimension tags</th></tr>
			</thead>
			if view.GroupID != 0 {
				if len(view.Groups) == 0 {
					<tbody>
						@noGoals("No Goals match.")
					</tbody>
				}
				for _, grp := range view.Groups {
					<tbody data-testid="goal-group">
						<tr class="gl-group">
							<th data-testid="goal-group-label" colspan="6" scope="colgroup">
								if grp.Value != nil {
									{ grp.Value.Value }
								} else {
									Unassigned
								}
							</th>
						</tr>
						for _, row := range grp.Rows {
							@goalListRow(row)
						}
					</tbody>
				}
			} else {
				<tbody>
					if len(view.Rows) == 0 && view.filtered() {
						@noGoals("No Goals match.")
					} else if len(view.Rows) == 0 {
						@noGoals("No Goals yet.")
					}
					for _, row := range view.Rows {
						@goalListRow(row)
					}
				</tbody>
			}
		</table>
	</div>
}

// noGoals is the Goal list's empty state, spanning the table.
templ noGoals(text string) {
	<tr><td data-testid="no-goals" colspan="6" class="muted">{ text }</td></tr>
}

// goalListRow is one Goal in the list: its Health, its title with the Ownerless
// and freshness marks under it, its Owner, and its Dimension values.
templ goalListRow(row goalRow) {
	{{ g := row.Goal }}
	<tr data-testid="goal-row">
		<td>
			if health := row.health(); health != "" {
				<span data-testid="goal-row-health" class={ "badge", healthClass(health) }><span class="dot"></span>{ health }</span>
			} else {
				<span data-testid="goal-row-health" class="badge lc">{ g.Lifecycle }</span>
			}
		</td>
		<td>
			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a>
			if g.Ownerless || row.Freshness.Stale || row.Freshness.PathToGreenOverdue {
				<div class="gl-marks">
					if g.Ownerless {
						<span data-testid="ownerless" class="badge ol">Ownerless</span>
					}
					@goalRowFreshness(row.Freshness)
				</div>
			}
		</td>
		<td>@person(g.Owner)</td>
		<td data-testid="goal-row-due" class="num">
			if g.DeliveryDate.IsZero() {
				<span class="muted">—</span>
			} else {
				@struckDates(row.PriorDates)
				{ fmtDate(g.DeliveryDate) }
			}
		</td>
		<td data-testid="goal-row-last-checkin" class="muted">{ row.lastCheckin() }</td>
		<td>
			for _, val := range row.Values {
				<span data-testid="goal-value-tag" class="tag">{ val.Value }</span>
			}
		</td>
	</tr>
}

// goalsStyles are the Goal list's own rules on top of app.css: the propose
// form's popover, the one-row filter bar, and the table's group headers and
// marks.
templ goalsStyles() {
	<style>
		.gl-propose{position:relative}
		.gl-propose>form{position:absolute;right:0;top:48px;z-index:10;width:360px;max-width:calc(100vw - 32px);padding:16px;display:flex;flex-direction:column;gap:12px;box-shadow:var(--shadow-pop);box-sizing:border-box}
		.gl-filters{display:flex;flex-direction:column;gap:8px}
		.gl-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
		.gl-bar input[type=search]{flex:1;min-width:200px}
		.gl-mine{display:inline-flex;align-items:center;gap:8px;white-space:nowrap}
		.gl-filters details{padding:0 4px}
		.gl-filters details>summary{justify-content:flex-start;color:var(--color-primary-strong);font-weight:600}
		.gl-filters fieldset{display:inline-flex;flex-wrap:wrap;gap:4px 12px;border:1px solid var(--color-border);border-radius:var(--radius-md);margin:0 8px 8px 0;padding:8px 12px}
		.gl-group th{background:var(--color-primary-subtle);color:var(--color-ink);font-size:13px;font-weight:600;letter-spacing:0;text-transform:none}
		.gl-marks{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}
		#goal-list td .tag{margin:4px 4px 4px 0}
	</style>
}

// goalPage shows a single Goal: a header summarizing it with every action in
// reach, then its latest status, So What, Metrics, Milestones, Highlights and
// history in the main column, and its links, people and Dimension values in the
// sidebar.
templ goalPage(current *domain.Account, v goalView) {
	{{ g := v.Goal }}
	{{ owner := current != nil && current.ID == g.Owner.ID }}
	{{ admin := current != nil && current.IsAdmin }}
	@layout(g.Title, current) {
		@goalPageStyles()
		if g.Ownerless {
			<p data-testid="goal-ownerless" class="alert ol" role="alert"><strong>Ownerless</strong><span>this Goal's Owner has left the org and it needs an Admin to reassign it.</span></p>
		}
		<nav data-testid="goal-breadcrumb" class="small muted" aria-label="Breadcrumb">
			<a href="/goals">Goals</a>
			{ " / " }
			if len(v.Parents) > 0 {
				<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", v.Parents[0].Goal.ID)) }>{ v.Parents[0].Goal.Title }</a>
				{ " / " }
			}
			<span aria-current="page">{ g.Title }</span>
		</nav>
		@goalFreshness(v.Freshness)
		@goalSignals(v.Signals)
		@goalHead(v, owner, admin)
		<div class="grid-main-aside">
			<div data-testid="goal-main" class="gp-col">
				if owner && g.Lifecycle == domain.LifecycleProposed {
					@defineGoal(v)
				}
				@checkinSection(v)
				<article data-testid="goal" class="card gp-card">
					<h3><button type="button" class="disclose help" aria-expanded="false" aria-controls="so-what-help" title={ soWhatHelp }>So What</button></h3>
					<p id="so-what-help" class="explain" hidden>{ soWhatHelp }</p>
					<p data-testid="goal-so-what">{ g.SoWhat }</p>
				</article>
				<section data-testid="goal-metrics" class="gp-block">
					<h2>Metrics</h2>
					@metricList(v.Trends, owner)
				</section>
				<section data-testid="goal-milestones" class="card gp-card">
					<h3>Milestones</h3>
					@milestoneList(v, owner && g.Lifecycle == domain.LifecycleProposed)
				</section>
				<section data-testid="goal-highlights" class="card gp-card">
					<h3>Highlights</h3>
					@highlightList(v.Highlights)
				</section>
				<div data-testid="goal-history" class="card gp-card">
					<h3>History</h3>
					<section data-testid="goal-checkin-history">
						<details>
							<summary>{ fmt.Sprintf("Check-in history (%d)", len(v.Checkins)) }</summary>
							@checkinHistory(v.Checkins)
						</details>
					</section>
					<section data-testid="goal-date-slips">
						<details>
							<summary>{ fmt.Sprintf("Date Slips (%d)", len(v.DateSlips)) }</summary>
							@dateSlipList(v)
						</details>
					</section>
					<section data-testid="goal-so-what-history">
						<details>
							<summary>{ fmt.Sprintf("So What history (%d)", len(v.Revisions)) }</summary>
							<ul class="gp-list">
								for _, rev := range v.Revisions {
									<li>
										<span>{ rev.SoWhat }</span>
										<span class="muted small">
											{ "— " }
											@person(rev.Author)
											{ " at " + rev.CreatedAt.Format("2006-01-02 15:04") }
										</span>
									</li>
								}
							</ul>
						</details>
					</section>
					<section data-testid="goal-ownership-history">
						<details>
							<summary>{ fmt.Sprintf("Ownership history (%d)", len(v.Ownership)) }</summary>
							@ownershipHistory(v.Ownership)
						</details>
					</section>
				</div>
				@addChildGoal(v)
			</div>
			<aside data-testid="goal-sidebar" class="gp-col">
				<div class="card gp-card">
					<section data-testid="goal-parents">
						<h3>Contributes to</h3>
						@linkList(v.Parents, v.LinkHealth, "no-parents", "This Goal contributes to nothing yet.")
					</section>
				</div>
				<div class="card gp-card">
					<section data-testid="goal-children">
						<h3>Contributed to by</h3>
						@linkList(v.Children, v.LinkHealth, "no-children", "Nothing contributes to this Goal yet.")
					</section>
				</div>
				<div data-testid="goal-people" class="card gp-card">
					<h3>People</h3>
					<p><span class="label">Owner</span><br/>@person(g.Owner)</p>
					@delegatesSection(v, owner)
					<section data-testid="goal-contributors">
						<h3 class="label">Contributors</h3>
						<ul class="gp-list">
							if len(v.Contributors) == 0 {
								<li data-testid="no-contributors" class="muted">No Contributors yet.</li>
							}
							for _, c := range v.Contributors {
								<li>@person(c)</li>
							}
						</ul>
					</section>
				</div>
				<section data-testid="goal-dimensions" class="card gp-card">
					<h3>Dimensions</h3>
					@goalDimensions(v, owner)
				</section>
			</aside>
		</div>
	}
}

// goalHead is the Goal's summary a reader takes in at a glance — badges for
// its Health, Lifecycle, Kind, Top-level and Dimension values, its title, and a
// meta line naming the Owner, the delivery date with its slips struck, and the
// cadence — with Check in and No change top right for whoever may check in.
templ goalHead(v goalView, owner, admin bool) {
	{{ g := v.Goal }}
	<header data-testid="goal-head" class="gp-head">
		<div class="gp-summary">
			<div data-testid="goal-badges" class="gp-badges">
				if health := v.health(); health != "" {
					<span class={ "badge", healthClass(health) }><span class="dot"></span>{ health }</span>
				}
				<span class="badge lc" data-testid="goal-lifecycle">{ g.Lifecycle }</span>
				<span class="badge lc" data-testid="goal-kind">
					if g.Kind == "" {
						Not yet Dated or Ongoing
					} else {
						{ g.Kind }
					}
				</span>
				if g.TopLevel {
					<button type="button" class="badge lc disclose help" data-testid="goal-top-level" aria-expanded="false" aria-controls="top-level-help" title={ topLevelHelp }>Top-level</button>
					<span id="top-level-help" class="explain" hidden>{ topLevelHelp }</span>
				}
				for _, val := range v.Values {
					<span class="tag">{ val.Value }</span>
				}
			</div>
			<h1 data-testid="goal-title">{ g.Title }</h1>
			<p data-testid="goal-meta" class="gp-meta">
				<span>Owner <strong data-testid="goal-owner">@person(g.Owner)</strong></span>
				if !g.DeliveryDate.IsZero() {
					<span>
						Delivers 
						<span data-testid="goal-delivery-date">
							@struckDates(v.priorDates(0))
							<strong>{ fmtDate(g.DeliveryDate) }</strong>
						</span>
					</span>
				}
				<span>Checks in <span data-testid="goal-cadence">every { fmt.Sprintf("%d", g.CadenceDays) } days</span></span>
			</p>
			if note := v.lifecycleNote(); note != "" {
				<p data-testid="goal-lifecycle-note" class="muted">{ note }</p>
			}
		</div>
		<div data-testid="goal-actions" class="gp-actions">
			if v.CanCheckin && (g.Lifecycle == domain.LifecycleActive || g.Lifecycle == domain.LifecycleOnHold) {
				<a class="btn primary" data-testid="checkin-link" href={ templ.SafeURL(fmt.Sprintf("/goals/%d/checkin", g.ID)) }>Check in</a>
				if g.Lifecycle == domain.LifecycleActive && v.LatestCheckin != nil {
					@noChangeCheckinButton(g.ID, "No change")
				}
			}
			@goalMore(v, owner, admin)
		</div>
	</header>
}

// goalPageStyles are the Goal page's own rules on top of app.css: the header
// with its actions and More menu, the main column and sidebar, and the Metric
// cards.
templ goalPageStyles() {
	<style>
		.gp-head{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;flex-wrap:wrap}
		.gp-summary{display:flex;flex-direction:column;gap:12px;min-width:0;flex:1 1 320px}
		.gp-badges{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
		.gp-meta{display:flex;flex-wrap:wrap;gap:4px 20px;color:var(--color-ink-muted)}
		.gp-meta strong{color:var(--color-ink)}
		.gp-actions{display:flex;gap:8px;align-items:flex-start;margin-left:auto}
		.gp-actions form{margin:0}
		.gp-more{position:relative}
		.gp-more>summary{justify-content:center}
		.gp-menu{position:absolute;right:0;top:48px;z-index:10;width:340px;max-width:calc(100vw - 32px);padding:8px;box-shadow:var(--shadow-pop);box-sizing:border-box}
		.gp-menu ul{list-style:none;margin:0;padding:0}
		.gp-menu li>a,.gp-menu li>details>summary{display:flex;min-height:36px;padding:0 12px;border-radius:var(--radius-md);align-items:center;color:var(--color-ink);font-weight:500}
		.gp-menu li>a:hover,.gp-menu li>details>summary:hover{background:var(--color-primary-subtle);text-decoration:none}
		.gp-menu section{padding:8px 12px 12px;display:flex;flex-direction:column;gap:8px}
		.gp-menu form{display:flex;flex-direction:column;gap:8px}
		.gp-menu h3{font-family:var(--font-body);line-height:1.3}
		.gp-col{display:flex;flex-direction:column;gap:20px;min-width:0}
		.gp-card{padding:24px;display:flex;flex-direction:column;gap:12px}
		.gp-block{display:flex;flex-direction:column;gap:12px}
		.gp-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
		.gp-inline{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px}
		.gp-values{border:0;margin:0;padding:0;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
		.gp-form{display:flex;flex-direction:column;gap:12px}
		.gp-edit form{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
		details.gp-card>summary h3{margin:0}
		.gp-link{display:flex;flex-direction:column;gap:4px}
		.gp-link-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
		.gp-link-meta form{margin:0 0 0 auto}
		.gp-metric-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
		.gp-current .num{font-size:28px;line-height:1.1}
		.gp-spark{max-width:100%;height:auto;display:block;overflow:visible}
		.gp-spark-target{stroke:var(--color-ink-muted)}
		.gp-spark-line{stroke:var(--color-primary-strong)}
		.gp-spark-last{fill:var(--color-primary-strong);stroke:var(--color-surface)}
		.gp-edit form{flex-direction:column}
		.gp-define>section{display:flex;flex-direction:column;gap:4px;padding-top:12px;border-top:1px solid var(--color-border)}
		.gp-define textarea{flex:1;min-width:240px}
		.gp-check{display:flex;gap:8px;align-items:baseline}
		.gp-check>span:first-child{width:16px;font-weight:600;color:var(--health-r-ink)}
		.gp-check.done>span:first-child{color:var(--health-g-ink)}
		.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
	</style>
}

// goalMore is the header's More menu: every action on the Goal the viewer may
// take beyond checking in. Each item opens its form inline, or links to the
// collapsed section lower on the page that holds it (openSection).
templ goalMore(v goalView, owner, admin bool) {
	{{ g := v.Goal }}
	<details data-testid="goal-more" class="gp-more">
		<summary class="btn">More ▾</summary>
		<div class="card gp-menu">
			<ul>
				if (owner || admin) && !g.Ownerless {
					<li>
						<details>
							<summary>Hand off</summary>
							<section data-testid="handoff-goal">
								<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/handoff", g.ID)) }>
									<label class="field">
										<span>New Owner's email</span>
										<input type="email" name="to_email" required/>
									</label>
									<button type="submit" class="btn">Start handoff</button>
								</form>
							</section>
						</details>
					</li>
				}
				if owner {
					<li><a href="#manage-people" onclick={ openSection("manage-people") }>Add a delegate</a></li>
					<li>
						<details>
							<summary>Link to a parent goal</summary>
							<section data-testid="request-link">
								<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/links", g.ID)) }>
									<label class="field">
										<span>Parent Goal</span>
										<select name="parent_id" required>
											for _, c := range v.Candidates {
												<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Title }</option>
											}
										</select>
									</label>
									<label class="field">
										<span>Note (optional)</span>
										<textarea name="note"></textarea>
									</label>
									<button type="submit" class="btn">Request link</button>
								</form>
							</section>
						</details>
					</li>
				}
				<li><a href="#add-child" onclick={ openSection("add-child") }>Add a child goal</a></li>
				if owner {
					<li><a href="#edit-dimensions" onclick={ openSection("edit-dimensions") }>Edit Dimension values</a></li>
				}
				if admin {
					<li>
						@topLevelControl(g)
					</li>
					if !g.Owner.Departed {
						<li>
							<details>
								<summary>Mark owner departed…</summary>
								<section data-testid="depart-owner">
									<p class="small muted">@person(g.Owner)
									{ " has left the org." }</p>
									<form method="post" action={ templ.SafeURL(fmt.Sprintf("/accounts/%d/depart", g.Owner.ID)) } onsubmit={ confirmScript(confirmDepart) }>
										<button type="submit" class="btn danger">
											{ "Mark " }
											@personPlain(g.Owner)
											{ " departed" }
										</button>
									</form>
								</section>
							</details>
						</li>
					} else {
						<li>
							<details>
								<summary>Mark returned…</summary>
								<section data-testid="return-owner">
									<p class="small muted">@person(g.Owner)
									{ " is back in the org." }</p>
									<form method="post" action={ templ.SafeURL(fmt.Sprintf("/accounts/%d/return", g.Owner.ID)) } onsubmit={ confirmScript(confirmReturn) }>
										<button type="submit" class="btn">
											{ "Mark " }
											@personPlain(g.Owner)
											{ " returned" }
										</button>
									</form>
								</section>
							</details>
						</li>
					}
					if g.Ownerless {
						<li>
							<details>
								<summary>Reassign</summary>
								<section data-testid="reassign-goal">
									<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/reassign", g.ID)) }>
										<label class="field">
											<span>New Owner's email</span>
											<input type="email" name="email" required/>
										</label>
										<button type="submit" class="btn">Reassign</button>
									</form>
								</section>
							</details>
						</li>
					}
				}
			</ul>
		</div>
	</details>
}

// soWhatHelp defines So What on the Goal page, opened from its heading.
const soWhatHelp = "The customer problem this Goal addresses and what is expected to change when it succeeds."

// topLevelHelp says what Top-level means, opened from the Goal page's badge.
const topLevelHelp = "One of the org's root outcomes"

// confirmDepart is what an Admin confirms before marking a Goal's Owner departed.
const confirmDepart = "Mark this Owner departed? Every Goal they own becomes Ownerless until an Admin reassigns it."

// confirmReturn is what an Admin confirms before reversing a Goal's Owner's
// departure.
const confirmReturn = "Mark this Owner returned? They can sign in again, and the Goals they still own stop being Ownerless. Goals reassigned while they were away stay with their new Owners."

// openSection opens the collapsed section a More menu item links to, so
// following the link shows its form, and closes the menu over it.
func openSection(id string) templ.ComponentScript {
	return templ.ComponentScript{Call: "document.getElementById('" + id + "').open=true;this.closest('details').open=false"}
}

// goalDimensions shows the Goal's values in each Dimension as tags — retired
// values stay readable — and, for its Owner, a collapsed section to set them:
// a select for a Dimension that takes one value, and a checkbox per value, saved
// together, for one that takes several (CONTEXT.md: Owners assign Dimension
// values; retired values stay readable). A retired value the Goal carries keeps
// its checked box so saving doesn't silently drop it. It links everyone to the
// Dimensions page, which isn't in the main nav.
templ goalDimensions(v goalView, owner bool) {
	{{ g := v.Goal }}
	if len(v.Dimensions) == 0 {
		<p data-testid="no-dimensions-defined" class="muted">No Dimensions defined yet.</p>
	}
	<ul class="gp-list">
		for _, d := range v.Dimensions {
			{{ assigned := v.assignedValues(d.ID) }}
			<li data-testid="goal-dimension">
				<span class="label">{ d.Name }</span>
				<br/>
				for _, current := range assigned {
					<span class="tag" data-testid="goal-dimension-value">{ current.Value }</span>
					if current.Retired {
						<span class="muted small" data-testid="retired">(retired)</span>
					}
				}
				if len(assigned) == 0 {
					<span class="muted" data-testid="goal-dimension-unassigned">unassigned</span>
				}
			</li>
		}
	</ul>
	if owner && len(v.Dimensions) > 0 {
		<details id="edit-dimensions">
			<summary class="small">Edit Dimension values</summary>
			for _, d := range v.Dimensions {
				if d.TakesSeveral() {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/dimensions", g.ID)) } class="gp-inline">
						<input type="hidden" name="dimension_id" value={ fmt.Sprintf("%d", d.ID) }/>
						<fieldset class="gp-values">
							<legend>{ d.Name }</legend>
							for _, val := range d.Values {
								if !val.Retired || v.carries(val) {
									<label>
										<input type="checkbox" name="value_id" value={ fmt.Sprintf("%d", val.ID) } checked?={ v.carries(val) }/>
										{ val.Value }
										if val.Retired {
											<span class="muted small">(retired)</span>
										}
									</label>
								}
							}
						</fieldset>
						<button type="submit" class="btn sm">Save</button>
					</form>
				} else {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/dimensions", g.ID)) } class="gp-inline">
						<select name="value_id" aria-label={ d.Name }>
							<option value="">{ d.Name }: choose</option>
							for _, val := range d.Values {
								if !val.Retired {
									<option value={ fmt.Sprintf("%d", val.ID) } selected?={ v.carries(val) }>{ val.Value }</option>
								}
							}
						</select>
						<button type="submit" class="btn sm">Assign</button>
					</form>
				}
			}
		</details>
	}
	<p class="small"><a href="/dimensions">All Dimensions →</a></p>
}

// addChildGoal creates a Goal under this one, collapsed until the More menu
// opens it or a failed create sends the page back: it offers this Goal's values
// as defaults (pre-checked, but not inherited — only the kept ones are
// assigned) and requests a "contributes to" link to this Goal (CONTEXT.md:
// Contributes to; the parent's values are offered as defaults).
templ addChildGoal(v goalView) {
	{{ g := v.Goal }}
	<details id="add-child" class="card gp-card" open?={ v.ChildForm.Error != "" }>
		<summary><h3>Add a child Goal</h3></summary>
		<section data-testid="add-child-goal">
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/children", g.ID)) } class="gp-form">
				if v.ChildForm.Error != "" {
					<p data-testid="child-goal-error" class="alert r" role="alert">{ v.ChildForm.Error }</p>
				}
				<label class="field">
					<span>Title</span>
					<input type="text" name="title" value={ v.ChildForm.Title } required/>
				</label>
				<label class="field">
					<span>So What</span>
					<textarea name="so_what" required>{ v.ChildForm.SoWhat }</textarea>
				</label>
				if len(v.Values) > 0 {
					<fieldset data-testid="child-defaults">
						<legend>Defaults from { g.Title }</legend>
						for _, val := range v.Values {
							if !val.Retired {
								<label>
									<input type="checkbox" name="value_id" value={ fmt.Sprintf("%d", val.ID) } checked?={ v.ChildForm.keeps(val.ID) }/>
									{ val.Value }
								</label>
							}
						}
					</fieldset>
				}
				<button type="submit" class="btn primary">Create child Goal</button>
			</form>
		</section>
	</details>
}

// defineGoal is the Owner's toolkit for a Proposed Goal: mark it Dated or
// Ongoing, set the cadence, revise the So What, add Contributors, Milestones and
// Metrics, and — once the activation checklist is done — activate it.
templ defineGoal(v goalView) {
	{{ g := v.Goal }}
	<section data-testid="define-goal" class="card gp-card gp-define">
		<h3>Define this Goal</h3>
		<section data-testid="mark-kind">
			<h3>Delivery</h3>
			<form class="gp-inline" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/dated", g.ID)) }>
				<label>
					Delivery date
					<input type="date" name="delivery_date" value={ v.SuggestedDate } required/>
				</label>
				<button type="submit" class="btn">Mark Dated</button>
			</form>
			<form class="gp-inline" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/ongoing", g.ID)) }>
				<button type="submit" class="btn">Mark Ongoing</button>
			</form>
		</section>
		<section data-testid="set-cadence">
			<h3>Check-in cadence</h3>
			<form class="gp-inline" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/cadence", g.ID)) }>
				<label>
					Days between Check-ins
					<input type="number" name="cadence_days" min="1" value={ fmt.Sprintf("%d", g.CadenceDays) } required/>
				</label>
				<button type="submit" class="btn">Set cadence</button>
			</form>
		</section>
		<section data-testid="edit-so-what">
			<h3>Revise the So What</h3>
			<form class="gp-inline" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/so-what", g.ID)) }>
				<textarea name="so_what" required>{ g.SoWhat }</textarea>
				<button type="submit" class="btn">Save So What</button>
			</form>
		</section>
		<section data-testid="add-contributor">
			<h3>Add a Contributor</h3>
			<form class="gp-inline" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/contributors", g.ID)) }>
				<label>
					Email
					<input type="email" name="email" required/>
				</label>
				<button type="submit" class="btn">Add Contributor</button>
			</form>
		</section>
		<section data-testid="add-milestone">
			<h3>Add a Milestone</h3>
			<form class="gp-inline" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/milestones", g.ID)) }>
				<label>
					Name
					<input type="text" name="name" required/>
				</label>
				<label>
					Date
					<input type="date" name="target_date" required/>
				</label>
				<button type="submit" class="btn">Add Milestone</button>
			</form>
		</section>
		<section data-testid="add-metric">
			<h3>Add a Metric</h3>
			<form class="gp-inline" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/metrics", g.ID)) }>
				@metricFields(domain.Metric{Direction: domain.MetricUp})
				<button type="submit" class="btn">Add Metric</button>
			</form>
		</section>
		<section data-testid="activation" class="gp-activation">
			<h3>Ready to activate?</h3>
			<ul data-testid="activation-checklist" class="gp-list">
				for _, item := range v.activationChecklist() {
					if item.Done {
						<li data-done="true" class="gp-check done"><span aria-hidden="true">✓</span> <span>{ item.Label }</span> <span class="muted small">done</span></li>
					} else {
						<li data-done="false" class="gp-check"><span aria-hidden="true">✗</span> <span>{ item.Label }</span> <span class="muted small">missing</span></li>
					}
				}
			</ul>
		</section>
		<form data-testid="activate-goal" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/activate", g.ID)) }>
			<button type="submit" class="btn primary" disabled?={ !v.readyToActivate() }>Activate Goal</button>
		</form>
	</section>
}

// milestoneList is a Goal's Milestones as a table of status, name, and date
// with its history struck through (CONTEXT.md: Date Slip), headed by the Goal's
// slip count and Milestone Churn. editable gives the Owner of a Proposed Goal an
// edit form on each; once Active, Milestones change in a Check-in.
templ milestoneList(v goalView, editable bool) {
	<p class="muted small">
		<span data-testid="goal-slip-count">{ fmt.Sprintf("%d", len(v.DateSlips)) }</span> slips
		·
		<span data-testid="goal-milestone-churn">{ fmt.Sprintf("%d", v.MilestoneChurn) }</span> added or removed since Active
	</p>
	if len(v.Milestones) == 0 {
		<p data-testid="no-milestones" class="muted">No Milestones yet.</p>
	} else {
		<table>
			<thead>
				<tr>
					<th>Status</th>
					<th>Milestone</th>
					<th>Date</th>
					if editable {
						<th><span class="sr-only">Edit</span></th>
					}
				</tr>
			</thead>
			<tbody>
				for _, m := range v.Milestones {
					<tr data-testid="goal-milestone">
						<td><span class="badge lc" data-testid="milestone-status">{ m.Status }</span></td>
						if m.Status == domain.MilestoneRemoved {
							<td>
								<del>{ m.Name }</del>
								if m.RemovedReason != "" {
									<div class="muted small">Removed: { m.RemovedReason }</div>
								}
							</td>
						} else {
							<td>{ m.Name }</td>
						}
						<td class="num">
							@struckDates(v.priorDates(m.ID))
							{ fmtDate(m.TargetDate) }
						</td>
						if editable {
							<td>
								<details class="gp-edit">
									<summary class="btn quiet sm">Edit</summary>
									<form method="post" action={ templ.SafeURL(fmt.Sprintf("/milestones/%d", m.ID)) }>
										<input type="text" name="name" value={ m.Name } aria-label="Name" required/>
										<input type="date" name="target_date" value={ fmtDate(m.TargetDate) } aria-label="Date" required/>
										<button type="submit" class="btn sm">Save</button>
									</form>
								</details>
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
	}
}

// struckDates renders the dates a date held before its Date Slips, each struck
// through ahead of the current date: ~~10/15~~ 11/03 (CONTEXT.md: Date Slip).
templ struckDates(dates []time.Time) {
	for _, d := range dates {
		<del>{ fmtDate(d) }</del>{ " " }
	}
}

// dateSlipList shows a Goal's Date Slips, earliest first: what moved, from and
// to, and the reason (CONTEXT.md: Date Slip — the full history is kept).
templ dateSlipList(v goalView) {
	<ul>
		if len(v.DateSlips) == 0 {
			<li data-testid="no-date-slips">No Date Slips.</li>
		}
		for _, s := range v.DateSlips {
			<li data-testid="date-slip">
				if s.MilestoneID == 0 {
					<strong>Delivery date</strong>
				} else {
					<strong>Milestone { v.milestoneName(s.MilestoneID) }</strong>
				}
				: <del>{ fmtDate(s.OldDate) }</del> { fmtDate(s.NewDate) }
				<span>— { s.Reason }</span>
				<span>— at { s.CreatedAt.Format("2006-01-02 15:04") }</span>
			</li>
		}
	</ul>
}

// ownershipHistory lists every Handoff and Admin Reassign of a Goal, oldest
// first, each with who it went from and to, who started it and when, and its
// outcome (CONTEXT.md: Handoff — every Handoff is kept with its outcome).
templ ownershipHistory(changes []domain.Handoff) {
	<ul class="gp-list">
		if len(changes) == 0 {
			<li data-testid="no-ownership-changes" class="muted">No ownership changes yet.</li>
		}
		for _, c := range changes {
			<li data-testid="ownership-change">
				<span>
					@person(c.From)
					{ " → " }
					@person(c.To)
				</span>
				<span>— { ownershipOutcome(c.Status) }</span>
				<span class="muted small">
					{ "— started by " }
					@person(c.InitiatedBy)
					{ " at " + c.CreatedAt.Format("2006-01-02 15:04") }
				</span>
			</li>
		}
	</ul>
}

// metricList shows each of a Goal's Metrics as a card: its current value, its
// baseline and target, and its trend over time against the target (CONTEXT.md:
// the Goal page shows each Metric's trend); the Owner edits one in a collapsed
// section.
templ metricList(trends []metricTrend, owner bool) {
	if len(trends) == 0 {
		<p data-testid="no-metrics" class="muted">No Metrics yet.</p>
	}
	for _, t := range trends {
		{{ m := t.Metric }}
		<div data-testid="goal-metric" class="card gp-card gp-metric">
			<div class="gp-metric-head">
				<div>
					<h3>{ m.Name }</h3>
					<p class="muted small">{ fmtNum(m.Baseline) } → { fmtNum(m.Target) } { m.Unit } by { fmtDate(m.TargetDate) }</p>
				</div>
				<p class="gp-current">
					if v, ok := t.current(); ok {
						<span class="num" data-testid="metric-current">{ fmtNum(v) }</span> <span class="muted">{ m.Unit }</span>
					} else {
						<span class="num muted" data-testid="metric-current">—</span>
					}
				</p>
			</div>
			if len(t.Readings) > 0 {
				@metricSparkline(t)
			}
			@metricTrendReadings(t)
			if owner {
				<details data-testid="metric-edit" class="gp-edit">
					<summary class="small">Edit Metric</summary>
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/metrics/%d", m.ID)) }>
						@metricFields(m)
						<button type="submit" class="btn sm">Save</button>
					</form>
				</details>
			}
		</div>
	}
}

// metricSparkline draws a Metric's readings as a line, the latest point marked,
// over a dashed line at its target, each point naming its reading on hover.
templ metricSparkline(t metricTrend) {
	{{ s := t.sparkline() }}
	<svg class="gp-spark" role="img" aria-label={ t.trendLabel() } viewBox={ fmt.Sprintf("0 0 %g %g", sparkW, sparkH) } width={ fmt.Sprintf("%g", sparkW) } height={ fmt.Sprintf("%g", sparkH) }>
		<line x1="0" x2={ fmt.Sprintf("%g", sparkW) } y1={ fmt.Sprintf("%.1f", s.TargetY) } y2={ fmt.Sprintf("%.1f", s.TargetY) } class="gp-spark-target" stroke-width="1" stroke-dasharray="4 3"></line>
		<polyline points={ s.polyline() } class="gp-spark-line" fill="none" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></polyline>
		for _, p := range s.Points {
			<circle cx={ fmt.Sprintf("%.1f", p.X) } cy={ fmt.Sprintf("%.1f", p.Y) } r="6" fill="transparent"><title>{ p.Title }</title></circle>
		}
		<circle cx={ fmt.Sprintf("%.1f", s.last().X) } cy={ fmt.Sprintf("%.1f", s.last().Y) } r="4" class="gp-spark-last" stroke-width="2"><title>{ s.last().Title }</title></circle>
	</svg>
}

// metricTrendReadings lists a Metric's readings over time against its target —
// the sparkline as a table a reader can scan — collapsed under a count
// (CONTEXT.md: Metric - its current value is recorded at each Check-in).
templ metricTrendReadings(t metricTrend) {
	{{ m := t.Metric }}
	<details>
		<summary class="small muted">{ fmt.Sprintf("Readings (%d)", len(t.Readings)) }</summary>
		<ol data-testid="metric-trend" class="gp-list small">
			if len(t.Readings) == 0 {
				<li data-testid="no-readings">No readings yet.</li>
			}
			for _, rd := range t.Readings {
				<li data-testid="metric-reading">
					<span class="num">{ rd.CreatedAt.Format("2006-01-02") }: { fmtNum(rd.Value) } { m.Unit }</span>
					<span class="muted">(target { fmtNum(m.Target) })</span>
				</li>
			}
		</ol>
	</details>
}

// highlightList shows a Goal's Highlights, newest first, each with its kind,
// note, the Owner credited, and when it was flagged (CONTEXT.md: Highlight).
templ highlightList(highlights []domain.Highlight) {
	<ul>
		if len(highlights) == 0 {
			<li data-testid="no-highlights">No Highlights yet.</li>
		}
		for _, hl := range highlights {
			<li data-testid="highlight">
				<strong>{ hl.Kind }</strong>: { hl.Note }
				<span>
					{ "— " }
					@person(hl.Owner)
					{ " at " + hl.CreatedAt.Format("2006-01-02 15:04") }
				</span>
			</li>
		}
	</ul>
}

// metricFields is the shared set of Metric inputs, prefilled from m for editing.
templ metricFields(m domain.Metric) {
	<label>
		Name
		<input type="text" name="name" value={ m.Name } required/>
	</label>
	<label>
		Unit
		<input type="text" name="unit" value={ m.Unit } required/>
	</label>
	<label>
		Direction
		<select name="direction">
			<option value={ domain.MetricUp } selected?={ m.Direction == domain.MetricUp }>up</option>
			<option value={ domain.MetricDown } selected?={ m.Direction == domain.MetricDown }>down</option>
		</select>
	</label>
	<label>
		Baseline
		<input type="number" step="any" name="baseline" value={ fmtNum(m.Baseline) } required/>
	</label>
	<label>
		Target
		<input type="number" step="any" name="target" value={ fmtNum(m.Target) } required/>
	</label>
	<label>
		Target date
		<input type="date" name="target_date" value={ fmtDate(m.TargetDate) } required/>
	</label>
}

// linkList renders a Goal's parents or children as navigable links, each with
// its Health and a button to remove the connecting link that asks for
// confirmation first. emptyTestID/emptyText render when there are none.
templ linkList(links []domain.GoalLink, health map[int64]string, emptyTestID, emptyText string) {
	<ul class="gp-list">
		if len(links) == 0 {
			<li data-testid={ emptyTestID } class="muted">{ emptyText }</li>
		}
		for _, l := range links {
			<li class="gp-link">
				<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", l.Goal.ID)) }>{ l.Goal.Title }</a>
				<span class="gp-link-meta">
					if h := health[l.Goal.ID]; h != "" {
						<span class={ "badge", healthClass(h) }><span class="dot"></span>{ h }</span>
					} else {
						<span class="badge lc">{ l.Goal.Lifecycle }</span>
					}
					if l.Goal.Ownerless {
						<span data-testid="ownerless" class="badge ol">Ownerless</span>
					}
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/links/%d/remove", l.LinkID)) } onsubmit={ confirmScript(confirmRemoveLink) }>
						<button type="submit" class="btn quiet sm">Remove</button>
					</form>
				</span>
				<span class="muted small">
					{ "Owner " }
					@person(l.Goal.Owner)
				</span>
			</li>
		}
	</ul>
}

// confirmRemoveLink is what someone confirms before removing a "contributes to"
// link.
const confirmRemoveLink = "Remove this link? The child Goal will no longer contribute to the parent."
