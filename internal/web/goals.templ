package web

import (
	"fmt"
	"strings"
	"time"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// goalsPage is the Goal list an exec scans in seconds: a header offering New
// goal, the filter bar, and the Goals as a table led by Health, problems first
// (CONTEXT.md: filter and group Goals). New goal links to the New goal page.
templ goalsPage(current *domain.Account, view goalsListData) {
	@layout("Goals", current) {
		@goalsStyles()
		<header data-testid="goals-head" class="page-head">
			<div>
				<h1>Goals</h1>
				<p class="muted">Every goal in the org. Problems sort to the top.</p>
			</div>
			<a data-testid="new-goal" class="btn primary" href="/goals/new">New goal</a>
		</header>
		@goalFilters(view)
		@goalList(view)
	}
}

// goalFilters is the filter bar — search, Health, Lifecycle, Mine only and
// Incomplete — with the Dimension filters and Group by folded under More
// filters, all submitted as a GET so the chosen slice lives in the URL.
//
// Under htmx the form applies itself (#94): a change, a pause in typing the
// search, or Enter GETs the view and swaps in only the list, so the form keeps
// its focus and an open More filters, and pushes the address.
// hx-history="false" keeps htmx from snapshotting the page, whose form controls
// would come back unchosen: Back loads the earlier address afresh instead.
templ goalFilters(view goalsListData) {
	<form
		method="get"
		action="/goals"
		data-testid="goal-filters"
		class="gl-filters"
		hx-get="/goals"
		hx-trigger="submit, change[target.type!='search'], input[target.type=='search'] delay:400ms"
		hx-target="#goal-list"
		hx-select="#goal-list"
		hx-swap="outerHTML"
		hx-push-url="true"
		hx-sync="this:replace"
		hx-history="false"
	>
		<div class="gl-bar">
			<input data-testid="goal-search" type="search" name="q" value={ view.Filter.Query } placeholder="Search title or Owner" aria-label="Search Goals by title or Owner"/>
			<select data-testid="goal-health-filter" name="health" aria-label="Health">
				<option value="" selected?={ view.Filter.Health == "" }>Any Health</option>
				for _, hf := range healthFilters {
					<option value={ hf.Value } selected?={ view.Filter.Health == hf.Value }>
						if hf.Health == "" {
							No Health
						} else {
							{ hf.Health }
						}
					</option>
				}
			</select>
			<select data-testid="goal-lifecycle-filter" name="lifecycle" aria-label="Lifecycle">
				<option value="" selected?={ view.Filter.Lifecycle == "" }>Any Lifecycle</option>
				for _, lc := range lifecycleFilters {
					<option value={ lc } selected?={ view.Filter.Lifecycle == lc }>{ lc }</option>
				}
			</select>
			<label class="gl-mine">
				<input data-testid="goal-mine-filter" type="checkbox" name="mine" value="1" checked?={ view.Filter.Mine }/>
				Mine only
			</label>
			<label class="gl-mine">
				<input data-testid="goal-incomplete-filter" type="checkbox" name="incomplete" value="1" checked?={ view.Filter.Incomplete }/>
				Incomplete
			</label>
			<noscript><button type="submit" class="btn">Apply</button></noscript>
			<a href="/goals" class="btn quiet">Clear</a>
		</div>
		if len(view.Dimensions) > 0 {
			<details data-testid="more-filters" open?={ view.moreFiltersSet() }>
				<summary>More filters</summary>
				for _, d := range view.Dimensions {
					<fieldset>
						<legend>{ d.Name }</legend>
						for _, v := range d.Values {
							<label>
								<input type="checkbox" name="value" value={ fmt.Sprintf("%d", v.ID) } checked?={ view.Selected[v.ID] }/>
								{ v.Value }
								if v.Retired {
									<span>(retired)</span>
								}
							</label>
						}
					</fieldset>
				}
				if view.Table == nil {
					<label>
						Group by
						<select name="group">
							<option value="" selected?={ view.GroupID == 0 }>— none —</option>
							for _, d := range view.Dimensions {
								<option value={ fmt.Sprintf("%d", d.ID) } selected?={ view.GroupID == d.ID }>{ d.Name }</option>
							}
						</select>
					</label>
				}
			</details>
		}
		if view.Table != nil {
			<input type="hidden" name="layout" value="table"/>
			if view.Table.Sort != "" {
				<input type="hidden" name="sort" value={ view.Table.Sort }/>
			}
			if view.Table.Desc {
				<input type="hidden" name="dir" value="desc"/>
			}
			if group := view.Query.Get("group"); group != "" {
				<input type="hidden" name="group" value={ group }/>
			}
		}
	</form>
}

// goalList is the htmx swap target: the Goal list as a table led by Health,
// flat or with a section per value of the grouping Dimension, under a total of
// the Goals it lists. Grouped by a several-values Dimension a Goal can appear in
// more than one section, so the total counts each Goal once (ADR 0005).
templ goalList(view goalsListData) {
	if view.Table != nil {
		@goalTableLayout(view)
	} else {
		@goalListLayout(view)
	}
}

// goalListLayout is the Goal list's list layout, led by Health.
templ goalListLayout(view goalsListData) {
	<div id="goal-list" data-testid="goal-list" class="card">
		@goalListHead(view)
		<table>
			<thead>
				<tr><th>Health</th><th>Goal</th><th>Owner</th><th>Due</th><th>Last check-in</th><th>Dimension tags</th></tr>
			</thead>
			if view.GroupID != 0 {
				if len(view.Groups) == 0 {
					<tbody>
						@noGoals("No Goals match.")
					</tbody>
				}
				for _, grp := range view.Groups {
					<tbody data-testid="goal-group">
						<tr class="gl-group">
							<th data-testid="goal-group-label" colspan="6" scope="colgroup">
								if grp.Value != nil {
									{ grp.Value.Value }
								} else {
									Unassigned
								}
							</th>
						</tr>
						for _, row := range grp.Rows {
							@goalListRow(row)
						}
					</tbody>
				}
			} else {
				<tbody>
					if len(view.Rows) == 0 && view.filtered() {
						@noGoals("No Goals match.")
					} else if len(view.Rows) == 0 {
						@noGoals("No Goals yet.")
					}
					for _, row := range view.Rows {
						@goalListRow(row)
					}
				</tbody>
			}
		</table>
	</div>
}

// goalListHead tops the Goal list with its total and the List / Table toggle,
// whose links keep every filter.
templ goalListHead(view goalsListData) {
	<div class="gl-head">
		<p data-testid="goal-count" class="muted small gl-count">{ goalCount(len(view.Rows)) }</p>
		<nav class="gl-layout" aria-label="Layout">
			<a
				data-testid="layout-list"
				class="btn quiet sm"
				href={ view.layoutURL("") }
				if view.Table == nil {
					aria-current="page"
				}
			>List</a>
			<a
				data-testid="layout-table"
				class="btn quiet sm"
				href={ view.layoutURL(layoutTable) }
				if view.Table != nil {
					aria-current="page"
				}
			>Table</a>
		</nav>
	</div>
}

// noGoals is the Goal list's empty state, spanning the table.
templ noGoals(text string) {
	<tr><td data-testid="no-goals" colspan="6" class="muted">{ text }</td></tr>
}

// goalListRow is one Goal in the list: its Health, its title with the
// Ownerless, freshness and Incomplete marks under it (Incomplete the quietest),
// its Owner, and its Dimension values, a Retired one or one in a Retired
// Dimension marked retired.
templ goalListRow(row goalRow) {
	{{ g := row.Goal }}
	<tr data-testid="goal-row">
		<td>
			if health := row.health(); health != "" {
				<span data-testid="goal-row-health" class={ "badge", healthClass(health) }><span class="dot"></span>{ health }</span>
			} else {
				<span data-testid="goal-row-health" class="badge lc">{ g.Lifecycle }</span>
			}
		</td>
		<td>
			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a>
			if g.Ownerless || row.Freshness.Stale || row.Freshness.PathToGreenOverdue || len(row.Incomplete) > 0 {
				<div class="gl-marks">
					if g.Ownerless {
						<span data-testid="ownerless" class="badge ol">Ownerless</span>
					}
					@goalRowFreshness(row.Freshness)
					if len(row.Incomplete) > 0 {
						<span data-testid="incomplete" class="badge lc" title={ "No value yet in " + strings.Join(row.Incomplete, ", ") }>Incomplete</span>
					}
				</div>
			}
		</td>
		<td>
			@person(g.Owner)
		</td>
		<td data-testid="goal-row-due" class="num gl-dates">
			if g.DeliveryDate.IsZero() {
				<span class="muted">—</span>
			} else {
				@struckDates(row.PriorDates)
				<span>{ fmtDate(g.DeliveryDate) }</span>
			}
		</td>
		<td data-testid="goal-row-last-checkin" class="muted">{ row.lastCheckin() }</td>
		<td>
			for _, val := range row.Values {
				<span data-testid="goal-value-tag" class="tag">{ val.Value }</span>
				if val.Retired || val.DimensionRetired {
					<span class="muted small" data-testid="retired">(retired)</span>
				}
			}
		</td>
	</tr>
}

// goalTableLayout is the Goal list's table layout: one row per Goal, a column
// per live Dimension and Field, and no totals row (ADR 0005). It scrolls
// sideways inside its own container rather than widening the page, and
// downloads as CSV in the import format (#81). Edit values turns it into one
// plain form, saved by one Save, that sets the Dimension values and Fields of
// the Goals the person may (#80).
templ goalTableLayout(view goalsListData) {
	<div id="goal-list" data-testid="goal-list" class="card">
		@goalListHead(view)
		@goalTableColumns(view)
		<p class="gl-download">
			<a data-testid="goal-table-download" class="btn quiet sm" href={ view.downloadURL() } download>Download CSV</a>
			if !view.Table.Edit {
				<a data-testid="goal-table-edit" class="btn quiet sm" href={ view.editURL() }>Edit values</a>
			}
		</p>
		if view.Table.Edit {
			<form data-testid="goal-table-form" method="post" action={ view.saveURL() } class="gl-edit">
				@goalTableErrors(view.Table)
				<p class="muted small gl-edit-hint">Title, Owner, Health, Lifecycle and delivery date change on each Goal's own page.</p>
				@goalTableGrid(view)
				<div class="gl-edit-actions">
					<button data-testid="goal-table-save" type="submit" class="btn primary">Save</button>
					<a data-testid="goal-table-cancel" class="btn quiet" href={ view.viewURL() }>Cancel</a>
				</div>
			</form>
		} else {
			@goalTableGrid(view)
		}
	</div>
}

// goalTableGrid is the Goal table itself, its sort headers and its rows.
templ goalTableGrid(view goalsListData) {
	<div class="table-scroll">
		<table data-testid="goal-table">
			<thead data-testid="goal-table-head">
				<tr>
					for _, col := range view.Table.Columns {
						<th scope="col" aria-sort={ view.Table.ariaSort(col) }><a href={ view.sortURL(col.Key) }>{ col.Label }</a></th>
					}
				</tr>
			</thead>
			<tbody>
				if len(view.Table.Rows) == 0 {
					<tr><td data-testid="no-goals" colspan={ fmt.Sprintf("%d", len(view.Table.Columns)) } class="muted">No Goals match.</td></tr>
				}
				for _, row := range view.Table.Rows {
					<tr data-testid="goal-table-row">
						for _, col := range view.Table.Columns {
							if view.Table.editsCell(col, row) {
								@goalTableEditCell(view.Table, col, row)
							} else {
								@goalTableCell(col, row, view.Table.Edit)
							}
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// goalTableErrors heads a refused save: nothing was saved, and why.
templ goalTableErrors(t *goalTable) {
	if t.Refusal != "" || len(t.Bad) > 0 {
		<div data-testid="goal-table-errors" class="alert gl-edit-errors" role="alert">
			<strong>Nothing was saved.</strong>
			if t.Refusal != "" {
				<span>{ t.Refusal }</span>
			} else if len(t.Bad) == 1 {
				<span>Fix the marked cell and save again.</span>
			} else {
				<span>Fix the { fmt.Sprintf("%d", len(t.Bad)) } marked cells and save again.</span>
			}
		</div>
	}
}

// goalTableEditCell is a Dimension's or Field's cell in edit mode: the Goal
// page's inputs for it, holding what is saved or what a refused save posted,
// and a refused cell's reason under them.
templ goalTableEditCell(t *goalTable, col tableColumn, row goalTableRow) {
	{{ name := cellName(col, row.Goal.ID) }}
	{{ bad := t.bad(col, row) }}
	{{ label := col.Label + " of " + row.Goal.Title }}
	<td class={ "gl-edit-cell", templ.KV("gl-bad", bad != "") }>
		<input type="hidden" name={ wasPrefix + name } value={ t.was(col, row) }/>
		if col.Field != nil {
			switch col.Field.Type {
				case domain.FieldNumber:
					<input
						type="number"
						step="any"
						name={ name }
						value={ t.fieldInputValue(col, row) }
						aria-label={ label }
						if bad != "" {
							aria-invalid="true"
							aria-describedby={ name + "-error" }
						}
					/>
				case domain.FieldLongText:
					<textarea
						name={ name }
						aria-label={ label }
						if bad != "" {
							aria-invalid="true"
							aria-describedby={ name + "-error" }
						}
					>{ t.fieldInputValue(col, row) }</textarea>
				case domain.FieldDate:
					<input
						type="date"
						name={ name }
						value={ t.fieldInputValue(col, row) }
						aria-label={ label }
						if bad != "" {
							aria-invalid="true"
							aria-describedby={ name + "-error" }
						}
					/>
				default:
					<input
						type="text"
						name={ name }
						value={ t.fieldInputValue(col, row) }
						aria-label={ label }
						if bad != "" {
							aria-invalid="true"
							aria-describedby={ name + "-error" }
						}
					/>
			}
		} else {
			{{ d := *col.Dimension }}
			if d.TakesSeveral() {
				<fieldset
					class="gl-values"
					aria-label={ label }
					if bad != "" {
						aria-describedby={ name + "-error" }
					}
				>
					for _, val := range d.Values {
						if t.offers(col, row, val) {
							<label>
								<input
									type="checkbox"
									name={ name }
									value={ fmt.Sprintf("%d", val.ID) }
									checked?={ t.picks(col, row, val) }
									if bad != "" {
										aria-invalid="true"
									}
								/>
								{ val.Value }
								if val.Retired {
									<span class="muted small">(retired)</span>
								}
							</label>
						}
					}
				</fieldset>
			} else {
				<select
					name={ name }
					aria-label={ label }
					if bad != "" {
						aria-invalid="true"
						aria-describedby={ name + "-error" }
					}
				>
					<option value="">—</option>
					for _, val := range d.Values {
						if t.offers(col, row, val) {
							<option value={ fmt.Sprintf("%d", val.ID) } selected?={ t.picks(col, row, val) }>
								{ val.Value }
								if val.Retired {
									(retired)
								}
							</option>
						}
					}
				</select>
			}
			if d.Extendable() {
				<input type="text" name={ newValueName(row.Goal.ID, d.ID) } value={ t.newValueTyped(col, row) } placeholder="Add a value" aria-label={ "Add a " + col.Label + " value to " + row.Goal.Title }/>
			}
		}
		if bad != "" {
			<p data-testid="cell-error" id={ name + "-error" } class="gl-cell-error">{ bad }</p>
		}
	</td>
}

// goalTableColumns is the Columns control: a tick per column but Title, which
// a plain GET form saves for this browser, so it works without JavaScript.
templ goalTableColumns(view goalsListData) {
	<details data-testid="goal-columns-control" class="gl-columns">
		<summary>Columns</summary>
		<form data-testid="goal-columns" method="get" action="/goals">
			for _, kv := range view.carriedQuery() {
				<input type="hidden" name={ kv[0] } value={ kv[1] }/>
			}
			<input type="hidden" name="columns" value="1"/>
			for _, col := range view.Table.All {
				if col.Key != "title" {
					<label><input type="checkbox" name="show" value={ col.Key } checked?={ !view.Table.Hidden[col.Key] }/>{ col.Label }</label>
				}
			}
			<button type="submit" class="btn sm">Apply</button>
		</form>
	</details>
}

// goalTableCell is one row's cell in col, read-only. In edit mode the Health,
// Lifecycle and delivery date link to the Goal, whose page changes them; an
// empty cell has no link. The Owner stays the person control, which a link
// can't hold, and the Title already links to the Goal.
templ goalTableCell(col tableColumn, row goalTableRow, edit bool) {
	{{ g := row.Goal }}
	switch col.Key {
		case "title":
			<td><a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a></td>
		case "owner":
			<td>
				@person(g.Owner)
			</td>
		case "health":
			<td>
				if health := row.health(); health != "" {
					@goalLinkIf(edit, g) {
						<span class={ "badge", healthClass(health) }><span class="dot"></span>{ health }</span>
					}
				}
			</td>
		case "lifecycle":
			<td>
				@goalLinkIf(edit, g) {
					{ g.Lifecycle }
				}
			</td>
		case "due":
			<td class="num">
				if !g.DeliveryDate.IsZero() {
					@goalLinkIf(edit, g) {
						@struckDates(row.PriorDates)
						{ fmtDate(g.DeliveryDate) }
					}
				}
			</td>
		case "checkin":
			<td class="muted">
				if row.Latest != nil {
					{ row.lastCheckin() }
				}
			</td>
		default:
			<td class={ templ.KV("num", col.Field != nil && col.Field.Type == domain.FieldNumber), templ.KV("gl-long", col.Field != nil && col.Field.Type == domain.FieldLongText) }>{ col.text(row) }</td>
	}
}

// goalLinkIf links its content to the Goal when link is true.
templ goalLinkIf(link bool, g domain.Goal) {
	if link {
		<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>
			{ children... }
		</a>
	} else {
		{ children... }
	}
}

// goalsStyles are the Goal list's own rules on top of app.css: the one-row
// filter bar, the table's group headers and marks,
// and the table layout's toggle, Columns control, sort headers and edit mode.
templ goalsStyles() {
	<style>
		.gl-filters{display:flex;flex-direction:column;gap:8px}
		.gl-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
		.gl-bar input[type=search]{flex:1;min-width:200px}
		.gl-mine{display:inline-flex;align-items:center;gap:8px;white-space:nowrap}
		.gl-filters details{padding:0 4px}
		.gl-filters details>summary{justify-content:flex-start;color:var(--color-primary-strong);font-weight:600}
		.gl-filters fieldset{display:inline-flex;flex-wrap:wrap;gap:4px 12px;border:1px solid var(--color-border);border-radius:var(--radius-md);margin:0 8px 8px 0;padding:8px 12px}
		.gl-count{margin:0;padding:8px 12px}
		.gl-group th{background:var(--color-surface-alt);color:var(--color-ink);font-size:13px;font-weight:600;letter-spacing:0;text-transform:none}
		.gl-dates>*{white-space:nowrap}
		.gl-marks{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px}
		#goal-list td .tag{margin:4px 4px 4px 0}
		.gl-head{display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap;padding-right:12px}
		.gl-layout{display:inline-flex;gap:4px}
		.gl-layout a[aria-current=page]{background:var(--color-primary-subtle);color:var(--color-ink)}
		.gl-columns{padding:0 12px}
		.gl-download{margin:0;padding:0 12px 8px}
		.gl-columns>summary{justify-content:flex-start;color:var(--color-primary-strong);font-weight:600}
		.gl-columns form{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;padding-bottom:12px}
		.gl-columns label{display:inline-flex;align-items:center;gap:8px}
		#goal-list th a{color:inherit;text-decoration:none}
		#goal-list th[aria-sort=ascending] a::after{content:" ↑"}
		#goal-list th[aria-sort=descending] a::after{content:" ↓"}
		.table-scroll td{white-space:nowrap}
		.table-scroll td.gl-long{white-space:normal;min-width:240px}
		.gl-edit-hint{margin:0;padding:0 12px 8px}
		.gl-edit-errors{margin:0 12px 12px;color:var(--color-danger-ink)}
		.gl-edit-actions{display:flex;gap:8px;padding:12px}
		.gl-edit-cell{vertical-align:top}
		.gl-edit-cell input[type=number]{width:128px}
		.gl-edit-cell input[type=text]{min-width:160px}
		.gl-edit-cell input[type=text]+input[type=text],.gl-edit-cell select+input[type=text],.gl-edit-cell fieldset+input[type=text]{margin-top:4px;display:block}
		.gl-edit-cell textarea{min-width:240px}
		.gl-values{display:flex;flex-direction:column;gap:4px;border:0;margin:0;padding:0}
		.gl-values label{display:inline-flex;align-items:center;gap:8px}
		.gl-cell-error{margin:4px 0 0;max-width:240px;white-space:normal;font-size:13px;color:var(--color-danger-ink)}
	</style>
}

// goalPage shows a single Goal: a header summarizing it with every action in
// reach and its So What beneath, then its latest status, Metrics, Milestones,
// Highlights and history in the main column, and its links, people,
// Dimension values and Fields in the sidebar. Only the latest status, each Metric and
// Milestones are cards; the rest sit on the canvas under a rule.
templ goalPage(current *domain.Account, v goalView) {
	{{ g := v.Goal }}
	{{ owner := current != nil && current.ID == g.Owner.ID }}
	{{ admin := current != nil && current.IsAdmin }}
	@layout(g.Title, current) {
		@goalPageStyles()
		if g.Ownerless {
			<p data-testid="goal-ownerless" class="alert ol" role="alert"><strong>Ownerless</strong><span>this Goal's Owner has left the org and it needs an Admin to reassign it.</span></p>
		}
		<nav data-testid="goal-breadcrumb" class="small muted" aria-label="Breadcrumb">
			<a href="/goals">Goals</a>
			{ " / " }
			if len(v.Parents) > 0 {
				<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", v.Parents[0].Goal.ID)) }>{ v.Parents[0].Goal.Title }</a>
				{ " / " }
			}
			<span aria-current="page">{ g.Title }</span>
		</nav>
		@goalFreshness(g.ID, v.Freshness, v.CanCheckin)
		@goalSignals(v.Signals)
		@goalIncomplete(v.Incomplete)
		@goalHead(v, owner, admin)
		@toastNotice(v.Toast)
		<div class="grid-main-aside">
			<div data-testid="goal-main" class="gp-col">
				if owner && g.Lifecycle == domain.LifecycleProposed {
					@defineGoal(v)
				}
				@checkinSection(v)
				<section data-testid="goal-metrics" class="gp-block">
					<h2>Metrics</h2>
					@metricList(v.Trends, owner)
				</section>
				<section data-testid="goal-milestones" class="card gp-card">
					<h3>Milestones</h3>
					@milestoneList(v, owner && g.Lifecycle == domain.LifecycleProposed)
				</section>
				<section data-testid="goal-highlights" class="gp-block ruled">
					<h2>Highlights</h2>
					@highlightList(v.Highlights)
				</section>
				@goalHistory(v.History)
			</div>
			<aside data-testid="goal-sidebar" class="gp-col gp-side">
				<section data-testid="goal-parents" class="gp-block ruled">
					@groupHead(v, formParentLink, "+ Add", "Add a parent Goal") {
						<h3>Contributes to</h3>
					}
					@linkList(g.ID, v.Parents, v.LinkHealth, "no-parents", "This Goal contributes to nothing yet.")
					@requestParentLink(v)
					@suggestedParents(v)
				</section>
				<section data-testid="goal-children" class="gp-block ruled">
					<h3>Contributed to by</h3>
					@linkList(g.ID, v.Children, v.LinkHealth, "no-children", "Nothing contributes to this Goal yet.")
				</section>
				<div data-testid="goal-people" class="gp-block ruled">
					<h3>People</h3>
					<p>
						<span class="label">Owner</span>
						<br/>
						@person(g.Owner)
					</p>
					@ownerForms(v)
					@delegatesSection(v)
					<section data-testid="goal-contributors">
						@groupHead(v, formContributors, "Manage", "Manage Contributors") {
							<h3 class="label">Contributors</h3>
						}
						<ul class="gp-list">
							if len(v.Contributors) == 0 {
								<li data-testid="no-contributors" class="muted">No Contributors yet.</li>
							}
							for _, c := range v.Contributors {
								<li>
									@person(c)
								</li>
							}
						</ul>
						if v.opens(formContributors) {
							@openGoalForm(v, formContributors, "Add a Contributor") {
								<form data-testid="add-contributor" class="gp-inline" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/contributors", g.ID)) }>
									<input type="email" name="email" value={ v.FormInput.Get("email") } aria-label="Contributor email" placeholder="Contributor email" required autofocus/>
									<button type="submit" class="btn sm">Add Contributor</button>
								</form>
							}
						}
					</section>
				</div>
				<section data-testid="goal-dimensions" class="gp-block ruled">
					@groupHead(v, formDimensions, "Edit", "Edit Dimensions") {
						<h3>Dimensions</h3>
					}
					@goalDimensions(v)
				</section>
				<section data-testid="goal-field-block" class="gp-block ruled">
					@groupHead(v, formFields, "Edit", "Edit Fields") {
						<h3>Fields</h3>
					}
					@goalFields(v)
				</section>
			</aside>
		</div>
	}
}

// goalHead is the Goal's summary a reader takes in at a glance: its title, its
// So What as a lead paragraph, and one metadata line — the Health badge, then
// the Lifecycle, Kind, Owner, delivery date with its slips struck, cadence and
// Top-level as plain text — with Check in and No change top right for whoever
// may check in. Dimension values and Fields stay in the sidebar.
templ goalHead(v goalView, owner, admin bool) {
	{{ g := v.Goal }}
	<header data-testid="goal-head" class="gp-head">
		<div class="gp-summary">
			<h1 data-testid="goal-title">{ g.Title }</h1>
			<article data-testid="goal" class="gp-statement" aria-labelledby="so-what-label">
				<h2 id="so-what-label" class="sr-only">So What</h2>
				<p data-testid="goal-so-what" class="gp-lead">{ g.SoWhat }</p>
				<button type="button" class="disclose help explain gp-lead-help" aria-expanded="false" aria-controls="so-what-help" title={ soWhatHelp }>What is a So What?</button>
				<p id="so-what-help" class="explain" hidden>{ soWhatHelp }</p>
			</article>
			<p data-testid="goal-meta" class="gp-meta">
				if health := v.health(); health != "" {
					<span class={ "badge", healthClass(health) }><span class="dot"></span>{ health }</span>
				}
				<span data-testid="goal-lifecycle">{ g.Lifecycle }</span>
				<span data-testid="goal-kind">
					if g.Kind == "" {
						Not yet Dated or Ongoing
					} else {
						{ g.Kind }
					}
				</span>
				<span>
					Owner 
					<strong data-testid="goal-owner">
						@person(g.Owner)
					</strong>
				</span>
				if !g.DeliveryDate.IsZero() {
					<span>
						Delivers 
						<span data-testid="goal-delivery-date" class="gp-dates">
							@struckDates(v.priorDates(0))
							<strong>{ fmtDate(g.DeliveryDate) }</strong>
						</span>
					</span>
				}
				<span>Checks in <span data-testid="goal-cadence">every { fmt.Sprintf("%d", g.CadenceDays) } days</span></span>
				if g.TopLevel {
					<span><button type="button" class="disclose help" data-testid="goal-top-level" aria-expanded="false" aria-controls="top-level-help" title={ topLevelHelp }>Top-level</button></span>
				}
			</p>
			if g.TopLevel {
				<p id="top-level-help" class="explain" hidden>{ topLevelHelp }</p>
			}
			if note := v.lifecycleNote(); note != "" {
				<p data-testid="goal-lifecycle-note" class="muted">{ note }</p>
			}
			if v.opens(formTopLevel) {
				@openGoalForm(v, formTopLevel, "") {
					@topLevelControl(g)
				}
			}
		</div>
		<div data-testid="goal-actions" class="gp-actions">
			if v.CanCheckin && (g.Lifecycle == domain.LifecycleActive || g.Lifecycle == domain.LifecycleOnHold) {
				<a class="btn primary" data-testid="checkin-link" href={ templ.SafeURL(fmt.Sprintf("/goals/%d/checkin", g.ID)) }>Check in</a>
				if g.Lifecycle == domain.LifecycleActive && v.LatestCheckin != nil {
					@noChangeCheckinButton(g.ID, "No change", "btn quiet")
				}
			}
			@goalMore(v)
		</div>
	</header>
}

// goalPageStyles are the Goal page's own rules on top of app.css: the header
// with its actions and More menu, the main column and sidebar, the Milestone
// dates, each kept whole on its line, and the Metric cards.
templ goalPageStyles() {
	<style>
		.gp-head{display:flex;justify-content:space-between;align-items:flex-start;gap:24px;flex-wrap:wrap}
		.gp-dates>*{white-space:nowrap}
		.gp-summary{display:flex;flex-direction:column;gap:12px;min-width:0;flex:1 1 320px}
		.gp-summary h1{margin:0}
		.gp-statement{display:flex;flex-direction:column;align-items:flex-start;gap:4px;max-width:720px}
		.gp-lead{margin:0;font-size:18px;line-height:1.55;color:var(--color-ink)}
		.gp-lead-help{font-size:13px}
		.gp-meta{display:flex;flex-wrap:wrap;gap:4px 8px;align-items:center;margin:0;color:var(--color-ink-muted)}
		.gp-meta>*+*::before{content:"·";margin-right:8px;color:var(--color-ink-muted)}
		.gp-meta strong{color:var(--color-ink)}
		.gp-actions{display:flex;gap:8px;align-items:flex-start;margin-left:auto}
		.gp-actions form{margin:0}
		.gp-more{position:relative}
		.gp-more>summary{justify-content:center}
		.gp-menu{position:absolute;right:0;top:48px;z-index:10;width:240px;max-width:calc(100vw - 32px);padding:8px;box-shadow:var(--shadow-pop);box-sizing:border-box}
		.gp-menu ul{list-style:none;margin:0;padding:0}
		.gp-menu li>a{display:flex;min-height:36px;padding:0 12px;border-radius:var(--radius-md);align-items:center;color:var(--color-ink);font-weight:500}
		.gp-menu li>a:hover{background:var(--color-primary-subtle);text-decoration:none}
		.gp-group-head{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
		.gp-group-head>h3{margin:0}
		.gp-open{display:flex;flex-direction:column;align-items:flex-start;gap:8px}
		.gp-open form{align-self:stretch}
		.gp-col{display:flex;flex-direction:column;gap:20px;min-width:0}
		.gp-card{padding:24px;display:flex;flex-direction:column;gap:12px}
		.gp-block{display:flex;flex-direction:column;gap:12px}
		@media (max-width:900px){.gp-side>.ruled:first-child{border-top:1px solid var(--color-border);padding-top:20px}}
		.gp-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
		.gp-inline{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px}
		.gp-values{border:0;margin:0;padding:0;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
		.gp-form{display:flex;flex-direction:column;gap:12px}
		.gp-edit form{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
		.gp-link{display:flex;flex-direction:column;gap:4px}
		.gp-link-meta{display:flex;align-items:center;gap:8px;flex-wrap:wrap}
		.gp-link-meta form{margin:0 0 0 auto}
		.gp-decide{display:flex;gap:8px;margin-left:auto}
		.gp-link-meta .gp-decide form{margin:0}
		.gp-metric-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
		.gp-current .num{font-size:28px;line-height:1.1}
		.gp-spark{max-width:100%;height:auto;display:block;overflow:visible}
		.gp-spark-target{stroke:var(--color-ink-muted)}
		.gp-spark-line{stroke:var(--color-primary-strong)}
		.gp-spark-last{fill:var(--color-primary-strong);stroke:var(--color-surface)}
		.gp-edit form{flex-direction:column}
		.gp-activation{display:flex;flex-direction:column;gap:4px;padding-top:12px;border-top:1px solid var(--color-border)}
		.gp-check{display:flex;gap:8px;align-items:baseline}
		.gp-check>span:first-child{width:16px;font-weight:600;color:var(--health-r-ink)}
		.gp-check.done>span:first-child{color:var(--health-g-ink)}
		.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
	</style>
}

// goalMore is the header's action menu, a "⋯" disclosure: every action on the
// Goal the viewer may take beyond checking in, each a plain link that reloads
// the page with that action's form open where it belongs (goalView.openURL).
// It holds no forms, and is left out when it would be empty.
templ goalMore(v goalView) {
	if actions := v.actions(); len(actions) > 0 {
		<details data-testid="goal-more" class="gp-more">
			<summary class="btn" aria-label="More actions" title="More actions">⋯</summary>
			<div class="card gp-menu">
				<ul>
					for _, a := range actions {
						<li><a href={ a.URL }>{ a.Label }</a></li>
					}
				</ul>
			</div>
		</details>
	}
}

// openGoalForm wraps the one form the Goal page shows open in place (goalForm):
// a label naming it, why its last submit was refused, the form itself, and a
// Cancel back to the plain page. The form's first control takes autofocus, so
// the page lands on it.
templ openGoalForm(v goalView, form goalForm, title string) {
	<section class="gp-open" data-open-form={ string(form) } aria-label={ title }>
		if title != "" {
			<h3 class="label">{ title }</h3>
		}
		if v.FormError != "" {
			<p data-testid="form-error" class="alert r" role="alert">{ v.FormError }</p>
		}
		{ children... }
		<a data-testid="cancel-form" class="btn quiet sm" href={ templ.SafeURL(fmt.Sprintf("/goals/%d", v.Goal.ID)) }>Cancel</a>
	</section>
}

// groupHead is a sidebar group's heading with, for whoever may use it, a small
// link beside it that opens the group's form in place (goalForm), hidden while
// that form is open. linkName is the link's accessible name, which holds its
// visible text.
templ groupHead(v goalView, form goalForm, link, linkName string) {
	<div class="gp-group-head">
		{ children... }
		if v.offers(form) && !v.opens(form) {
			<a data-testid={ "open-" + string(form) } class="small" href={ v.openURL(form) } aria-label={ linkName }>{ link }</a>
		}
	</div>
}

// ownerForms are the open-in-place forms about the Goal's Owner, under them in
// the People block: Hand off, and for an Admin Reassign, Mark owner departed
// and Mark returned, the last two asking for confirmation.
templ ownerForms(v goalView) {
	{{ g := v.Goal }}
	if v.opens(formHandoff) {
		@openGoalForm(v, formHandoff, "Hand off") {
			<form data-testid="handoff-goal" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/handoff", g.ID)) } class="gp-form">
				<label class="field">
					<span>New Owner's email</span>
					<input type="email" name="to_email" value={ v.FormInput.Get("to_email") } required autofocus/>
				</label>
				<button type="submit" class="btn">Start handoff</button>
			</form>
		}
	}
	if v.opens(formReassign) {
		@openGoalForm(v, formReassign, "Reassign") {
			<form data-testid="reassign-goal" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/reassign", g.ID)) } class="gp-form">
				<label class="field">
					<span>New Owner's email</span>
					<input type="email" name="email" value={ v.FormInput.Get("email") } required autofocus/>
				</label>
				<button type="submit" class="btn">Reassign</button>
			</form>
		}
	}
	if v.opens(formDepart) {
		@openGoalForm(v, formDepart, "Mark owner departed") {
			<p class="small muted">
				@person(g.Owner)
				{ " has left the org." }
			</p>
			<form data-testid="depart-owner" method="post" action={ templ.SafeURL(fmt.Sprintf("/accounts/%d/depart", g.Owner.ID)) } onsubmit={ confirmScript(confirmDepart) }>
				<button type="submit" class="btn danger" autofocus>
					{ "Mark " }
					@personPlain(g.Owner)
					{ " departed" }
				</button>
			</form>
		}
	}
	if v.opens(formReturn) {
		@openGoalForm(v, formReturn, "Mark returned") {
			<p class="small muted">
				@person(g.Owner)
				{ " is back in the org." }
			</p>
			<form data-testid="return-owner" method="post" action={ templ.SafeURL(fmt.Sprintf("/accounts/%d/return", g.Owner.ID)) } onsubmit={ confirmScript(confirmReturn) }>
				<button type="submit" class="btn" autofocus>
					{ "Mark " }
					@personPlain(g.Owner)
					{ " returned" }
				</button>
			</form>
		}
	}
}

// soWhatHelp defines So What on the Goal page, opened from its heading.
const soWhatHelp = "The customer problem this Goal addresses and what is expected to change when it succeeds."

// topLevelHelp says what Top-level means, opened from the Goal page's badge.
const topLevelHelp = "One of the org's root outcomes"

// confirmDepart is what an Admin confirms before marking a Goal's Owner departed.
const confirmDepart = "Mark this Owner departed? Every Goal they own becomes Ownerless until an Admin reassigns it."

// confirmReturn is what an Admin confirms before reversing a Goal's Owner's
// departure.
const confirmReturn = "Mark this Owner returned? They can sign in again, and the Goals they still own stop being Ownerless. Goals reassigned while they were away stay with their new Owners."

// goalDimensions shows the Goal's values in each Dimension as tags — retired
// values stay readable — and, for its Owner, a Delegate or an Admin, a form
// to set them that opens in place from the block's Edit link:
// a select for a Dimension that takes one value, whose "None" clears it, and a
// checkbox per value, saved together, for one that takes several (CONTEXT.md:
// Delegate; retired values stay readable). An Extendable Dimension also has an
// input to add a value. A retired value the Goal carries stays selected, or
// keeps its checked box, so saving doesn't silently drop it. A Retired Dimension gets no control and is
// listed only when the Goal carries a value in it, marked retired (CONTEXT.md:
// Retired). It links everyone to the Dimensions page, which isn't in the main
// nav.
templ goalDimensions(v goalView) {
	{{ g := v.Goal }}
	if len(v.Dimensions) == 0 {
		<p data-testid="no-dimensions-defined" class="muted">No Dimensions defined yet.</p>
	}
	<ul class="gp-list">
		for _, d := range v.Dimensions {
			{{ assigned := v.assignedValues(d.ID) }}
			if !d.Retired || len(assigned) > 0 {
				<li data-testid="goal-dimension">
					<span class="label">{ d.Name }</span>
					<br/>
					for _, current := range assigned {
						<span class="tag" data-testid="goal-dimension-value">{ current.Value }</span>
						if current.Retired || d.Retired {
							<span class="muted small" data-testid="retired">(retired)</span>
						}
					}
					if len(assigned) == 0 {
						<span class="muted" data-testid="goal-dimension-unassigned">unassigned</span>
					}
				</li>
			}
		}
	</ul>
	if v.opens(formDimensions) {
		@openGoalForm(v, formDimensions, "Edit Dimension values") {
			for i, d := range domain.OfferedDimensions(v.Dimensions) {
				if d.TakesSeveral() {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/dimensions", g.ID)) } class="gp-inline">
						<input type="hidden" name="dimension_id" value={ fmt.Sprintf("%d", d.ID) }/>
						<fieldset class="gp-values">
							<legend>{ d.Name }</legend>
							for j, val := range v.choices(d) {
								<label>
									<input type="checkbox" name="value_id" value={ fmt.Sprintf("%d", val.ID) } checked?={ v.carries(val) } autofocus?={ i == 0 && j == 0 }/>
									{ val.Value }
									if val.Retired {
										<span class="muted small">(retired)</span>
									}
								</label>
							}
						</fieldset>
						<button type="submit" class="btn sm">Save</button>
					</form>
				} else {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/dimensions", g.ID)) } class="gp-inline">
						<input type="hidden" name="dimension_id" value={ fmt.Sprintf("%d", d.ID) }/>
						<label>
							{ d.Name }
							<select name="value_id" aria-label={ d.Name } autofocus?={ i == 0 }>
								<option value="">None</option>
								for _, val := range v.choices(d) {
									<option value={ fmt.Sprintf("%d", val.ID) } selected?={ v.carries(val) }>{ valueOptionLabel(val) }</option>
								}
							</select>
						</label>
						<button type="submit" class="btn sm">Save</button>
					</form>
				}
				if d.Extendable() {
					@addGoalValue(v, d)
				}
			}
		}
	}
	<p class="small"><a href="/dimensions">All Dimensions →</a></p>
}

// addGoalValue is an Extendable Dimension's "add a value" input beside its
// choices on the Goal page: the value typed is set on the Goal, and added to
// the list first when it's new (CONTEXT.md: Extendable). A refused value comes
// back typed in.
templ addGoalValue(v goalView, d domain.Dimension) {
	<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/dimensions", v.Goal.ID)) } class="gp-inline">
		<input type="hidden" name="dimension_id" value={ fmt.Sprintf("%d", d.ID) }/>
		<input type="text" name="new_value" aria-label={ "Add a " + d.Name + " value" } placeholder={ "Add a " + d.Name + " value" } value={ v.typedFor("dimension_id", d.ID, "new_value") } required/>
		<button type="submit" class="btn sm">Add</button>
	</form>
}

// requestParentLink is the open-in-place form, under Contributes to, by which
// the Owner asks that this Goal contribute to another, with an optional note.
templ requestParentLink(v goalView) {
	if v.opens(formParentLink) {
		@openGoalForm(v, formParentLink, "Link to a parent Goal") {
			<form data-testid="request-link" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/links", v.Goal.ID)) } class="gp-form">
				<label class="field">
					<span>Parent Goal</span>
					<select name="parent_id" required autofocus>
						for _, c := range v.Candidates {
							<option value={ fmt.Sprintf("%d", c.ID) } selected?={ v.FormInput.Get("parent_id") == fmt.Sprintf("%d", c.ID) }>{ c.Title }</option>
						}
					</select>
				</label>
				<label class="field">
					<span>Note (optional)</span>
					<textarea name="note">{ v.FormInput.Get("note") }</textarea>
				</label>
				<button type="submit" class="btn">Request link</button>
			</form>
		}
	}
}

// defineGoal is the Owner's toolkit for a Proposed Goal: the activation
// checklist, Activate Goal once it is done, and Finish defining, which opens
// the define page to set the Kind, cadence, So What, Milestones, Metrics and
// the rest on one form. Contributors are added from the sidebar's
// Contributors group.
templ defineGoal(v goalView) {
	{{ g := v.Goal }}
	<section data-testid="define-goal" class="card gp-card gp-define">
		<h3>Define this Goal</h3>
		<p><a data-testid="finish-defining" class="btn" href={ templ.SafeURL(fmt.Sprintf("/goals/%d/define", g.ID)) }>Finish defining</a></p>
		<div data-testid="activation" class="gp-activation">
			<h3>Ready to activate?</h3>
			<ul data-testid="activation-checklist" class="gp-list">
				for _, item := range v.activationChecklist() {
					if item.Done {
						<li data-done="true" class="gp-check done"><span aria-hidden="true">✓</span> <span>{ item.Label }</span> <span class="muted small">done</span></li>
					} else {
						<li data-done="false" class="gp-check"><span aria-hidden="true">✗</span> <span>{ item.Label }</span> <span class="muted small">missing</span></li>
					}
				}
			</ul>
		</div>
		<form data-testid="activate-goal" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/activate", g.ID)) }>
			<button type="submit" class="btn primary" disabled?={ !v.readyToActivate() }>Activate Goal</button>
		</form>
	</section>
}

// goalIncomplete flags an Incomplete Goal at the top of its page, naming the
// required Dimensions and Fields it has no value in. It is a status, not an
// alarm: quieter than Red and Stale (CONTEXT.md: Incomplete). It renders
// nothing when the Goal lacks none.
templ goalIncomplete(missing []string) {
	if len(missing) > 0 {
		<p data-testid="goal-incomplete" class="alert lc" role="status"><strong>Incomplete</strong><span>{ "no value yet in " + strings.Join(missing, ", ") }</span></p>
	}
}

// milestoneList is a Goal's Milestones as a table of status, name, and date
// with its history struck through (CONTEXT.md: Date Slip), headed by the Goal's
// slip count and Milestone Churn. editable gives the Owner of a Proposed Goal an
// edit form on each; once Active, Milestones change in a Check-in.
templ milestoneList(v goalView, editable bool) {
	<p class="muted small">
		<span data-testid="goal-slip-count">{ fmt.Sprintf("%d", len(v.DateSlips)) }</span> slips
		·
		<span data-testid="goal-milestone-churn">{ fmt.Sprintf("%d", v.MilestoneChurn) }</span> added or removed since Active
	</p>
	if len(v.Milestones) == 0 {
		<p data-testid="no-milestones" class="muted">No Milestones yet.</p>
	} else {
		<table>
			<thead>
				<tr>
					<th>Status</th>
					<th>Milestone</th>
					<th>Date</th>
					if editable {
						<th><span class="sr-only">Edit</span></th>
					}
				</tr>
			</thead>
			<tbody>
				for _, m := range v.Milestones {
					<tr data-testid="goal-milestone">
						<td><span class="badge lc" data-testid="milestone-status">{ m.Status }</span></td>
						if m.Status == domain.MilestoneRemoved {
							<td>
								<del>{ m.Name }</del>
								if m.RemovedReason != "" {
									<div class="muted small">Removed: { m.RemovedReason }</div>
								}
							</td>
						} else {
							<td>{ m.Name }</td>
						}
						<td class="num gp-dates">
							@struckDates(v.priorDates(m.ID))
							<span>{ fmtDate(m.TargetDate) }</span>
						</td>
						if editable {
							<td>
								<details class="gp-edit">
									<summary class="btn quiet sm">Edit</summary>
									<form method="post" action={ templ.SafeURL(fmt.Sprintf("/milestones/%d", m.ID)) }>
										<input type="text" name="name" value={ m.Name } aria-label="Name" required/>
										<input type="date" name="target_date" value={ fmtDate(m.TargetDate) } aria-label="Date" required/>
										<button type="submit" class="btn sm">Save</button>
									</form>
								</details>
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
	}
}

// struckDates renders the dates a date held before its Date Slips, each struck
// through ahead of the current date: ~~10/15~~ 11/03 (CONTEXT.md: Date Slip).
templ struckDates(dates []time.Time) {
	for _, d := range dates {
		<del>{ fmtDate(d) }</del>{ " " }
	}
}

// milestoneMarkBadge is a Milestone's mark (domain.MilestoneMarkOf) as a
// badge, Red and Yellow in their Health colours though they are not a Health,
// or nothing when it has none and reads as on track (CONTEXT.md: Milestone).
templ milestoneMarkBadge(mark string) {
	if mark != domain.MilestoneMarkNone {
		<span data-testid="milestone-mark" class={ "badge", healthClass(mark) }>{ mark }</span>
	}
}

// milestoneDates renders a Milestone's date current first, then the most
// recent date it slipped from struck through, and the number of times it
// slipped once that is more than one: 11/20 ~~11/03~~ (3) (CONTEXT.md: Date
// Slip). prior comes earliest first.
templ milestoneDates(current time.Time, prior []time.Time) {
	<span>{ fmtDate(current) }</span>
	if n := len(prior); n > 0 {
		<del>{ fmtDate(prior[n-1]) }</del>
	}
	if n := len(prior); n > 1 {
		<span data-testid="milestone-slips">{ fmt.Sprintf("(%d)", n) }</span>
	}
}

// metricList shows each of a Goal's Metrics as a card: its current value, its
// baseline and target, and its trend over time against the target (CONTEXT.md:
// the Goal page shows each Metric's trend); the Owner edits one in a collapsed
// section.
templ metricList(trends []metricTrend, owner bool) {
	if len(trends) == 0 {
		<p data-testid="no-metrics" class="muted">No Metrics yet.</p>
	}
	for _, t := range trends {
		{{ m := t.Metric }}
		<div data-testid="goal-metric" class="card gp-card gp-metric">
			<div class="gp-metric-head">
				<div>
					<h3>{ m.Name }</h3>
					<p class="muted small">{ fmtNum(m.Baseline) } → { fmtNum(m.Target) } { m.Unit } by { fmtDate(m.TargetDate) }</p>
				</div>
				<p class="gp-current">
					if v, ok := t.current(); ok {
						<span class="num" data-testid="metric-current">{ fmtNum(v) }</span> <span class="muted">{ m.Unit }</span>
					} else {
						<span class="num muted" data-testid="metric-current">—</span>
					}
				</p>
			</div>
			if len(t.Readings) > 0 {
				@metricSparkline(t)
			}
			@metricTrendReadings(t)
			if owner {
				<details data-testid="metric-edit" class="gp-edit">
					<summary class="small">Edit Metric</summary>
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/metrics/%d", m.ID)) }>
						@metricFields(m)
						<button type="submit" class="btn sm">Save</button>
					</form>
				</details>
			}
		</div>
	}
}

// metricSparkline draws a Metric's readings as a line, the latest point marked,
// over a dashed line at its target, each point naming its reading on hover.
templ metricSparkline(t metricTrend) {
	{{ s := t.sparkline() }}
	<svg class="gp-spark" role="img" aria-label={ t.trendLabel() } viewBox={ fmt.Sprintf("0 0 %g %g", sparkW, sparkH) } width={ fmt.Sprintf("%g", sparkW) } height={ fmt.Sprintf("%g", sparkH) }>
		<line x1="0" x2={ fmt.Sprintf("%g", sparkW) } y1={ fmt.Sprintf("%.1f", s.TargetY) } y2={ fmt.Sprintf("%.1f", s.TargetY) } class="gp-spark-target" stroke-width="1" stroke-dasharray="4 3"></line>
		<polyline points={ s.polyline() } class="gp-spark-line" fill="none" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></polyline>
		for _, p := range s.Points {
			<circle cx={ fmt.Sprintf("%.1f", p.X) } cy={ fmt.Sprintf("%.1f", p.Y) } r="6" fill="transparent"><title>{ p.Title }</title></circle>
		}
		<circle cx={ fmt.Sprintf("%.1f", s.last().X) } cy={ fmt.Sprintf("%.1f", s.last().Y) } r="4" class="gp-spark-last" stroke-width="2"><title>{ s.last().Title }</title></circle>
	</svg>
}

// metricTrendReadings lists a Metric's readings over time against its target —
// the sparkline as a table a reader can scan — collapsed under a count
// (CONTEXT.md: Metric - its current value is recorded at each Check-in).
templ metricTrendReadings(t metricTrend) {
	{{ m := t.Metric }}
	<details>
		<summary class="small muted">{ fmt.Sprintf("Readings (%d)", len(t.Readings)) }</summary>
		<ol data-testid="metric-trend" class="gp-list small">
			if len(t.Readings) == 0 {
				<li data-testid="no-readings">No readings yet.</li>
			}
			for _, rd := range t.Readings {
				<li data-testid="metric-reading">
					<span class="num">{ rd.CreatedAt.Format("2006-01-02") }: { fmtNum(rd.Value) } { m.Unit }</span>
					<span class="muted">(target { fmtNum(m.Target) })</span>
				</li>
			}
		</ol>
	</details>
}

// highlightList shows a Goal's Highlights, newest first, each with its kind,
// note, the Owner credited, and when it was flagged (CONTEXT.md: Highlight).
templ highlightList(highlights []domain.Highlight) {
	<ul>
		if len(highlights) == 0 {
			<li data-testid="no-highlights">No Highlights yet.</li>
		}
		for _, hl := range highlights {
			<li data-testid="highlight">
				<strong>{ hl.Kind }</strong>: { hl.Note }
				<span>
					{ "— " }
					@person(hl.Owner)
					{ " at " + hl.CreatedAt.Format("2006-01-02 15:04") }
				</span>
			</li>
		}
	</ul>
}

// metricFields is the shared set of Metric inputs, prefilled from m for editing.
templ metricFields(m domain.Metric) {
	<label>
		Name
		<input type="text" name="name" value={ m.Name } required/>
	</label>
	<label>
		Unit
		<input type="text" name="unit" value={ m.Unit } required/>
	</label>
	<label>
		Direction
		<select name="direction">
			<option value={ domain.MetricUp } selected?={ m.Direction == domain.MetricUp }>up</option>
			<option value={ domain.MetricDown } selected?={ m.Direction == domain.MetricDown }>down</option>
		</select>
	</label>
	<label>
		Baseline
		<input type="number" step="any" name="baseline" value={ fmtNum(m.Baseline) } required/>
	</label>
	<label>
		Target
		<input type="number" step="any" name="target" value={ fmtNum(m.Target) } required/>
	</label>
	<label>
		Target date
		<input type="date" name="target_date" value={ fmtDate(m.TargetDate) } required/>
	</label>
}

// linkList renders Goal goalID's parents or children as navigable links, each
// with its Health and a button that removes the connecting link at once: the
// page that follows offers Undo. emptyTestID/emptyText render when there are
// none.
templ linkList(goalID int64, links []domain.GoalLink, health map[int64]string, emptyTestID, emptyText string) {
	<ul class="gp-list">
		if len(links) == 0 {
			<li data-testid={ emptyTestID } class="muted">{ emptyText }</li>
		}
		for _, l := range links {
			<li class="gp-link">
				<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", l.Goal.ID)) }>{ l.Goal.Title }</a>
				<span class="gp-link-meta">
					if h := health[l.Goal.ID]; h != "" {
						<span class={ "badge", healthClass(h) }><span class="dot"></span>{ h }</span>
					} else {
						<span class="badge lc">{ l.Goal.Lifecycle }</span>
					}
					if l.Goal.Ownerless {
						<span data-testid="ownerless" class="badge ol">Ownerless</span>
					}
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/links/%d/remove", l.LinkID)) }>
						<input type="hidden" name="goal_id" value={ fmt.Sprint(goalID) }/>
						<button type="submit" class="btn quiet sm">Remove</button>
					</form>
				</span>
				<span class="muted small">
					{ "Owner " }
					@person(l.Goal.Owner)
				</span>
			</li>
		}
	</ul>
}
