package web

import (
	"fmt"
	"time"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// goalsPage lists every Goal, offers the create-Goal form, and lets the reader
// filter and group the list by Dimension values (CONTEXT.md: filter and group
// Goals).
templ goalsPage(current *domain.Account, view goalsListData) {
	@layout("Goals", current) {
		<h1>Goals</h1>
		<section>
			<h2>Propose a Goal</h2>
			<form hx-post="/goals" hx-target="#goal-list" hx-swap="outerHTML" method="post" action="/goals">
				<label>
					Title
					<input type="text" name="title" required/>
				</label>
				<label>
					So What
					<textarea name="so_what" required></textarea>
				</label>
				<button type="submit">Create Goal</button>
			</form>
		</section>
		@goalFilters(view)
		@goalList(view)
	}
}

// goalFilters offers the filter checkboxes and the group-by selector, submitted
// as a GET so the chosen slice lives in the URL.
templ goalFilters(view goalsListData) {
	if len(view.Dimensions) > 0 {
		<form method="get" action="/goals" data-testid="goal-filters">
			for _, d := range view.Dimensions {
				<fieldset>
					<legend>{ d.Name }</legend>
					for _, v := range d.Values {
						<label>
							<input type="checkbox" name="value" value={ fmt.Sprintf("%d", v.ID) } checked?={ view.Selected[v.ID] }/>
							{ v.Value }
							if v.Retired {
								<span>(retired)</span>
							}
						</label>
					}
				</fieldset>
			}
			<label>
				Group by
				<select name="group">
					<option value="" selected?={ view.GroupID == 0 }>— none —</option>
					for _, d := range view.Dimensions {
						<option value={ fmt.Sprintf("%d", d.ID) } selected?={ view.GroupID == d.ID }>{ d.Name }</option>
					}
				</select>
			</label>
			<button type="submit">Apply</button>
			<a href="/goals">Clear</a>
		</form>
	}
}

// goalList is the htmx swap target: the Goal list, flat or grouped by a
// Dimension's values.
templ goalList(view goalsListData) {
	<div id="goal-list" data-testid="goal-list">
		if view.GroupID != 0 {
			if len(view.Groups) == 0 {
				<p data-testid="no-goals">No Goals match.</p>
			}
			for _, grp := range view.Groups {
				<section data-testid="goal-group">
					<h3 data-testid="goal-group-label">
						if grp.Value != nil {
							{ grp.Value.Value }
						} else {
							Unassigned
						}
					</h3>
					@goalItems(grp.Goals)
				</section>
			}
		} else {
			@goalItems(view.Goals)
		}
	</div>
}

// goalItems renders a flat list of Goals with their assigned Dimension values.
templ goalItems(goals []domain.GoalWithValues) {
	<ul>
		if len(goals) == 0 {
			<li data-testid="no-goals">No Goals yet.</li>
		}
		for _, gv := range goals {
			<li>
				<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", gv.Goal.ID)) }>{ gv.Goal.Title }</a>
				<span>— { gv.Goal.Lifecycle } — Owner { gv.Goal.Owner.Email }</span>
				if gv.Goal.Ownerless {
					<strong data-testid="ownerless">— Ownerless</strong>
				}
				for _, val := range gv.Values {
					<span data-testid="goal-value-tag">[{ val.Value }]</span>
				}
			</li>
		}
	</ul>
}

// goalPage shows a single Goal on its own page, with its parents and children
// for navigation and, for its Owner, a form to request a new "contributes to"
// link.
templ goalPage(current *domain.Account, v goalView) {
	{{ g := v.Goal }}
	{{ owner := current != nil && current.ID == g.Owner.ID }}
	{{ admin := current != nil && current.IsAdmin }}
	@layout(g.Title, current) {
		if g.Ownerless {
			<p data-testid="goal-ownerless" role="alert"><strong>Ownerless</strong> — this Goal's Owner has left the org and it needs an Admin to reassign it.</p>
		}
		<article data-testid="goal">
			<h1 data-testid="goal-title">{ g.Title }</h1>
			<p><strong>Lifecycle:</strong> <span data-testid="goal-lifecycle">{ g.Lifecycle }</span></p>
			if note := v.lifecycleNote(); note != "" {
				<p data-testid="goal-lifecycle-note">{ note }</p>
			}
			<p><strong>Owner:</strong> <span data-testid="goal-owner">{ g.Owner.Email }</span></p>
			<p>
				<strong>Kind:</strong>
				<span data-testid="goal-kind">
					if g.Kind == "" {
						Not yet Dated or Ongoing
					} else {
						{ g.Kind }
					}
				</span>
				if !g.DeliveryDate.IsZero() {
					<span data-testid="goal-delivery-date">
						{ " — delivers " }
						@struckDates(v.priorDates(0))
						{ fmtDate(g.DeliveryDate) }
					</span>
				}
			</p>
			<p><strong>Check-in cadence:</strong> <span data-testid="goal-cadence">every { fmt.Sprintf("%d", g.CadenceDays) } days</span></p>
			<p>
				<strong>Date Slips:</strong> <span data-testid="goal-slip-count">{ fmt.Sprintf("%d", len(v.DateSlips)) }</span>
				· <strong>Milestone Churn:</strong> <span data-testid="goal-milestone-churn">{ fmt.Sprintf("%d", v.MilestoneChurn) }</span>
				<span>(Milestones added or removed since Active)</span>
			</p>
			<h2>So What</h2>
			<p data-testid="goal-so-what">{ g.SoWhat }</p>
		</article>
		if owner && g.Lifecycle == domain.LifecycleProposed {
			@defineGoal(v)
		}
		@checkinSection(v, v.CanCheckin)
		<section data-testid="goal-milestones">
			<h2>Milestones</h2>
			@milestoneList(v, owner && g.Lifecycle == domain.LifecycleProposed)
		</section>
		<section data-testid="goal-date-slips">
			<h2>Date Slips</h2>
			@dateSlipList(v)
		</section>
		<section data-testid="goal-metrics">
			<h2>Metrics</h2>
			@metricList(v.Trends, owner)
		</section>
		<section data-testid="goal-highlights">
			<h2>Highlights</h2>
			@highlightList(v.Highlights)
		</section>
		<section data-testid="goal-contributors">
			<h2>Contributors</h2>
			<ul>
				if len(v.Contributors) == 0 {
					<li data-testid="no-contributors">No Contributors yet.</li>
				}
				for _, c := range v.Contributors {
					<li>{ c.Email }</li>
				}
			</ul>
		</section>
		@delegatesSection(v, owner)
		<section data-testid="goal-dimensions">
			<h2>Dimensions</h2>
			@goalDimensions(v, owner)
		</section>
		<section data-testid="goal-so-what-history">
			<h2>So What history</h2>
			<ul>
				for _, rev := range v.Revisions {
					<li>
						<span>{ rev.SoWhat }</span>
						<span>— { rev.Author.Email } at { rev.CreatedAt.Format("2006-01-02 15:04") }</span>
					</li>
				}
			</ul>
		</section>
		<section data-testid="goal-parents">
			<h2>Contributes to</h2>
			@linkList(v.Parents, "no-parents", "This Goal contributes to nothing yet.")
		</section>
		<section data-testid="goal-children">
			<h2>Contributed to by</h2>
			@linkList(v.Children, "no-children", "Nothing contributes to this Goal yet.")
		</section>
		@ownership(&g, owner, admin)
		if owner {
			<section data-testid="request-link">
				<h2>Contribute this Goal to another</h2>
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/links", g.ID)) }>
					<label>
						Parent Goal
						<select name="parent_id" required>
							for _, c := range v.Candidates {
								<option value={ fmt.Sprintf("%d", c.ID) }>{ c.Title }</option>
							}
						</select>
					</label>
					<label>
						Note (optional)
						<textarea name="note"></textarea>
					</label>
					<button type="submit">Request link</button>
				</form>
			</section>
		}
		@addChildGoal(v)
		<p><a href="/goals">Back to Goals</a></p>
	}
}

// goalDimensions shows the Goal's value in each Dimension — retired values stay
// readable — and, for its Owner, a per-Dimension control to assign a value
// (CONTEXT.md: Owners assign Dimension values; retired values stay readable).
templ goalDimensions(v goalView, owner bool) {
	{{ g := v.Goal }}
	if len(v.Dimensions) == 0 {
		<p data-testid="no-dimensions-defined">No Dimensions defined yet.</p>
	}
	<ul>
		for _, d := range v.Dimensions {
			{{ current := v.assignedValue(d.ID) }}
			<li data-testid="goal-dimension">
				<span>{ d.Name }: </span>
				if current != nil {
					<span data-testid="goal-dimension-value">{ current.Value }</span>
					if current.Retired {
						<strong data-testid="retired">(retired)</strong>
					}
				} else {
					<span data-testid="goal-dimension-unassigned">unassigned</span>
				}
				if owner {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/dimensions", g.ID)) } style="display:inline">
						<select name="value_id">
							<option value="">— choose —</option>
							for _, val := range d.Values {
								if !val.Retired {
									<option value={ fmt.Sprintf("%d", val.ID) } selected?={ current != nil && current.ID == val.ID }>{ val.Value }</option>
								}
							}
						</select>
						<button type="submit">Assign</button>
					</form>
				}
			</li>
		}
	</ul>
}

// addChildGoal creates a Goal under this one: it offers this Goal's values as
// defaults (pre-checked, but not inherited — only the kept ones are assigned) and
// requests a "contributes to" link to this Goal (CONTEXT.md: Contributes to; the
// parent's values are offered as defaults).
templ addChildGoal(v goalView) {
	{{ g := v.Goal }}
	<section data-testid="add-child-goal">
		<h2>Add a child Goal</h2>
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/children", g.ID)) }>
			<label>
				Title
				<input type="text" name="title" required/>
			</label>
			<label>
				So What
				<textarea name="so_what" required></textarea>
			</label>
			if len(v.Values) > 0 {
				<fieldset data-testid="child-defaults">
					<legend>Defaults from { g.Title }</legend>
					for _, val := range v.Values {
						if !val.Retired {
							<label>
								<input type="checkbox" name="value_id" value={ fmt.Sprintf("%d", val.ID) } checked/>
								{ val.Value }
							</label>
						}
					}
				</fieldset>
			}
			<button type="submit">Create child Goal</button>
		</form>
	</section>
}

// ownership renders the ownership-change controls for a Goal: an Owner or Admin
// can hand a present-Owner Goal to a new Owner (who must accept), an Admin can
// mark the current Owner departed, and an Admin can reassign an Ownerless Goal
// (CONTEXT.md: Handoff, Ownerless, Admin).
templ ownership(g *domain.Goal, owner, admin bool) {
	if (owner || admin) && !g.Ownerless {
		<section data-testid="handoff-goal">
			<h2>Hand off this Goal</h2>
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/handoff", g.ID)) }>
				<label>
					New Owner's email
					<input type="email" name="to_email" required/>
				</label>
				<button type="submit">Start handoff</button>
			</form>
		</section>
	}
	if admin && !g.Owner.Departed {
		<section data-testid="depart-owner">
			<h2>Owner has left the org</h2>
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/accounts/%d/depart", g.Owner.ID)) }>
				<button type="submit">Mark { g.Owner.Email } departed</button>
			</form>
		</section>
	}
	if admin && g.Ownerless {
		<section data-testid="reassign-goal">
			<h2>Reassign this Ownerless Goal</h2>
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/reassign", g.ID)) }>
				<label>
					New Owner's email
					<input type="email" name="email" required/>
				</label>
				<button type="submit">Reassign</button>
			</form>
		</section>
	}
}

// defineGoal is the Owner's toolkit for a Proposed Goal: mark it Dated or
// Ongoing, set the cadence, revise the So What, add Contributors, Milestones and
// Metrics, and — once it meets the minimum standard — activate it.
templ defineGoal(v goalView) {
	{{ g := v.Goal }}
	<section data-testid="define-goal">
		<section data-testid="mark-kind">
			<h2>Delivery</h2>
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/dated", g.ID)) }>
				<label>
					Delivery date
					<input type="date" name="delivery_date" value={ v.SuggestedDate } required/>
				</label>
				<button type="submit">Mark Dated</button>
			</form>
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/ongoing", g.ID)) }>
				<button type="submit">Mark Ongoing</button>
			</form>
		</section>
		<section data-testid="set-cadence">
			<h2>Check-in cadence</h2>
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/cadence", g.ID)) }>
				<label>
					Days between Check-ins
					<input type="number" name="cadence_days" min="1" value={ fmt.Sprintf("%d", g.CadenceDays) } required/>
				</label>
				<button type="submit">Set cadence</button>
			</form>
		</section>
		<section data-testid="edit-so-what">
			<h2>Revise the So What</h2>
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/so-what", g.ID)) }>
				<textarea name="so_what" required>{ g.SoWhat }</textarea>
				<button type="submit">Save So What</button>
			</form>
		</section>
		<section data-testid="add-contributor">
			<h2>Add a Contributor</h2>
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/contributors", g.ID)) }>
				<label>
					Email
					<input type="email" name="email" required/>
				</label>
				<button type="submit">Add Contributor</button>
			</form>
		</section>
		<section data-testid="add-milestone">
			<h2>Add a Milestone</h2>
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/milestones", g.ID)) }>
				<label>
					Name
					<input type="text" name="name" required/>
				</label>
				<label>
					Date
					<input type="date" name="target_date" required/>
				</label>
				<button type="submit">Add Milestone</button>
			</form>
		</section>
		<section data-testid="add-metric">
			<h2>Add a Metric</h2>
			<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/metrics", g.ID)) }>
				@metricFields(domain.Metric{Direction: domain.MetricUp})
				<button type="submit">Add Metric</button>
			</form>
		</section>
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/activate", g.ID)) } data-testid="activate-goal">
			<button type="submit">Activate Goal</button>
		</form>
	</section>
}

// milestoneList lists a Goal's Milestones with their status and date history
// struck through (CONTEXT.md: Date Slip). editable gives the Owner of a Proposed
// Goal an inline edit form on each; once Active, Milestones change in a Check-in.
templ milestoneList(v goalView, editable bool) {
	<ul>
		if len(v.Milestones) == 0 {
			<li data-testid="no-milestones">No Milestones yet.</li>
		}
		for _, m := range v.Milestones {
			<li data-testid="goal-milestone">
				<span>
					if m.Status == domain.MilestoneRemoved {
						<del>{ m.Name }</del>
					} else {
						{ m.Name }
					}
					{ " — " }
					@struckDates(v.priorDates(m.ID))
					{ fmtDate(m.TargetDate) }
				</span>
				<span data-testid="milestone-status">({ m.Status })</span>
				if m.RemovedReason != "" {
					<span>— removed: { m.RemovedReason }</span>
				}
				if editable {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/milestones/%d", m.ID)) } style="display:inline">
						<input type="text" name="name" value={ m.Name } required/>
						<input type="date" name="target_date" value={ fmtDate(m.TargetDate) } required/>
						<button type="submit">Save</button>
					</form>
				}
			</li>
		}
	</ul>
}

// struckDates renders the dates a date held before its Date Slips, each struck
// through ahead of the current date: ~~10/15~~ 11/03 (CONTEXT.md: Date Slip).
templ struckDates(dates []time.Time) {
	for _, d := range dates {
		<del>{ fmtDate(d) }</del>{ " " }
	}
}

// dateSlipList shows a Goal's Date Slips, earliest first: what moved, from and
// to, and the reason (CONTEXT.md: Date Slip — the full history is kept).
templ dateSlipList(v goalView) {
	<ul>
		if len(v.DateSlips) == 0 {
			<li data-testid="no-date-slips">No Date Slips.</li>
		}
		for _, s := range v.DateSlips {
			<li data-testid="date-slip">
				if s.MilestoneID == 0 {
					<strong>Delivery date</strong>
				} else {
					<strong>Milestone { v.milestoneName(s.MilestoneID) }</strong>
				}
				: <del>{ fmtDate(s.OldDate) }</del> { fmtDate(s.NewDate) }
				<span>— { s.Reason }</span>
				<span>— at { s.CreatedAt.Format("2006-01-02 15:04") }</span>
			</li>
		}
	</ul>
}

// metricList lists a Goal's Metrics with each Metric's trend over time against
// its target (CONTEXT.md: the Goal page shows each Metric's trend); the Owner
// gets an inline edit form on each.
templ metricList(trends []metricTrend, owner bool) {
	<ul>
		if len(trends) == 0 {
			<li data-testid="no-metrics">No Metrics yet.</li>
		}
		for _, t := range trends {
			{{ m := t.Metric }}
			<li data-testid="goal-metric">
				<span>{ m.Name }: { fmtNum(m.Baseline) } → { fmtNum(m.Target) } { m.Unit } ({ m.Direction }) by { fmtDate(m.TargetDate) }</span>
				@metricTrendReadings(t)
				if owner {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/metrics/%d", m.ID)) } style="display:inline">
						@metricFields(m)
						<button type="submit">Save</button>
					</form>
				}
			</li>
		}
	</ul>
}

// metricTrendReadings shows a Metric's readings over time against its target, so
// the reader can see the trend (CONTEXT.md: Metric - its current value is
// recorded at each Check-in).
templ metricTrendReadings(t metricTrend) {
	{{ m := t.Metric }}
	<ol data-testid="metric-trend">
		if len(t.Readings) == 0 {
			<li data-testid="no-readings">No readings yet.</li>
		}
		for _, rd := range t.Readings {
			<li data-testid="metric-reading">
				<span>{ rd.CreatedAt.Format("2006-01-02") }: { fmtNum(rd.Value) } { m.Unit }</span>
				<span>(target { fmtNum(m.Target) })</span>
			</li>
		}
	</ol>
}

// highlightList shows a Goal's Highlights, newest first, each with its kind,
// note, the Owner credited, and when it was flagged (CONTEXT.md: Highlight).
templ highlightList(highlights []domain.Highlight) {
	<ul>
		if len(highlights) == 0 {
			<li data-testid="no-highlights">No Highlights yet.</li>
		}
		for _, hl := range highlights {
			<li data-testid="highlight">
				<strong>{ hl.Kind }</strong>: { hl.Note }
				<span>— { hl.Owner.Email } at { hl.CreatedAt.Format("2006-01-02 15:04") }</span>
			</li>
		}
	</ul>
}

// metricFields is the shared set of Metric inputs, prefilled from m for editing.
templ metricFields(m domain.Metric) {
	<label>
		Name
		<input type="text" name="name" value={ m.Name } required/>
	</label>
	<label>
		Unit
		<input type="text" name="unit" value={ m.Unit } required/>
	</label>
	<label>
		Direction
		<select name="direction">
			<option value={ domain.MetricUp } selected?={ m.Direction == domain.MetricUp }>up</option>
			<option value={ domain.MetricDown } selected?={ m.Direction == domain.MetricDown }>down</option>
		</select>
	</label>
	<label>
		Baseline
		<input type="number" step="any" name="baseline" value={ fmtNum(m.Baseline) } required/>
	</label>
	<label>
		Target
		<input type="number" step="any" name="target" value={ fmtNum(m.Target) } required/>
	</label>
	<label>
		Target date
		<input type="date" name="target_date" value={ fmtDate(m.TargetDate) } required/>
	</label>
}

// linkList renders a Goal's parents or children as navigable links, each with a
// button to remove the connecting link. emptyTestID/emptyText render when there
// are none.
templ linkList(links []domain.GoalLink, emptyTestID, emptyText string) {
	<ul>
		if len(links) == 0 {
			<li data-testid={ emptyTestID }>{ emptyText }</li>
		}
		for _, l := range links {
			<li>
				<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", l.Goal.ID)) }>{ l.Goal.Title }</a>
				<span>— Owner { l.Goal.Owner.Email }</span>
				if l.Goal.Ownerless {
					<strong data-testid="ownerless">— Ownerless</strong>
				}
				<form method="post" action={ templ.SafeURL(fmt.Sprintf("/links/%d/remove", l.LinkID)) } style="display:inline">
					<button type="submit">Remove</button>
				</form>
			</li>
		}
	</ul>
}
