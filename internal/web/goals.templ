package web

import (
	"fmt"
	"strings"
	"time"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// goalsPage is the Goal list an exec scans in seconds, in the flat frame: a
// header strip with the count, the List / Table switch and New goal, the
// filter bar, and the Goals as a full-bleed list grouped by Health, problems
// first in each group (CONTEXT.md: filter and group Goals). New goal links to
// the New goal page.
templ goalsPage(current *domain.Account, view goalsListData) {
	@framedLayout("Goals", current, goalsHeader(view)) {
		@goalsStyles()
		@goalFilters(view)
		@goalList(view)
	}
}

// goalsHeader is the Goal list's header strip: "Goals" with the muted count of
// the Goals listed, then the List / Table switch and New goal. An htmx filter
// change swaps in only the list, so the filter form selects the count and the
// switch, whose links keep every filter, out of band (goalFilters).
templ goalsHeader(view goalsListData) {
	<div data-testid="goals-head" class="page-header gl-ph">
		<div class="ph-title">
			<h1>Goals</h1>
			<span data-testid="goal-count" id="goal-count" class="ph-count">{ view.countLabel() }</span>
		</div>
		<div class="ph-actions">
			<nav id="goal-layout" class="gl-seg" aria-label="Layout">
				<a
					data-testid="layout-list"
					href={ view.layoutURL("") }
					if view.Table == nil {
						aria-current="page"
					}
				>List</a>
				<a
					data-testid="layout-table"
					href={ view.layoutURL(layoutTable) }
					if view.Table != nil {
						aria-current="page"
					}
				>Table</a>
			</nav>
			<a data-testid="new-goal" class="btn primary sm" href="/goals/new">New goal</a>
		</div>
	</div>
}

// goalFilters is the filter bar, one row of chips — the Scope, Health,
// Lifecycle, Incomplete, "+ Filter" for More filters' Dimension filters, and
// Group by — with the search at its right and Clear after the chips, all
// submitted as a GET so the chosen slice lives in the URL. The chips are the
// real selects, checkbox and <details>. The markup runs in the order they are
// drawn, so Tab follows the row and then the Dimension filters More filters'
// panel opens below it (#404).
//
// Under htmx the form applies itself (#94): a change, a pause in typing the
// search, or Enter GETs the view and swaps in only the list, so the form keeps
// its focus and an open More filters, and pushes the address. Clear's slot
// rides along out of band, so Clear comes and goes with the filter (#385), and
// the header's count and List / Table switch are selected out of band too.
// hx-history="false" keeps htmx from snapshotting the page, whose form controls
// would come back unchosen: Back loads the earlier address afresh instead.
templ goalFilters(view goalsListData) {
	<form
		method="get"
		action="/goals"
		data-testid="goal-filters"
		class="gl-filters"
		hx-get="/goals"
		hx-trigger="submit, change[target.type!='search'], input[target.type=='search'] delay:400ms"
		hx-target="#goal-list"
		hx-select="#goal-list"
		hx-select-oob="#goal-count,#goal-layout"
		hx-swap="outerHTML"
		hx-push-url="true"
		hx-sync="this:replace"
		hx-history="false"
	>
		<div class="gl-bar">
			@pageScopeChip("goal-scope-filter", view.Org)
			<label class="filter-chip">
				<span class="chip-key chip-key-set" aria-hidden="true">Health:</span>
				<select data-testid="goal-health-filter" name="health" aria-label="Health">
					<option value="" selected?={ view.Filter.Health == "" }>Any Health</option>
					for _, hf := range healthFilters {
						<option value={ hf.Value } selected?={ view.Filter.Health == hf.Value }>
							if hf.Health == "" {
								No Health
							} else {
								{ hf.Health }
							}
						</option>
					}
				</select>
			</label>
			<label class="filter-chip">
				<span class="chip-key chip-key-set" aria-hidden="true">Lifecycle:</span>
				<select data-testid="goal-lifecycle-filter" name="lifecycle" aria-label="Lifecycle">
					<option value="" selected?={ view.Filter.Lifecycle == "" }>Any Lifecycle</option>
					for _, lc := range lifecycleFilters {
						<option value={ lc } selected?={ view.Filter.Lifecycle == lc }>{ lc }</option>
					}
				</select>
			</label>
			<label class="filter-chip">
				<input data-testid="goal-incomplete-filter" type="checkbox" name="incomplete" value="1" checked?={ view.Filter.Incomplete }/>
				Incomplete
			</label>
			if len(view.Dimensions) > 0 {
				<details data-testid="more-filters" class="gl-more-toggle" open?={ view.moreFiltersSet() }>
					<summary aria-controls="goal-more-filters" title="More filters"><span aria-hidden="true">+</span> Filter</summary>
				</details>
				if view.Table == nil {
					<label class="filter-chip">
						<span class="chip-key">Group by:</span>
						<select name="group">
							<option value="" selected?={ view.GroupID == 0 }>Health</option>
							for _, d := range view.Dimensions {
								<option value={ fmt.Sprintf("%d", d.ID) } selected?={ view.GroupID == d.ID }>{ d.Name }</option>
							}
						</select>
					</label>
				}
			}
			<noscript><button type="submit" class="btn">Apply</button></noscript>
			<span
				data-testid="goal-filters-clear-slot"
				id="goal-filters-clear-slot"
				class="gl-clear"
				if view.SwapClearOOB {
					hx-swap-oob="true"
				}
			>
				if view.anyGoalFilterSet() {
					<a data-testid="goal-filters-clear" href="/goals" class="btn quiet sm">Clear</a>
				}
			</span>
			<input data-testid="goal-search" type="search" name="q" value={ view.Filter.Query } placeholder="Search title or Owner" aria-label="Search Goals by title or Owner"/>
		</div>
		if len(view.Dimensions) > 0 {
			<div data-testid="more-filters-panel" id="goal-more-filters" class="gl-more">
				for _, d := range view.Dimensions {
					<fieldset>
						<legend>{ d.Name }</legend>
						for _, v := range d.Values {
							<label>
								<input type="checkbox" name="value" value={ fmt.Sprintf("%d", v.ID) } checked?={ view.Selected[v.ID] }/>
								{ v.Value }
								if v.Retired {
									<span>(retired)</span>
								}
							</label>
						}
					</fieldset>
				}
			</div>
		}
		if view.Table != nil {
			<input type="hidden" name="layout" value="table"/>
			if view.Table.Sort != "" {
				<input type="hidden" name="sort" value={ view.Table.Sort }/>
			}
			if view.Table.Desc {
				<input type="hidden" name="dir" value="desc"/>
			}
			if group := view.Query.Get("group"); group != "" {
				<input type="hidden" name="group" value={ group }/>
			}
		}
	</form>
}

// goalList is the htmx swap target: the Goal list as a table led by Health,
// or its table layout. Grouped by a several-values Dimension a Goal can appear
// in more than one group, so the header's total counts each Goal once (ADR
// 0005).
templ goalList(view goalsListData) {
	if view.Table != nil {
		@goalTableLayout(view)
	} else {
		@goalListLayout(view)
	}
}

// goalListLayout is the Goal list's list layout: a full-bleed list under a
// muted row of column labels, grouped by Health, or by a value of the grouping
// Dimension, each group under a header row with its name and count.
templ goalListLayout(view goalsListData) {
	<div id="goal-list" data-testid="goal-list" class="gl-wrap">
		<table class="gl-list">
			<thead>
				<tr>
					<th scope="col" class="gl-col-health"><span class="sr-only">Health</span></th>
					<th scope="col" class="gl-col-goal">Goal</th>
					<th scope="col" class="gl-col-owner">Owner</th>
					<th scope="col" class="gl-col-due">Due</th>
					<th scope="col" class="gl-col-checkin">Last check-in</th>
				</tr>
			</thead>
			if view.GroupID != 0 {
				if len(view.Groups) == 0 {
					<tbody>
						@noGoals(view, view.noMatch())
					</tbody>
				}
				for _, grp := range view.Groups {
					<tbody data-testid="goal-group">
						<tr data-testid="goal-group-head" class="gl-group">
							<th colspan="5" scope="colgroup">
								if grp.Value != nil {
									@goalGroupLabel(grp.Value.Value, len(grp.Rows))
								} else {
									@goalGroupLabel("Unassigned", len(grp.Rows))
								}
							</th>
						</tr>
						for _, row := range grp.Rows {
							@goalListRow(row, view.Dates)
						}
					</tbody>
				}
			} else {
				if len(view.HealthGroups) == 0 {
					<tbody>
						if view.filtered() {
							@noGoals(view, view.noMatch())
						} else {
							@noGoals(view, "No Goals yet.")
						}
					</tbody>
				}
				for _, grp := range view.HealthGroups {
					<tbody data-testid="goal-health-group">
						<tr data-testid="goal-group-head" class="gl-group">
							<th colspan="5" scope="colgroup">
								<span class={ "gl-mark", healthMarkClass(grp.Health) } aria-hidden="true">
									@goalHealthDot(grp.Health)
								</span>
								@goalGroupLabel(grp.name(), len(grp.Rows))
							</th>
						</tr>
						for _, row := range grp.Rows {
							@goalListRow(row, view.Dates)
						}
					</tbody>
				}
			}
		</table>
	</div>
}

// goalGroupLabel is a group header's name and its count of rows: "Red 4".
templ goalGroupLabel(name string, n int) {
	<span data-testid="goal-group-label">{ name }</span>
	<span data-testid="goal-group-count" class="gl-group-count">{ fmt.Sprint(n) }</span>
}

// noGoals is the Goal list's empty state, spanning the table.
templ noGoals(view goalsListData, text string) {
	<tr>
		<td data-testid="no-goals" colspan="5" class="muted">
			{ text }
			@seeEveryonesGoals(view)
		</td>
	</tr>
}

// seeEveryonesGoals links an empty list on the viewer's default scope to
// everyone's Goals, keeping its other filters.
templ seeEveryonesGoals(view goalsListData) {
	if view.Org.Default {
		<a data-testid="see-everyones" href={ view.everyoneURL() }>See everyone's →</a>
	}
}

// goalListRow is one Goal in the list: its Health's shape, named for
// assistive technology, then its title with its chips beside it — the
// Lifecycle of a Goal with no Health, the Ownerless, freshness and Incomplete
// marks (Incomplete the quietest), and its Dimension values, a Retired one or
// one in a Retired Dimension marked retired — then its Owner with their
// initials, Due and Last check-in.
templ goalListRow(row goalRow, dates displayDates) {
	{{ g := row.Goal }}
	{{ health := row.health() }}
	<tr data-testid="goal-row">
		<td class="gl-health">
			@goalHealthMark(health)
		</td>
		<td class="gl-goal">
			<div class="gl-line">
				<a class="gl-title" href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a>
				if health == "" || g.Ownerless || row.Freshness.CheckinOverdue || row.Freshness.PathToGreenOverdue || row.Freshness.MilestoneOverdue || len(row.Incomplete) > 0 {
					<span class="gl-marks">
						if health == "" {
							<span data-testid="goal-row-lifecycle" class="badge lc">{ g.Lifecycle }</span>
						}
						if g.Ownerless {
							<span data-testid="ownerless" class="badge ol" title={ ownerlessHelp }>Ownerless</span>
						}
						@goalRowFreshness(row.Freshness)
						if len(row.Incomplete) > 0 {
							<span data-testid="incomplete" class="badge lc" title={ "No value yet in " + strings.Join(row.Incomplete, ", ") }>Incomplete</span>
						}
					</span>
				}
				<span class="gl-tags">
					for _, val := range row.Values {
						<span data-testid="goal-value-tag" class="tag">{ val.Value }</span>
						if val.Retired || val.DimensionRetired {
							<span class="muted small" data-testid="retired">(retired)</span>
						}
					}
				</span>
			</div>
		</td>
		<td class="gl-owner">
			<span class="gl-avatar" aria-hidden="true">{ initials(g.Owner) }</span>
			@person(g.Owner)
		</td>
		<td data-testid="goal-row-due" class="num gl-dates">
			if g.DeliveryDate.IsZero() {
				<span class="muted">—</span>
			} else {
				@struckDates(g.DeliveryDate, row.PriorDates, dates)
				<span>{ dates.date(g.DeliveryDate) }</span>
			}
		</td>
		<td data-testid="goal-row-last-checkin" class="muted gl-checkin">{ row.lastCheckin() }</td>
	</tr>
}

// goalHealthMark is a list row's Health: its shape alone — octagon for Red,
// a downward triangle for Yellow, circle for Green, an empty ring for none —
// named by an aria-label, so colour is never the only signal (DESIGN.md
// § Components: Health).
templ goalHealthMark(health string) {
	{{ name := goalHealthGroup{Health: health}.name() }}
	<span data-testid="goal-row-health" class={ "gl-mark", healthMarkClass(health) } role="img" aria-label={ name }>
		@goalHealthDot(health)
		<span class="sr-only">{ name }</span>
	</span>
}

// goalHealthDot is the shared Health shape (.dot) inside a .gl-mark; a Goal
// with no Health has none, its mark the empty ring.
templ goalHealthDot(health string) {
	if health != "" {
		<span class="dot"></span>
	}
}

// goalTableLayout is the Goal list's table layout: one row per Goal, a column
// per live Dimension and Field, and no totals row (ADR 0005), full-bleed under
// the filter bar like the list. It scrolls sideways inside its own container
// rather than widening the page, and downloads as CSV in the import format
// (#81). Edit values turns it into one plain form, saved by one Save, that
// sets the Dimension values and Fields of the Goals the person may (#80).
templ goalTableLayout(view goalsListData) {
	<div id="goal-list" data-testid="goal-list" class="gl-wrap gl-table">
		@goalTableColumns(view)
		<p class="gl-download">
			<a data-testid="goal-table-download" class="btn quiet sm" href={ view.downloadURL() } download>Download CSV</a>
			if !view.Table.Edit {
				<a data-testid="goal-table-edit" class="btn quiet sm" href={ view.editURL() }>Edit values</a>
			}
		</p>
		if view.Table.Edit {
			<form data-testid="goal-table-form" method="post" action={ view.saveURL() } class="gl-edit">
				@goalTableErrors(view.Table)
				<p class="muted small gl-edit-hint">Title, Owner, Health, Lifecycle and delivery date change on each Goal's own page.</p>
				@goalTableGrid(view)
				<div class="gl-edit-actions">
					<button data-testid="goal-table-save" type="submit" class="btn primary">Save</button>
					<a data-testid="goal-table-cancel" class="btn quiet" href={ view.viewURL() }>Cancel</a>
				</div>
			</form>
		} else {
			@goalTableGrid(view)
		}
	</div>
}

// goalTableGrid is the Goal table itself, its sort headers and its rows.
templ goalTableGrid(view goalsListData) {
	<div class="table-scroll">
		<table data-testid="goal-table">
			<thead data-testid="goal-table-head">
				<tr>
					for _, col := range view.Table.Columns {
						<th scope="col" aria-sort={ view.Table.ariaSort(col) }><a href={ view.sortURL(col.Key) }>{ col.Label }</a></th>
					}
				</tr>
			</thead>
			<tbody>
				if len(view.Table.Rows) == 0 {
					<tr>
						<td data-testid="no-goals" colspan={ fmt.Sprintf("%d", len(view.Table.Columns)) } class="muted">
							{ view.noMatch() }
							@seeEveryonesGoals(view)
						</td>
					</tr>
				}
				for _, row := range view.Table.Rows {
					<tr data-testid="goal-table-row">
						for _, col := range view.Table.Columns {
							if view.Table.editsCell(col, row) {
								@goalTableEditCell(view.Table, col, row)
							} else {
								@goalTableCell(col, row, view.Table.Edit, view.Dates)
							}
						}
					</tr>
				}
			</tbody>
		</table>
	</div>
}

// goalTableErrors heads a refused save: nothing was saved, and why.
templ goalTableErrors(t *goalTable) {
	if t.Refusal != "" || len(t.Bad) > 0 {
		<div data-testid="goal-table-errors" class="alert gl-edit-errors" role="alert">
			<strong>Nothing was saved.</strong>
			if t.Refusal != "" {
				<span>{ t.Refusal }</span>
			} else if len(t.Bad) == 1 {
				<span>Fix the marked cell and save again.</span>
			} else {
				<span>Fix the { fmt.Sprintf("%d", len(t.Bad)) } marked cells and save again.</span>
			}
		</div>
	}
}

// goalTableEditCell is a Dimension's or Field's cell in edit mode: the Goal
// page's inputs for it, holding what is saved or what a refused save posted,
// and a refused cell's reason under them.
templ goalTableEditCell(t *goalTable, col tableColumn, row goalTableRow) {
	{{ name := cellName(col, row.Goal.ID) }}
	{{ bad := t.bad(col, row) }}
	{{ label := col.Label + " of " + row.Goal.Title }}
	<td class={ "gl-edit-cell", templ.KV("gl-bad", bad != "") }>
		<input type="hidden" name={ wasPrefix + name } value={ t.was(col, row) }/>
		if col.Field != nil {
			switch col.Field.Type {
				case domain.FieldNumber:
					<input
						type="number"
						step="any"
						name={ name }
						value={ t.fieldInputValue(col, row) }
						aria-label={ label }
						if bad != "" {
							aria-invalid="true"
							aria-describedby={ name + "-error" }
						}
					/>
				case domain.FieldLongText:
					<textarea
						name={ name }
						aria-label={ label }
						if bad != "" {
							aria-invalid="true"
							aria-describedby={ name + "-error" }
						}
					>{ t.fieldInputValue(col, row) }</textarea>
				case domain.FieldDate:
					<input
						type="date"
						name={ name }
						value={ t.fieldInputValue(col, row) }
						aria-label={ label }
						if bad != "" {
							aria-invalid="true"
							aria-describedby={ name + "-error" }
						}
					/>
				default:
					<input
						type="text"
						name={ name }
						value={ t.fieldInputValue(col, row) }
						aria-label={ label }
						if bad != "" {
							aria-invalid="true"
							aria-describedby={ name + "-error" }
						}
					/>
			}
		} else {
			{{ d := *col.Dimension }}
			if d.TakesSeveral() {
				<fieldset
					class="gl-values"
					aria-label={ label }
					if bad != "" {
						aria-describedby={ name + "-error" }
					}
				>
					for _, val := range d.Values {
						if t.offers(col, row, val) {
							<label>
								<input
									type="checkbox"
									name={ name }
									value={ fmt.Sprintf("%d", val.ID) }
									checked?={ t.picks(col, row, val) }
									if bad != "" {
										aria-invalid="true"
									}
								/>
								{ val.Value }
								if val.Retired {
									<span class="muted small">(retired)</span>
								}
							</label>
						}
					}
				</fieldset>
			} else {
				<select
					name={ name }
					aria-label={ label }
					if bad != "" {
						aria-invalid="true"
						aria-describedby={ name + "-error" }
					}
				>
					<option value="">—</option>
					for _, val := range d.Values {
						if t.offers(col, row, val) {
							<option value={ fmt.Sprintf("%d", val.ID) } selected?={ t.picks(col, row, val) }>
								{ val.Value }
								if val.Retired {
									(retired)
								}
							</option>
						}
					}
				</select>
			}
			if d.Extendable() {
				<input type="text" name={ newValueName(row.Goal.ID, d.ID) } value={ t.newValueTyped(col, row) } placeholder="Add a value" aria-label={ "Add a " + col.Label + " value to " + row.Goal.Title }/>
			}
		}
		if bad != "" {
			<p data-testid="cell-error" id={ name + "-error" } class="gl-cell-error">{ bad }</p>
		}
	</td>
}

// goalTableColumns is the Columns control: a tick per column but Title, which
// a plain GET form saves for this browser, so it works without JavaScript.
templ goalTableColumns(view goalsListData) {
	<details data-testid="goal-columns-control" class="gl-columns">
		<summary>Columns</summary>
		<form data-testid="goal-columns" method="get" action="/goals">
			for _, kv := range view.carriedQuery() {
				<input type="hidden" name={ kv[0] } value={ kv[1] }/>
			}
			<input type="hidden" name="columns" value="1"/>
			for _, col := range view.Table.All {
				if col.Key != "title" {
					<label><input type="checkbox" name="show" value={ col.Key } checked?={ !view.Table.Hidden[col.Key] }/>{ col.Label }</label>
				}
			}
			<button type="submit" class="btn sm">Apply</button>
		</form>
	</details>
}

// goalTableCell is one row's cell in col, read-only. In edit mode the Health,
// Lifecycle and delivery date link to the Goal, whose page changes them; an
// empty cell has no link. The Owner stays the person control, which a link
// can't hold, and the Title already links to the Goal.
templ goalTableCell(col tableColumn, row goalTableRow, edit bool, dates displayDates) {
	{{ g := row.Goal }}
	switch col.Key {
		case "title":
			<td><a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a></td>
		case "owner":
			<td>
				@person(g.Owner)
			</td>
		case "health":
			<td>
				if health := row.health(); health != "" {
					@goalLinkIf(edit, g) {
						@healthChip("", health)
					}
				}
			</td>
		case "lifecycle":
			<td>
				@goalLinkIf(edit, g) {
					{ g.Lifecycle }
				}
			</td>
		case "due":
			<td class="num">
				if !g.DeliveryDate.IsZero() {
					@goalLinkIf(edit, g) {
						@struckDates(g.DeliveryDate, row.PriorDates, dates)
						{ dates.date(g.DeliveryDate) }
					}
				}
			</td>
		case "checkin":
			<td class="muted">
				if row.Latest != nil {
					{ row.lastCheckin() }
				}
			</td>
		default:
			<td class={ templ.KV("num", col.Field != nil && col.Field.Type == domain.FieldNumber), templ.KV("gl-long", col.Field != nil && col.Field.Type == domain.FieldLongText) }>{ col.text(row, dates) }</td>
	}
}

// goalLinkIf links its content to the Goal when link is true.
templ goalLinkIf(link bool, g domain.Goal) {
	if link {
		<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>
			{ children... }
		</a>
	} else {
		{ children... }
	}
}

// goalsStyles are the Goal list's own rules on top of app.css, in the flat
// frame (DESIGN.md § Goal list):
//   - the page drops its padding and width cap, so the filter bar and the
//     list run edge to edge with 28px sides;
//   - the header strip's List / Table switch is a segmented control;
//   - the filter bar is one row of 28px chips (their rules shared, in
//     app.css), the search at its right. Its row and More filters' panel lay
//     their controls out in the form's own row, in markup order, so the
//     panel's Dimension filters, shown while its "+ Filter" is open (always,
//     where :has() isn't supported), wrap onto a line below;
//   - the list is 40px rows on hairlines under a muted row of column labels,
//     each group under a header row on --color-group, a row's Health as its
//     11px shape, its chips 22px pills, and its dates in tabular figures. At
//     600px and below a row stacks: its Goal first, beside its shape in the
//     row's gutter, then its Owner, Due and Last check-in wrapping under it;
//   - the table layout keeps its Columns control, sort headers and edit mode,
//     restyled as the same hairline list, scrolling sideways in its own box.
templ goalsStyles() {
	<style>
		.page:has(>#goal-list){max-width:none;padding:0 0 64px;gap:0}
		.gl-seg{display:inline-flex;height:32px;border:2px solid var(--color-chip-bg);border-radius:var(--radius-md);background:var(--color-chip-bg);box-sizing:border-box}
		.gl-seg a{display:inline-flex;align-items:center;box-sizing:border-box;padding:0 12px;border:1px solid transparent;border-radius:4px;color:var(--color-ink-2);font-size:13px;font-weight:500}
		.gl-seg a:hover{color:var(--color-ink);text-decoration:none}
		.gl-seg a[aria-current=page]{background:var(--color-canvas);border-color:var(--color-primary-strong);color:var(--color-ink)}
		.gl-filters{display:flex;flex-wrap:wrap;align-items:center;gap:8px;padding:12px 28px;border-bottom:1px solid var(--color-border)}
		.gl-bar,.gl-more,.gl-clear{display:contents}
		.gl-more-toggle>summary{min-height:0;height:28px;gap:4px;padding:0 8px;border:1px dashed var(--color-border-strong);border-radius:var(--radius-md);color:var(--color-ink-2);font-size:13px;font-weight:500;white-space:nowrap;box-sizing:border-box}
		.gl-more-toggle[open]>summary,.gl-filters:has(.gl-more input:checked) .gl-more-toggle>summary{background:var(--color-primary-subtle);color:var(--color-ink)}
		@media (scripting:enabled){.gl-bar noscript{display:none}}
		.gl-clear>a{height:28px}
		.gl-bar input[type=search]{flex:1 1 160px;min-width:0;max-width:240px;margin-left:auto;height:28px;padding:0 12px;font-size:13px}
		.gl-filters:has(.gl-more-toggle[open]) .gl-more::before{content:"";flex-basis:100%}
		.gl-more fieldset{display:inline-flex;flex-wrap:wrap;gap:4px 12px;margin:0;padding:4px 12px 8px;border:1px solid var(--color-border);border-radius:var(--radius-md)}
		.gl-more fieldset label{display:inline-flex;align-items:center;gap:8px}
		.gl-filters:has(.gl-more-toggle:not([open])) .gl-more fieldset{display:none}
		.gl-list{table-layout:fixed}
		.gl-list th,.gl-list td{height:40px;padding:4px 12px;border-bottom:1px solid var(--color-border);background:none;box-sizing:border-box}
		.gl-list tr>:first-child{padding-left:28px}
		.gl-list tr>:last-child{padding-right:28px}
		.gl-list thead th{height:32px;padding-top:0;padding-bottom:0;color:var(--color-ink-muted);font-size:12px;font-weight:500}
		.gl-list .gl-col-health{width:40px;padding-right:0}
		.gl-list .gl-health{padding-right:0;line-height:0}
		.gl-list .gl-col-owner{width:200px}
		.gl-list .gl-col-due{width:168px}
		.gl-list .gl-col-checkin{width:148px}
		.gl-group th{height:36px;background:var(--color-group);color:var(--color-ink);font-size:13px;font-weight:600;letter-spacing:0;text-transform:none}
		.gl-group .gl-mark{margin-right:8px}
		.gl-group-count{margin-left:8px;color:var(--color-ink-muted);font-weight:500;font-variant-numeric:tabular-nums}
		.gl-list tr[data-testid=goal-row]:hover{background:var(--color-row-hover)}
		.gl-mark{display:inline-flex;align-items:center;justify-content:center;flex:none;vertical-align:middle}
		.gl-mark .dot{--dot-size:11px}
		.gl-mark.r{background:none;color:var(--health-r-mark)}
		.gl-mark.y{background:none;color:var(--health-y-mark)}
		.gl-mark.g{background:none;color:var(--health-g-mark)}
		.gl-mark.none{width:11px;height:11px;box-sizing:border-box;border:1.5px solid var(--color-ink-muted);border-radius:50%}
		.gl-line{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;min-width:0}
		.gl-title{flex:0 1 auto;min-width:0;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--color-ink);font-weight:500}
		.gl-title:hover{color:var(--color-ink)}
		.gl-marks,.gl-tags{display:flex;flex:0 1 auto;flex-wrap:wrap;align-items:center;gap:4px;min-width:0}
		.gl-tags:empty{display:none}
		.gl-marks .badge{height:22px;padding:0 8px;border-radius:var(--radius-full);background:var(--color-chip-bg);color:var(--color-chip-ink);font-size:12px;font-weight:500;line-height:20px}
		.gl-marks .badge.lc{border-color:transparent}
		.gl-tags .tag{height:22px;padding:0 8px;font-size:12px;line-height:20px;box-sizing:border-box}
		.gl-owner{overflow-wrap:anywhere}
		.gl-avatar{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;margin-right:8px;border-radius:var(--radius-full);background:var(--color-chip-bg);color:var(--color-chip-ink);font-size:10px;font-weight:600;vertical-align:middle}
		.gl-list .gl-dates,.gl-list .gl-checkin{font-size:13px;font-variant-numeric:tabular-nums}
		.gl-list .gl-dates{color:var(--color-ink-2);font-weight:400}
		.gl-dates>*{white-space:nowrap}
		#goal-list [data-testid=no-goals]{height:auto;padding-top:24px;padding-bottom:24px}
		.gl-columns{padding:0 28px}
		.gl-download{margin:0;padding:0 16px 8px}
		.gl-columns>summary{justify-content:flex-start;color:var(--color-primary-strong);font-weight:600}
		.gl-columns form{display:flex;flex-wrap:wrap;align-items:center;gap:8px 16px;padding-bottom:12px}
		.gl-columns label{display:inline-flex;align-items:center;gap:8px}
		.gl-table th{height:32px;padding:0 12px;background:none;color:var(--color-ink-muted);font-size:12px;font-weight:500}
		.gl-table td{height:40px;padding:4px 12px;font-size:14px}
		.gl-table tr>:first-child{padding-left:28px}
		.gl-table tr>:last-child{padding-right:28px}
		.gl-table tbody tr:hover{background:var(--color-row-hover)}
		.gl-table tr:last-child td{border-bottom:1px solid var(--color-border)}
		#goal-list th a{color:inherit;text-decoration:none}
		#goal-list th[aria-sort=ascending] a::after{content:" ↑"}
		#goal-list th[aria-sort=descending] a::after{content:" ↓"}
		.table-scroll td{white-space:nowrap}
		.table-scroll td.gl-long{white-space:normal;min-width:240px}
		.gl-edit-hint{margin:0;padding:0 28px 8px}
		.gl-edit-errors{margin:0 28px 12px;color:var(--color-danger-ink)}
		.gl-edit-actions{display:flex;gap:8px;padding:12px 28px}
		.gl-edit-cell{vertical-align:top}
		.gl-edit-cell input[type=number]{width:128px}
		.gl-edit-cell input[type=text]{min-width:160px}
		.gl-edit-cell input[type=text]+input[type=text],.gl-edit-cell select+input[type=text],.gl-edit-cell fieldset+input[type=text]{margin-top:4px;display:block}
		.gl-edit-cell textarea{min-width:240px}
		.gl-values{display:flex;flex-direction:column;gap:4px;border:0;margin:0;padding:0}
		.gl-values label{display:inline-flex;align-items:center;gap:8px}
		.gl-cell-error{margin:4px 0 0;max-width:240px;white-space:normal;font-size:13px;color:var(--color-danger-ink)}
		@media (pointer:coarse){.gl-more-toggle>summary,.gl-bar input[type=search],.gl-seg{height:auto;min-height:44px}.gl-seg a{min-height:40px}}
		@media (max-width:1200px){.gl-list .gl-col-owner{width:168px}.gl-list .gl-col-due{width:152px}.gl-list .gl-col-checkin{width:136px}}
		@media (max-width:900px){.gl-filters{padding:12px 16px}.gl-list tr>:first-child,.gl-table tr>:first-child{padding-left:16px}.gl-list tr>:last-child,.gl-table tr>:last-child{padding-right:16px}.gl-list .gl-col-health{width:28px}.gl-list .gl-col-owner{width:160px}.gl-list .gl-col-due{width:136px}.gl-list .gl-col-checkin{width:120px}.gl-columns,.gl-edit-hint,.gl-edit-actions{padding-left:16px;padding-right:16px}.gl-download{padding-left:4px;padding-right:4px}.gl-edit-errors{margin-left:16px;margin-right:16px}}
		@media (max-width:600px){.gl-ph{flex-wrap:wrap;padding-top:8px;padding-bottom:8px}.gl-bar input[type=search]{flex:1 1 100%;max-width:none;margin-left:0}.gl-list{table-layout:auto}.gl-list thead{display:none}.gl-list tr{display:flex;flex-wrap:wrap;align-items:center;gap:4px 12px;padding:12px 16px 12px 40px;border-bottom:1px solid var(--color-border)}.gl-list td,.gl-list th,.gl-list tr>*,.gl-list tr>:first-child,.gl-list tr>:last-child{display:block;height:auto;padding:0;border-bottom:none}.gl-list .gl-group{padding:8px 16px;background:var(--color-group)}.gl-list [colspan]{flex-basis:100%}.gl-list .gl-health{order:-2;width:12px;margin-left:-24px}.gl-list .gl-goal{order:-1;flex-basis:100%}.gl-title{white-space:normal}.gl-list .gl-owner{white-space:normal}.gl-list .gl-tags{display:none}.gl-list td::before{color:var(--color-ink-muted);font-family:var(--font-body);font-size:13px;font-weight:400}.gl-dates::before{content:"Due "}.gl-checkin::before{content:"Last check-in "}}
	</style>
}

// goalPage shows a single Goal in the flat frame (DESIGN.md § Goal page). Its
// header strip is the breadcrumb, with Check in and the More menu at its right.
// Under it, any warning banners run as quiet full-width strips, then a document
// column — the title, Why it matters as a lead paragraph, then Latest status,
// Metrics, Milestones, Highlights, Draft Highlights, Action Items, Comments and
// History as sections — beside a properties rail of its Health, Lifecycle,
// people, cadence, delivery, level, Dimension values and Fields, then what it
// contributes to and what contributes to it. Nothing on it is a card; at 900px
// and below the rail stacks under the column.
templ goalPage(current *domain.Account, v goalView) {
	{{ g := v.Goal }}
	{{ owner := current != nil && current.ID == g.Owner.ID }}
	@framedLayout(g.Title, current, goalPageHeader(v)) {
		@goalPageStyles()
		<div class="gp-frame">
			<div class="gp-banners">
				if g.Ownerless {
					<p data-testid="goal-ownerless" class="alert ol" role="alert"><strong>Ownerless</strong><span>this Goal's Owner has left the company and it needs an Admin to reassign it.</span></p>
				}
				@goalFreshness(g.ID, v.Freshness, v.CanCheckin, v.dates())
				@goalSignals(v.Signals, v.dates())
				@goalIncomplete(v.Incomplete)
			</div>
			@toastNotice(v.Toast)
			<div class="gp-body">
				<div data-testid="goal-main" class="gp-doc">
					@goalHead(v)
					if owner && g.Lifecycle == domain.LifecycleProposed {
						@defineGoal(v)
					}
					@checkinSection(v)
					<section data-testid="goal-metrics" class="gp-block gp-section">
						<h2>Metrics</h2>
						@metricList(v.Trends, owner, v.dates())
					</section>
					<section data-testid="goal-milestones" class="gp-block gp-section gp-milestones">
						@groupHead(v, formMilestones, "+ Add", "Add a Milestone") {
							<h2>Milestones</h2>
						}
						@milestoneList(v, owner && g.Lifecycle == domain.LifecycleProposed)
						if v.opens(formMilestones) {
							@openGoalForm(v, formMilestones, "Add Milestone") {
								<form data-testid="add-milestone" class="gp-inline" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/milestones", g.ID)) }>
									<input type="text" name="name" value={ v.FormInput.Get("name") } aria-label="Milestone name" placeholder="Milestone name" required autofocus/>
									<input type="date" name="target_date" value={ v.FormInput.Get("target_date") } aria-label="Milestone date" required/>
									<button type="submit" class="btn sm">Add Milestone</button>
								</form>
							}
						}
					</section>
					if len(v.Highlights) > 0 {
						<section data-testid="goal-highlights" class="gp-block gp-section">
							<h2>Highlights</h2>
							@highlightList(v.Highlights, v.dates())
						</section>
					}
					@draftHighlightSection(v)
					if items := v.openActionItems(); len(items) > 0 {
						<section id="action-items" data-testid="goal-action-items" class="gp-block gp-section">
							<h2>Action Items</h2>
							<ul class="gp-list gp-rows">
								for _, l := range items {
									@goalActionItemRow(l, current, fmt.Sprintf("/goals/%d#action-items", g.ID))
								}
							</ul>
						</section>
					}
					@goalComments(current, v)
					@goalHistory(v.History)
				</div>
				@goalRail(current, v)
			</div>
		</div>
	}
}

// goalPageHeader is the Goal page's header strip: the breadcrumb — Goals, the
// first Goal it contributes to when it has one, then its own title — with, at
// its right, Check in and No change for whoever may check in, and the More
// menu (DESIGN.md § Goal page header strip). The title's own <h1> heads the
// document column, so the strip has none.
templ goalPageHeader(v goalView) {
	{{ g := v.Goal }}
	<div data-testid="goal-page-header" class="page-header gp-ph">
		<nav data-testid="goal-breadcrumb" class="ph-title gp-crumbs" aria-label="Breadcrumb">
			<a class="ph-parent" href="/goals">Goals</a>
			<span class="ph-sep" aria-hidden="true">›</span>
			if len(v.Parents) > 0 {
				<a class="ph-parent gp-crumb" href={ templ.SafeURL(fmt.Sprintf("/goals/%d", v.Parents[0].Goal.ID)) }>{ v.Parents[0].Goal.Title }</a>
				<span class="ph-sep" aria-hidden="true">›</span>
			}
			<span class="gp-crumb" aria-current="page">{ g.Title }</span>
		</nav>
		<div data-testid="goal-actions" class="ph-actions gp-actions">
			if v.CanCheckin && (g.Lifecycle == domain.LifecycleActive || g.Lifecycle == domain.LifecycleOnHold) {
				<a class="btn primary sm" data-testid="checkin-link" href={ templ.SafeURL(fmt.Sprintf("/goals/%d/checkin", g.ID)) }>Check in</a>
				if g.Lifecycle == domain.LifecycleActive && v.LatestCheckin != nil && v.NoChangeRefusal == "" {
					@noChangeCheckinButton(g.ID, "No change", "btn quiet sm")
				}
			}
			@goalMore(v)
		</div>
	</div>
}

// goalActionItemRow is an open Action Item about the Goal: what it asks, who
// owns it, when it is due, flagged when overdue, and the Report it came from,
// leading to that publication's Action Items. Its owner gets the Close that
// comes back to returnTo.
templ goalActionItemRow(l domain.ActionItemListing, current *domain.Account, returnTo string) {
	<li data-testid="goal-action-item">
		{ l.Item.Text }{ " · " }
		@person(l.Item.Owner)
		{ " · due " }{ showDateYear(l.Item.DueDate) }
		if l.Overdue {
			<span data-testid="goal-action-item-overdue" class="badge r">Overdue</span>
		}
		{ " · from " }
		<a href={ templ.SafeURL(fmt.Sprintf("/reports/%d/publications/%d#action-items", l.Item.DefinitionID, l.Item.PublicationID)) }>{ l.ReportName }</a>
		if current != nil && current.ID == l.Item.Owner.ID {
			@closeActionItemForm(l.Item, returnTo)
		}
	</li>
}

// goalHead opens the document column: the Goal's title at 28px, its Why it
// matters as a 16px lead paragraph, and what its Lifecycle came with — the
// outcome of a Done Goal or why it is On Hold or Cancelled. The Edit title and
// Why it matters form and Mark Top-level open here in place.
templ goalHead(v goalView) {
	{{ g := v.Goal }}
	<header data-testid="goal-head" class="gp-head">
		<h1 data-testid="goal-title">{ g.Title }</h1>
		<article data-testid="goal" class="gp-statement" aria-labelledby="why-it-matters-label">
			<h2 id="why-it-matters-label" class="sr-only">Why it matters</h2>
			<p data-testid="goal-why-it-matters" class="gp-lead">{ g.WhyItMatters }</p>
			<button type="button" class="disclose help explain gp-lead-help" aria-expanded="false" aria-controls="why-it-matters-help" title={ whyItMattersHelp }>What goes here?</button>
			<p id="why-it-matters-help" class="explain" hidden>{ whyItMattersHelp }</p>
		</article>
		if note := v.lifecycleNote(); note != "" {
			<p data-testid="goal-lifecycle-note" class="muted">{ note }</p>
		}
		if v.opens(formTitleWhyItMatters) {
			@titleWhyItMattersForm(v)
		}
		if v.opens(formTopLevel) {
			@openGoalForm(v, formTopLevel, "") {
				@topLevelControl(g)
			}
		}
	</header>
}

// goalRail is the Goal page's properties rail, behind a 1px left edge: its
// properties as label and value rows (goalProperties), then its Dimension
// values, its Fields, the Goals it contributes to and those contributing to it.
// Each group's form opens in place in the rail from its heading's link.
templ goalRail(current *domain.Account, v goalView) {
	{{ g := v.Goal }}
	<aside data-testid="goal-sidebar" class="gp-rail" aria-label="Properties">
		@goalProperties(v)
		<section data-testid="goal-dimensions" class="gp-block gp-rail-group">
			@groupHead(v, formDimensions, "Edit", "Edit Dimensions") {
				<h3>Dimensions</h3>
			}
			<button type="button" class="disclose help explain" aria-expanded="false" aria-controls="dimension-values-help" title={ dimensionValuesHelp }>What are Dimension values?</button>
			<p id="dimension-values-help" class="explain" hidden>{ dimensionValuesHelp }</p>
			@goalDimensions(v)
		</section>
		<section data-testid="goal-field-block" class="gp-block gp-rail-group">
			@groupHead(v, formFields, "Edit", "Edit Fields") {
				<h3>Fields</h3>
			}
			@goalFields(v)
		</section>
		<section data-testid="goal-parents" class="gp-block gp-rail-group">
			@groupHead(v, formParentLink, "+ Add", "Add a parent Goal") {
				<h3>Contributes to</h3>
			}
			@linkList(g, current, v.Parents, v.LinkHealth, "no-parents", "This Goal contributes to nothing yet.")
			@requestParentLink(v)
			@suggestedParents(v)
		</section>
		<section data-testid="goal-children" class="gp-block gp-rail-group">
			<h3>Contributed to by</h3>
			@linkList(g, current, v.Children, v.LinkHealth, "no-children", "Nothing contributes to this Goal yet.")
		</section>
	</aside>
}

// goalProperties are the rail's label and value rows, in the order DESIGN.md §
// Properties rail gives them: Health as its pill, Lifecycle, Kind, then the
// people — the Owner, with the forms about them opened in place under them, the
// Delegates and the Contributors — then the cadence, the delivery date with its
// slips struck, and Top-level for a Goal that is one.
templ goalProperties(v goalView) {
	{{ g := v.Goal }}
	<div data-testid="goal-meta" class="gp-props">
		<dl class="gp-prop-list">
			<div class="gp-prop">
				<dt>Health</dt>
				<dd>
					if health := v.health(); health != "" {
						@healthChip("", health)
					} else {
						<span class="muted">No Health</span>
					}
				</dd>
			</div>
			<div class="gp-prop">
				<dt>Lifecycle</dt>
				<dd><span data-testid="goal-lifecycle">{ g.Lifecycle }</span></dd>
			</div>
			<div class="gp-prop">
				<dt>Kind</dt>
				<dd>
					<span data-testid="goal-kind">
						if g.Kind == "" {
							Not yet Dated or Ongoing
						} else {
							<button type="button" class="disclose help" aria-expanded="false" aria-controls="kind-help" title={ kindHelp(g.Kind) }>{ g.Kind }</button>
						}
					</span>
				</dd>
			</div>
		</dl>
		if g.Kind != "" {
			<p id="kind-help" class="explain" hidden>{ kindHelp(g.Kind) }</p>
		}
		<div data-testid="goal-people" class="gp-people">
			<dl class="gp-prop-list">
				<div class="gp-prop">
					<dt>Owner</dt>
					<dd>
						<strong data-testid="goal-owner">
							@person(g.Owner)
						</strong>
					</dd>
				</div>
			</dl>
			@ownerForms(v)
			@delegatesSection(v)
			<section data-testid="goal-contributors" class="gp-prop">
				@groupHead(v, formContributors, "Manage", "Manage Contributors") {
					<h3 class="label">Contributors</h3>
				}
				<ul class="gp-list">
					if len(v.Contributors) == 0 {
						<li data-testid="no-contributors" class="muted">No Contributors yet.</li>
					}
					for _, c := range v.Contributors {
						<li>
							@person(c)
						</li>
					}
				</ul>
				if v.opens(formContributors) {
					@openGoalForm(v, formContributors, "Add a Contributor") {
						<form data-testid="add-contributor" class="gp-inline" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/contributors", g.ID)) }>
							<input type="email" name="email" value={ v.FormInput.Get("email") } aria-label="Contributor email" placeholder="Contributor email" required autofocus/>
							<button type="submit" class="btn sm">Add Contributor</button>
						</form>
					}
				}
			</section>
		</div>
		<dl class="gp-prop-list">
			<div class="gp-prop">
				<dt>Cadence</dt>
				<dd><span data-testid="goal-cadence">every { fmt.Sprintf("%d", g.CadenceDays) } days</span></dd>
			</div>
			if !g.DeliveryDate.IsZero() {
				<div class="gp-prop">
					<dt>Delivers</dt>
					<dd>
						<span data-testid="goal-delivery-date" class="gp-dates">
							@struckDates(g.DeliveryDate, v.priorDates(0), v.dates())
							<strong>{ v.dates().date(g.DeliveryDate) }</strong>
						</span>
					</dd>
				</div>
			}
			if g.TopLevel {
				<div class="gp-prop">
					<dt>Level</dt>
					<dd><button type="button" class="disclose help" data-testid="goal-top-level" aria-expanded="false" aria-controls="top-level-help" title={ topLevelHelp }>Top-level</button></dd>
				</div>
			}
		</dl>
		if g.TopLevel {
			<p id="top-level-help" class="explain" hidden>{ topLevelHelp }</p>
		}
	</div>
}

// goalPageStyles are the Goal page's own rules on top of app.css: the frame of
// banners, document column and rail, which runs full width and full height
// under the header strip; the header strip's breadcrumb and actions with the
// More menu; the column's title, lead and sections, each a 13/600 heading
// over hairline-ruled rows; the Metric rows with their sparklines; and the
// rail's label and value rows. On a coarse pointer the More menu's items and a
// group head's small link (Manage, Edit, + Add) are 44px tall.
templ goalPageStyles() {
	<style>
		.page:has(>.gp-frame){max-width:none;padding:0;gap:0}
		.gp-frame{display:flex;flex-direction:column;min-height:calc(100vh - 48px)}
		.gp-frame:has(.toast){padding-bottom:128px}
		.gp-banners{display:flex;flex-direction:column}
		.gp-banners:empty{display:none}
		.gp-banners .alert{gap:8px;margin:0;padding:8px 28px;border:0;border-bottom:1px solid var(--color-border);border-radius:0;background:var(--color-group);color:var(--color-ink);font-size:13px;line-height:1.5;flex-wrap:wrap}
		.gp-banners .alert.st{border-bottom:1px dashed var(--checkin-overdue-edge)}
		.gp-banners .alert.ol{border-bottom:1px dashed var(--color-ink-muted)}
		.gp-banners .alert>strong{font-weight:600}
		.gp-crumbs{flex:1 1 auto}
		.gp-crumb{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
		.gp-crumbs>[aria-current]{color:var(--color-ink);font-weight:500}
		.gp-ph .ph-parent:hover{color:var(--color-ink)}
		.gp-dates>*{white-space:nowrap}
		.gp-actions{display:flex;gap:8px;align-items:center;margin-left:auto}
		.gp-actions form{margin:0}
		.gp-more{position:relative}
		.gp-more>summary{justify-content:center;min-height:0}
		.gp-menu{position:absolute;right:0;top:calc(100% + 4px);z-index:10;width:240px;max-width:calc(100vw - 32px);padding:8px;background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg);box-shadow:var(--shadow-pop);box-sizing:border-box}
		.gp-menu ul{list-style:none;margin:0;padding:0}
		.gp-menu li>a{display:flex;min-height:36px;padding:0 12px;border-radius:var(--radius-md);align-items:center;color:var(--color-ink);font-weight:500}
		.gp-menu li>a:hover{background:var(--color-primary-subtle);text-decoration:none}
		.gp-body{flex:1;display:grid;grid-template-columns:minmax(0,1fr) 300px}
		.gp-doc{width:100%;max-width:860px;margin:0 auto;padding:32px 28px 64px;box-sizing:border-box;display:flex;flex-direction:column;gap:40px;min-width:0}
		.gp-head{display:flex;flex-direction:column;gap:12px}
		.gp-head h1{margin:0;font-size:28px;line-height:1.2;font-weight:600;letter-spacing:-0.02em}
		.gp-head>p{margin:0}
		.gp-statement{display:flex;flex-direction:column;align-items:flex-start;gap:4px}
		.gp-lead{margin:0;font-size:16px;line-height:1.6;color:var(--color-ink-2)}
		.gp-lead-help{font-size:13px}
		.gp-section{gap:0}
		.gp-section>h2,.gp-section>.gp-group-head{min-height:32px;padding-bottom:8px;border-bottom:1px solid var(--color-border);box-sizing:border-box}
		.gp-section>.gp-group-head{align-items:center}
		.gp-doc h2{margin:0;font-size:13px;line-height:1.4;font-weight:600;letter-spacing:0;color:var(--color-ink)}
		.gp-section>*+*{margin-top:12px}
		.gp-section>p{margin-bottom:0}
		.gp-section>.gp-rows,.gp-section>.gp-metric,.gp-section>.rp-thread,.gp-milestones>.table-scroll{margin-top:0}
		.gp-rows{gap:0}
		.gp-rows>li{padding:8px 0;border-bottom:1px solid var(--color-border)}
		.gp-milestones th{height:32px;padding:0 16px 0 0;background:none;color:var(--color-ink-muted);font-size:12px;font-weight:500}
		.gp-milestones td{padding:8px 16px 8px 0;border-bottom:1px solid var(--color-border);vertical-align:baseline}
		.gp-milestones tr:last-child td{border-bottom:1px solid var(--color-border)}
		.gp-milestones th:nth-child(-n+2){width:1%;white-space:nowrap}
		.gp-metric{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(96px,auto);align-items:center;gap:4px 24px;padding:12px 0;border-bottom:1px solid var(--color-border)}
		.gp-metric>details{grid-column:1/-1}
		.gp-metric>details>summary{min-height:32px;justify-content:flex-start}
		.gp-metric h3{margin:0;font-size:14px;line-height:1.4;font-weight:500;color:var(--color-ink)}
		.gp-metric-name>p{margin:4px 0 0}
		.gp-current{margin:0;text-align:right;white-space:nowrap}
		.gp-current .num{font-size:20px;line-height:1.2;font-weight:600}
		.gp-spark{width:160px;max-width:100%;height:auto;display:block;overflow:visible}
		.gp-spark-target{stroke:var(--color-ink-muted)}
		.gp-spark-line{stroke:var(--color-primary-strong)}
		.gp-spark-last{fill:var(--color-primary-strong);stroke:var(--color-canvas)}
		.gp-group-head{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
		.gp-group-head>h2,.gp-group-head>h3{margin:0}
		.gp-open{display:flex;flex-direction:column;align-items:flex-start;gap:8px}
		.gp-open form{align-self:stretch}
		.gp-block{display:flex;flex-direction:column;gap:12px}
		.gp-block>.help{align-self:flex-start}
		.gp-inline{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:8px}
		.rp-inline-form{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end}
		.rp-inline-form label{display:flex;flex-direction:column;gap:4px;font-size:13px;font-weight:600}
		.rp-thread{border-left:1px solid var(--color-border);padding-left:12px;margin:8px 0;display:flex;flex-direction:column;gap:8px}
		.gp-section>.rp-thread{margin:0;padding:12px 0;border-left:0;border-bottom:1px solid var(--color-border)}
		.gp-section>.rp-thread>p{margin:0}
		.rp-reply{margin-left:24px}
		.gp-values{border:0;margin:0;padding:0;display:flex;gap:8px;flex-wrap:wrap;align-items:center}
		.gp-form{display:flex;flex-direction:column;gap:12px}
		.gp-edit form{display:flex;gap:8px;flex-wrap:wrap;margin-top:8px}
		.gp-decide{display:flex;gap:8px;margin-left:auto}
		.gp-link-meta .gp-decide form{margin:0}
		.gp-edit form{flex-direction:column}
		.gp-activation{display:flex;flex-direction:column;gap:4px;padding-top:12px;border-top:1px solid var(--color-border)}
		.gp-activation h3{margin:0;font-size:13px;font-weight:600}
		.gp-check{display:flex;gap:8px;align-items:baseline}
		.gp-check>span:first-child{width:16px;font-weight:600;color:var(--color-ink-muted)}
		.gp-check.done>span:first-child{color:var(--health-g-ink)}
		.gp-rail{display:flex;flex-direction:column;gap:16px;min-width:0;padding:20px 20px 48px;border-left:1px solid var(--color-border);box-sizing:border-box;font-size:13px}
		.gp-rail>*+*{padding-top:16px;border-top:1px solid var(--color-border)}
		.gp-rail h3{margin:0;font-size:12px;line-height:1.5;font-weight:600;letter-spacing:0;color:var(--color-ink)}
		.gp-rail .gp-block{gap:8px}
		.gp-rail p{margin:0}
		.gp-rail .gp-list{gap:4px}
		.gp-rail .gp-link{padding:4px 0}
		.gp-rail .gp-link-head>a{font-weight:500;color:var(--color-ink)}
		.gp-props,.gp-people{display:flex;flex-direction:column}
		.gp-prop-list{margin:0}
		.gp-prop{display:grid;grid-template-columns:96px minmax(0,1fr) auto;align-items:baseline;gap:4px 8px;min-height:32px;padding:4px 0;box-sizing:border-box}
		.gp-prop>dt,.gp-prop>.gp-group-head>h3{grid-column:1;margin:0;font-size:12.5px;line-height:24px;font-weight:500;color:var(--color-ink-muted)}
		.gp-prop>dd{grid-column:2/-1;margin:0;min-width:0;line-height:24px;color:var(--color-ink)}
		.gp-prop>.gp-group-head{display:contents}
		.gp-prop>.gp-group-head>a{grid-column:3;grid-row:1}
		.gp-prop>:not(dt):not(dd):not(.gp-group-head):not(.gp-open){grid-column:2;min-width:0}
		.gp-prop>.gp-open{grid-column:1/-1}
		.gp-prop .gp-list{line-height:24px}
		.gp-prop .help.explain{justify-self:start;font-size:12px}
		.gp-props>.explain,.gp-people>.gp-open{margin:4px 0 8px}
		.gp-prop dd .badge{line-height:20px}
		.gp-prop strong{font-weight:500}
		.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
		@media (pointer:coarse){.gp-menu li>a{min-height:44px}.gp-group-head>a{display:inline-flex;align-items:center;min-height:44px}}
		@media (max-width:900px){.gp-body{grid-template-columns:minmax(0,1fr)}.gp-doc{max-width:none;padding:20px 16px 32px;gap:32px}.gp-rail{padding:20px 16px 48px;border-left:0;border-top:1px solid var(--color-border)}.gp-banners .alert{padding:8px 16px}}
		@media (max-width:600px){.gp-ph{flex-wrap:wrap;padding-top:8px;padding-bottom:8px}.gp-metric{grid-template-columns:minmax(0,1fr) auto}.gp-metric>.gp-metric-spark{grid-column:1/-1;grid-row:2}}
	</style>
}

// goalMore is the header's action menu, a "More ▾" disclosure: every action on the
// Goal the viewer may take beyond checking in, each a plain link that reloads
// the page with that action's form open where it belongs (goalView.openURL).
// It holds no forms, and is left out when it would be empty.
templ goalMore(v goalView) {
	if actions := v.actions(); len(actions) > 0 {
		<details data-testid="goal-more" class="gp-more">
			<summary class="btn sm" aria-label="More actions" title="More actions">More ▾</summary>
			<div class="gp-menu">
				<ul>
					for _, a := range actions {
						<li><a href={ a.URL }>{ a.Label }</a></li>
					}
				</ul>
			</div>
		</details>
	}
}

// titleWhyItMattersForm is the Edit title and Why it matters form, open in the page head
// for the Owner or an Admin: the Goal's title and Why it matters as they stand, or
// each as typed when a save was refused.
templ titleWhyItMattersForm(v goalView) {
	{{ g := v.Goal }}
	{{ title, whyItMatters := g.Title, g.WhyItMatters }}
	if typed, ok := v.FormInput["title"]; ok && len(typed) > 0 {
		{{ title = typed[0] }}
	}
	if typed, ok := v.FormInput["why_it_matters"]; ok && len(typed) > 0 {
		{{ whyItMatters = typed[0] }}
	}
	@openGoalForm(v, formTitleWhyItMatters, "Edit title and Why it matters") {
		<form data-testid="edit-title-why-it-matters" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/why-it-matters", g.ID)) } class="gp-form">
			<label class="field">
				<span>Title</span>
				<input type="text" name="title" value={ title } required autofocus/>
			</label>
			<label class="field">
				<span>Why it matters</span>
				<textarea name="why_it_matters" rows="3" required>{ whyItMatters }</textarea>
			</label>
			<button type="submit" class="btn">Save</button>
		</form>
	}
}

// openGoalForm wraps the one form the Goal page shows open in place (goalForm):
// a label naming it, why its last submit was refused, the form itself, and a
// Cancel back to the plain page. The form's first control takes autofocus, so
// the page lands on it.
templ openGoalForm(v goalView, form goalForm, title string) {
	<section class="gp-open" data-open-form={ string(form) } aria-label={ title }>
		if title != "" {
			<h3 class="label">{ title }</h3>
		}
		if v.FormError != "" {
			<p data-testid="form-error" class="alert r" role="alert">{ v.FormError }</p>
		}
		{ children... }
		<a data-testid="cancel-form" class="btn quiet sm" href={ templ.SafeURL(fmt.Sprintf("/goals/%d", v.Goal.ID)) }>Cancel</a>
	</section>
}

// groupHead is a section's or rail group's heading with, for whoever may use
// it, a small link beside it that opens the group's form in place (goalForm),
// hidden while that form is open. linkName is the link's accessible name, which holds its
// visible text.
templ groupHead(v goalView, form goalForm, link, linkName string) {
	<div class="gp-group-head">
		{ children... }
		if v.offers(form) && !v.opens(form) {
			<a data-testid={ "open-" + string(form) } class="small" href={ v.openURL(form) } aria-label={ linkName }>{ link }</a>
		}
	</div>
}

// ownerForms are the open-in-place forms about the Goal's Owner, under them in
// the People block: Hand off, and for an Admin Reassign, Mark owner departed
// and Mark returned, the last two asking for confirmation.
templ ownerForms(v goalView) {
	{{ g := v.Goal }}
	if v.opens(formHandoff) {
		@openGoalForm(v, formHandoff, "Hand off") {
			<form data-testid="handoff-goal" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/handoff", g.ID)) } class="gp-form">
				<label class="field">
					<span>New Owner's email</span>
					<input type="email" name="to_email" value={ v.FormInput.Get("to_email") } required autofocus/>
				</label>
				<button type="submit" class="btn">Start handoff</button>
			</form>
		}
	}
	if v.opens(formReassign) {
		@openGoalForm(v, formReassign, "Reassign") {
			<form data-testid="reassign-goal" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/reassign", g.ID)) } class="gp-form">
				<label class="field">
					<span>New Owner's email</span>
					<input type="email" name="email" value={ v.FormInput.Get("email") } required autofocus/>
				</label>
				<button type="submit" class="btn">Reassign</button>
			</form>
		}
	}
	if v.opens(formDepart) {
		@openGoalForm(v, formDepart, "Mark owner departed") {
			<p class="small muted">
				@person(g.Owner)
				{ " has left the company." }
			</p>
			<form data-testid="depart-owner" method="post" action={ templ.SafeURL(fmt.Sprintf("/accounts/%d/depart", g.Owner.ID)) } onsubmit={ confirmScript(confirmDepart) }>
				<button type="submit" class="btn danger" autofocus>
					{ "Mark " }
					@personPlain(g.Owner)
					{ " departed" }
				</button>
			</form>
		}
	}
	if v.opens(formReturn) {
		@openGoalForm(v, formReturn, "Mark returned") {
			<p class="small muted">
				@person(g.Owner)
				{ " is back in the company." }
			</p>
			<form data-testid="return-owner" method="post" action={ templ.SafeURL(fmt.Sprintf("/accounts/%d/return", g.Owner.ID)) } onsubmit={ confirmScript(confirmReturn) }>
				<button type="submit" class="btn" autofocus>
					{ "Mark " }
					@personPlain(g.Owner)
					{ " returned" }
				</button>
			</form>
		}
	}
}

// whyItMattersHelp defines Why it matters on the Goal page, opened from its heading.
const whyItMattersHelp = "The customer problem this Goal addresses and what is expected to change when it succeeds."

// topLevelHelp says what Top-level means, opened from the Goal page's badge.
const topLevelHelp = "One of the company's root outcomes"

// datedHelp says what Dated means, opened from the Goal page's kind and shown
// on the New goal form's Dated card.
const datedHelp = "Has a delivery date. Its Health is judged against that date and its Milestones."

// ongoingHelp says what Ongoing means, opened from the Goal page's kind and
// shown on the New goal form's Ongoing card.
const ongoingHelp = "Has no delivery date. Its Health is judged against its Metrics' targets."

// kindHelp is the help text for a Goal's kind, Dated or Ongoing.
func kindHelp(kind string) string {
	if kind == domain.GoalOngoing {
		return ongoingHelp
	}
	return datedHelp
}

// ownerlessHelp says what Ownerless means, as the title of an Ownerless badge.
const ownerlessHelp = "Its Owner has left the company. It gets a new Owner when an Admin reassigns it, or when someone accepts a Handoff its Owner started before leaving."

// dimensionValuesHelp says what Dimension values are, opened from under the
// Goal page's Dimensions heading.
const dimensionValuesHelp = "Values from lists an Admin defines, such as Pillar or Quarter, used to filter and group Goals."

// confirmDepart is what an Admin confirms before marking a Goal's Owner departed.
const confirmDepart = "Mark this Owner departed? Every Goal they own becomes Ownerless until an Admin reassigns it."

// confirmReturn is what an Admin confirms before reversing a Goal's Owner's
// departure.
const confirmReturn = "Mark this Owner returned? They can sign in again, and the Goals they still own stop being Ownerless. Goals reassigned while they were away stay with their new Owners."

// goalDimensions shows the Goal's values in each Dimension as the rail's label
// and value rows, the values as tags — retired values stay readable — and, for its Owner, a Delegate or an Admin, a form
// to set them that opens in place from the block's Edit link:
// a select for a Dimension that takes one value, whose "None" clears it, and a
// checkbox per value, saved together, for one that takes several (CONTEXT.md:
// Delegate; retired values stay readable). An Extendable Dimension also has an
// input to add a value. A retired value the Goal carries stays selected, or
// keeps its checked box, so saving doesn't silently drop it. A Retired Dimension gets no control and is
// listed only when the Goal carries a value in it, marked retired (CONTEXT.md:
// Retired). It links everyone to the Dimensions page, which isn't in the main
// nav.
templ goalDimensions(v goalView) {
	{{ g := v.Goal }}
	if len(v.Dimensions) == 0 {
		<p data-testid="no-dimensions-defined" class="muted">No Dimensions defined yet.</p>
	}
	<dl class="gp-prop-list">
		for _, d := range v.Dimensions {
			{{ assigned := v.assignedValues(d.ID) }}
			if !d.Retired || len(assigned) > 0 {
				<div data-testid="goal-dimension" class="gp-prop">
					<dt>{ d.Name }</dt>
					<dd>
						for _, current := range assigned {
							<span class="tag" data-testid="goal-dimension-value">{ current.Value }</span>
							if current.Retired || d.Retired {
								<span class="muted small" data-testid="retired">(retired)</span>
							}
						}
						if len(assigned) == 0 {
							<span class="muted" data-testid="goal-dimension-unassigned">unassigned</span>
						}
					</dd>
				</div>
			}
		}
	</dl>
	if v.opens(formDimensions) {
		@openGoalForm(v, formDimensions, "Edit Dimension values") {
			for i, d := range domain.OfferedDimensions(v.Dimensions) {
				if d.TakesSeveral() {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/dimensions", g.ID)) } class="gp-inline">
						<input type="hidden" name="dimension_id" value={ fmt.Sprintf("%d", d.ID) }/>
						<fieldset class="gp-values">
							<legend>{ d.Name }</legend>
							for j, val := range v.choices(d) {
								<label>
									<input type="checkbox" name="value_id" value={ fmt.Sprintf("%d", val.ID) } checked?={ v.carries(val) } autofocus?={ i == 0 && j == 0 }/>
									{ val.Value }
									if val.Retired {
										<span class="muted small">(retired)</span>
									}
								</label>
							}
						</fieldset>
						<button type="submit" class="btn sm">Save</button>
					</form>
				} else {
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/dimensions", g.ID)) } class="gp-inline">
						<input type="hidden" name="dimension_id" value={ fmt.Sprintf("%d", d.ID) }/>
						<label>
							{ d.Name }
							<select name="value_id" aria-label={ d.Name } autofocus?={ i == 0 }>
								<option value="">None</option>
								for _, val := range v.choices(d) {
									<option value={ fmt.Sprintf("%d", val.ID) } selected?={ v.carries(val) }>{ valueOptionLabel(val) }</option>
								}
							</select>
						</label>
						<button type="submit" class="btn sm">Save</button>
					</form>
				}
				if d.Extendable() {
					@addGoalValue(v, d)
				}
			}
		}
	}
	<p class="small"><a href="/dimensions">All Dimensions →</a></p>
}

// addGoalValue is an Extendable Dimension's "add a value" input beside its
// choices on the Goal page: the value typed is set on the Goal, and added to
// the list first when it's new (CONTEXT.md: Extendable). A refused value comes
// back typed in.
templ addGoalValue(v goalView, d domain.Dimension) {
	<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/dimensions", v.Goal.ID)) } class="gp-inline">
		<input type="hidden" name="dimension_id" value={ fmt.Sprintf("%d", d.ID) }/>
		<input type="text" name="new_value" aria-label={ "Add a " + d.Name + " value" } placeholder={ "Add a " + d.Name + " value" } value={ v.typedFor("dimension_id", d.ID, "new_value") } required/>
		<button type="submit" class="btn sm">Add</button>
	</form>
}

// requestParentLink is the open-in-place form, under Contributes to, by which
// the Owner asks that this Goal contribute to another, with an optional note.
templ requestParentLink(v goalView) {
	if v.opens(formParentLink) {
		@openGoalForm(v, formParentLink, "Link to a parent Goal") {
			<form data-testid="request-link" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/links", v.Goal.ID)) } class="gp-form">
				<label class="field">
					<span>Parent Goal</span>
					<select name="parent_id" required autofocus>
						for _, c := range v.Candidates {
							<option value={ fmt.Sprintf("%d", c.ID) } selected?={ v.FormInput.Get("parent_id") == fmt.Sprintf("%d", c.ID) }>{ c.Title }</option>
						}
					</select>
				</label>
				<label class="field">
					<span>Note (optional)</span>
					<textarea name="note">{ v.FormInput.Get("note") }</textarea>
				</label>
				<button type="submit" class="btn">Request link</button>
			</form>
		}
	}
}

// defineGoal is the Owner's toolkit for a Proposed Goal: the activation
// checklist, Activate Goal once it is done, and Finish defining, which opens
// the define page to set the Kind, cadence, Why it matters, Milestones, Metrics and
// the rest on one form. Contributors are added from the rail's Contributors
// row.
templ defineGoal(v goalView) {
	{{ g := v.Goal }}
	<section data-testid="define-goal" class="gp-block gp-section gp-define">
		<h2>Define this Goal</h2>
		<p><a data-testid="finish-defining" class="btn" href={ templ.SafeURL(fmt.Sprintf("/goals/%d/define", g.ID)) }>Finish defining</a></p>
		<div data-testid="activation" class="gp-activation">
			<h3>Ready to activate?</h3>
			<ul data-testid="activation-checklist" class="gp-list">
				for _, item := range v.activationChecklist() {
					if item.Done {
						<li data-done="true" class="gp-check done"><span aria-hidden="true">✓</span> <span>{ item.Label }</span> <span class="muted small">done</span></li>
					} else {
						<li data-done="false" class="gp-check"><span aria-hidden="true">○</span> <span>{ item.Label }</span> <span class="muted small">to do</span></li>
					}
				}
			</ul>
		</div>
		<form data-testid="activate-goal" method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/activate", g.ID)) }>
			<button type="submit" class="btn primary" disabled?={ !v.readyToActivate() }>Activate Goal</button>
		</form>
	</section>
}

// goalIncomplete flags an Incomplete Goal at the top of its page, naming the
// required Dimensions and Fields it has no value in. It is a status, not an
// alarm: quieter than Red and Check-in overdue (CONTEXT.md: Incomplete). It
// renders nothing when the Goal lacks none.
templ goalIncomplete(missing []string) {
	if len(missing) > 0 {
		<p data-testid="goal-incomplete" class="alert lc" role="status"><strong>Incomplete</strong><span>{ "no value yet in " + strings.Join(missing, ", ") }</span></p>
	}
}

// milestoneList is a Goal's Milestones as a table of mark, date with the date
// it last slipped from struck through, and name (CONTEXT.md: Milestone, Date
// Slip), headed by the Goal's slip count and Milestone Churn. A Milestone with
// no mark leaves its Status blank, so those marked stand out. editable gives
// the Owner of a Proposed Goal an edit form on each; once Active, Milestones
// change in a Check-in.
templ milestoneList(v goalView, editable bool) {
	<p class="muted small">
		<span data-testid="goal-slip-count">{ fmt.Sprintf("%d", len(v.DateSlips)) }</span> slips
		·
		<span data-testid="goal-milestone-churn">{ fmt.Sprintf("%d", v.MilestoneChurn) }</span> added or removed since Active
	</p>
	if len(v.Milestones) == 0 {
		<p data-testid="no-milestones" class="muted">No Milestones yet.</p>
	} else {
		<div class="table-scroll">
		<table>
			<thead>
				<tr>
					<th>Status</th>
					<th>Date</th>
					<th>Milestone</th>
					if editable {
						<th><span class="sr-only">Edit</span></th>
					}
				</tr>
			</thead>
			<tbody>
				for _, m := range v.Milestones {
					<tr data-testid="goal-milestone">
						<td>
							@milestoneMarkBadge(v.milestoneMark(m))
						</td>
						<td class="num gp-dates">
							@milestoneDates(m.TargetDate, v.priorDates(m.ID), v.dates())
						</td>
						if m.Status == domain.MilestoneRemoved {
							<td>
								<del>{ m.Name }</del>
								if m.RemovedReason != "" {
									<div class="muted small">Removed: { m.RemovedReason }</div>
								}
							</td>
						} else {
							<td>{ m.Name }</td>
						}
						if editable {
							<td>
								<details class="gp-edit">
									<summary class="btn quiet sm">Edit</summary>
									<form method="post" action={ templ.SafeURL(fmt.Sprintf("/milestones/%d", m.ID)) }>
										<input type="text" name="name" value={ m.Name } aria-label="Name" required/>
										<input type="date" name="target_date" value={ fmtDate(m.TargetDate) } aria-label="Date" required/>
										<button type="submit" class="btn sm">Save</button>
									</form>
								</details>
							</td>
						}
					</tr>
				}
			</tbody>
		</table>
		</div>
	}
}

// struckDates renders the dates a date held before its Date Slips, each struck
// through ahead of the current date: ~~10/15~~ 11/03 (CONTEXT.md: Date Slip).
// A date equal to the current one is never struck through.
templ struckDates(current time.Time, prior []time.Time, dates displayDates) {
	for _, d := range domain.StruckDates(current, prior) {
		<del>{ dates.date(d) }</del>{ " " }
	}
}

// milestoneMarkBadge is a Milestone's mark (domain.MilestoneMarkOf) as a
// badge, Red and Yellow in their Health colours though they are not a Health,
// or nothing when it has none and reads as on track (CONTEXT.md: Milestone).
templ milestoneMarkBadge(mark string) {
	if mark != domain.MilestoneMarkNone {
		<span data-testid="milestone-mark" class={ "badge", healthClass(mark) }>{ mark }</span>
	}
}

// milestoneDates renders a Milestone's date as slippedDates does, its count
// marked milestone-slips.
templ milestoneDates(current time.Time, prior []time.Time, dates displayDates) {
	@slippedDates(current, prior, dates, "milestone-slips")
}

// slippedDates renders a date current first, then the most recent date it
// slipped from struck through, and the number of times it slipped once that is
// more than one, marked with countTestID: 11/20 ~~11/03~~ (3) (CONTEXT.md: Date
// Slip). prior comes earliest first. A date equal to the current one is never
// struck through: the most recent that differs is, or none.
templ slippedDates(current time.Time, prior []time.Time, dates displayDates, countTestID string) {
	<span>{ dates.date(current) }</span>
	if struck := domain.StruckDates(current, prior); len(struck) > 0 {
		<del>{ dates.date(struck[len(struck)-1]) }</del>
	}
	if n := len(prior); n > 1 {
		<span data-testid={ countTestID }>{ fmt.Sprintf("(%d)", n) }</span>
	}
}

// metricList shows each of a Goal's Metrics as a row: its name over its
// baseline and target, its trend over time against the target as a sparkline,
// and its current value in tabular figures (CONTEXT.md: the Goal page shows
// each Metric's trend); its readings and, for the Owner, its edit form fold
// under it.
templ metricList(trends []metricTrend, owner bool, dates displayDates) {
	if len(trends) == 0 {
		<p data-testid="no-metrics" class="muted">No Metrics yet.</p>
	}
	for _, t := range trends {
		{{ m := t.Metric }}
		<div data-testid="goal-metric" class="gp-metric">
			<div class="gp-metric-name">
				<h3>{ m.Name }</h3>
				<p class="muted small">{ fmtNum(m.Baseline) } → { fmtNum(m.Target) } { m.Unit } by { dates.date(m.TargetDate) }</p>
			</div>
			<div class="gp-metric-spark">
				if len(t.Readings) > 0 {
					@metricSparkline(t, dates)
				}
			</div>
			<p class="gp-current">
				if v, ok := t.current(); ok {
					<span class="num" data-testid="metric-current">{ fmtNum(v) }</span> <span class="muted">{ m.Unit }</span>
				} else {
					<span class="num muted" data-testid="metric-current">—</span>
				}
			</p>
			@metricTrendReadings(t, dates)
			if owner {
				<details data-testid="metric-edit" class="gp-edit">
					<summary class="small">Edit Metric</summary>
					<form method="post" action={ templ.SafeURL(fmt.Sprintf("/metrics/%d", m.ID)) }>
						@metricFields(m)
						<button type="submit" class="btn sm">Save</button>
					</form>
				</details>
			}
		</div>
	}
}

// metricSparkline draws a Metric's readings as a line, the latest point marked,
// over a dashed line at its target, each point naming its reading on hover.
templ metricSparkline(t metricTrend, dates displayDates) {
	{{ s := t.sparkline(dates) }}
	<svg class="gp-spark" role="img" aria-label={ t.trendLabel() } viewBox={ fmt.Sprintf("0 0 %g %g", sparkW, sparkH) } width={ fmt.Sprintf("%g", sparkW) } height={ fmt.Sprintf("%g", sparkH) }>
		<line x1="0" x2={ fmt.Sprintf("%g", sparkW) } y1={ fmt.Sprintf("%.1f", s.TargetY) } y2={ fmt.Sprintf("%.1f", s.TargetY) } class="gp-spark-target" stroke-width="1" stroke-dasharray="4 3"></line>
		<polyline points={ s.polyline() } class="gp-spark-line" fill="none" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"></polyline>
		for _, p := range s.Points {
			<circle cx={ fmt.Sprintf("%.1f", p.X) } cy={ fmt.Sprintf("%.1f", p.Y) } r="6" fill="transparent"><title>{ p.Title }</title></circle>
		}
		<circle cx={ fmt.Sprintf("%.1f", s.last().X) } cy={ fmt.Sprintf("%.1f", s.last().Y) } r="4" class="gp-spark-last" stroke-width="2"><title>{ s.last().Title }</title></circle>
	</svg>
}

// metricTrendReadings lists a Metric's readings over time against its target —
// the sparkline as a table a reader can scan — collapsed under a count
// (CONTEXT.md: Metric - its current value is recorded at each Check-in).
templ metricTrendReadings(t metricTrend, dates displayDates) {
	{{ m := t.Metric }}
	<details>
		<summary class="small muted">{ fmt.Sprintf("Readings (%d)", len(t.Readings)) }</summary>
		<ol data-testid="metric-trend" class="gp-list small">
			if len(t.Readings) == 0 {
				<li data-testid="no-readings">No readings yet.</li>
			}
			for _, rd := range t.Readings {
				<li data-testid="metric-reading">
					<span>{ dates.dayOf(rd.CreatedAt) }: <span class="num">{ fmtNum(rd.Value) }</span> { m.Unit }</span>
					<span class="muted">(target { fmtNum(m.Target) })</span>
				</li>
			}
		</ol>
	</details>
}

// highlightList shows a Goal's Highlights, newest first, each with its kind,
// note, the Owner credited, and when it was flagged (CONTEXT.md: Highlight).
// The Goal page leaves it out for a Goal with none.
templ highlightList(highlights []domain.Highlight, dates displayDates) {
	<ul class="gp-list gp-rows">
		for _, hl := range highlights {
			<li data-testid="highlight">
				<strong>{ hl.Kind }</strong>: { hl.Note }
				<span>
					{ "— " }
					@person(hl.Owner)
					{ " at " + dates.timestamp(hl.CreatedAt) }
				</span>
			</li>
		}
	</ul>
}

// metricFields is the shared set of Metric inputs, prefilled from m for editing.
templ metricFields(m domain.Metric) {
	<label>
		Name
		<input type="text" name="name" value={ m.Name } required/>
	</label>
	<label>
		Unit
		<input type="text" name="unit" value={ m.Unit } required/>
	</label>
	<label>
		Direction
		<select name="direction">
			<option value={ domain.MetricUp } selected?={ m.Direction == domain.MetricUp }>up</option>
			<option value={ domain.MetricDown } selected?={ m.Direction == domain.MetricDown }>down</option>
		</select>
	</label>
	<label>
		Baseline
		<input type="number" step="any" name="baseline" value={ fmtNum(m.Baseline) } required/>
	</label>
	<label>
		Target
		<input type="number" step="any" name="target" value={ fmtNum(m.Target) } required/>
	</label>
	<label>
		Target date
		<input type="date" name="target_date" value={ fmtDate(m.TargetDate) } required/>
	</label>
}

// linkList renders Goal g's parents or children as navigable links, each led
// by its Health, or its Lifecycle when it has none, on the title's line and, for current when they own g or the linked Goal (the Owners
// RemoveLink allows), a button that removes the connecting link at once: the
// page that follows offers Undo. emptyTestID/emptyText render when there are
// none.
templ linkList(g domain.Goal, current *domain.Account, links []domain.GoalLink, health map[int64]string, emptyTestID, emptyText string) {
	<ul class="gp-list">
		if len(links) == 0 {
			<li data-testid={ emptyTestID } class="muted">{ emptyText }</li>
		}
		for _, l := range links {
			<li class="gp-link">
				<span class="gp-link-head">
					if h := health[l.Goal.ID]; h != "" {
						@healthChip("", h)
					} else {
						<span class="badge lc">{ l.Goal.Lifecycle }</span>
					}
					<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", l.Goal.ID)) }>{ l.Goal.Title }</a>
				</span>
				<span class="gp-link-meta">
					if l.Goal.Ownerless {
						<span data-testid="ownerless" class="badge ol" title={ ownerlessHelp }>Ownerless</span>
					}
					if current != nil && (current.ID == g.Owner.ID || current.ID == l.Goal.Owner.ID) {
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/links/%d/remove", l.LinkID)) }>
							<input type="hidden" name="goal_id" value={ fmt.Sprint(g.ID) }/>
							<button type="submit" class="btn quiet sm">Remove</button>
						</form>
					}
				</span>
				<span class="muted small">
					{ "Owner " }
					@person(l.Goal.Owner)
				</span>
			</li>
		}
	</ul>
}
