package web

import (
	"fmt"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// confirmRetireField is what Retire asks before retiring a Field.
const confirmRetireField = "Retire this Field? Goals that have a value in it keep showing it, but it is no longer offered for entry."

// fieldsPage lists every Field as a card saying what it holds, and — for an
// Admin — the form to define one: a name, one of the four types, and a number
// Field's optional unit (CONTEXT.md: Admin defines Fields; Field). A Field's
// type can't change once it is defined. An Admin retires a Field from its
// card, and a Retired Field stays listed, flagged retired, with a button to
// restore it (CONTEXT.md: Retired).
templ fieldsPage(current *domain.Account, fields []domain.Field) {
	{{ admin := current != nil && current.IsAdmin }}
	@layout("Fields", current) {
		@fieldsStyles()
		<header class="page-head">
			<div>
				<h1>Fields</h1>
				<p class="muted">The values typed directly on a Goal to describe it. A Field never filters, groups or adds up Goals.</p>
			</div>
		</header>
		if admin {
			<details>
				<summary class="btn primary">Define a Field</summary>
				<form data-testid="create-field" class="card fd-card fd-new" method="post" action="/fields">
					<h3>Define a Field</h3>
					<label class="field">
						<span>Name</span>
						<input type="text" name="name" required/>
					</label>
					<fieldset class="fd-types">
						<legend>It holds <span class="hint">— this can't change later</span></legend>
						<label><input type="radio" name="type" value={ domain.FieldNumber } checked/> a number</label>
						<label><input type="radio" name="type" value={ domain.FieldShortText }/> a short text</label>
						<label><input type="radio" name="type" value={ domain.FieldLongText }/> a long text</label>
						<label><input type="radio" name="type" value={ domain.FieldDate }/> a date</label>
					</fieldset>
					<label class="field">
						<span>Unit <span class="hint">— optional, numbers only (e.g. $, FTE)</span></span>
						<input type="text" name="unit"/>
					</label>
					<div>
						<button type="submit" class="btn primary">Create Field</button>
					</div>
				</form>
			</details>
		}
		<ul data-testid="fields" class="fd-list">
			if len(fields) == 0 {
				<li data-testid="no-fields" class="card fd-card muted">No Fields yet.</li>
			}
			for _, f := range fields {
				<li data-testid="field" class="card fd-card">
					<h3>
						{ f.Name }
						if f.Retired {
							<span data-testid="field-retired" class="muted small">retired</span>
						}
					</h3>
					<p class="muted small" data-testid="field-type">{ fieldTypeLabel(f) }</p>
					if admin {
						if f.Retired {
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/fields/%d/restore", f.ID)) }>
								<button type="submit" class="btn sm">Restore this Field</button>
							</form>
						} else {
							<form method="post" action={ templ.SafeURL(fmt.Sprintf("/fields/%d/retire", f.ID)) } onsubmit={ confirmScript(confirmRetireField) }>
								<button type="submit" class="btn danger sm">Retire this Field</button>
							</form>
						}
					}
				</li>
			}
		</ul>
	}
}

// fieldsStyles are the Fields page's own rules on top of app.css.
templ fieldsStyles() {
	<style>
		.fd-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:16px}
		.fd-card{padding:20px;display:flex;flex-direction:column;gap:12px}
		.fd-new{margin-top:12px}
		.fd-card form{margin:0}
		.fd-types{border:0;margin:0;padding:0;display:flex;gap:16px;flex-wrap:wrap}
		.fd-types legend{padding:0;margin-bottom:4px}
	</style>
}
