package web

import (
	"fmt"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// goalFreshness flags, at the top of a Goal's page, a Goal that is Check-in
// overdue or whose Path to Green is overdue, as a banner in Check-in overdue's
// style. The Check-in overdue banner ends with a link to the Check-in form for
// whoever may check in (the Owner or a Delegate). It renders nothing for a
// fresh Goal.
templ goalFreshness(goalID int64, f domain.Freshness, canCheckin bool, dates displayDates) {
	if f.CheckinOverdue {
		<p data-testid="goal-checkin-overdue" class="alert st" role="alert">
			<strong>Check-in overdue</strong><span>{ checkinOverdueSince(f) }</span>
			if canCheckin {
				<a data-testid="checkin-overdue-checkin-now" href={ templ.SafeURL(fmt.Sprintf("/goals/%d/checkin", goalID)) }>Check in now</a>
			}
		</p>
	}
	if f.PathToGreenOverdue {
		<p data-testid="goal-path-overdue" class="alert st" role="alert"><strong>Path to Green overdue</strong><span>{ pathOverdue(f, dates) }</span></p>
	}
}

// goalRowFreshness marks a Goal's row in the Goal list with Check-in overdue's
// dashed grey chip when it is Check-in overdue, saying for how long, when its
// Path to Green is overdue, or when it is Green past a Milestone's date
// (Milestone overdue).
templ goalRowFreshness(f domain.Freshness) {
	if f.CheckinOverdue {
		<span data-testid="checkin-overdue" class="badge st">Check-in overdue · { fmt.Sprintf("%d days", f.DaysSince) }</span>
	}
	if f.PathToGreenOverdue {
		<span data-testid="path-overdue" class="badge st">Path to Green overdue</span>
	}
	if f.MilestoneOverdue {
		<span data-testid="milestone-overdue" class="badge st">Milestone overdue</span>
	}
}

// rolledUpCheckinOverdue says, beside the Rolled-up Health, how many Active
// children are Check-in overdue ("3 of 12 overdue"). It never changes the
// color, and renders nothing when none are.
templ rolledUpCheckinOverdue(r domain.RolledUpHealth) {
	if r.CheckinOverdueChildren > 0 {
		· <span data-testid="goal-rollup-checkin-overdue">{ fmt.Sprintf("%d of %d overdue", r.CheckinOverdueChildren, r.ActiveChildren) }</span>
	}
}

// checkinOverdueSince says how long a Check-in overdue Goal has gone without a
// Check-in, against its cadence.
func checkinOverdueSince(f domain.Freshness) string {
	return fmt.Sprintf("no Check-in for %d days on a %d-day cadence", f.DaysSince, f.CadenceDays)
}

// pathOverdue names the target date a Path to Green has missed, as dates
// shows it.
func pathOverdue(f domain.Freshness, dates displayDates) string {
	return fmt.Sprintf("meant to be back to Green by %s", dates.date(f.PathTargetDate))
}
