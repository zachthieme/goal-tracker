package web

import (
	"fmt"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// delegatePage is the Delegate's worklist: every Goal an Owner has authorized
// them to check in on, each a row with its Health, its Owner, when it was last
// checked in on, and a Check in link to the Check-in page, so they can update it
// without sharing the Owner's login (CONTEXT.md: Delegate). It sits in the flat
// frame: its title in the page header, and the Goals a plain section of
// hairline rows (DESIGN.md § Components: Sections).
//
//nolint:contextcheck // templ hands its closures Render's ctx in a struct field, which contextcheck can't follow
templ delegatePage(current *domain.Account, goals []delegatedGoal) {
	@framedLayout("Delegated to me", current, pageHeader(pageHead{Title: "Delegated to me"})) {
		<style>
			.dg-section{display:flex;flex-direction:column;gap:12px}
			.dg-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--color-border)}
			.dg-row{display:flex;align-items:center;gap:16px;flex-wrap:wrap;min-height:44px;padding:12px 0;border-bottom:1px solid var(--color-border);box-sizing:border-box}
			.dg-health{flex:none;min-width:96px}
			.dg-what{flex:1;min-width:0;display:flex;flex-direction:column;gap:4px}
			.dg-what p{margin:0}
			.dg-action{flex:none}
			.dg-action p{margin:0}
		</style>
		<section class="dg-section">
			<div>
				<h2>Goals delegated to me</h2>
				<p class="muted">Goals whose Owner has authorized you to write Check-ins on their behalf.</p>
			</div>
			if len(goals) == 0 {
				<p data-testid="no-delegated-goals" class="muted">No Goals have been delegated to you yet.</p>
			} else {
				<ul data-testid="delegated-goals" class="dg-list">
					for _, item := range goals {
						{{ g := item.Goal }}
						<li data-testid="delegated-goal" class="dg-row">
							<div class="dg-health">
								if item.Health != "" {
									@healthChip("delegated-goal-health", item.Health)
								} else {
									<span class="badge lc">{ g.Lifecycle }</span>
								}
							</div>
							<div class="dg-what">
								<h3><a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a></h3>
								<p class="muted small">
									Owner 
									<strong data-testid="delegated-goal-owner">
										@person(g.Owner)
									</strong>
									if item.Latest != nil {
										{ " · Last check-in " + daysAgo(item.Freshness.DaysSince) + " by " }
										@person(item.Latest.Author)
									} else {
										{ " · " }<span data-testid="delegated-goal-no-health">No Check-ins yet.</span>
									}
								</p>
							</div>
							<div class="dg-action">
								if domain.LifecycleTakesCheckins(g.Lifecycle) {
									<a class="btn primary sm" href={ templ.SafeURL(fmt.Sprintf("/goals/%d/checkin", g.ID)) }>Check in</a>
								} else {
									<p data-testid="delegated-goal-not-active" class="muted small">{ fmt.Sprintf("A %s Goal takes no Check-ins.", g.Lifecycle) }</p>
								}
							</div>
						</li>
					}
				</ul>
			}
		</section>
	}
}

// delegateHelp says what a Delegate is, opened from under the Goal page's
// Delegates (CONTEXT.md: Delegate).
const delegateHelp = "Someone the Owner authorizes to write Check-ins and set this Goal's Dimension values and Fields. The Owner stays accountable."

// delegatesSection is the Goal page rail's Delegates row: the Goal's
// Delegates, marking a Departed one (CONTEXT.md: Departed), with a Manage link
// for their Owner that opens, in place, the form to authorize or revoke one by
// email (CONTEXT.md: an Owner authorizes a Delegate).
templ delegatesSection(v goalView) {
	{{ g := v.Goal }}
	<section data-testid="goal-delegates" class="gp-prop">
		@groupHead(v, formDelegates, "Manage", "Manage Delegates") {
			<h3 class="label">Delegates</h3>
		}
		<ul data-testid="delegate-list" class="gp-list">
			if len(v.Delegates) == 0 {
				<li data-testid="no-delegates" class="muted">No Delegates yet.</li>
			}
			for _, d := range v.Delegates {
				<li data-testid="delegate">
					@person(d)
					if d.Departed {
						{ " " }<span data-testid="delegate-departed" class="badge lc">departed</span>
					}
				</li>
			}
		</ul>
		<button type="button" class="disclose help explain" aria-expanded="false" aria-controls="delegate-help" title={ delegateHelp }>What is a Delegate?</button>
		<p id="delegate-help" class="explain" hidden>{ delegateHelp }</p>
		if v.opens(formDelegates) {
			@openGoalForm(v, formDelegates, "Manage Delegates") {
				for _, d := range v.Delegates {
					<form
						method="post"
						class="gp-inline"
						action={ templ.SafeURL(fmt.Sprintf("/goals/%d/delegates/remove", g.ID)) }
					>
						<input type="hidden" name="email" value={ d.Email }/>
						@person(d)
						<button type="submit" class="btn quiet sm">Remove</button>
					</form>
				}
				<form
					data-testid="add-delegate"
					method="post"
					class="gp-inline"
					action={ templ.SafeURL(fmt.Sprintf("/goals/%d/delegates", g.ID)) }
				>
					@personPicker(personField{Name: "email", Value: v.FormInput.Get("email"), Caption: "Delegate email", CaptionHidden: true, Autofocus: true})
					<button type="submit" class="btn sm">Add Delegate</button>
				</form>
			}
		}
	</section>
}
