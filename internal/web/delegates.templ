package web

import (
	"fmt"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// delegatePage is the Delegate's worklist: every Goal an Owner has authorized
// them to check in on, each a card with its Health, its Owner, when it was last
// checked in on, and a Check in link to the Check-in page, so they can update it
// without sharing the Owner's login (CONTEXT.md: Delegate).
templ delegatePage(current *domain.Account, goals []delegatedGoal) {
	@layout("Delegated to me", current) {
		<style>
			.dg-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:16px}
			.dg-card{padding:20px 24px;display:flex;flex-direction:column;gap:12px}
			.dg-card .btn{align-self:flex-start}
		</style>
		<header class="page-head">
			<div>
				<h1>Goals delegated to me</h1>
				<p class="muted">Goals whose Owner has authorized you to write Check-ins on their behalf.</p>
			</div>
		</header>
		if len(goals) == 0 {
			<p data-testid="no-delegated-goals" class="muted">No Goals have been delegated to you yet.</p>
		}
		<ul data-testid="delegated-goals" class="dg-list">
			for _, item := range goals {
				{{ g := item.Goal }}
				<li data-testid="delegated-goal" class="card dg-card">
					<div>
						if item.Latest != nil && item.Latest.Health != "" && g.Lifecycle == domain.LifecycleActive {
							<span class={ "badge", healthClass(item.Latest.Health) }><span class="dot"></span><span data-testid="delegated-goal-health">{ item.Latest.Health }</span></span>
						} else {
							<span class="badge lc">{ g.Lifecycle }</span>
						}
					</div>
					<h3><a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a></h3>
					<p class="muted">
						Owner 
						<strong data-testid="delegated-goal-owner">
							@person(g.Owner)
						</strong>
					</p>
					if item.Latest != nil {
						<p class="muted small">
							{ "Last check-in " + daysAgo(item.DaysSince) + " by " }
							@person(item.Latest.Author)
						</p>
					} else {
						<p data-testid="delegated-goal-no-health" class="muted small">No Check-ins yet.</p>
					}
					if g.Lifecycle == domain.LifecycleActive || g.Lifecycle == domain.LifecycleOnHold {
						<a class="btn primary" href={ templ.SafeURL(fmt.Sprintf("/goals/%d/checkin", g.ID)) }>Check in</a>
					} else {
						<p data-testid="delegated-goal-not-active" class="muted small">{ fmt.Sprintf("A %s Goal takes no Check-ins.", g.Lifecycle) }</p>
					}
				</li>
			}
		</ul>
	}
}

// delegatesSection lists a Goal's Delegates, marking a Departed one (CONTEXT.md:
// Departed), and gives their Owner a Manage link that opens, in place, the
// form to authorize or revoke one by email (CONTEXT.md: an Owner authorizes a
// Delegate).
templ delegatesSection(v goalView) {
	{{ g := v.Goal }}
	<section data-testid="goal-delegates">
		@groupHead(v, formDelegates, "Manage", "Manage Delegates") {
			<h3 class="label">Delegates</h3>
		}
		<ul data-testid="delegate-list" class="gp-list">
			if len(v.Delegates) == 0 {
				<li data-testid="no-delegates" class="muted">No Delegates yet.</li>
			}
			for _, d := range v.Delegates {
				<li data-testid="delegate">
					@person(d)
					if d.Departed {
						{ " " }<span data-testid="delegate-departed" class="badge lc">departed</span>
					}
				</li>
			}
		</ul>
		if v.opens(formDelegates) {
			@openGoalForm(v, formDelegates, "Manage Delegates") {
				for _, d := range v.Delegates {
					<form
						method="post"
						class="gp-inline"
						action={ templ.SafeURL(fmt.Sprintf("/goals/%d/delegates/remove", g.ID)) }
					>
						<input type="hidden" name="email" value={ d.Email }/>
						@person(d)
						<button type="submit" class="btn quiet sm">Remove</button>
					</form>
				}
				<form
					data-testid="add-delegate"
					method="post"
					class="gp-inline"
					action={ templ.SafeURL(fmt.Sprintf("/goals/%d/delegates", g.ID)) }
				>
					<input type="email" name="email" value={ v.FormInput.Get("email") } aria-label="Delegate email" placeholder="Delegate email" required autofocus/>
					<button type="submit" class="btn sm">Add Delegate</button>
				</form>
			}
		}
	</section>
}
