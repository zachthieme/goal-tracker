package web

import (
	"fmt"
	"slices"
	"time"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// reportsPage lists every saved Report Definition as a row of a status table —
// its scope, its Goals and their Health, when it was last published and by
// whom, and how much its draft has changed since — and links New report to the
// builder (CONTEXT.md: Report Definition). Dates are the org's (loc).
templ reportsPage(current *domain.Account, data reportsListData) {
	@layout("Reports", current) {
		@reportStyles()
		<header class="page-head">
			<div>
				<h1>Reports</h1>
				<p data-testid="reports-description" class="muted">Recurring write-ups of a set of Goals. Publish a frozen copy for readers to comment on.</p>
			</div>
			<a data-testid="new-report" class="btn primary" href="/reports/new">New report</a>
		</header>
		if len(data.Reports) == 0 {
			<p data-testid="no-reports" class="muted">No reports yet.</p>
		} else {
			<div class="card rp-table">
				<table data-testid="report-table">
					<thead>
						<tr><th>Report</th><th>Goals</th><th>Last published</th><th class="rp-draft">Draft</th></tr>
					</thead>
					<tbody>
						for _, sum := range data.Reports {
							@reportRow(sum, data.Loc)
						}
					</tbody>
				</table>
			</div>
		}
	}
}

// reportRow is one Report Definition in the status table: its name over its
// scope, its Goal count over a bar of their Health, its last publication's
// date in the org's timezone (loc) over its publisher, or Never, and its
// draft's changes since, or Not published.
templ reportRow(sum domain.ReportSummary, loc *time.Location) {
	<tr data-testid="report-row">
		<td class="rp-name">
			<a href={ templ.SafeURL(fmt.Sprintf("/reports/%d", sum.Definition.ID)) }>{ sum.Definition.Name }</a>
			<span data-testid="report-scope" class="small muted">{ sum.Scope }</span>
		</td>
		<td>
			<span data-testid="report-goals">{ fmt.Sprint(sum.Goals) }</span>
			if h := sum.Health; h.Green+h.Yellow+h.Red > 0 {
				@reportHealthBar(h)
			}
		</td>
		<td>
			if p := sum.LastPublication; p != nil {
				<span data-testid="report-published">{ fmtPublishedDateIn(p.PublishedAt, loc) }</span>
				<span class="small muted">
					@person(p.PublishedBy)
				</span>
			} else {
				<span data-testid="report-published" class="muted">Never</span>
			}
		</td>
		<td class="rp-draft">
			if sum.Changes == nil {
				<span data-testid="report-draft" class="muted">Not published</span>
			} else if *sum.Changes > 0 {
				<span data-testid="report-draft" class="rp-changes-hot">{ plural(*sum.Changes, "change") }</span>
			} else {
				<span data-testid="report-draft" class="muted">{ plural(*sum.Changes, "change") }</span>
			}
		</td>
	</tr>
}

// reportHealthBar draws a Report's Goals by Health as one segmented bar, a
// unit for each Goal with a Health, Green then Yellow then Red, as Home's
// does (DESIGN.md: Health distribution bar). Its label says the same to
// assistive technology.
templ reportHealthBar(h domain.HealthCounts) {
	<div data-testid="report-health-bar" class="rp-bar" role="img" aria-label={ fmt.Sprintf("%d Green, %d Yellow, %d Red", h.Green, h.Yellow, h.Red) }>
		for range h.Green {
			<span class="g"></span>
		}
		for range h.Yellow {
			<span class="y"></span>
		}
		for range h.Red {
			<span class="r"></span>
		}
	</div>
}

// reportDraftPage shows a saved Report Definition and its draft Report read
// against a baseline the reader can change — by default the previous
// publication. A header, sticky above a phone's width, carries the save status,
// the baseline chip, the History of its publications (times in the org's
// timezone, loc) and Publish; below it the
// author composes the narrative on the left beside a preview of exactly what
// readers will see (CONTEXT.md: Report, Report Definition). Paths to Green are
// judged overdue as of asOf, today.
templ reportDraftPage(current *domain.Account, r domain.Report, asOf time.Time, pubs []domain.Publication, d discussion, loc *time.Location, chip baselineChip, panel goalsPanel) {
	@layout(r.Definition.Name, current) {
		@reportStyles()
		<header data-testid="draft-header" class="rp-draft-head">
			<div class="rp-draft-title">
				<div>
					<p class="small muted"><a href="/reports">Reports</a>{ " / " }Draft</p>
					<h1 data-testid="report-name">{ r.Definition.Name }</h1>
				</div>
				@saveStatus("", false)
			</div>
			@reportBaselineChip(r, chip)
			<div class="rp-head-actions">
				@reportHistory(pubs, loc)
				@editDefinitionLink(panel.Edit, "btn")
				@reportPublish(r, chip)
			</div>
		</header>
		<div data-testid="draft-panes" class="rp-panes">
			<aside data-testid="compose-panel" class="rp-body rp-compose">
				<section data-testid="draft-introduction">
					<h2>Introduction</h2>
					if r.Definition.Introduction != "" {
						<p>{ r.Definition.Introduction }</p>
					} else {
						<p class="muted">No introduction.</p>
					}
				</section>
				@narrativeCuration(r, chip)
			</aside>
			<div class="rp-body">
				@reportGoalsPanel(panel)
				@draftPreview(r, asOf, d)
			</div>
		</div>
	}
}

// draftPreview is the draft's preview pane: exactly what readers will see.
// Autosaving the narrative swaps it in place.
templ draftPreview(r domain.Report, asOf time.Time, d discussion) {
	<section id="draft-preview" data-testid="report-draft" class="rp-body">
		<p class="label">Preview: exactly what readers will see</p>
		@reportContent(r, asOf, d)
	</section>
}

// saveStatus is the draft header's save status: "Saving…" while the compose
// form autosaves (it is the form's indicator), then the outcome, text. An
// autosave's answer swaps it in out of band.
templ saveStatus(text string, oob bool) {
	<span
		data-testid="save-status"
		id="save-status"
		class="small muted rp-save"
		if oob {
			hx-swap-oob="true"
		}
	>
		<span class="rp-saving">Saving…</span>
		<span data-testid="save-result" id="save-result">{ text }</span>
	</span>
}

// narrativeSaved answers an autosave of the narrative: the preview showing it,
// and out of band the save status, the compose form's Highlights count (there
// is none to swap when there are no Highlights) and Publish…'s summary.
templ narrativeSaved(r domain.Report, asOf time.Time, d discussion, chip baselineChip) {
	@draftPreview(r, asOf, d)
	@saveStatus("Saved", true)
	if len(r.Highlights) > 0 {
		@curationCount(r, true)
	}
	@publishSummaryText(r, chip, true)
}

// reportBaselineChip is the draft header's "Changes since …" menu: back to the
// previous publication (once there is one), 30 days ago, or a date the reader
// picks. Each is a plain link or GET form, so the baseline lives in the URL.
templ reportBaselineChip(r domain.Report, chip baselineChip) {
	<details data-testid="baseline-chip" class="rp-menu rp-chip">
		<summary>
			<span>Changes since <strong data-testid="baseline-label">{ chip.Label }</strong></span>
			<span aria-hidden="true">▾</span>
		</summary>
		<ul class="card rp-list">
			if chip.Published {
				<li><a data-testid="baseline-last-publication" href={ templ.SafeURL(chip.Draft) }>Last publication</a></li>
			}
			<li><a data-testid="baseline-30-days" href={ templ.SafeURL(chip.Draft + "?baseline=" + chip.ThirtyDaysAgo) }>30 days ago</a></li>
			<li>
				<details data-testid="baseline-pick">
					<summary>Pick a date…</summary>
					<form data-testid="report-baseline" class="rp-inline-form" method="get" action={ templ.SafeURL(chip.Draft) }>
						<label>
							Changes since
							<input type="date" name="baseline" value={ fmtDate(r.Baseline) }/>
						</label>
						<button type="submit" class="btn">Apply</button>
					</form>
				</details>
			</li>
		</ul>
	</details>
}

// reportPublish is the draft header's Publish…: a disclosure confirming what
// the publication will freeze, with Cancel, which reloads the draft as it
// stands and so closes it, and the publish form. A date the reader picked is
// carried on the action; otherwise publishing reads against the previous
// publication, as the draft does.
templ reportPublish(r domain.Report, chip baselineChip) {
	<details data-testid="publish-confirm" class="rp-menu rp-confirm">
		<summary class="btn primary">Publish…</summary>
		<div class="card rp-publish">
			<div>
				<h2>{ "Publish " + r.Definition.Name + "?" }</h2>
				@publishSummaryText(r, chip, false)
			</div>
			<div class="rp-actions">
				<a data-testid="publish-cancel" class="btn quiet" href={ templ.SafeURL(chip.Draft + chip.Query) }>Cancel</a>
				<form data-testid="report-publish" method="post" action={ templ.SafeURL(fmt.Sprintf("/reports/%d/publications%s", r.Definition.ID, chip.Query)) }>
					<button type="submit" class="btn primary">Publish</button>
				</form>
			</div>
		</div>
	</details>
}

// publishSummaryText is Publish…'s summary of what the publication will
// freeze. An autosave's answer swaps it in out of band.
templ publishSummaryText(r domain.Report, chip baselineChip, oob bool) {
	<p
		data-testid="publish-summary"
		id="publish-summary"
		class="muted"
		if oob {
			hx-swap-oob="true"
		}
	>{ publishSummary(r, chip) }</p>
}

// reportHistory is the draft header's menu of a Report Definition's
// publications, newest first, each with when it was published in the org's
// timezone and who published it.
templ reportHistory(pubs []domain.Publication, loc *time.Location) {
	<details data-testid="report-history" class="rp-menu">
		<summary>{ fmt.Sprintf("History (%d)", len(pubs)) }</summary>
		<ul class="card rp-list">
			if len(pubs) == 0 {
				<li data-testid="no-publications" class="muted">Not published yet.</li>
			}
			for _, p := range pubs {
				<li data-testid="report-publication">
					<a href={ templ.SafeURL(publicationPath(p)) }>{ fmtPublishedIn(p.PublishedAt, loc) }</a>
					<br/>
					<span class="small muted">
						{ "by " }
						@person(p.PublishedBy)
					</span>
				</li>
			}
		</ul>
	</details>
}

// reportGoalsPanel tells the author which Goals the draft selects, for them
// alone and never published: what the definition selects in plain words, then
// each Goal once with its Health, the exceptions marked for attention and
// those only in by Also include marked added, the first few up front and the
// rest behind Show all.
templ reportGoalsPanel(panel goalsPanel) {
	<section data-testid="report-goals" class="card rp-goals">
		<div class="rp-goals-head">
			<h2 data-testid="report-goal-count">{ plural(len(panel.Goals), "Goal") + " in this report" }</h2>
			<span data-testid="scope-summary" class="small muted">{ panel.Scope }</span>
			@editDefinitionLink(panel.Edit, "btn quiet sm")
		</div>
		@reportGoalList(panel.Goals[:min(len(panel.Goals), reportGoalsShown)])
		if len(panel.Goals) > reportGoalsShown {
			<details data-testid="report-goals-more">
				<summary>{ fmt.Sprintf("Show all %d", len(panel.Goals)) }</summary>
				@reportGoalList(panel.Goals[reportGoalsShown:])
			</details>
		}
	</section>
}

// editDefinitionLink is Edit definition, linking to edit, as class; there is
// none for a reader who may not edit the definition (edit is "").
templ editDefinitionLink(edit, class string) {
	if edit != "" {
		<a data-testid="edit-definition" class={ class } href={ templ.SafeURL(edit) }>Edit definition</a>
	}
}

// reportGoalList lists Goals on the draft's Goals panel, each linking to its
// place in the preview.
templ reportGoalList(goals []reportGoal) {
	<ul class="rp-goal-list">
		for _, g := range goals {
			<li data-testid="report-goal">
				<span class={ "rp-goal-dot", healthClass(g.Health) } role="img" aria-label={ reportHealth(g.Health) }><span class="dot"></span></span>
				<a href={ templ.SafeURL(fmt.Sprintf("#goal-%d", g.Goal.ID)) }>{ g.Goal.Title }</a>
				if g.Added {
					<span data-testid="report-goal-added" class="small muted rp-attention">added</span>
				}
				if g.Attention {
					<span data-testid="report-goal-attention" class="small muted rp-attention">attention</span>
				}
			</li>
		}
	</ul>
}

// publicationPage shows a published Report exactly as it was frozen: who
// published it and when, and what it read its changes against. It links the
// ways to read it outside the tool: Markdown, and a page to print to PDF.
// Readers discuss it in place: comments on each Goal's block, and the Action
// Items raised on it (ticket #19).
templ publicationPage(current *domain.Account, p domain.Publication, d discussion) {
	@layout(p.Report.Definition.Name, current) {
		@reportStyles()
		<div class="rp-read">
			<header class="rp-head">
				<div>
					<p class="small muted" data-testid="report-breadcrumb">
						<a href="/reports">Reports</a>{ " / " }<a href={ templ.SafeURL(fmt.Sprintf("/reports/%d", p.DefinitionID)) }>{ p.Report.Definition.Name }</a>
					</p>
					<h1 data-testid="report-name">{ p.Report.Definition.Name }</h1>
					@publishedLine(p)
				</div>
				<div class="rp-actions" data-testid="report-export">
					<a data-testid="export-markdown" class="btn sm" href={ templ.SafeURL(publicationPath(p) + "/markdown") }>Markdown</a>
					<a data-testid="export-print" class="btn sm" href={ templ.SafeURL(publicationPath(p) + "/print") }>Print / PDF</a>
				</div>
			</header>
			@reportContent(p.Report, p.PublishedAt, d)
			@publicationActionItems(d)
		</div>
	}
}

// publicationPrintPage is a published Report on its own, without the app's
// navigation, styled to print to PDF from the browser.
templ publicationPrintPage(p domain.Publication) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Report.Definition.Name } · { fmtPublished(p.PublishedAt) }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href={ reportFontsURL }/>
			<style>
				/* Goal Tracker · design-system: DESIGN.md § Print variant */
				:root {
					--print-font: 'Source Serif 4', Georgia, serif;
					--print-ink: #000;
					--print-ink-2: #444;
					--print-rule: #999;
				}
				@page { margin: 18mm 16mm; }
				body { font-family: var(--print-font); color: var(--print-ink); font-size: 11pt; line-height: 1.45; max-width: 44rem; margin: 2rem auto; padding: 0 1rem; }
				h1 { font-size: 24pt; font-weight: 600; line-height: 1.15; margin: 0 0 0.25rem; }
				h2 { font-size: 13pt; font-weight: 600; margin: 2rem 0 0; padding-top: 0.5rem; border-top: 1.5pt solid var(--print-ink); break-after: avoid; }
				h3 { font-size: 13pt; font-weight: 600; line-height: 1.25; margin: 0; }
				p { margin: 0.4rem 0; }
				strong { font-weight: 600; }
				a { color: inherit; text-decoration: none; }
				ul { margin: 0.2rem 0 0.4rem; padding-left: 1.1rem; }
				article { break-inside: avoid; border-top: 0.5pt solid var(--print-rule); padding: 0.9rem 0 0.6rem; }
				h2 + article { border-top: none; }
				.rp-card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
				.rp-card-head p { margin: 0.1rem 0 0; }
				table { border-collapse: collapse; width: 100%; font-size: 10pt; }
				th, td { text-align: left; vertical-align: top; padding: 0.3rem 0.75rem 0.3rem 0; border-bottom: 0.5pt solid var(--print-rule); }
				th { font-weight: 600; font-variant: small-caps; letter-spacing: 0.05em; border-bottom: 1pt solid var(--print-ink); }
				tr { break-inside: avoid; }
				.dot { display: none; }
				.badge { font-weight: 600; white-space: nowrap; }
				.shape { margin-right: 0.25em; }
				.muted { color: var(--print-ink-2); }
				.small { font-size: 9.5pt; }
				.label { font-variant: small-caps; letter-spacing: 0.05em; color: var(--print-ink-2); margin: 0.6rem 0 0; }
				.rp-fields { display: flex; flex-wrap: wrap; gap: 0.1rem 1rem; margin: 0.3rem 0; }
				.rp-fields > div { display: flex; gap: 0.25rem; }
				.rp-fields dt { font-weight: 600; }
				.rp-fields dt::after { content: ":"; }
				.rp-fields dd { margin: 0; }
				.rp-field-long { white-space: pre-line; }
				@media print {
					body { margin: 0; max-width: none; padding: 0; }
					.no-print { display: none; }
				}
			</style>
		</head>
		<body>
			<p class="no-print">
				<button type="button" onclick="window.print()">Print</button>
				{ " " }
				<a href={ templ.SafeURL(publicationPath(p)) }>Back to the publication</a>
			</p>
			<h1 data-testid="report-name">{ p.Report.Definition.Name }</h1>
			@publishedLine(p)
			<section data-testid="report-snapshot">
				@reportBody(p.Report, p.PublishedAt, discussion{})
			</section>
		</body>
	</html>
}

// reportContent is what a reader of a Report sees, published or previewed on
// the draft: the Health summary, then the Report's body. The draft previews
// through it so its preview is the publication.
templ reportContent(r domain.Report, asOf time.Time, d discussion) {
	@healthSummary(r)
	<section data-testid="report-snapshot" class="rp-body">
		@reportBody(r, asOf, d)
	</section>
}

// healthSummary counts the Report's selected Goals by Health — Red, Yellow,
// Green — and how many are Stale, so a reader sees the shape of the org before
// reading a block.
templ healthSummary(r domain.Report) {
	<section data-testid="health-summary" class="rp-tiles">
		for _, t := range healthTiles(r) {
			<div class="card rp-tile">
				<span class={ "badge", t.class }><span class="dot"></span>{ t.label }</span>
				<span data-testid={ "health-count-" + t.key } class="num rp-count">{ fmt.Sprintf("%d", t.count) }</span>
			</div>
		}
	</section>
}

// publishedLine says who published a Report and when, and what it read its
// changes against.
templ publishedLine(p domain.Publication) {
	<p data-testid="report-published" class="muted">
		{ "Published " + fmtPublished(p.PublishedAt) + " by " }
		@person(p.PublishedBy)
		if p.Report.Previous.ID != 0 {
			{ " · changes since the previous publication, " }{ fmtPublished(p.Report.Previous.PublishedAt) }
		} else {
			{ " · changes since " }{ fmtDate(p.Report.Baseline) }
		}
	</p>
}

// reportBody is a Report's content, drafted or published: its open Action
// Items, the introduction, the narrative curated from Highlights, then the
// exceptions that need attention, counted, each a card with the full MBR block, and
// every other selected Goal on track, one table row with its Health, title,
// Owner, and due date (CONTEXT.md: Report), and last the Goals that entered or
// left since the latest publication. A Path to Green is judged overdue as of
// asOf. On a publication, each Goal carries its discussion.
templ reportBody(r domain.Report, asOf time.Time, d discussion) {
	@reportActionItems(r.ActionItems, d)
	if r.Definition.Introduction != "" {
		<p data-testid="report-introduction">{ r.Definition.Introduction }</p>
	}
	@reportNarrative(r.Narrative)
	if len(r.Exceptions) == 0 && len(r.Lines) == 0 {
		<p data-testid="no-selected-goals">No Goals selected.</p>
	}
	if len(r.Exceptions) > 0 {
		<section data-testid="needs-attention">
			<h2>Needs attention{ " " }<span data-testid="needs-attention-count" class="num muted">{ fmt.Sprintf("%d", len(r.Exceptions)) }</span></h2>
			for _, b := range r.Exceptions {
				@reportBlock(b, asOf, d)
			}
		</section>
	}
	if len(r.Lines) > 0 {
		<section data-testid="on-track-section">
			<h2>On track</h2>
			<div class="card">
				<table data-testid="on-track">
					<thead>
						<tr><th>Health</th><th>Goal</th><th>Owner</th><th>Due</th></tr>
					</thead>
					<tbody>
						for _, sg := range r.Lines {
							<tr data-testid="selected-goal" id={ fmt.Sprintf("goal-%d", sg.Goal.ID) }>
								<td>
									@healthBadge("selected-health", sg.Health)
								</td>
								<td>
									<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", sg.Goal.ID)) }>{ sg.Goal.Title }</a>
									@reportFields(sg.Fields)
								</td>
								<td data-testid="selected-owner">
									@person(sg.Goal.Owner)
								</td>
								<td>
									if !sg.Goal.DeliveryDate.IsZero() {
										<span data-testid="selected-due" class="num rp-date">{ fmtDate(sg.Goal.DeliveryDate) }</span>
									} else {
										<span class="muted">—</span>
									}
								</td>
							</tr>
							if d.Pub != nil {
								<tr>
									<td colspan="4">
										@goalDiscussion(sg.Goal.ID, d)
									</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		</section>
	}
	@membershipChanges(r.MembershipChanges)
}

// membershipChanges lists the Goals that entered or left the Report since its
// Definition's latest publication, each linking to the Goal, with Added or
// Left and why. It shows only when there are some.
templ membershipChanges(changes []domain.MembershipChange) {
	if len(changes) > 0 {
		<section data-testid="membership-changes">
			<h2>Goals that entered or left this report</h2>
			<div class="card">
				<table>
					<thead>
						<tr><th>Goal</th><th>Change</th><th>Why</th></tr>
					</thead>
					<tbody>
						for _, c := range changes {
							<tr data-testid="membership-change" id={ fmt.Sprintf("membership-%d", c.Goal.ID) }>
								<td><a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", c.Goal.ID)) }>{ c.Goal.Title }</a></td>
								<td data-testid="membership-direction">{ c.Direction }</td>
								<td data-testid="membership-reason">{ c.Reason }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</section>
	}
}

// narrativeCuration is the draft page's form for curating the narrative of the
// next publication: every Highlight in scope since the baseline, each with a
// box to include it and the section it goes into, and the section text for
// each section (CONTEXT.md: Highlight).
templ narrativeCuration(r domain.Report, chip baselineChip) {
	<section data-testid="report-curation" class="rp-body">
		<h2>Narrative</h2>
		// A date the reader picked rides on the action, so the draft reloads
		// against it. With htmx the form autosaves as the author types,
		// swapping in the preview and the save status but never its own
		// fields; Save narrative is for readers without JavaScript.
		<form
			data-testid="narrative-curation"
			class="card rp-form rp-card"
			method="post"
			action={ templ.SafeURL(narrativeAction(r, chip)) }
			hx-post={ narrativeAction(r, chip) }
			hx-trigger="change, input delay:400ms"
			hx-target="#draft-preview"
			hx-swap="outerHTML"
			hx-sync="this:replace"
			hx-indicator="#save-status"
			hx-on:htmx:response-error={ notSavedScript }
			hx-on:htmx:send-error={ notSavedScript }
		>
			if len(r.Highlights) == 0 {
				<p data-testid="no-highlights">No Highlights since { fmtDate(r.Baseline) }.</p>
			} else {
				<div class="rp-curation-head">
					<h3>Highlights since { fmtDate(r.Baseline) }</h3>
					@curationCount(r, false)
				</div>
				<ul class="rp-list">
					for _, nh := range r.Highlights {
						@curationHighlight(nh)
					}
				</ul>
			}
			<h3>Your notes per section</h3>
			for _, section := range narrativeSections {
				@sectionText(section, narrativeText(r, section))
			}
			<noscript><button type="submit" class="btn">Save narrative</button></noscript>
		</form>
	</section>
}

// curationCount is how many of the Highlights the compose form offers are
// picked into the narrative. An autosave's answer swaps it in out of band.
templ curationCount(r domain.Report, oob bool) {
	<span
		data-testid="curation-count"
		id="curation-count"
		class="small muted"
		if oob {
			hx-swap-oob="true"
		}
	>{ fmt.Sprintf("%d of %d in", pickedHighlights(r), len(r.Highlights)) }</span>
}

// narrativeAction is where the curation form posts: the narrative, against the
// baseline the reader picked.
func narrativeAction(r domain.Report, chip baselineChip) string {
	return fmt.Sprintf("/reports/%d/narrative%s", r.Definition.ID, chip.Query)
}

// notSavedScript says Not saved in the draft's save status when an autosave
// gets an error status or no answer at all.
var notSavedScript = templ.ComponentScript{Call: "document.getElementById('save-result').textContent = 'Not saved'"}

// sectionText is a section's own text on the curation form, folded under the
// section's heading: open when the author has written some, closed and
// offering to add some when not.
templ sectionText(section, text string) {
	<details data-testid={ "section-text-" + section } class="card rp-section-text" open?={ text != "" }>
		<summary data-testid="section-text-summary">
			<span>{ sectionHeading(section) }</span>
			if text == "" {
				<span class="rp-add">+ Add note</span>
			}
		</summary>
		<label class="field">
			<span class="sr-only">{ sectionHeading(section) }</span>
			<textarea name={ "text-" + section }>{ text }</textarea>
		</label>
	</details>
}

// curationHighlight is one Highlight on the curation form: a box to include it
// and, while ticked, the section it goes into — the one it was picked into, or
// else its own kind. Unticked, it shows its kind instead. The section radios
// stay in the form, hidden by CSS, so it always submits a section without JS.
templ curationHighlight(nh domain.NarrativeHighlight) {
	<li data-testid="curation-highlight" class="rp-curate">
		<label class="rp-include">
			<input type="checkbox" name={ fmt.Sprintf("include-%d", nh.Highlight.ID) } value="on" checked?={ nh.Section != "" }/>
			<span>{ nh.Highlight.Note }</span>
		</label>
		<p class="small muted">
			@person(nh.Highlight.Owner)
			{ " · " }
			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", nh.GoalID)) }>{ nh.GoalTitle }</a>
			<span class="rp-kind">{ " · " + nh.Highlight.Kind }</span>
		</p>
		<fieldset class="rp-sections">
			<legend class="sr-only">Section</legend>
			for _, section := range narrativeSections {
				<label>
					<input type="radio" name={ fmt.Sprintf("pick-%d", nh.Highlight.ID) } value={ section } checked?={ curatedSection(nh) == section }/>
					<span>{ section }</span>
				</label>
			}
		</fieldset>
	</li>
}

// reportNarrative is a Report's Insights, Accomplishments, and Misses, in the
// serif face under label headings: the author's text and the Highlights they
// picked, each crediting the Goal's Owner. Sections with neither are left out.
templ reportNarrative(narrative []domain.NarrativeSection) {
	if len(narrative) > 0 {
		<section data-testid="report-narrative" class="card rp-narrative">
			for _, sec := range narrative {
				<h3 data-testid="narrative-section" class="label">{ sec.Heading() }</h3>
				if sec.Text != "" {
					<p data-testid="narrative-text">{ sec.Text }</p>
				}
				if len(sec.Highlights) > 0 {
					<ul>
						for _, nh := range sec.Highlights {
							<li data-testid="narrative-highlight">
								{ nh.Highlight.Note }
								@highlightCredit(nh)
							</li>
						}
					</ul>
				}
			}
		</section>
	}
}

// highlightCredit credits a Highlight to the Goal's Owner, naming the Goal.
templ highlightCredit(nh domain.NarrativeHighlight) {
	<span data-testid="highlight-credit" class="rp-credit">
		{ " — " }
		@person(nh.Highlight.Owner)
		{ ", " }
		<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", nh.GoalID)) }>{ nh.GoalTitle }</a>
	</span>
}

// reportBlock is an exception Goal's full MBR block, as a card: title, Owner,
// Lifecycle, and due date with its history struck through; Health and badges
// top right; So What, latest status, and Path to Green in a tinted box, marked
// Overdue when its target date passed before asOf; Milestones, Metrics against
// target, and the Rolled-up Health with the Owner's explanation. The Fields the
// definition chose sit under the head, beside the Goal rather than in the
// status box. On a publication it ends with the Goal's discussion.
templ reportBlock(b domain.ReportBlock, asOf time.Time, d discussion) {
	<article data-testid="report-exception" class="card rp-card" id={ fmt.Sprintf("goal-%d", b.Goal.ID) }>
		<div class="rp-card-head">
			<div>
				<h3><a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", b.Goal.ID)) }>{ b.Goal.Title }</a></h3>
				<p class="small muted">
					<span data-testid="report-owner">
						@person(b.Goal.Owner)
					</span>
					{ " · " }{ b.Goal.Lifecycle }
					if !b.Goal.DeliveryDate.IsZero() {
						{ " · due " }
						<span data-testid="report-due">
							@struckDates(b.PriorDueDates)
							{ fmtDate(b.Goal.DeliveryDate) }
						</span>
					}
				</p>
			</div>
			<div class="rp-badges">
				@healthBadge("report-health", b.Health)
				for _, badge := range b.Badges {
					<span data-testid="report-badge" class={ "badge", badgeClass(badge) }>{ badge }</span>
				}
			</div>
		</div>
		@reportFields(b.Fields)
		<div data-testid="report-status-box" class={ "rp-tint", templ.KV("overdue", pathOverdueAt(b, asOf)) }>
			<p data-testid="report-so-what"><strong>So What:</strong> { b.Goal.SoWhat }</p>
			if b.Status != "" {
				<p data-testid="report-status"><strong>Status:</strong> { b.Status }</p>
			}
			if b.PathToGreen != "" {
				<p data-testid="report-path-to-green">
					<strong>Path to Green:</strong> { b.PathToGreen } (back to Green by { fmtDate(b.PathTargetDate) })
					if pathOverdueAt(b, asOf) {
						{ " " }<strong data-testid="path-overdue" class="badge r">Overdue</strong>
					}
				</p>
			}
		</div>
		if len(b.Milestones) > 0 {
			<div>
				<p class="label">Milestones</p>
				<ul data-testid="report-milestones">
					for _, m := range b.Milestones {
						<li data-testid="report-milestone">
							if m.Milestone.Status == domain.MilestoneRemoved {
								<del>{ m.Milestone.Name }</del>
							} else {
								{ m.Milestone.Name }
							}
							{ " — " }
							@struckDates(m.PriorDates)
							{ fmtDate(m.Milestone.TargetDate) }
							if m.New {
								{ " " }<span class="badge lc">New</span>
							}
							if m.Milestone.Status != domain.MilestonePlanned {
								{ " " }<span class="badge lc">{ m.Milestone.Status }</span>
							}
							if m.Milestone.RemovedReason != "" {
								<span>— { m.Milestone.RemovedReason }</span>
							}
						</li>
					}
				</ul>
			</div>
		}
		if len(b.Metrics) > 0 {
			<div>
				<p class="label">Metrics</p>
				<ul data-testid="report-metrics">
					for _, m := range b.Metrics {
						<li data-testid="report-metric">
							{ m.Metric.Name }:
							if m.Read {
								{ fmtNum(m.Current) }
							} else {
								no reading yet
							}
							{ " against a target of " }{ fmtNum(m.Metric.Target) } { m.Metric.Unit } by { fmtDate(m.Metric.TargetDate) }
							{ " (baseline " }{ fmtNum(m.Metric.Baseline) }, { m.Metric.Direction })
						</li>
					}
				</ul>
			</div>
		}
		if b.RolledUp.Present || b.RolledUp.StaleChildren > 0 {
			<p data-testid="report-rollup">
				if b.RolledUp.Present {
					<strong>Rolled-up Health:</strong>
					@healthBadge("rollup-health", b.RolledUp.Health)
				}
				@rolledUpStale(b.RolledUp)
				if b.Explanation != "" {
					<br/>
					<strong>Why the Health differs:</strong> { b.Explanation }
				}
			</p>
		}
		@goalDiscussion(b.Goal.ID, d)
	</article>
}

// reportFields is a Goal's values in the Fields its Report chose, each a
// labelled value: a number with its unit, a long text with its line breaks
// kept. A Goal with no value in any of them shows nothing (ticket #78).
templ reportFields(fields []domain.FieldValue) {
	if len(fields) > 0 {
		<dl data-testid="report-fields" class="rp-fields small">
			for _, v := range fields {
				<div data-testid="report-field">
					<dt>{ v.Field.Name }</dt>
					<dd class={ templ.KV("rp-field-long", v.Field.Type == domain.FieldLongText) }>
						if v.Field.Type == domain.FieldNumber {
							<span class="num">{ v.Value }</span>
							if v.Field.Unit != "" {
								{ " " + v.Field.Unit }
							}
						} else {
							{ v.Value }
						}
					</dd>
				</div>
			}
		</dl>
	}
}

// healthBadge is a Health as a coloured badge, marked for print, or a dash
// when there is none yet.
templ healthBadge(testID, health string) {
	<span data-testid={ testID } class={ "badge", healthClass(health) }>
		@healthMark(health)
		{ reportHealth(health) }
	</span>
}

// healthMark marks a Health on a badge: the design system's coloured dot on
// screen, and on the print page, which hides the dot, a shape that survives
// black-and-white printing — ■ Red, ▲ Yellow, ● Green.
templ healthMark(health string) {
	<span class="dot"></span>
	if shape := healthShape(health); shape != "" {
		<span class="shape" aria-hidden="true">{ shape }</span>
	}
}

// healthShape is the shape the print page marks a Health with.
func healthShape(health string) string {
	switch health {
	case domain.HealthRed:
		return "■"
	case domain.HealthYellow:
		return "▲"
	case domain.HealthGreen:
		return "●"
	}
	return ""
}

// reportFontsURL loads the serif the print page reads in. Print sits outside
// DESIGN.md on purpose: it is set for black-and-white paper, not the screen.
const reportFontsURL = "https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap"

// healthClass is the badge colour for a Health; no Health yet is neutral.
func healthClass(health string) string {
	switch health {
	case domain.HealthRed:
		return "r"
	case domain.HealthYellow:
		return "y"
	case domain.HealthGreen:
		return "g"
	}
	return "lc"
}

// badgeClass is a report badge's colour: Stale in its own colour, Ownerless as
// prominent as Red, a New Date as a warning, and the rest neutral.
func badgeClass(badge string) string {
	switch badge {
	case domain.BadgeStale:
		return "st"
	case domain.BadgeOwnerless:
		return "r"
	case domain.BadgeNewDate:
		return "y"
	}
	return "lc"
}

// pathOverdueAt reports whether an Active exception's Path to Green had missed
// its target date as of asOf — the day it was published, or today on the
// draft (CONTEXT.md: Path to Green).
func pathOverdueAt(b domain.ReportBlock, asOf time.Time) bool {
	if b.Goal.Lifecycle != domain.LifecycleActive || b.PathTargetDate.IsZero() {
		return false
	}
	if b.Health != domain.HealthRed && b.Health != domain.HealthYellow {
		return false
	}
	return fmtDate(asOf.UTC()) > fmtDate(b.PathTargetDate)
}

// reportGoalsShown is how many Goals the draft's Goals panel lists before Show
// all.
const reportGoalsShown = 6

// reportGoal is one Goal on the draft's Goals panel: its Health, whether it
// is an exception, which gets a full block that needs the reader's attention,
// and whether it is Added: in the Report only because of Also include.
type reportGoal struct {
	Goal      domain.Goal
	Health    string
	Attention bool
	Added     bool
}

// reportGoals lists the Goals a Report selects, the exceptions first and then
// the rest, as the Report itself reads, marking those in added.
func reportGoals(r domain.Report, added map[int64]bool) []reportGoal {
	out := make([]reportGoal, 0, len(r.Exceptions)+len(r.Lines))
	for _, b := range r.Exceptions {
		out = append(out, reportGoal{Goal: b.Goal, Health: b.Health, Attention: true, Added: added[b.Goal.ID]})
	}
	for _, sg := range r.Lines {
		out = append(out, reportGoal{Goal: sg.Goal, Health: sg.Health, Added: added[sg.Goal.ID]})
	}
	return out
}

// healthTile is one count on a Report's Health summary.
type healthTile struct {
	key, label, class string
	count             int
}

// healthTiles counts a Report's selected Goals by Health, and its Stale ones —
// only an exception block can be Stale, since a Stale Goal is an exception.
func healthTiles(r domain.Report) []healthTile {
	byHealth := map[string]int{}
	stale := 0
	for _, b := range r.Exceptions {
		byHealth[b.Health]++
		if slices.Contains(b.Badges, domain.BadgeStale) {
			stale++
		}
	}
	for _, sg := range r.Lines {
		byHealth[sg.Health]++
	}
	return []healthTile{
		{"red", domain.HealthRed, "r", byHealth[domain.HealthRed]},
		{"yellow", domain.HealthYellow, "y", byHealth[domain.HealthYellow]},
		{"green", domain.HealthGreen, "g", byHealth[domain.HealthGreen]},
		{"stale", domain.BadgeStale, "st", stale},
	}
}

// reportHealth renders a selected Goal's Health, or a dash when it has no Check-in
// yet (a Proposed Goal, or an Active one not yet checked in on).
func reportHealth(health string) string {
	if health == "" {
		return "—"
	}
	return health
}

// fmtPublished renders the instant a Report was published, to the minute.
func fmtPublished(t time.Time) string {
	return t.UTC().Format("2006-01-02 15:04 UTC")
}

// fmtPublishedIn renders the instant a Report was published, to the minute, in
// the org's timezone: "2 Mar 2026, 19:00 PST".
func fmtPublishedIn(t time.Time, loc *time.Location) string {
	return t.In(loc).Format("2 Jan 2006, 15:04 MST")
}

// fmtPublishedDateIn renders the day a Report was published in the org's
// timezone: "Mar 2".
func fmtPublishedDateIn(t time.Time, loc *time.Location) string {
	return t.In(loc).Format("Jan 2")
}

// pickedHighlights counts the Highlights the author has picked into a section,
// as last saved.
func pickedHighlights(r domain.Report) int {
	n := 0
	for _, nh := range r.Highlights {
		if nh.Section != "" {
			n++
		}
	}
	return n
}

// curatedSection is the section a Highlight's control selects: the one the
// author picked it into, or else its own kind, since kinds and sections are
// the same strings.
func curatedSection(nh domain.NarrativeHighlight) string {
	if nh.Section != "" {
		return nh.Section
	}
	return nh.Highlight.Kind
}

// narrativeSections are a Report narrative's sections in the order it shows
// them.
var narrativeSections = []string{domain.HighlightInsight, domain.HighlightAccomplishment, domain.HighlightMiss}

// sectionHeading is a narrative section's title, e.g. "Insights".
func sectionHeading(section string) string {
	return domain.NarrativeSection{Kind: section}.Heading()
}

// narrativeText is the author's text for one section of a Report's narrative.
func narrativeText(r domain.Report, section string) string {
	for _, sec := range r.Narrative {
		if sec.Kind == section {
			return sec.Text
		}
	}
	return ""
}

// reportStyles are the Report pages' own rules on top of app.css: the reading
// column a publication is centred in, the Health tiles, the exception cards and
// their tinted status box, the discussion footer, the scrolling root-Goal
// picker, and the draft's header, its Goals panel, and its compose and preview
// panes, which stack into one column at 900px and shrink to a phone's width
// rather than to the On track table's. At a phone's width the header stops
// sticking and stacks into rows — the name with its save status, the chip, then
// History, Edit definition and Publish… — and the Publish… card spans the
// screen between its gutters.
templ reportStyles() {
	<style>
		.shape{display:none}
		.page>.rp-read{width:100%;max-width:880px;margin:0 auto;display:flex;flex-direction:column;gap:24px}
		.rp-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap}
		.rp-head h1{margin:4px 0}
		.rp-actions{display:flex;gap:8px}
		.rp-tiles,.rp-body .rp-tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
		.rp-tile{padding:16px;display:flex;align-items:center;justify-content:space-between;gap:8px}
		.rp-count{font-size:24px}
		.rp-body{display:flex;flex-direction:column;gap:24px}
		.rp-body section{display:flex;flex-direction:column;gap:12px}
		.rp-list{list-style:none;margin:0;padding:0}
		.rp-list>li{padding:12px 24px;border-bottom:1px solid var(--color-border)}
		.rp-list>li:last-child{border-bottom:none}
		.rp-narrative{font-size:16px;line-height:1.7;padding:24px;color:var(--color-ink)}
		.rp-narrative .label{margin-top:12px}
		.rp-narrative .label:first-child{margin-top:0}
		.rp-narrative ul{margin:4px 0 0;padding-left:20px}
		.rp-credit{color:var(--color-ink-muted);font-size:13px}
		.rp-section-text{padding:0 16px}
		.rp-section-text[open]{padding-bottom:16px}
		.rp-add{color:var(--color-primary-strong);font-weight:500}
		.rp-curation-head{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
		.rp-curation-head h3{font-size:15px;margin:0}
		.rp-curate{display:flex;flex-direction:column;gap:4px}
		.rp-include{display:flex;align-items:flex-start;gap:12px;cursor:pointer}
		.rp-include input{margin-top:4px}
		.rp-curate>p{margin-left:28px}
		.rp-form fieldset.rp-sections{display:inline-flex;flex-direction:row;gap:0;align-self:flex-start;border:1px solid var(--color-border-strong);border-radius:var(--radius-md);padding:0;margin:4px 0 0 28px;overflow:hidden}
		.rp-sections label{position:relative;padding:4px 12px;cursor:pointer;font-size:13px}
		.rp-curate:not(:has(input[name^=include-]:checked)) .rp-sections{display:none}
		.rp-curate:has(input[name^=include-]:checked) .rp-kind{display:none}
		.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
		@supports selector(:has(*)){
			.rp-sections input{position:absolute;opacity:0;pointer-events:none}
			.rp-sections label:has(input:checked){background:var(--color-ink);color:var(--color-surface)}
			.rp-sections label:has(input:focus-visible){outline:2px solid var(--color-focus);outline-offset:-2px}
		}
		.rp-card{padding:24px;display:flex;flex-direction:column;gap:12px}
		.rp-card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
		.rp-card-head h3{font-size:19px}
		.rp-badges{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
		.rp-tint{background:var(--color-surface-alt);border-radius:var(--radius-md);padding:12px 16px;display:flex;flex-direction:column;gap:8px}
		.rp-tint.overdue{background:var(--health-r-bg)}
		.rp-card ul{margin:0;padding-left:20px}
		.rp-card .rp-list{padding:0}
		.rp-discussion{border-top:1px solid var(--color-border);padding-top:8px;display:flex;flex-wrap:wrap;gap:4px 16px;align-items:flex-start}
		.rp-discussion>details{flex:1 1 auto}
		.rp-discussion details>summary{min-height:32px;justify-content:flex-start;color:var(--color-primary-strong);font-weight:500}
		.rp-thread{border-left:1px solid var(--color-border);padding-left:12px;margin:8px 0;display:flex;flex-direction:column;gap:8px}
		.rp-reply{margin-left:24px}
		.rp-inline-form{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end}
		.rp-inline-form label{display:flex;flex-direction:column;gap:4px;font-size:13px;font-weight:600}
		.rp-table{overflow:hidden}
		.rp-table td{vertical-align:top}
		.rp-table tbody tr:last-child>td{border-bottom:none}
		.rp-name>a{display:block;font-weight:600;color:var(--color-ink)}
		.rp-name>span,.rp-table td>.small{display:block}
		.rp-draft{text-align:right}
		.rp-date{white-space:nowrap}
		.rp-changes-hot{display:inline-block;padding:4px 12px;border-radius:var(--radius-full);background:var(--health-y-bg);color:var(--health-y-ink);font-weight:600;white-space:nowrap}
		.rp-bar{display:flex;width:176px;max-width:100%;height:12px;margin-top:4px;border-radius:var(--radius-full);overflow:hidden}
		.rp-bar>span{flex:1 1 0;min-width:2px}
		.rp-bar>.g{background:var(--health-g-ink)}
		.rp-bar>.y{background:var(--health-y-ink)}
		.rp-bar>.r{background:var(--health-r-ink)}
		.rp-bar>.g+.y,.rp-bar>.g+.r,.rp-bar>.y+.r{margin-left:4px}
		.rp-form{display:flex;flex-direction:column;gap:16px}
		.rp-form fieldset{border:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
		.rp-form legend{font-weight:600;font-size:13px;padding:0 0 8px}
		.rp-fields{display:flex;flex-wrap:wrap;gap:4px 16px;margin:0}
		.rp-fields>div{display:flex;gap:4px;min-width:0}
		.rp-fields dt{font-weight:600}
		.rp-fields dt::after{content:":"}
		.rp-fields dd{margin:0}
		.rp-field-long{white-space:pre-line}
		.rp-publish{position:absolute;right:0;z-index:3;width:min(560px,calc(100vw - 32px));padding:24px;display:flex;align-items:center;gap:16px 24px;flex-wrap:wrap;box-shadow:0 12px 32px rgb(0 0 0 / 12%)}
		.rp-publish>div:first-child{flex:1 1 280px}
		.rp-publish h2{font-size:17px;margin:0 0 4px}
		.rp-publish p{margin:0}
		.rp-publish .rp-actions{align-items:center}
		.rp-draft-head{position:sticky;top:0;z-index:2;background:var(--color-canvas);border-bottom:1px solid var(--color-border);padding:12px 0;display:flex;align-items:center;gap:16px 24px;flex-wrap:wrap}
		.rp-draft-head h1{margin:0}
		.rp-menu.rp-chip>summary{justify-content:flex-start;gap:4px;color:var(--color-ink);font-weight:400;padding:0 16px;border:1px solid var(--color-border-strong);border-radius:var(--radius-full)}
		.rp-menu.rp-chip>ul{left:0;right:auto}
		.rp-chip>ul>li>details>summary{min-height:0;color:var(--color-primary-strong);font-weight:500}
		.rp-chip form{margin-top:8px}
		.rp-draft-title{display:contents}
		.rp-draft-head .rp-save{order:1;flex:1 1 auto;text-align:right}
		.rp-head-actions{order:1;margin-left:auto;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
		.rp-saving{display:none}
		.rp-save.htmx-request .rp-saving{display:inline}
		.rp-save.htmx-request #save-result{display:none}
		.rp-menu{position:relative}
		.rp-menu>summary{color:var(--color-primary-strong);font-weight:600}
		.rp-menu>ul{position:absolute;right:0;z-index:3;min-width:280px;max-height:360px;overflow-y:auto}
		.rp-goals{padding:16px 24px;display:flex;flex-direction:column;gap:12px}
		.rp-goals-head{display:flex;align-items:baseline;gap:8px 16px;flex-wrap:wrap}
		.rp-goals-head h2{font-size:19px;margin:0}
		.rp-goal-list{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px 24px}
		.rp-goal-list>li{display:flex;align-items:center;gap:8px;min-width:0}
		.rp-goals .rp-goal-dot{background:none;border:none;display:inline-flex}
		.rp-attention{margin-left:auto}
		.rp-goals details>summary{min-height:32px;justify-content:flex-start;color:var(--color-primary-strong);font-weight:500}
		.rp-goals details>ul{margin-top:8px}
		.rp-panes{display:grid;grid-template-columns:380px minmax(0,1fr);gap:24px;align-items:start}
		.rp-panes>*{min-width:0}
		@media (max-width:600px){.rp-table thead{display:none}.rp-table tr{display:block;padding:12px 16px;border-bottom:1px solid var(--color-border)}.rp-table tbody tr:last-child{border-bottom:none}.rp-table td{display:block;padding:4px 0;border-bottom:none}.rp-table .rp-draft{text-align:left}.rp-publish{position:fixed;left:16px;right:16px;width:auto}.rp-draft-head{position:static}.rp-draft-title{display:flex;flex-basis:100%;align-items:flex-end;gap:8px 16px;min-width:0}.rp-draft-title>div{min-width:0}.rp-head-actions{flex-basis:100%;flex-wrap:nowrap;margin-left:0;gap:8px}.rp-head-actions .rp-menu>ul{left:0;right:auto}}
		@media (max-width:900px){.rp-tiles,.rp-body .rp-tiles{grid-template-columns:repeat(2,minmax(0,1fr))}.rp-panes{grid-template-columns:minmax(0,1fr)}.rp-goal-list{grid-template-columns:minmax(0,1fr)}}
	</style>
}
