package web

import (
	"fmt"
	"slices"
	"strings"
	"time"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// reportsPage lists every saved Report Definition as a row of a status list —
// its scope, its Goals and their Health, when it was last published and by
// whom, and how much its draft has changed since — and links New report to the
// builder (CONTEXT.md: Report Definition). Dates are the company's (loc). It
// sits in the flat frame under a header strip holding New report: the Open
// Action Items are a section of rows, and the definitions a full-bleed list
// whose rows are ruled off by hairlines (DESIGN.md § Reports list).
templ reportsPage(current *domain.Account, data reportsListData) {
	@framedLayout("Reports", current, reportsListHeader()) {
		@reportStyles()
		<div class="rp-index">
			<p data-testid="reports-description" class="muted rp-index-lead">Recurring write-ups of a set of Goals. Publish a frozen copy for readers to comment on.</p>
			if len(data.YourActionItems) + len(data.OrgActionItems) > 0 {
				<section data-testid="reports-action-items" class="rp-chase">
					<h2>Open Action Items</h2>
					if len(data.YourActionItems) > 0 {
						@reportsActionItemGroup("Yours", "reports-action-items-yours", data.YourActionItems)
					}
					if len(data.OrgActionItems) > 0 {
						@reportsActionItemGroup("My org", "reports-action-items-org", data.OrgActionItems)
					}
				</section>
			}
			if len(data.Reports) == 0 {
				<p data-testid="no-reports" class="muted rp-index-lead">No reports yet.</p>
			} else {
				<section class="rp-defs" aria-labelledby="rp-defs-head">
					<h2 id="rp-defs-head">Report Definitions</h2>
					<div class="rp-table">
						<table data-testid="report-table">
							<thead>
								<tr><th>Report</th><th>Goals</th><th>Last published</th><th class="rp-draft">Draft</th><th class="rp-download-cell"><span class="sr-only">Download</span></th></tr>
							</thead>
							<tbody>
								for _, sum := range data.Reports {
									@reportRow(sum, data.Loc, data.PDFFile)
								}
							</tbody>
						</table>
					</div>
				</section>
			}
		</div>
	}
}

// reportsListHeader is the Reports list's header strip: its title, and New
// report at the right as the page's primary action.
templ reportsListHeader() {
	@pageHeader(pageHead{Title: "Reports"}) {
		<a data-testid="new-report" class="btn primary sm" href="/reports/new">New report</a>
	}
}

// reportsActionItemGroup is one group of the Reports page's Open Action Items,
// a header row naming it with how many it holds, its list carrying testID.
templ reportsActionItemGroup(label, testID string, items []domain.ActionItemListing) {
	<div class="rp-chase-group">
		<h3 class="rp-group">{ label }<span class="rp-group-count">{ fmt.Sprint(len(items)) }</span></h3>
		<ul data-testid={ testID } class="rp-chase-list">
			for _, l := range items {
				@reportsActionItemRow(l)
			}
		</ul>
	</div>
}

// reportsActionItemRow is an open Action Item on the Reports page, read as on
// Home: what it asks, leading where Home's row does, flagged when overdue,
// with its Report, the Goal it is about, if any, and when it is due, then its
// owner. It closes and reassigns nothing; that stays on its publication and
// Home.
templ reportsActionItemRow(l domain.ActionItemListing) {
	<li data-testid="reports-action-item">
		<span class="badge lc">Action Item</span>
		<a href={ templ.SafeURL(homeActionItemPath(l.Item)) }>{ l.Item.Text }</a>
		if l.Overdue {
			<span data-testid="reports-action-item-overdue" class="badge r">Overdue</span>
		}
		<span class="muted">{ homeActionItemPlace(l) }</span>
		@person(l.Item.Owner)
	</li>
}

// reportRow is one Report Definition in the status list, on one line: its
// name then its scope, its Goal count then a bar of their Health, its last
// publication's date in the company's timezone (loc) then its publisher, or
// Never, its draft's changes since, or Not published, and a Download menu for
// its last publication, a PDF file when pdfFile.
templ reportRow(sum domain.ReportSummary, loc *time.Location, pdfFile bool) {
	<tr data-testid="report-row">
		<td class="rp-name">
			<a href={ templ.SafeURL(fmt.Sprintf("/reports/%d", sum.Definition.ID)) }>{ sum.Definition.Name }</a>
			<span data-testid="report-scope" class="small muted">{ sum.Scope }</span>
		</td>
		<td>
			<span data-testid="report-goals">{ fmt.Sprint(sum.Goals) }</span>
			if h := sum.Health; h.Green+h.Yellow+h.Red > 0 {
				@reportHealthBar(h)
			}
		</td>
		<td>
			if p := sum.LastPublication; p != nil {
				<span data-testid="report-published">{ showDayOfYear(p.PublishedAt, loc) }</span>
				<span class="small muted">
					{ "by " }
					@person(p.PublishedBy)
				</span>
			} else {
				<span data-testid="report-published" class="muted">Never</span>
			}
		</td>
		<td class="rp-draft">
			if sum.Changes == nil {
				<span data-testid="report-draft" class="muted">Not published</span>
			} else if *sum.Changes > 0 {
				<span data-testid="report-draft" class="rp-changes-hot">{ plural(*sum.Changes, "change") }</span>
			} else {
				<span data-testid="report-draft" class="muted">{ plural(*sum.Changes, "change") }</span>
			}
		</td>
		<td class="rp-download-cell">
			if p := sum.LastPublication; p != nil {
				@downloadMenu(*p, pdfFile)
			}
		</td>
	</tr>
}

// downloadMenu is a Download button opening a menu of the ways to take
// publication p away: Markdown, and a PDF file when pdfFile, or else its print
// page, to print to PDF from the browser. The menu is a native popover, so it
// opens without script, from the keyboard too, and closes on Escape or a click
// elsewhere; where the browser can anchor it, it hangs from the button.
templ downloadMenu(p domain.Publication, pdfFile bool) {
	<div data-testid="download-menu" class="rp-download">
		<button type="button" class="btn sm" popovertarget={ fmt.Sprintf("download-%d", p.ID) }>Download</button>
		<div id={ fmt.Sprintf("download-%d", p.ID) } class="rp-download-menu" popover>
			<a data-testid="download-markdown" href={ templ.SafeURL(publicationPath(p) + "/markdown") }>Markdown (.md)</a>
			if pdfFile {
				<a data-testid="download-pdf" href={ templ.SafeURL(publicationPath(p) + "/pdf") }>PDF (.pdf)</a>
			} else {
				<a data-testid="download-pdf" href={ templ.SafeURL(publicationPath(p) + "/print") }>PDF (print from browser)</a>
			}
		</div>
	</div>
}

// reportHealthBar draws a Report's Goals by Health as one segmented bar, a
// unit for each Goal with a Health, Green then Yellow then Red, as Home's
// does (DESIGN.md: Health distribution bar). Its label says the same to
// assistive technology.
templ reportHealthBar(h domain.HealthCounts) {
	<div data-testid="report-health-bar" class="rp-bar" role="img" aria-label={ fmt.Sprintf("%d Green, %d Yellow, %d Red", h.Green, h.Yellow, h.Red) }>
		for range h.Green {
			<span class="g"></span>
		}
		for range h.Yellow {
			<span class="y"></span>
		}
		for range h.Red {
			<span class="r"></span>
		}
	</div>
}

// reportDraftPage shows a saved Report Definition and its draft Report read
// against a baseline the reader can change — by default the previous
// publication. Its header strip, sticky above a phone's width, carries the
// breadcrumb, the save status, the baseline chip and Publish at the right.
// Below it the page is one page in two columns: the main column is the
// Report as readers get it, the narrative composed in place, and the narrow
// column beside it holds its Delegates and its History, history, times in the
// company's timezone, loc, moving under the main column where the page is too narrow for both (CONTEXT.md: Report,
// Report Definition; DESIGN.md § A Report's draft page). Paths to Green are
// judged overdue as of asOf, today. panel says what the definition selects.
// The compose form shows form, and the save status says status. Only a reader
// m lets manage the Report gets Edit definition, the compose form and
// Publish…; everyone else reads the narrative as it stands.
//
//nolint:contextcheck // templ hands its closures Render's ctx in a struct field, which contextcheck can't follow
templ reportDraftPage(current *domain.Account, r domain.Report, asOf time.Time, d discussion, loc *time.Location, chip baselineChip, panel goalsPanel, m reportManagement, history []draftHistoryEntry, form narrativeForm, status string) {
	{{ facts := r.Facts() }}
	@framedLayout(r.Definition.Name, current, reportDraftHeader(r, chip, panel, m, status)) {
		@reportStyles()
		<div class="rp-draft-page">
			<div data-testid="report-draft" class="rp-body rp-main">
				<header class="rp-head">
					<h1 data-testid="report-name">{ r.Definition.Name }</h1>
					<p data-testid="report-meta" class="muted">{ draftMeta(r, panel) }</p>
				</header>
				for _, f := range facts {
					if f.Kind == domain.ReportFactIntroduction {
						@reportIntroduction(f)
					}
				}
				@healthSummary(r)
				@reportLead(facts)
				// A div, not a section: .rp-body section's 12px gap would
				// otherwise space the Report's sections closer than on a
				// publication.
				<div data-testid="report-snapshot" class="rp-body">
					if m.Manage {
						@reportBody(withoutReportFacts(facts, domain.ReportFactIntroduction, domain.ReportFactNarrative), asOf, d, &form)
					} else {
						@reportBody(withoutReportFacts(facts, domain.ReportFactIntroduction), asOf, d, nil)
					}
				</div>
			</div>
			<aside data-testid="draft-side" class="rp-body rp-side">
				@reportDelegates(m)
				@reportHistory(r, history, loc, false)
			</aside>
		</div>
		if m.Manage {
			@narrativeSaveScript()
		}
	}
}

// draftMeta is the draft's line under its name: what the definition selects
// in plain words, how many Goals that is, and what the draft reads changes
// against ("Team: Growth · 1 left out · 6 Goals · changes since Sep 4, 2026").
func draftMeta(r domain.Report, panel goalsPanel) string {
	parts := []string{}
	if panel.Scope != "" {
		parts = append(parts, panel.Scope)
	}
	since := "changes since " + showDateYear(r.Baseline)
	if words := r.Since().Words(); words != "" {
		since = "changes since " + words + ", " + showDateYear(r.Baseline)
	}
	return strings.Join(append(parts, plural(len(r.Exceptions)+len(r.Lines), "Goal"), since), " · ")
}

// narrativeSaveScript keeps the compose form's unsaved changes in sight. A
// change to the form marks the save status Unsaved changes, and its Highlights
// count follows the boxes ticked. While the status is marked (data-unsaved),
// Publish… says to save the narrative first, its Publish button disabled, and
// leaving or reloading the page asks the browser's "Leave site?". A save's or
// Add another's answer swaps in the Narrative section unless the author
// changed the form while it was on its way: then what they typed stays, only
// the answer's out-of-band parts are taken, and the status stays marked.
// Without script none of it runs, and Publish works as ever.
templ narrativeSaveScript() {
	<script>
		(function () {
			// edits counts the author's changes; sent is the count when the
			// Narrative section last posted.
			var edits = 0, sent = 0, stale = false;
			document.addEventListener("input", changed);
			document.addEventListener("change", changed);
			// toggle doesn't bubble, so Publish… opening is caught on its way down.
			document.addEventListener("toggle", heed, true);
			document.addEventListener("htmx:afterSettle", heed);
			document.addEventListener("htmx:beforeRequest", function (e) {
				if (fromNarrative(e)) sent = edits;
			});
			document.addEventListener("htmx:beforeSwap", function (e) {
				stale = fromNarrative(e) && edits !== sent;
				if (stale) e.detail.swapOverride = "none";
			});
			document.addEventListener("htmx:afterRequest", function () {
				if (!stale) return;
				stale = false;
				markUnsaved();
			});
			window.addEventListener("beforeunload", function (e) {
				if (!unsaved()) return;
				e.preventDefault();
				e.returnValue = "";
			});
			heed();

			function fromNarrative(e) {
				return e.detail.elt instanceof Element && !!e.detail.elt.closest("#report-curation");
			}
			function unsaved() {
				var status = document.getElementById("save-status");
				return !!status && status.hasAttribute("data-unsaved");
			}
			function changed(e) {
				if (!(e.target instanceof Element) || !e.target.closest("#narrative-curation")) return;
				edits++;
				var form = document.getElementById("narrative-curation"), count = document.getElementById("curation-count");
				if (count) {
					var boxes = form.querySelectorAll('input[name^="include-"]');
					count.textContent = form.querySelectorAll('input[name^="include-"]:checked').length + " of " + boxes.length + " in";
				}
				markUnsaved();
			}
			function markUnsaved() {
				var status = document.getElementById("save-status");
				if (!status) return;
				status.setAttribute("data-unsaved", "");
				document.getElementById("save-result").textContent = "Unsaved changes";
				heed();
			}
			function heed() {
				var publish = document.querySelector('[data-testid="publish-confirm"]');
				if (!publish) return;
				var refused = unsaved();
				publish.querySelector('[data-testid="publish-unsaved"]').hidden = !refused;
				publish.querySelector('[data-testid="report-publish"] button').disabled = refused;
			}
		})();
	</script>
}

// reportDraftHeader is the draft's header strip: the breadcrumb Reports › its
// name, muted and marked a Draft, and the save status at the left, then the
// baseline chip, and Edit definition and Publish…, for a reader who may manage
// the Report, at the right (DESIGN.md § A Report's draft page).
templ reportDraftHeader(r domain.Report, chip baselineChip, panel goalsPanel, m reportManagement, status string) {
	<header data-testid="draft-header" class="page-header rp-draft-head">
		<div class="rp-draft-title">
			<nav class="ph-title" data-testid="report-breadcrumb" aria-label="Breadcrumb">
				<a class="ph-parent" href="/reports">Reports</a>
				<span class="ph-sep" aria-hidden="true">›</span>
				<span class="rp-crumb muted" aria-current="page">{ r.Definition.Name }</span>
				<span class="ph-count">Draft</span>
			</nav>
			@saveStatus(status, false)
		</div>
		@reportBaselineChip(r, chip)
		<div class="rp-head-actions">
			@editDefinitionLink(panel.Edit, "btn sm")
			if m.Manage {
				@reportPublish(r, chip)
			}
		</div>
	</header>
}

// reportDelegateHelp says what a Report Delegate is.
const reportDelegateHelp = "Someone its creator or an Admin authorizes to change this Report, curate its narrative and publish it. Only its creator and Admins add and remove them."

// reportDelegates is the draft's Delegates, in its narrow column: the Report Definition's
// Report Delegates, marking a Departed one, and for its creator and Admins a
// Remove on each and a form to add one by email, with why a refused one was
// refused (CONTEXT.md: Report Delegate).
templ reportDelegates(m reportManagement) {
	<section data-testid="report-delegates" class="rp-delegates">
		<h2>Delegates</h2>
		<ul data-testid="report-delegate-list" class="rp-list">
			if len(m.Delegates) == 0 {
				<li data-testid="no-report-delegates" class="muted">No Report Delegates yet.</li>
			}
			for _, d := range m.Delegates {
				<li data-testid="report-delegate" class="rp-delegate">
					<span>
						@person(d)
						if d.Departed {
							{ " " }<span data-testid="report-delegate-departed" class="badge lc">departed</span>
						}
					</span>
					if m.ManageDelegates {
						<form method="post" action={ templ.SafeURL(fmt.Sprintf("/reports/%d/delegates/remove", m.DefID)) }>
							<input type="hidden" name="account" value={ fmt.Sprint(d.ID) }/>
							<button data-testid="remove-report-delegate" type="submit" class="btn quiet sm">Remove</button>
						</form>
					}
				</li>
			}
		</ul>
		<button type="button" class="disclose help explain" aria-expanded="false" aria-controls="report-delegate-help" title={ reportDelegateHelp }>What is a Report Delegate?</button>
		<p id="report-delegate-help" class="explain" hidden>{ reportDelegateHelp }</p>
		if m.ManageDelegates {
			if m.Refused != "" {
				<p data-testid="report-delegate-refused" class="alert r" role="alert">{ m.Refused }</p>
			}
			<form data-testid="add-report-delegate" class="rp-delegate-add" method="post" action={ templ.SafeURL(fmt.Sprintf("/reports/%d/delegates", m.DefID)) }>
				<input type="email" name="email" value={ m.Email } aria-label="Report Delegate email" placeholder="Delegate email" required/>
				<button type="submit" class="btn sm">Add Delegate</button>
			</form>
		}
	</section>
}

// draftHistoryShown is how many of a draft's History entries, after the
// Draft, it shows before Show all.
const draftHistoryShown = 20

// reportHistory is the draft's History, in its narrow column: first the Draft,
// reading changes since r's baseline, then history, newest first: each
// publication, linking to it, and every other change in the Report log, each
// with who and when in the company's timezone (loc). The newest
// draftHistoryShown show up front and the rest behind Show all. Anyone who
// can open the Report reads it; nobody can change it (CONTEXT.md: Report log).
// Saving the narrative swaps it in out of band (oob), with the save's entry.
templ reportHistory(r domain.Report, history []draftHistoryEntry, loc *time.Location, oob bool) {
	<section
		data-testid="report-history"
		id="report-history"
		class="rp-history"
		if oob {
			hx-swap-oob="true"
		}
	>
		<h2>History</h2>
		<ol class="rp-history-list">
			<li data-testid="report-history-draft" class="muted">
				<span class="rp-mark rp-mark-draft" aria-hidden="true"></span>
				<span>Draft</span>
				<span class="small">{ "changes since " + showDateYear(r.Baseline) }</span>
			</li>
			for _, e := range history[:min(len(history), draftHistoryShown)] {
				@draftHistoryItem(e, loc)
			}
		</ol>
		if len(history) > draftHistoryShown {
			<details data-testid="report-history-more">
				<summary>{ fmt.Sprintf("Show all %d", len(history)) }</summary>
				<ol class="rp-history-list">
					for _, e := range history[draftHistoryShown:] {
						@draftHistoryItem(e, loc)
					}
				</ol>
			</details>
		}
	</section>
}

// draftHistoryItem is one History entry: "Published", linking to its
// publication, on an accent marker, or a Report log entry's Detail on a plain
// one; then when, with its year, and who.
templ draftHistoryItem(e draftHistoryEntry, loc *time.Location) {
	<li data-testid="report-history-entry">
		if e.Publication != "" {
			<span class="rp-mark rp-mark-published" aria-hidden="true"></span>
			<a href={ templ.SafeURL(e.Publication) }>{ e.Detail }</a>
		} else {
			<span class="rp-mark" aria-hidden="true"></span>
			<span>{ e.Detail }</span>
		}
		<span class="small muted">
			{ showTimeYear(e.At, loc) + " · " }
			@person(e.By)
		</span>
	</li>
}

// The save status's outcomes, beside "Saving…" while a save runs and a
// refusal's "Not saved".
const (
	narrativeSavedStatus   = "Saved"
	narrativeUnsavedStatus = "Unsaved changes"
)

// saveStatus is the draft header's save status: "Saving…" while Save narrative
// saves (it is the button's indicator), then text: Saved, Unsaved changes, or
// why the narrative was not saved. Unless it is empty or Saved, it marks the
// compose form unsaved (data-unsaved), which Publish… and leaving the page
// heed (narrativeSaveScript). An htmx answer swaps it in out of band.
//
//nolint:contextcheck // templ hands its closures Render's ctx in a struct field, which contextcheck can't follow
templ saveStatus(text string, oob bool) {
	<span
		data-testid="save-status"
		id="save-status"
		class="small muted rp-save"
		if text != "" && text != narrativeSavedStatus {
			data-unsaved
		}
		if oob {
			hx-swap-oob="true"
		}
	>
		<span class="rp-saving">Saving…</span>
		<span data-testid="save-result" id="save-result">{ text }</span>
	</span>
}

// narrativeSaved answers Save narrative over htmx: the Narrative section, its
// compose form showing form, the narrative as saved, and out of band the save
// status, Publish…'s summary and the History, history, in the company's
// timezone, loc.
//
//nolint:contextcheck // templ hands its closures Render's ctx in a struct field, which contextcheck can't follow
templ narrativeSaved(form narrativeForm, history []draftHistoryEntry, loc *time.Location) {
	@narrativeCuration(form)
	@saveStatus(narrativeSavedStatus, true)
	@publishSummaryText(form.Report, form.Chip, true)
	@reportHistory(form.Report, history, loc, true)
}

// narrativeFormAgain answers Add another over htmx: the Narrative section, its
// compose form as posted, with its added note box, and out of band the save
// status saying status. Add another saves nothing, so Publish…'s summary and
// the History stay as they were.
//
//nolint:contextcheck // templ hands its closures Render's ctx in a struct field, which contextcheck can't follow
templ narrativeFormAgain(form narrativeForm, status string) {
	@narrativeCuration(form)
	@saveStatus(status, true)
}

// reportBaselineChip is the draft header's "Changes since …" menu: back to the
// previous publication (once there is one), 30 days ago, or a date the reader
// picks. Each is a plain link or GET form, so the baseline lives in the URL.
templ reportBaselineChip(r domain.Report, chip baselineChip) {
	<details data-testid="baseline-chip" class="rp-menu rp-chip">
		<summary>
			<span>Changes since <strong data-testid="baseline-label">{ chip.Label }</strong></span>
			<span aria-hidden="true">▾</span>
		</summary>
		<ul class="rp-pop rp-list">
			if chip.Published {
				<li><a data-testid="baseline-last-publication" href={ templ.SafeURL(chip.Draft) }>Last publication</a></li>
			}
			<li><a data-testid="baseline-30-days" href={ templ.SafeURL(chip.Draft + "?baseline=" + chip.ThirtyDaysAgo) }>30 days ago</a></li>
			<li>
				<details data-testid="baseline-pick">
					<summary>Pick a date…</summary>
					<form data-testid="report-baseline" class="rp-inline-form" method="get" action={ templ.SafeURL(chip.Draft) }>
						<label>
							Changes since
							<input type="date" name="baseline" value={ fmtDate(r.Baseline) }/>
						</label>
						<button type="submit" class="btn">Apply</button>
					</form>
				</details>
			</li>
		</ul>
	</details>
}

// reportPublish is the draft header's Publish…: a disclosure confirming what
// the publication will freeze, with Cancel, which reloads the draft as it
// stands and so closes it, and the publish form. While the compose form has
// unsaved changes, script shows "Save the narrative first." and disables
// Publish (narrativeSaveScript). A date the reader picked is
// carried on the action; otherwise publishing reads against the previous
// publication, as the draft does.
templ reportPublish(r domain.Report, chip baselineChip) {
	<details data-testid="publish-confirm" class="rp-menu rp-confirm">
		<summary class="btn primary sm">Publish…</summary>
		<div class="rp-pop rp-publish">
			<div>
				<h2>{ "Publish " + r.Definition.Name + "?" }</h2>
				@publishSummaryText(r, chip, false)
				<p data-testid="publish-unsaved" role="alert" hidden><strong>Save the narrative first.</strong></p>
			</div>
			<div class="rp-actions">
				<a data-testid="publish-cancel" class="btn quiet" href={ templ.SafeURL(chip.Draft + chip.Query) }>Cancel</a>
				<form data-testid="report-publish" method="post" action={ templ.SafeURL(fmt.Sprintf("/reports/%d/publications%s", r.Definition.ID, chip.Query)) }>
					<button type="submit" class="btn primary">Publish</button>
				</form>
			</div>
		</div>
	</details>
}

// publishSummaryText is Publish…'s summary of what the publication will
// freeze. Saving the narrative over htmx swaps it in out of band.
templ publishSummaryText(r domain.Report, chip baselineChip, oob bool) {
	<p
		data-testid="publish-summary"
		id="publish-summary"
		class="muted"
		if oob {
			hx-swap-oob="true"
		}
	>{ publishSummary(r, chip) }</p>
}

// editDefinitionLink is Edit definition, linking to edit, as class; there is
// none for a reader who may not edit the definition (edit is "").
templ editDefinitionLink(edit, class string) {
	if edit != "" {
		<a data-testid="edit-definition" class={ class } href={ templ.SafeURL(edit) }>Edit definition</a>
	}
}

// publicationPage shows a published Report exactly as it was frozen: who
// published it and when, what it read its changes against, and how it
// selected its Goals as it read then. Its Download menu takes it away as
// Markdown or a PDF (a PDF file when pdfFile, else the page to print to PDF).
// Readers discuss it in place: comments on each Goal's block, and the Action
// Items raised on it (ticket #19). Its header strip holds the breadcrumb and
// Download at the right; the Report reads in a centred column below.
templ publicationPage(current *domain.Account, p domain.Publication, d discussion, pdfFile bool) {
	@framedLayout(p.Report.Definition.Name, current, publicationHeader(p, d.Loc, pdfFile)) {
		@reportStyles()
		<div class="rp-read">
			<header class="rp-head">
				<h1 data-testid="report-name">{ p.Report.Definition.Name }</h1>
				@publishedLine(p.Facts(), d.Loc)
				@publicationSelection(p.Facts())
			</header>
			@reportContent(p.Report, p.PublishedAt, d)
			@publicationActionItems(d)
		</div>
	}
}

// publicationHeader is a publication's header strip: Reports › its Report
// Definition, linking to the draft, › the day it was published in the
// company's timezone (loc), and its Download menu at the right (DESIGN.md §
// A publication).
templ publicationHeader(p domain.Publication, loc *time.Location, pdfFile bool) {
	<div class="page-header">
		<nav class="ph-title" data-testid="report-breadcrumb" aria-label="Breadcrumb">
			<a class="ph-parent" href="/reports">Reports</a>
			<span class="ph-sep" aria-hidden="true">›</span>
			<a class="ph-parent rp-crumb" href={ templ.SafeURL(fmt.Sprintf("/reports/%d", p.DefinitionID)) }>{ p.Report.Definition.Name }</a>
			<span class="ph-sep" aria-hidden="true">›</span>
			<span class="rp-crumb" aria-current="page">{ showDayOfYear(p.PublishedAt, loc) }</span>
		</nav>
		<div data-testid="report-export" class="ph-actions">
			@downloadMenu(p, pdfFile)
		</div>
	</div>
}

// publicationPrintPage is a published Report on its own, without the app's
// navigation, styled to print to PDF from the browser. Under the byline it
// says how the Report selected its Goals; it has no Health summary, so the line
// counting what moved since the baseline follows.
//
//nolint:contextcheck // templ hands its closures Render's ctx in a struct field, which contextcheck can't follow
templ publicationPrintPage(p domain.Publication, loc *time.Location) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Report.Definition.Name } · { showTimeYear(p.PublishedAt, loc) }</title>
			<style>
				/* Goal Tracker · design-system: DESIGN.md § Print variant */
				/* The serif the print page reads in, served by the app from
				 * static/fonts/. Print sits outside the screen system on purpose:
				 * it is set for paper, in colour that degrades to black and white. */
				@font-face {
					font-family: "Source Serif 4";
					font-style: normal;
					font-display: swap;
					font-weight: 200 900;
					src: url(/static/fonts/source-serif-4-latin-wght-normal.woff2) format("woff2");
					unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
				}
				@font-face {
					font-family: "Source Serif 4";
					font-style: normal;
					font-display: swap;
					font-weight: 200 900;
					src: url(/static/fonts/source-serif-4-latin-ext-wght-normal.woff2) format("woff2");
					unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
				}
				@font-face {
					font-family: "Source Serif 4";
					font-style: italic;
					font-display: swap;
					font-weight: 200 900;
					src: url(/static/fonts/source-serif-4-latin-wght-italic.woff2) format("woff2");
					unicode-range: U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD;
				}
				@font-face {
					font-family: "Source Serif 4";
					font-style: italic;
					font-display: swap;
					font-weight: 200 900;
					src: url(/static/fonts/source-serif-4-latin-ext-wght-italic.woff2) format("woff2");
					unicode-range: U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF;
				}
				:root {
					--print-font: 'Source Serif 4', Georgia, serif;
					--print-ink: #000;
					--print-ink-2: #444;
					--print-rule: #999;
					/* Health's tint and ink, the screen's light values: each ink
					 * reads at 6.27:1 or more on its tint and 7.13:1 on bare paper */
					--print-health-r-bg: #FDECEC; --print-health-r-ink: #A61B1B;
					--print-health-y-bg: #FFF3D1; --print-health-y-ink: #7A4F00;
					--print-health-g-bg: #E5F3EA; --print-health-g-ink: #1C6435;
					--print-health-none-bg: #F7F7F8; --print-health-none-ink: #33363C;
					/* Check-in overdue's grey chip, its dashed edge 3.27:1 on paper */
					--print-overdue-bg: #E9EAEC; --print-overdue-ink: #3B4048; --print-overdue-edge: #888F97;
				}
				@page { margin: 18mm 16mm; }
				body { font-family: var(--print-font); color: var(--print-ink); font-size: 11pt; line-height: 1.45; max-width: 44rem; margin: 2rem auto; padding: 0 1rem; }
				h1 { font-size: 24pt; font-weight: 600; line-height: 1.15; margin: 0 0 0.25rem; }
				h2 { font-size: 13pt; font-weight: 600; margin: 2rem 0 0; padding-top: 0.5rem; border-top: 1.5pt solid var(--print-ink); break-after: avoid; }
				h3 { font-size: 13pt; font-weight: 600; line-height: 1.25; margin: 0; }
				p { margin: 0.4rem 0; }
				strong { font-weight: 600; }
				a { color: inherit; text-decoration: none; }
				ul { margin: 0.2rem 0 0.4rem; padding-left: 1.1rem; }
				article { break-inside: avoid; border-top: 0.5pt solid var(--print-rule); padding: 0.9rem 0 0.6rem; }
				h2 + article { border-top: none; }
				.rp-card-head { display: flex; align-items: baseline; gap: 0.75rem; }
				.rp-health { white-space: nowrap; }
				.rp-card-title { flex: 1; min-width: 0; }
				.rp-card-head p { margin: 0.1rem 0 0; }
				.rp-badges { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: baseline; gap: 0.3rem; }
				table { border-collapse: collapse; width: 100%; font-size: 10pt; }
				th, td { text-align: left; vertical-align: top; padding: 0.3rem 0.75rem 0.3rem 0; border-bottom: 0.5pt solid var(--print-rule); }
				th { font-weight: 600; font-variant: small-caps; letter-spacing: 0.05em; border-bottom: 1pt solid var(--print-ink); }
				tr { break-inside: avoid; }
				/* Health's shape, as the screen draws it (app.css), in the
				 * Health's ink and kept when printed */
				.dot { --dot-size: 8px; width: var(--dot-size); height: var(--dot-size); display: inline-block; margin-right: 0.3em; vertical-align: 0.05em; background: currentColor; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
				.g .dot { border-radius: 50%; }
				.y .dot { clip-path: polygon(0 0, 100% 0, 50% 100%); width: calc(var(--dot-size) * 1.25); height: calc(var(--dot-size) * 1.125); }
				.r .dot { clip-path: polygon(30% 0, 70% 0, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0 70%, 0 30%); width: max(12px, calc(var(--dot-size) * 1.125)); height: max(12px, calc(var(--dot-size) * 1.125)); }
				.badge { font-weight: 600; white-space: nowrap; padding: 0 0.3em; border-radius: 2pt; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
				.r { background: var(--print-health-r-bg); color: var(--print-health-r-ink); }
				.y { background: var(--print-health-y-bg); color: var(--print-health-y-ink); }
				.g { background: var(--print-health-g-bg); color: var(--print-health-g-ink); }
				.lc { background: var(--print-health-none-bg); color: var(--print-health-none-ink); }
				.st { background: var(--print-overdue-bg); color: var(--print-overdue-ink); border: 0.5pt dashed var(--print-overdue-edge); }
				.muted { color: var(--print-ink-2); }
				.small { font-size: 9.5pt; }
				.label { font-variant: small-caps; letter-spacing: 0.05em; color: var(--print-ink-2); margin: 0.6rem 0 0; }
				.rp-fields { display: flex; flex-wrap: wrap; gap: 0.1rem 1rem; margin: 0.3rem 0; }
				.rp-fields > div { display: flex; gap: 0.25rem; }
				.rp-fields dt { font-weight: 600; }
				.rp-fields dt::after { content: ":"; }
				.rp-fields dd { margin: 0; }
				.rp-field-long { white-space: pre-line; }
				/* A Goal's facts in a label column, as on screen: the label in
				 * small caps, its value beside it */
				.rp-facts { display: grid; grid-template-columns: 7.5rem minmax(0, 1fr); gap: 0.15rem 0.75rem; margin: 0.3rem 0; }
				.rp-facts > div { display: contents; }
				.rp-facts dt { margin: 0; }
				.rp-facts dd { margin: 0; min-width: 0; }
				.rp-facts ul { margin: 0; }
				/* The Path to Green box, tinted in its Goal's Health, Red or
				 * Yellow, as on screen; Overdue is its badge */
				.rp-tint { padding: 0.2rem 0.5rem; border-radius: 2pt; margin: 0.3rem 0; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
				.rp-tint > p { margin: 0.2rem 0; }
				.rp-tint-r { background: var(--print-health-r-bg); }
				.rp-tint-y { background: var(--print-health-y-bg); }
				.rp-tint-r .rp-tint-label { color: var(--print-health-r-ink); }
				.rp-tint-y .rp-tint-label { color: var(--print-health-y-ink); }
				@media print {
					body { margin: 0; max-width: none; padding: 0; }
					.no-print { display: none; }
				}
			</style>
		</head>
		<body>
			<p class="no-print">
				<button type="button" onclick="window.print()">Print</button>
				{ " " }
				<a href={ templ.SafeURL(publicationPath(p)) }>Back to the publication</a>
			</p>
			<h1 data-testid="report-name">{ p.Report.Definition.Name }</h1>
			@publishedLine(p.Facts(), loc)
			@publicationSelection(p.Facts())
			@reportLead(p.Report.Facts())
			<section data-testid="report-snapshot">
				@reportBody(p.Report.Facts(), p.PublishedAt, discussion{Loc: loc, Print: true}, nil)
			</section>
		</body>
	</html>
}

// reportContent is what a reader of a published Report sees: the Health
// summary, the line counting what moved since the baseline, then the Report's
// body, each part as its facts list it (domain.Report.Facts). The Health
// summary shows whether or not they count its Goals by Health: a Report that
// selects none shows its zeros.
templ reportContent(r domain.Report, asOf time.Time, d discussion) {
	{{ facts := r.Facts() }}
	@healthSummary(r)
	@reportLead(facts)
	<section data-testid="report-snapshot" class="rp-body">
		@reportBody(facts, asOf, d, nil)
	</section>
}

// healthSummary shows how many of the Report's selected Goals have each Health
// — Red, Yellow, Green — and how many are Check-in overdue (healthTiles), so a
// reader sees the shape of the Report's Goals before reading a block. It is one
// row headed "Health", each count with its word beside it, so it reads to someone who doesn't know the
// shapes; each chip is its shape alone, so a pair reads once, "2 Red". The
// "·" between two pairs leads the pair after it, hanging into the gap
// before it, so a line never ends on one and one that starts a line is
// clipped; it is aria-hidden, so a screen reader doesn't read it.
templ healthSummary(r domain.Report) {
	<section data-testid="health-summary" class="rp-summary">
		<span class="label">Health</span>
		for i, t := range healthTiles(r) {
			<span class="rp-summary-pair">
				if i > 0 {
					<span class="muted rp-summary-sep" aria-hidden="true">·</span>
				}
				<span class={ "badge", "shape", t.class } title={ t.label } aria-hidden="true"><span class="dot"></span></span>
				<span><span data-testid={ "health-count-" + t.key } class="num">{ fmt.Sprintf("%d", t.count) }</span> { t.label }</span>
			</span>
		}
	</section>
}

// reportLead is the line a Report's facts open with under its Health summary:
// the movement line, when they hold one. The Health counts fact itself it
// skips, the Health summary standing for it on screen and the print page
// having none.
templ reportLead(facts []domain.ReportFact) {
	for _, f := range facts {
		if f.Kind == domain.ReportFactMovement {
			@reportMovement(f)
		}
	}
}

// reportMovement is the line counting the Goals that moved since the Report's
// baseline, its previous publication or a date ("Since the previous
// publication: 2 turned Red · 1 back to Green"). A Report frozen before
// Reports counted it has none to show.
templ reportMovement(f domain.ReportFact) {
	<p data-testid="report-movement">
		if parts := f.Movement.Parts; len(parts) > 0 {
			<strong>{ f.Label + " " + reportSince(f.Movement.Since) + ":" }</strong>{ " " + strings.Join(parts, " · ") }
		} else {
			{ "No movement since " + reportSince(f.Movement.Since) + "." }
		}
	</p>
}

// reportSince is what a Report reads changes against, as the movement line
// names it: "the previous publication", or its baseline date.
func reportSince(s domain.ReportSince) string {
	if words := s.Words(); words != "" {
		return words
	}
	return showDateYear(s.At)
}

// publishedLine says who published a Report and when, and what it read its
// changes against, from its byline fact (domain.Publication.Facts), its times
// in the company's timezone (loc).
templ publishedLine(facts []domain.ReportFact, loc *time.Location) {
	for _, f := range facts {
		if f.Kind == domain.ReportFactByline {
			<p data-testid="report-published" class="muted">
				{ f.Label + " " + showTimeYear(f.Byline.PublishedAt, loc) + " by " }
				@person(f.Byline.PublishedBy)
				if words := f.Byline.Since.Words(); words != "" {
					{ " · changes since " + words + ", " }{ showTimeYear(f.Byline.Since.At, loc) }
				} else {
					{ " · changes since " }{ showDateYear(f.Byline.Since.At) }
				}
			</p>
		}
	}
}

// publicationSelection says how a published Report selected its Goals, as it
// read when published ("Selection: Owner is in the org of Dana Okafor ·
// Active"), from its Selection fact. A publication frozen before selections
// were has none to show.
templ publicationSelection(facts []domain.ReportFact) {
	for _, f := range facts {
		if f.Kind == domain.ReportFactSelection {
			<p data-testid="report-selection" class="muted">{ f.Label + ": " + f.Text }</p>
		}
	}
}

// reportBody is a Report's content, as its facts list it: its open Action
// Items, the introduction, the narrative curated from Highlights, then its
// Goals — the exceptions, the Goals On track, and those that entered or left —
// or, when it selects none, "No Goals selected." in their place (CONTEXT.md:
// Report). The draft reads the same parts, its introduction under its name;
// for a reader who may manage it, compose is the form composing its narrative
// in place, which stands before its Goals.
templ reportBody(facts []domain.ReportFact, asOf time.Time, d discussion, compose *narrativeForm) {
	{{ story, goals := splitReportGoals(facts) }}
	for _, f := range story {
		@reportFact(f, asOf, d)
	}
	if compose != nil {
		@narrativeCuration(*compose)
	}
	if !reportSelectsGoals(facts) {
		<p data-testid="no-selected-goals">No Goals selected.</p>
	}
	for _, f := range goals {
		@reportFact(f, asOf, d)
	}
}

// reportGoalFacts are the kinds of fact about a Report's Goals.
var reportGoalFacts = []domain.ReportFactKind{domain.ReportFactExceptions, domain.ReportFactOnTrack, domain.ReportFactMembershipChanges}

// splitReportGoals splits a Report's facts, in order, into those before its
// Goals and those about them.
func splitReportGoals(facts []domain.ReportFact) (story, goals []domain.ReportFact) {
	for _, f := range facts {
		if slices.Contains(reportGoalFacts, f.Kind) {
			goals = append(goals, f)
		} else {
			story = append(story, f)
		}
	}
	return story, goals
}

// reportSelectsGoals reports whether a Report's facts hold any of its Goals,
// exceptions or On track.
func reportSelectsGoals(facts []domain.ReportFact) bool {
	return slices.ContainsFunc(facts, func(f domain.ReportFact) bool {
		return f.Kind == domain.ReportFactExceptions || f.Kind == domain.ReportFactOnTrack
	})
}

// withoutReportFacts is facts without those of the given kinds.
func withoutReportFacts(facts []domain.ReportFact, kinds ...domain.ReportFactKind) []domain.ReportFact {
	return slices.DeleteFunc(slices.Clone(facts), func(f domain.ReportFact) bool { return slices.Contains(kinds, f.Kind) })
}

// reportFact is one fact of a Report's body. Each exception is counted under
// the heading, most urgent first, an entry with the full MBR block opening
// with what changed on it since the baseline, its Path to Green judged overdue
// as of asOf; every Goal On track is one table row with its Health, title,
// Owner, and due date. On a publication, each Goal carries its discussion.
templ reportFact(f domain.ReportFact, asOf time.Time, d discussion) {
	switch f.Kind {
		case domain.ReportFactActionItems:
			@reportActionItems(f.ActionItems, d)
		case domain.ReportFactIntroduction:
			@reportIntroduction(f)
		case domain.ReportFactNarrative:
			@reportNarrative(f.Narrative)
		case domain.ReportFactExceptions:
			<section data-testid="needs-attention" class="rp-exceptions">
				<h2>{ f.Label }{ " " }<span data-testid="needs-attention-count" class="num muted">{ fmt.Sprintf("%d", len(f.Exceptions)) }</span></h2>
				for _, b := range f.Exceptions {
					@reportBlock(b, asOf, d)
				}
			</section>
		case domain.ReportFactOnTrack:
			@reportOnTrack(f, d)
		case domain.ReportFactMembershipChanges:
			@membershipChanges(f)
	}
}

// reportIntroduction is the Report Definition's Introduction, read-only; it is
// edited only with the definition.
templ reportIntroduction(f domain.ReportFact) {
	<p data-testid="report-introduction" class="rp-intro">{ f.Text }</p>
}

// reportOnTrack is the table of a Report's Goals On track, one row each.
templ reportOnTrack(f domain.ReportFact, d discussion) {
	<section data-testid="on-track-section">
		<h2>{ f.Label }</h2>
		<div class="rp-scroll">
			<table data-testid="on-track" class="rp-track">
				<thead>
					<tr><th>Health</th><th>Goal</th><th>Owner</th><th>Due</th></tr>
				</thead>
				<tbody>
					for _, sg := range f.Lines {
						<tr data-testid="selected-goal" id={ fmt.Sprintf("goal-%d", sg.Goal.ID) }>
							<td class="rp-track-health">
								@reportHealthBadge("selected-health", sg.Health, d)
							</td>
							<td class="rp-track-goal">
								<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", sg.Goal.ID)) }>{ sg.Goal.Title }</a>
								@reportFields(sg.Fields, d.dates())
							</td>
							<td data-testid="selected-owner" class="rp-track-owner">
								@person(sg.Goal.Owner)
							</td>
							<td class="rp-track-due">
								if !sg.Goal.DeliveryDate.IsZero() {
									<span data-testid="selected-due" class="rp-date">{ showDateYear(sg.Goal.DeliveryDate) }</span>
								} else {
									<span class="muted">—</span>
								}
							</td>
						</tr>
						if d.Pub != nil {
							<tr>
								<td colspan="4" class="rp-track-talk">
									@goalDiscussion(sg.Goal.ID, d)
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	</section>
}

// membershipChanges lists the Goals that entered or left the Report since its
// Definition's latest publication, each linking to the Goal, with Added or
// Left and why.
templ membershipChanges(f domain.ReportFact) {
	<section data-testid="membership-changes">
		<h2>{ f.Label }</h2>
		<div class="rp-scroll">
			<table>
				<thead>
					<tr><th>Goal</th><th>Change</th><th>Why</th></tr>
				</thead>
				<tbody>
					for _, c := range f.MembershipChanges {
						<tr data-testid="membership-change" id={ fmt.Sprintf("membership-%d", c.Goal.ID) }>
							<td><a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", c.Goal.ID)) }>{ c.Goal.Title }</a></td>
							<td data-testid="membership-direction">{ c.Direction }</td>
							<td data-testid="membership-reason">{ c.Reason }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

// narrativeCuration is the draft page's Narrative section for a reader who
// may manage the Report: the form curating the narrative of the next
// publication in place, under the Narrative heading with how many of the
// Highlights in scope since the baseline are in. Each section in turn holds
// the author's note boxes and the Highlights whose section control selects it,
// each with a box to include it and the section it goes into; one Save
// narrative ends it (CONTEXT.md: Highlight).
templ narrativeCuration(f narrativeForm) {
	<section data-testid="report-curation" id="report-curation" class="rp-curation">
		<div class="rp-curation-head">
			<h2>Narrative</h2>
			if len(f.Choices) > 0 {
				<span class="small muted">
					{ "Highlights since " + showDateYear(f.Report.Baseline) + " · " }
					@curationCount(f.included(), len(f.Choices))
				</span>
			}
		</div>
		// A date the reader picked rides on the action, so the draft reloads
		// against it. Only Save narrative saves. A reload shows what is
		// saved, not what the browser kept of the typing (autocomplete off),
		// as the save status and Publish… do.
		<form
			data-testid="narrative-curation"
			id="narrative-curation"
			class="rp-form"
			method="post"
			autocomplete="off"
			action={ templ.SafeURL(narrativeAction(f.Report, f.Chip)) }
			hx-on:htmx:response-error={ notSavedScript }
			hx-on:htmx:send-error={ notSavedScript }
		>
			if len(f.Choices) == 0 {
				<p data-testid="no-highlights" class="muted">No Highlights to pick since { showDateYear(f.Report.Baseline) }.</p>
			}
			for _, section := range narrativeSections {
				<div data-testid={ "compose-section-" + section } class="rp-compose-section">
					@sectionText(section, f.Notes[section], narrativeAction(f.Report, f.Chip))
					if choices := f.in(section); len(choices) > 0 {
						<ul class="rp-list">
							for _, c := range choices {
								@curationHighlight(c)
							}
						</ul>
					}
				</div>
			}
			// With htmx it saves in place, swapping in this section as saved
			// unless the author changed the form while it saved
			// (narrativeSaveScript); without script it is a plain submit.
			<button
				type="submit"
				class="btn rp-save-narrative"
				hx-post={ narrativeAction(f.Report, f.Chip) }
				hx-target="#report-curation"
				hx-swap="outerHTML"
				hx-sync="closest form:replace"
				hx-indicator="#save-status"
			>Save narrative</button>
		</form>
	</section>
}

// curationCount is how many (picked) of the Highlights the compose form offers
// (offered) are picked into the narrative, beside the Narrative heading.
// Ticking a box updates it (narrativeSaveScript), and a save brings it as
// saved.
templ curationCount(picked, offered int) {
	<span data-testid="curation-count" id="curation-count">{ fmt.Sprintf("%d of %d in", picked, offered) }</span>
}

// narrativeAction is where the curation form posts: the narrative, against the
// baseline the reader picked.
func narrativeAction(r domain.Report, chip baselineChip) string {
	return fmt.Sprintf("/reports/%d/narrative%s", r.Definition.ID, chip.Query)
}

// notSavedScript says Not saved in the draft's save status when a save or an
// Add another gets an error status or no answer at all.
var notSavedScript = templ.ComponentScript{Call: "document.getElementById('save-result').textContent = 'Not saved'"}

// sectionText is a section's own notes on the curation form, each in its own
// box, folded under the section's heading: open when the author has written
// some or added a box, closed and offering to add some when not. Add another
// posts the whole form to action and swaps the answer in for the Narrative
// section, one more box in this section; without JavaScript it is a plain
// submit.
templ sectionText(section string, notes []string, action string) {
	<details data-testid={ "section-text-" + section } class="rp-section-text" open?={ hasNotes(notes) || len(notes) > 1 }>
		<summary data-testid="section-text-summary">
			<span>{ sectionHeading(section) }</span>
			if !hasNotes(notes) {
				<span class="rp-add">+ Add note</span>
			}
		</summary>
		for i, note := range notes {
			<label class="field">
				<span class="sr-only">{ fmt.Sprintf("%s, note %d", sectionHeading(section), i+1) }</span>
				<textarea name={ "text-" + section }>{ note }</textarea>
			</label>
		}
		<button
			type="submit"
			name="add_note"
			value={ section }
			formnovalidate
			class="btn quiet"
			hx-post={ action }
			hx-target="#report-curation"
			hx-swap="outerHTML"
		>Add another</button>
	</details>
}

// curationHighlight is one Highlight on the curation form: a box to include it
// and, while ticked, the section it goes into. Unticked, it shows its kind
// instead. The section radios stay in the form, hidden by CSS, so it always
// submits a section without JS.
templ curationHighlight(c curationChoice) {
	{{ nh := c.Highlight }}
	<li data-testid="curation-highlight" class="rp-curate">
		// Tells the save which Highlights the form offered, so it leaves the
		// saved picks of others, before the baseline, as they are.
		<input type="hidden" name="offered" value={ fmt.Sprint(nh.Highlight.ID) }/>
		<label class="rp-include">
			<input type="checkbox" name={ fmt.Sprintf("include-%d", nh.Highlight.ID) } value="on" checked?={ c.Included }/>
			<span>{ nh.Highlight.Note }</span>
		</label>
		<p class="small muted">
			@person(nh.Highlight.Owner)
			{ "· " }
			<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", nh.GoalID)) }>{ nh.GoalTitle }</a>
			<span class="rp-kind">{ " · " + nh.Highlight.Kind }</span>
		</p>
		<fieldset class="rp-sections">
			<legend class="sr-only">Section</legend>
			for _, section := range narrativeSections {
				<label>
					<input type="radio" name={ fmt.Sprintf("pick-%d", nh.Highlight.ID) } value={ section } checked?={ c.Section == section }/>
					<span>{ section }</span>
				</label>
			}
		</fieldset>
	</li>
}

// reportNarrative is a Report's Insights, Accomplishments, and Misses as a
// plain section under a level-2 Narrative heading, each under its own heading
// (a label on the print page): the author's notes, each its own paragraph, and
// then the Highlights they picked, each crediting the Goal's Owner. Sections
// with neither are left out, and an empty narrative is left out whole.
templ reportNarrative(narrative []domain.NarrativeSection) {
	if len(narrative) > 0 {
		<section data-testid="report-narrative" class="rp-narrative">
			<h2>Narrative</h2>
			for _, sec := range narrative {
				<h3 data-testid="narrative-section" class="label">{ sec.Heading() }</h3>
				for _, note := range sec.Notes {
					<p data-testid="narrative-text">{ note }</p>
				}
				if len(sec.Highlights) > 0 {
					<ul>
						for _, nh := range sec.Highlights {
							<li data-testid="narrative-highlight">
								{ nh.Highlight.Note }
								@highlightCredit(nh)
							</li>
						}
					</ul>
				}
			}
		</section>
	}
}

// highlightCredit credits a Highlight to the Goal's Owner, naming the Goal.
templ highlightCredit(nh domain.NarrativeHighlight) {
	<span data-testid="highlight-credit" class="rp-credit">
		{ " — " }
		@person(nh.Highlight.Owner),
		<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", nh.GoalID)) }>{ nh.GoalTitle }</a>
	</span>
}

// reportBlock is an exception Goal's full MBR block, an entry ruled off from
// the next by a hairline, laid out from its facts (domain.ReportBlock.Facts):
// its head reads Health first, with its Run off Green and earlier Health, then
// the title over its Owner, Lifecycle, and due date with its history struck
// through, then its other badges; under them, when it changed since the
// baseline, a line saying what changed ("Changed: Turned Red · 1 Milestone
// slipped"), and under that the Goals in the Report it contributes to
// ("Contributes to: [Red] Growth ↓"); Why it matters and latest status as
// plain labelled rows; then, on a Red or Yellow Goal, the block's one tinted
// box, in its Health's tint (pathTintClass): its Path to Green, its
// back-to-Green date followed by the date it last slipped from in the Run off
// Green struck through and the count of slips once more than one, as drafted
// (see reportBackToGreenPrior), and marked Overdue when its target date passed
// before asOf, and after it an Ask for help open when the Report was drafted;
// then labelled rows of Milestones, each marked as of asOf, Metrics against
// target, and the Rolled-up Health with how many children are Red, Yellow and
// Check-in overdue ("2 of 6 Red · 1 Yellow · 1 overdue"), the Goals behind it,
// and the Owner's explanation when the block shows it. Each row's label sits
// in a column beside it (DESIGN.md § A publication). It reads asOf in the zone
// the block's Goal was judged in when drafted (see
// domain.ReportBlock.Timezone). Each Goal it names links to its place in the
// Report, marked ↓, or to its Goal page when the Report doesn't hold it (#246).
// A Yellow or Red Health reads with its Run off Green as drafted, and one that
// changed since the baseline with what it was after that ("Yellow · 2 wks · was
// Green"). The Fields the definition chose sit under the head, beside the Goal.
// On a publication it ends with the Goal's discussion.
templ reportBlock(b domain.ReportBlock, asOf time.Time, d discussion) {
	<article data-testid="report-exception" class="rp-block" id={ fmt.Sprintf("goal-%d", b.Goal.ID) }>
		for _, run := range reportBlockRuns(b.Facts(asOf)) {
			switch run.layout {
				case reportBlockAbout, reportBlockDetail:
					<dl class="rp-facts">
						for _, f := range run.facts {
							@reportBlockFact(f, d)
						}
					</dl>
				case reportBlockPath:
					if tint := pathTintClass(b.Health); tint != "" {
						<div data-testid="report-path-box" class={ "rp-tint", tint, templ.KV("overdue", reportPathOverdue(run.facts)) }>
							for _, f := range run.facts {
								@reportBlockFact(f, d)
							}
						</div>
					} else {
						for _, f := range run.facts {
							@reportBlockFact(f, d)
						}
					}
				default:
					for _, f := range run.facts {
						@reportBlockFact(f, d)
					}
			}
		}
		@goalDiscussion(b.Goal.ID, d)
	</article>
}

// How an exception block's page lays out a run of its facts: the head and the
// lines under it each on its own; Why it matters and the status in a label
// column; the Path to Green and the Ask for help in the tinted box on a Red or
// Yellow block; and the rest in a second label column.
const (
	reportBlockLoose  = "loose"
	reportBlockAbout  = "about"
	reportBlockPath   = "path"
	reportBlockDetail = "detail"
)

// reportBlockRun is a run of an exception block's facts its page lays out
// together.
type reportBlockRun struct {
	layout string
	facts  []domain.ReportFact
}

// reportBlockRuns gathers an exception block's facts, in order, into the runs
// its page lays out together.
func reportBlockRuns(facts []domain.ReportFact) []reportBlockRun {
	var runs []reportBlockRun
	for _, f := range facts {
		layout := reportBlockLoose
		switch f.Kind {
		case domain.ReportFactWhyItMatters, domain.ReportFactStatus:
			layout = reportBlockAbout
		case domain.ReportFactPathToGreen, domain.ReportFactAskForHelp:
			layout = reportBlockPath
		case domain.ReportFactMilestones, domain.ReportFactMetrics, domain.ReportFactRolledUp,
			domain.ReportFactSupportedBy, domain.ReportFactExplanation:
			layout = reportBlockDetail
		}
		if n := len(runs); n > 0 && runs[n-1].layout == layout {
			runs[n-1].facts = append(runs[n-1].facts, f)
			continue
		}
		runs = append(runs, reportBlockRun{layout: layout, facts: []domain.ReportFact{f}})
	}
	return runs
}

// reportPathOverdue reports whether a run of a block's facts holds an overdue
// Path to Green.
func reportPathOverdue(facts []domain.ReportFact) bool {
	return slices.ContainsFunc(facts, func(f domain.ReportFact) bool {
		return f.Kind == domain.ReportFactPathToGreen && f.PathToGreen.Overdue
	})
}

// reportBlockFact is one of an exception block's facts, under its label.
templ reportBlockFact(f domain.ReportFact, d discussion) {
	switch f.Kind {
		case domain.ReportFactBlockHead:
			@reportBlockHead(f.Head, d)
		case domain.ReportFactChanged:
			<p data-testid="report-changes" class="small">
				<strong>{ f.Label + ":" }</strong>{ " " }
				for i, c := range f.Changes {
					if i > 0 {
						{ " · " }
					}
					<span data-testid="report-change">{ c }</span>
				}
			</p>
		case domain.ReportFactContributesTo:
			<p data-testid="report-contributes-to" class="small">
				<strong>{ f.Label + ":" }</strong>{ " " }
				@linkedGoals(f.Goals, d)
			</p>
		case domain.ReportFactFields:
			@reportFields(f.Fields, d.dates())
		case domain.ReportFactWhyItMatters:
			<div>
				<dt class="label">{ f.Label }</dt>
				<dd data-testid="report-why-it-matters">{ f.Text }</dd>
			</div>
		case domain.ReportFactStatus:
			<div>
				<dt class="label">{ f.Label }</dt>
				<dd data-testid="report-status">{ f.Text }</dd>
			</div>
		case domain.ReportFactPathToGreen:
			{{ path := f.PathToGreen }}
			<p data-testid="report-path-to-green">
				<strong class="rp-tint-label">{ f.Label + ":" }</strong> { path.Plan } ({ path.ByWords() } { showDateYear(path.By) }@reportBackToGreenPrior(path))
				if path.Overdue {
					{ " " }<strong data-testid="path-overdue" class="badge r">{ path.OverdueWords() }</strong>
				}
			</p>
		case domain.ReportFactAskForHelp:
			<p data-testid="report-ask-for-help">
				<strong>{ f.Label }</strong>
				if f.Ask.Addressee != nil {
					{ " of " }@person(*f.Ask.Addressee)
				} else {
					{ " · " + f.Ask.Words() }
				}
			</p>
		case domain.ReportFactMilestones:
			<div>
				<dt class="label">{ f.Label }</dt>
				<dd>
					<ul data-testid="report-milestones">
						for _, m := range f.Milestones {
							<li data-testid="report-milestone">
								if m.Mark != domain.MilestoneMarkNone {
									@milestoneMarkBadge(m.Mark)
									{ " " }
								}
								<span class="rp-dates">
									@milestoneDates(m.Milestone.TargetDate, m.PriorDates, d.dates())
								</span>
								{ " " }
								if m.Milestone.Status == domain.MilestoneRemoved {
									<del>{ m.Milestone.Name }</del>
								} else {
									{ m.Milestone.Name }
								}
								if m.Milestone.RemovedReason != "" {
									{ " " }
									<span>— { m.Milestone.RemovedReason }</span>
								}
							</li>
						}
					</ul>
				</dd>
			</div>
		case domain.ReportFactMetrics:
			<div>
				<dt class="label">{ f.Label }</dt>
				<dd>
					<ul data-testid="report-metrics">
						for _, m := range f.Metrics {
							<li data-testid="report-metric">
								{ m.Metric.Name }:
								{ m.Reading(fmtNum) }
								{ " " + domain.ReportAgainstATargetOf + " " }{ fmtNum(m.Metric.Target) } { m.Metric.Unit } by { showDateYear(m.Metric.TargetDate) }
								{ " (baseline " }{ fmtNum(m.Metric.Baseline) }, { m.Metric.Direction })
							</li>
						}
					</ul>
				</dd>
			</div>
		case domain.ReportFactRolledUp:
			<div>
				<dt class="label">{ f.Label }</dt>
				<dd data-testid="report-rollup">
					if f.RolledUp.Present {
						@reportHealthBadge("rollup-health", f.RolledUp.Health, d)
						if f.RolledUp.Count != "" {
							{ "· " }
						}
					}
					if f.RolledUp.Count != "" {
						<span data-testid="report-rollup-count">{ f.RolledUp.Count }</span>
					}
				</dd>
			</div>
		case domain.ReportFactSupportedBy:
			<div>
				<dt class="label">{ f.Label }</dt>
				<dd data-testid="report-behind-it">
					@linkedGoals(f.Goals, d)
				</dd>
			</div>
		case domain.ReportFactExplanation:
			<div>
				<dt class="label">{ f.Label }</dt>
				<dd data-testid="report-health-explanation">{ f.Text }</dd>
			</div>
	}
}

// reportBlockHead is an exception block's head: its Health with its Run off
// Green and what it was, then its title over its Owner, Lifecycle and due
// date, then its badges.
templ reportBlockHead(h domain.ReportBlockHead, d discussion) {
	<div class="rp-card-head">
		<span class="rp-health">
			@reportHealthBadge("report-health", h.Health, d)
			if h.RunOffGreen != "" {
				<span data-testid="report-run-off-green" class="small muted">{ "· " + h.RunOffGreen }</span>
			}
			if h.WasHealth != "" {
				<span data-testid="report-prior-health" class="small muted">{ "· " + h.WasHealth }</span>
			}
		</span>
		<div class="rp-card-title">
			<h3><a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", h.GoalID)) }>{ h.Title }</a></h3>
			<p class="small muted">
				<span data-testid="report-owner">
					@person(h.Owner)
				</span>
				{ " · " }{ h.Lifecycle }
				if !h.Due.IsZero() {
					{ " · due " }
					<span data-testid="report-due" class="rp-dates">
						@struckDates(h.Due, h.PriorDue, d.dates())
						<span>{ showDateYear(h.Due) }</span>
					</span>
				}
			</p>
		</div>
		if len(h.Badges) > 0 {
			<div class="rp-badges">
				for _, badge := range h.Badges {
					<span data-testid="report-badge" class={ "badge", badgeClass(badge) }>{ badge }</span>
				}
			</div>
		}
	</div>
}

// pathTintClass is the tint of a block's Path to Green box, by its Health:
// Red's or Yellow's on a Red or Yellow Goal, and "" otherwise, when the block
// has no tinted box (DESIGN.md § A publication).
func pathTintClass(health string) string {
	switch health {
	case domain.HealthRed:
		return "rp-tint-r"
	case domain.HealthYellow:
		return "rp-tint-y"
	}
	return ""
}

// reportBackToGreenPrior follows a block's back-to-Green date with the date it
// last slipped from within the Run off Green struck through, and the number of
// times it slipped once that is more than one, as a Milestone's date reads:
// Oct 3, 2026 ~~Sep 12, 2026~~ (3). Prior dates come earliest first; with none
// it renders nothing. A date equal to the current one is never struck through:
// the most recent that differs is, or none.
templ reportBackToGreenPrior(path domain.ReportPathToGreen) {
	if struck := domain.StruckDates(path.By, path.PriorDates); len(struck) > 0 {
		{ " " }<del data-testid="report-back-to-green-prior">{ showDateYear(struck[len(struck)-1]) }</del>
	}
	@reportBackToGreenSlips(path.Slips)
}

// reportBackToGreenSlips is how many times a block's back-to-Green date slipped
// within the Run off Green, once that is more than one: (3).
templ reportBackToGreenSlips(n int) {
	if n > 1 {
		{ " " }<span data-testid="report-back-to-green-slips">{ fmt.Sprintf("(%d)", n) }</span>
	}
}

// linkedGoals names the Goals an exception block links to, joined by " · ":
// one the Report holds links to its block or line and is marked ↓, one it
// doesn't links to its Goal page. Each is led by its Health when it has one,
// a chip on screen and its shape and word printed ("[Red] Alpha ledger ↓").
templ linkedGoals(goals []domain.LinkedGoal, d discussion) {
	for i, g := range goals {
		if i > 0 {
			{ " · " }
		}
		<span class="rp-linked">
			if g.Health != "" {
				@reportHealthBadge("", g.Health, d)
			}
			if g.InReport {
				<a data-testid="report-linked-goal" href={ templ.SafeURL(fmt.Sprintf("#goal-%d", g.GoalID)) }>{ g.Title + " ↓" }</a>
			} else {
				<a data-testid="report-linked-goal" href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.GoalID)) }>{ g.Title }</a>
			}
		</span>
	}
}

// reportFields is a Goal's values in the Fields its Report chose, each a
// labelled value: a number with its unit, a long text with its line breaks
// kept, a date as dates shows it. A Goal with no value in any of them shows
// nothing (ticket #78).
templ reportFields(fields []domain.FieldValue, dates displayDates) {
	if len(fields) > 0 {
		<dl data-testid="report-fields" class="rp-fields small">
			for _, v := range fields {
				<div data-testid="report-field">
					<dt>{ v.Field.Name }</dt>
					<dd class={ templ.KV("rp-field-long", v.Field.Type == domain.FieldLongText) }>
						if v.Field.Type == domain.FieldNumber {
							<span class="num">{ v.Value }</span>
							if v.Field.Unit != "" {
								{ " " + v.Field.Unit }
							}
						} else if v.Field.Type == domain.FieldDate {
							{ dates.dateText(v.Value) }
						} else {
							{ v.Value }
						}
					</dd>
				</div>
			}
		</dl>
	}
}

// healthBadge is a Goal's Health on screen, its chip (healthChip), or a
// neutral badge reading a dash when there is none yet.
templ healthBadge(testID, health string) {
	if health == "" {
		<span data-testid={ testID } class="badge lc">{ reportHealth(health) }</span>{ " " }
	} else {
		@healthChip(testID, health)
	}
}

// reportHealthBadge is a Report's Health badge: on screen its healthBadge;
// printed, its shape beside its word, which paper keeps when it loses the
// colour (DESIGN.md § Print variant), or the dash alone when there is no
// Health yet.
templ reportHealthBadge(testID, health string, d discussion) {
	if d.Print {
		<span
			if testID != "" {
				data-testid={ testID }
			}
			class={ "badge", healthClass(health) }
		>
			if health != "" {
				<span class="dot"></span>
			}
			{ reportHealth(health) }
		</span>{ " " }
	} else {
		@healthBadge(testID, health)
	}
}

// healthChip is a Health on screen: its colour and shape say it, so its word
// is screen-reader text and its tooltip, not shown (DESIGN.md § Health).
templ healthChip(testID, health string) {
	@healthChipWith(testID, health, health, "")
}

// healthChipWith is healthChip with its own tooltip, tip, which opens with
// the word, and a class of the place's own beside the badge's. A space
// stands either side of it, as between elements on their own lines, so its
// word doesn't run into the text around it.
templ healthChipWith(testID, health, tip, class string) {
	{ " " }
	<span
		if testID != "" {
			data-testid={ testID }
		}
		class={ "badge", "shape", healthClass(health), templ.KV(class, class != "") }
		title={ tip }
	><span class="dot"></span><span class="sr-only">{ health }</span></span>{ " " }
}

// healthClass is the badge colour for a Health; no Health yet is neutral.
func healthClass(health string) string {
	switch health {
	case domain.HealthRed:
		return "r"
	case domain.HealthYellow:
		return "y"
	case domain.HealthGreen:
		return "g"
	}
	return "lc"
}

// badgeClass is a report badge's colour: Check-in overdue in its own colour,
// Ownerless as prominent as Red, a New Date as a warning, and the rest neutral.
func badgeClass(badge string) string {
	switch badge {
	case domain.BadgeCheckinOverdue:
		return "st"
	case domain.BadgeOwnerless:
		return "r"
	case domain.BadgeNewDate:
		return "y"
	}
	return "lc"
}

// healthTile is one count on a Report's Health summary.
type healthTile struct {
	key, label, class string
	count             int
}

// healthTiles lays out a Report's Health counts (domain.Report.HealthCounts)
// as its Health summary shows them: Red, Yellow, Green, then Check-in overdue.
func healthTiles(r domain.Report) []healthTile {
	c := r.HealthCounts()
	return []healthTile{
		{"red", domain.HealthRed, "r", c.Red},
		{"yellow", domain.HealthYellow, "y", c.Yellow},
		{"green", domain.HealthGreen, "g", c.Green},
		{"checkin-overdue", domain.BadgeCheckinOverdue, "st", c.CheckinOverdue},
	}
}

// reportHealth renders a selected Goal's Health, or a dash when it has no Check-in
// yet (a Proposed Goal, or an Active one not yet checked in on).
func reportHealth(health string) string {
	if health == "" {
		return "—"
	}
	return health
}

// pickedHighlights counts the Highlights the author has picked into a section,
// as last saved.
func pickedHighlights(r domain.Report) int {
	n := 0
	for _, nh := range r.Highlights {
		if nh.Section != "" {
			n++
		}
	}
	return n
}

// curatedSection is the section a Highlight's control selects: the one the
// author picked it into, or else its own kind, since kinds and sections are
// the same strings.
func curatedSection(nh domain.NarrativeHighlight) string {
	if nh.Section != "" {
		return nh.Section
	}
	return nh.Highlight.Kind
}

// narrativeSections are a Report narrative's sections in the order it shows
// them.
var narrativeSections = []string{domain.HighlightInsight, domain.HighlightAccomplishment, domain.HighlightMiss}

// sectionHeading is a narrative section's title, e.g. "Insights".
func sectionHeading(section string) string {
	return domain.NarrativeSection{Kind: section}.Heading()
}

// narrativeNotes is the author's notes in one section of a Report's narrative.
func narrativeNotes(r domain.Report, section string) []string {
	for _, sec := range r.Narrative {
		if sec.Kind == section {
			return slices.Clone(sec.Notes)
		}
	}
	return nil
}

// hasNotes reports whether any of a section's note boxes holds a note.
func hasNotes(notes []string) bool {
	return slices.ContainsFunc(notes, func(n string) bool { return strings.TrimSpace(n) != "" })
}

// reportStyles are the Report pages' own rules on top of app.css: the reading
// column a publication is centred in, the Report's heading scale (DESIGN.md §
// Type scale), the Health summary, the exception blocks with their label column
// and the Path to Green's Health tint, the discussion footer, the scrolling root-Goal
// picker, and the draft's header and its two columns, the Report beside its
// Delegates and History, which stack into one under 960px of the page's
// content width and shrink to a phone's width rather than to the On track
// table's. At a phone's width the header stops
// sticking and stacks into rows — the name with its save status, the chip, then
// Edit definition and Publish… — and the Publish… card spans the screen between
// its gutters.
templ reportStyles() {
	<style>
		.page>.rp-read{width:100%;max-width:880px;margin:0 auto;display:flex;flex-direction:column;gap:24px}
		.rp-head{display:flex;flex-direction:column;gap:4px}
		.rp-head h1{margin:0 0 4px;font-size:26px;font-weight:700;line-height:1.2}
		.rp-main h2,.rp-read h2{font-size:18px;font-weight:650;line-height:1.3}
		.rp-main section>h2,.rp-read section>h2,.rp-curation-head{margin-top:20px;padding-top:20px;border-top:1px solid var(--color-border)}
		.rp-exceptions>h2>.num{font-size:var(--text-body);font-weight:500}
		.rp-actions{display:flex;gap:8px}
		.rp-crumb{min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
		span.rp-crumb{color:var(--color-ink);font-weight:500}
		.rp-draft-head span.rp-crumb{color:var(--color-ink-muted);font-weight:400}
		.rp-summary,.rp-body .rp-summary{display:flex;flex-direction:row;flex-wrap:wrap;align-items:center;gap:4px 16px;overflow-x:clip}
		.rp-summary>.label{margin-right:-8px}
		.rp-summary-pair{position:relative;display:inline-flex;align-items:center;gap:8px;white-space:nowrap}
		.rp-summary-sep{position:absolute;right:100%;width:16px;text-align:center}
		.rp-summary .num{color:var(--color-ink)}
		.rp-body{display:flex;flex-direction:column;gap:24px}
		.rp-body section{display:flex;flex-direction:column;gap:12px}
		.rp-list{list-style:none;margin:0;padding:0}
		.rp-list>li{padding:12px 0;border-bottom:1px solid var(--color-border)}
		.rp-list>li:last-child{border-bottom:none}
		.rp-rows{border-top:1px solid var(--color-border)}
		.rp-rows>li{min-height:44px;padding:12px 0;box-sizing:border-box}
		.rp-rows>li:last-child{border-bottom:1px solid var(--color-border)}
		.rp-rows>li>details{display:inline-block;vertical-align:top;margin:8px 8px 0 0}
		.rp-rows>li>details[open]{display:block}
		.rp-rows>li>details>summary.btn,.rp-rows+details>summary.btn{min-height:32px}
		.rp-rows+details>summary.btn{align-self:flex-start}
		.rp-pop{background:var(--color-surface);border:1px solid var(--color-border);border-radius:var(--radius-lg)}
		.rp-pop.rp-list>li{padding:12px 16px}
		.rp-narrative{font-size:15px;line-height:1.7;color:var(--color-ink)}
		.rp-narrative h3.label{margin-top:16px;font-size:15px;font-weight:600;line-height:1.4;color:var(--color-ink)}
		.rp-narrative>h2+.label{margin-top:0}
		.rp-narrative ul{margin:4px 0 0;padding-left:20px}
		.rp-credit{color:var(--color-ink-muted);font-size:var(--text-secondary)}
		.rp-section-text{border-top:1px solid var(--color-border)}
		.rp-section-text[open]{padding-bottom:12px}
		.rp-section-text>summary{color:var(--color-ink);font-size:15px;font-weight:600}
		.rp-add{color:var(--color-primary-strong);font-size:var(--text-secondary);font-weight:500}
		.rp-curation-head{display:flex;align-items:baseline;justify-content:space-between;gap:8px}
		.rp-curate{display:flex;flex-direction:column;gap:4px}
		.rp-list>li.rp-curate{padding-left:0;padding-right:0}
		.rp-include{display:flex;align-items:flex-start;gap:12px;cursor:pointer}
		.rp-include input{margin-top:4px}
		.rp-curate>p{margin-left:28px}
		.rp-form fieldset.rp-sections{display:inline-flex;flex-direction:row;gap:0;align-self:flex-start;border:1px solid var(--color-border-strong);border-radius:var(--radius-md);padding:0;margin:4px 0 0 28px;overflow:hidden}
		.rp-sections label{position:relative;padding:4px 12px;cursor:pointer;font-size:var(--text-secondary)}
		.rp-curate:not(:has(input[name^=include-]:checked)) .rp-sections{display:none}
		.rp-curate:has(input[name^=include-]:checked) .rp-kind{display:none}
		.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap}
		@supports selector(:has(*)){
			.rp-sections input{position:absolute;opacity:0;pointer-events:none}
			.rp-sections label:has(input:checked){background:var(--color-ink);color:var(--color-surface)}
			.rp-sections label:has(input:focus-visible){outline:2px solid var(--color-focus);outline-offset:-2px}
		}
		.rp-block{container:rp-block/inline-size;display:flex;flex-direction:column;gap:12px;padding:20px 0;border-top:1px solid var(--color-border)}
		.rp-exceptions>h2+.rp-block{border-top:none;padding-top:8px}
		.page:has(>.rp-index){max-width:none;padding:24px 0 64px}
		.rp-index{--rp-gutter:28px;display:flex;flex-direction:column;gap:32px}
		.rp-index-lead,.rp-index h2{padding:0 var(--rp-gutter)}
		.rp-chase,.rp-defs{display:flex;flex-direction:column;gap:8px}
		.rp-chase-group{display:flex;flex-direction:column}
		.rp-group{display:flex;align-items:center;gap:8px;min-height:32px;padding:0 var(--rp-gutter);background:var(--color-group);border-top:1px solid var(--color-border);font-size:var(--text-label);font-weight:500;color:var(--color-ink-2)}
		.rp-group-count{color:var(--color-ink-muted);font-variant-numeric:tabular-nums}
		.rp-chase-list{list-style:none;margin:0;padding:0}
		.rp-chase-list>li{display:flex;flex-wrap:wrap;align-items:center;gap:4px 8px;min-height:44px;padding:4px var(--rp-gutter);border-top:1px solid var(--color-border);box-sizing:border-box}
		.rp-chase-list>li:hover{background:var(--color-row-hover)}
		.rp-chase-group:last-child>.rp-chase-list>li:last-child{border-bottom:1px solid var(--color-border)}
		.rp-chase-list>li>a{font-weight:500;color:var(--color-ink)}
		.rp-card-head{display:flex;align-items:flex-start;gap:8px 12px}
		.rp-card-title{flex:1;min-width:0}
		.rp-card-head h3{font-size:16px;font-weight:600;line-height:1.4}
		.rp-badges{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end;align-items:center}
		.rp-health{display:inline-flex;gap:8px;align-items:center;min-height:22px;white-space:nowrap}
		.rp-facts{display:flex;flex-direction:column;gap:8px;margin:0}
		.rp-facts>div{display:grid;grid-template-columns:120px minmax(0,1fr);gap:4px 16px;align-items:baseline}
		.rp-facts dd{margin:0;min-width:0}
		.rp-tint{border-radius:var(--radius-md);padding:12px 16px;display:flex;flex-direction:column;gap:8px}
		.rp-tint>p{margin:0}
		.rp-tint-r{background:var(--health-r-bg)}
		.rp-tint-y{background:var(--health-y-bg)}
		.rp-tint-r .rp-tint-label{color:var(--health-r-ink)}
		.rp-tint-y .rp-tint-label{color:var(--health-y-ink)}
		/* A block narrower than its head's three parts, as in a phone's
		 * column, drops its badges under Health and the title
		 * rather than squeezing the title until its words break, and puts
		 * each label above what it labels, as the 600px rule does for a
		 * phone. */
		@container rp-block (max-width:28rem){.rp-card-head{flex-wrap:wrap}.rp-badges{flex-basis:100%;justify-content:flex-start}.rp-facts>div{grid-template-columns:minmax(0,1fr);gap:4px}}
		.rp-block ul{margin:0;padding-left:20px}
		.rp-scroll{overflow-x:auto}
		.rp-scroll th{background:none;padding:8px 12px}
		.rp-scroll td{padding:12px}
		.rp-scroll th:first-child,.rp-scroll td:first-child{padding-left:0}
		.rp-scroll th:last-child,.rp-scroll td:last-child{padding-right:0}
		.rp-scroll tbody tr:last-child>td{border-bottom:1px solid var(--color-border)}
		.rp-track tr:has(+tr>.rp-track-talk)>td{border-bottom:none}
		.rp-track td.rp-track-talk{padding-top:0}
		.rp-discussion{border-top:1px solid var(--color-border);padding-top:8px;display:flex;flex-wrap:wrap;gap:4px 16px;align-items:flex-start}
		.rp-discussion>details{flex:1 1 auto}
		.rp-discussion details>summary{min-height:32px;justify-content:flex-start;color:var(--color-primary-strong);font-weight:500}
		.rp-thread{border-left:1px solid var(--color-border);padding-left:12px;margin:8px 0;display:flex;flex-direction:column;gap:8px}
		.rp-reply{margin-left:24px}
		.rp-inline-form{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end}
		.rp-inline-form label{display:flex;flex-direction:column;gap:4px;font-size:var(--text-secondary);font-weight:600}
		.rp-table{overflow-x:auto}
		.rp-table th{background:none;padding:8px 16px;border-top:1px solid var(--color-border)}
		.rp-table td{height:44px;padding:4px 16px;box-sizing:border-box;white-space:nowrap}
		.rp-table th:first-child,.rp-table td:first-child{padding-left:var(--rp-gutter)}
		.rp-table th:last-child,.rp-table td:last-child{padding-right:var(--rp-gutter)}
		.rp-table tbody tr:hover>td{background:var(--color-row-hover)}
		.rp-table tbody tr:last-child>td{border-bottom:1px solid var(--color-border)}
		.rp-name{width:40%;max-width:0;overflow:hidden;text-overflow:ellipsis}
		.rp-name>a{font-weight:500;color:var(--color-ink)}
		.rp-name>span,.rp-table td>.small{margin-left:8px}
		.rp-draft{text-align:right}
		.rp-download-cell{width:1%;text-align:right}
		.rp-download-menu{flex-direction:column;gap:4px;min-width:200px;padding:8px;border:1px solid var(--color-border);border-radius:var(--radius-lg);background:var(--color-surface);color:var(--color-ink);box-shadow:var(--shadow-pop);box-sizing:border-box}
		.rp-download-menu:popover-open{display:flex}
		@supports (position-area:bottom){.rp-download-menu{inset:auto;margin:4px 0;position-area:bottom span-left;position-try-fallbacks:flip-block,flip-inline}}
		.rp-download-menu>a{display:flex;align-items:center;min-height:36px;padding:0 12px;border-radius:var(--radius-md);color:var(--color-ink);font-weight:500;white-space:nowrap}
		.rp-download-menu>a:hover{background:var(--color-surface-hover);text-decoration:none}
		.rp-date{white-space:nowrap}
		.rp-dates>*{white-space:nowrap}
		.rp-changes-hot{display:inline-block;padding:4px 12px;border-radius:var(--radius-full);background:var(--health-y-bg);color:var(--health-y-ink);font-weight:600;white-space:nowrap}
		.rp-bar{display:inline-flex;vertical-align:middle;width:120px;max-width:100%;height:8px;margin-left:12px;border-radius:var(--radius-full);overflow:hidden}
		.rp-bar>span{flex:1 1 0;min-width:2px}
		.rp-bar>.g{background:var(--health-g-mark)}
		.rp-bar>.y{background:var(--health-y-mark)}
		.rp-bar>.r{background:var(--health-r-mark)}
		.rp-bar>.g+.y,.rp-bar>.g+.r,.rp-bar>.y+.r{margin-left:4px}
		.rp-form{display:flex;flex-direction:column;gap:16px}
		.rp-form fieldset{border:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
		.rp-form legend{font-weight:600;font-size:var(--text-secondary);padding:0 0 8px}
		.rp-fields{display:flex;flex-wrap:wrap;gap:4px 16px;margin:0}
		.rp-fields>div{display:flex;gap:4px;min-width:0}
		.rp-fields dt{font-weight:600}
		.rp-fields dt::after{content:":"}
		.rp-fields dd{margin:0}
		.rp-field-long{white-space:pre-line}
		.rp-publish{position:absolute;right:0;z-index:3;width:min(560px,calc(100vw - 32px));box-sizing:border-box;padding:24px;display:flex;align-items:center;gap:16px 24px;flex-wrap:wrap;box-shadow:0 12px 32px rgb(0 0 0 / 12%)}
		.rp-publish>div:first-child{flex:1 1 280px}
		.rp-publish h2{font-size:17px;margin:0 0 4px}
		.rp-publish p{margin:0}
		.rp-publish .rp-actions{align-items:center}
		.rp-draft-head{position:sticky;top:0;z-index:2;background:var(--color-canvas);padding:8px 28px;justify-content:flex-start;gap:8px 16px;flex-wrap:wrap}
		.rp-draft-head .rp-menu>summary{min-height:32px}
		.rp-menu.rp-chip>summary{box-sizing:border-box;min-height:32px;justify-content:flex-start;gap:4px;color:var(--color-ink);font-size:var(--text-secondary);font-weight:400;padding:0 12px;border:1px solid var(--color-border-strong);border-radius:var(--radius-full)}
		@media (pointer:coarse){.rp-rows>li>details>summary.btn,.rp-rows+details>summary.btn{min-height:44px}.rp-menu.rp-chip>summary{min-height:44px}.rp-draft-head .rp-menu>summary{min-height:44px}.rp-download-menu>a{min-height:44px}}
		.rp-menu.rp-chip>ul{left:0;right:auto}
		.rp-chip>ul>li>details>summary{min-height:0;color:var(--color-primary-strong);font-weight:500}
		.rp-chip form{margin-top:8px}
		.rp-draft-title{display:contents}
		.rp-draft-head .rp-save{order:1;flex:1 1 auto;text-align:right}
		.rp-head-actions{order:1;margin-left:auto;display:flex;align-items:center;gap:16px;flex-wrap:wrap}
		.rp-saving{display:none}
		.rp-save.htmx-request .rp-saving{display:inline}
		.rp-save.htmx-request #save-result{display:none}
		.rp-menu{position:relative}
		.rp-menu>summary{color:var(--color-primary-strong);font-weight:600}
		.rp-menu>ul{position:absolute;right:0;z-index:3;min-width:280px;max-height:360px;overflow-y:auto}
		.page:has(>.rp-draft-page){max-width:1200px;container:rp-draft/inline-size}
		.rp-draft-page{display:grid;grid-template-columns:minmax(0,780px) minmax(0,300px);gap:56px;align-items:start}
		.rp-draft-page>*{min-width:0}
		@container rp-draft (max-width:960px){.rp-draft-page{grid-template-columns:minmax(0,1fr);gap:40px}}
		.rp-intro{margin:0;font-size:15px;line-height:1.7;color:var(--color-ink)}
		.rp-compose-section{display:flex;flex-direction:column}
		.rp-compose-section:last-of-type{border-bottom:1px solid var(--color-border)}
		.rp-save-narrative{align-self:flex-start}
		.rp-delegate{display:flex;align-items:center;justify-content:space-between;gap:8px}
		.rp-delegate-add{display:flex;flex-wrap:wrap;gap:8px;margin-top:8px}
		.rp-delegate-add input{flex:1 1 200px}
		.rp-history-list{list-style:none;margin:0 0 0 4px;padding:0 0 0 20px;border-left:1px solid var(--color-border);display:flex;flex-direction:column;gap:12px}
		.rp-history-list>li{position:relative;display:flex;flex-direction:column;gap:4px}
		.rp-history>details>.rp-history-list{margin-top:12px}
		.rp-mark{position:absolute;left:-25px;top:5px;width:10px;height:10px;box-sizing:border-box;border-radius:50%;background:var(--color-ink-muted);box-shadow:0 0 0 2px var(--color-canvas)}
		.rp-mark-draft{background:var(--color-canvas);border:1.5px solid var(--color-ink-muted)}
		.rp-mark-published{background:var(--color-primary)}
		@media (max-width:600px){.rp-head h1{font-size:24px}.rp-card-head{flex-wrap:wrap}.rp-badges{flex-basis:100%;justify-content:flex-start}.rp-facts>div{grid-template-columns:minmax(0,1fr);gap:4px}.rp-table thead{display:none}.rp-table tr{display:block;padding:8px var(--rp-gutter);border-bottom:1px solid var(--color-border)}.rp-table tbody tr:first-child{border-top:1px solid var(--color-border)}.rp-table td{display:block;height:auto;padding:4px 0;border-bottom:none;white-space:normal}.rp-table td:first-child,.rp-table td:last-child{padding:4px 0}.rp-table tbody tr:last-child>td{border-bottom:none}.rp-name{width:auto;max-width:none}.rp-name>a{display:block}.rp-name>span{margin-left:0}.rp-table .rp-draft,.rp-table .rp-download-cell{text-align:left}.rp-table td:empty{display:none}.rp-publish{position:fixed;left:16px;right:16px;width:auto}.rp-draft-head{position:static}.rp-draft-title{display:flex;flex-basis:100%;align-items:flex-end;gap:8px 16px;min-width:0}.rp-draft-title>div{min-width:0}.rp-head-actions{flex-basis:100%;flex-wrap:nowrap;margin-left:0;gap:8px}.rp-head-actions .rp-menu>ul{left:0;right:auto}.rp-track thead{display:none}.rp-track tr{display:grid;grid-template-columns:auto minmax(0,1fr);align-items:center;gap:4px 12px;padding:12px 0;border-bottom:1px solid var(--color-border)}.rp-track tr:has(+tr>.rp-track-talk){border-bottom:none}.rp-track td,.rp-track tbody tr:last-child>td{display:block;padding:0;border-bottom:none}.rp-track .rp-track-goal{grid-column:2}.rp-track .rp-track-owner{grid-column:2}.rp-track .rp-track-due{grid-column:2}.rp-track .rp-track-talk{grid-column:1/-1}}
		@media (max-width:900px){.page:has(>.rp-index){padding:20px 0 48px}.rp-index{--rp-gutter:16px}.rp-draft-head{padding:8px 16px}}
		@media (min-width:1280px){.rp-draft-head{flex-wrap:nowrap}.rp-draft-head .rp-save{flex-basis:9em;min-width:9em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.rp-draft-head .rp-chip,.rp-draft-head .rp-head-actions{flex-shrink:0}}
	</style>
}
