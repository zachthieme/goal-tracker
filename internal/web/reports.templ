package web

import (
	"fmt"
	"slices"
	"time"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// reportsPage lists every saved Report Definition as a card, and behind a New
// report button the form to build a new one (CONTEXT.md: Report Definition). A
// definition selects Goals by root Goals plus a depth, by Dimension or Owner
// filters, or by filters alone.
templ reportsPage(current *domain.Account, data reportsListData) {
	@layout("Reports", current) {
		@reportStyles()
		<div class="page-head">
			<h1>Reports</h1>
		</div>
		<section data-testid="report-definitions" class="rp-body">
			<h2>Saved Report Definitions</h2>
			<ul class="rp-cards">
				if len(data.Defs) == 0 {
					<li data-testid="no-reports" class="muted">No Report Definitions yet.</li>
				}
				for _, d := range data.Defs {
					<li data-testid="report-definition" class="card rp-card">
						<a href={ templ.SafeURL(fmt.Sprintf("/reports/%d", d.ID)) }><strong>{ d.Name }</strong></a>
						if d.Introduction != "" {
							<span class="small muted">{ d.Introduction }</span>
						}
					</li>
				}
			</ul>
		</section>
		<details data-testid="create-report">
			<summary class="btn primary">New report</summary>
			<form class="card rp-card rp-form rp-new" method="post" action="/reports">
				<h3>New Report Definition</h3>
				<label class="field">
					<span>Name</span>
					<input type="text" name="name" required/>
				</label>
				<label class="field">
					<span>Introduction</span>
					<textarea name="introduction"></textarea>
				</label>
				<div class="field">
					<fieldset data-testid="report-roots" class="rp-picker">
						<legend>Root Goals <span class="hint">— Top-level Goals first</span></legend>
						for _, g := range data.Goals {
							<label>
								<input type="checkbox" name="root" value={ fmt.Sprintf("%d", g.ID) }/>
								{ g.Title }
								if g.TopLevel {
									{ " " }<span class="tag">Top-level</span>
								}
							</label>
						}
					</fieldset>
				</div>
				<label class="field">
					<span>Depth</span>
					<input type="number" name="depth" min="0" value="1"/>
					<span class="hint">0 = just the roots, 1 = roots and their direct contributors, …</span>
				</label>
				<label data-testid="report-owner-filter" class="field">
					<span>Owner filter</span>
					<select name="owner">
						<option value="">Any Owner</option>
						for _, o := range data.Owners {
							<option value={ fmt.Sprintf("%d", o.ID) } title={ o.Email }>{ o.Label() }</option>
						}
					</select>
				</label>
				<fieldset data-testid="report-dimension-filters">
					<legend>Dimension filters</legend>
					if len(data.Dims) == 0 {
						<p data-testid="no-dimensions-defined" class="muted">No Dimensions defined yet.</p>
					}
					for _, d := range data.Dims {
						<fieldset>
							<legend>{ d.Name }</legend>
							for _, v := range d.Values {
								if !v.Retired {
									<label>
										<input type="checkbox" name="filter" value={ fmt.Sprintf("%d", v.ID) }/>
										{ v.Value }
									</label>
								}
							}
						</fieldset>
					}
				</fieldset>
				<div><button type="submit" class="btn primary">Save Report Definition</button></div>
			</form>
		</details>
	}
}

// reportDraftPage shows a saved Report Definition and its draft Report read
// against a baseline the reader can change — by default the previous
// publication. It reads top to bottom as the author works: the baseline, the
// form to curate its narrative from Highlights, the draft preview, and only
// then the button that publishes it. Its publications are listed in a sidebar
// (CONTEXT.md: Report, Report Definition). Paths to Green are judged overdue as
// of asOf, today.
templ reportDraftPage(current *domain.Account, r domain.Report, asOf time.Time, pubs []domain.Publication, d discussion) {
	@layout(r.Definition.Name, current) {
		@reportStyles()
		<div class="page-head">
			<div>
				<p class="small muted"><a href="/reports">Reports</a>{ " / " }Draft</p>
				<h1 data-testid="report-name">{ r.Definition.Name }</h1>
			</div>
		</div>
		<div class="grid-main-aside">
			<div class="rp-body">
				<form data-testid="report-baseline" class="rp-inline-form" method="get">
					<label>
						Changes since
						<input type="date" name="baseline" value={ fmtDate(r.Baseline) }/>
					</label>
					<button type="submit" class="btn">Update</button>
				</form>
				if r.Previous.ID != 0 {
					<p data-testid="report-since-publication" class="muted">Showing what changed since the previous publication, { fmtPublished(r.Previous.PublishedAt) }.</p>
				}
				@narrativeCuration(r)
				<section data-testid="report-draft" class="rp-body">
					<h2>Draft preview</h2>
					@reportBody(r, asOf, d)
				</section>
				<form data-testid="report-publish" class="card rp-publish" method="post" action={ templ.SafeURL(fmt.Sprintf("/reports/%d/publications", r.Definition.ID)) }>
					// A date the reader picked is carried through; otherwise publishing
					// reads against the previous publication, as the draft does.
					if r.Previous.ID == 0 {
						<input type="hidden" name="baseline" value={ fmtDate(r.Baseline) }/>
					}
					<p class="muted">Publishes a frozen copy readers can comment on.</p>
					<button type="submit" class="btn primary">Publish</button>
				</form>
			</div>
			<aside data-testid="report-publications" class="rp-body">
				<h2>Publications</h2>
				<ul class="card rp-list">
					if len(pubs) == 0 {
						<li data-testid="no-publications" class="muted">Not published yet.</li>
					}
					for _, p := range pubs {
						<li data-testid="report-publication">
							<a href={ templ.SafeURL(publicationPath(p)) }>{ fmtPublished(p.PublishedAt) }</a>
							<br/>
							<span class="small muted">
								{ "by " }
								@person(p.PublishedBy)
							</span>
						</li>
					}
				</ul>
				<p><a href="/reports">Back to Reports</a></p>
			</aside>
		</div>
	}
}

// publicationPage shows a published Report exactly as it was frozen: who
// published it and when, and what it read its changes against. It links the
// ways to read it outside the tool: Markdown, and a page to print to PDF.
// Readers discuss it in place: comments on each Goal's block, and the Action
// Items raised on it (ticket #19).
templ publicationPage(current *domain.Account, p domain.Publication, d discussion) {
	@layout(p.Report.Definition.Name, current) {
		@reportStyles()
		<div class="rp-read">
			<header class="rp-head">
				<div>
					<p class="small muted" data-testid="report-breadcrumb">
						<a href="/reports">Reports</a>{ " / " }<a href={ templ.SafeURL(fmt.Sprintf("/reports/%d", p.DefinitionID)) }>{ p.Report.Definition.Name }</a>
					</p>
					<h1 data-testid="report-name">{ p.Report.Definition.Name }</h1>
					@publishedLine(p)
				</div>
				<div class="rp-actions" data-testid="report-export">
					<a data-testid="export-markdown" class="btn sm" href={ templ.SafeURL(publicationPath(p) + "/markdown") }>Markdown</a>
					<a data-testid="export-print" class="btn sm" href={ templ.SafeURL(publicationPath(p) + "/print") }>Print / PDF</a>
				</div>
			</header>
			@healthSummary(p.Report)
			<section data-testid="report-snapshot" class="rp-body">
				@reportBody(p.Report, p.PublishedAt, d)
			</section>
			@publicationActionItems(d)
		</div>
	}
}

// publicationPrintPage is a published Report on its own, without the app's
// navigation, styled to print to PDF from the browser.
templ publicationPrintPage(p domain.Publication) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ p.Report.Definition.Name } · { fmtPublished(p.PublishedAt) }</title>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link rel="stylesheet" href={ reportFontsURL }/>
			<style>
				/* Goal Tracker · design-system: DESIGN.md § Print variant */
				:root {
					--print-font: 'Source Serif 4', Georgia, serif;
					--print-ink: #000;
					--print-ink-2: #444;
					--print-rule: #999;
				}
				@page { margin: 18mm 16mm; }
				body { font-family: var(--print-font); color: var(--print-ink); font-size: 11pt; line-height: 1.45; max-width: 44rem; margin: 2rem auto; padding: 0 1rem; }
				h1 { font-size: 24pt; font-weight: 600; line-height: 1.15; margin: 0 0 0.25rem; }
				h2 { font-size: 13pt; font-weight: 600; margin: 2rem 0 0; padding-top: 0.5rem; border-top: 1.5pt solid var(--print-ink); break-after: avoid; }
				h3 { font-size: 13pt; font-weight: 600; line-height: 1.25; margin: 0; }
				p { margin: 0.4rem 0; }
				strong { font-weight: 600; }
				a { color: inherit; text-decoration: none; }
				ul { margin: 0.2rem 0 0.4rem; padding-left: 1.1rem; }
				article { break-inside: avoid; border-top: 0.5pt solid var(--print-rule); padding: 0.9rem 0 0.6rem; }
				h2 + article { border-top: none; }
				.rp-card-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; }
				.rp-card-head p { margin: 0.1rem 0 0; }
				table { border-collapse: collapse; width: 100%; font-size: 10pt; }
				th, td { text-align: left; vertical-align: top; padding: 0.3rem 0.75rem 0.3rem 0; border-bottom: 0.5pt solid var(--print-rule); }
				th { font-weight: 600; font-variant: small-caps; letter-spacing: 0.05em; border-bottom: 1pt solid var(--print-ink); }
				tr { break-inside: avoid; }
				.dot { display: none; }
				.badge { font-weight: 600; white-space: nowrap; }
				.shape { margin-right: 0.25em; }
				.muted { color: var(--print-ink-2); }
				.small { font-size: 9.5pt; }
				.label { font-variant: small-caps; letter-spacing: 0.05em; color: var(--print-ink-2); margin: 0.6rem 0 0; }
				@media print {
					body { margin: 0; max-width: none; padding: 0; }
					.no-print { display: none; }
				}
			</style>
		</head>
		<body>
			<p class="no-print">
				<button type="button" onclick="window.print()">Print</button>
				{ " " }
				<a href={ templ.SafeURL(publicationPath(p)) }>Back to the publication</a>
			</p>
			<h1 data-testid="report-name">{ p.Report.Definition.Name }</h1>
			@publishedLine(p)
			<section data-testid="report-snapshot">
				@reportBody(p.Report, p.PublishedAt, discussion{})
			</section>
		</body>
	</html>
}

// healthSummary counts the Report's selected Goals by Health — Red, Yellow,
// Green — and how many are Stale, so a reader sees the shape of the org before
// reading a block.
templ healthSummary(r domain.Report) {
	<section data-testid="health-summary" class="rp-tiles">
		for _, t := range healthTiles(r) {
			<div class="card rp-tile">
				<span class={ "badge", t.class }><span class="dot"></span>{ t.label }</span>
				<span data-testid={ "health-count-" + t.key } class="num rp-count">{ fmt.Sprintf("%d", t.count) }</span>
			</div>
		}
	</section>
}

// publishedLine says who published a Report and when, and what it read its
// changes against.
templ publishedLine(p domain.Publication) {
	<p data-testid="report-published" class="muted">
		{ "Published " + fmtPublished(p.PublishedAt) + " by " }
		@person(p.PublishedBy)
		if p.Report.Previous.ID != 0 {
			{ " · changes since the previous publication, " }{ fmtPublished(p.Report.Previous.PublishedAt) }
		} else {
			{ " · changes since " }{ fmtDate(p.Report.Baseline) }
		}
	</p>
}

// reportBody is a Report's content, drafted or published: its open Action
// Items, the introduction, the narrative curated from Highlights, then the
// exceptions that need attention, each a card with the full MBR block, and
// every other selected Goal on track, one table row with its Health, title,
// Owner, and due date (CONTEXT.md: Report). A Path to Green is judged overdue
// as of asOf. On a publication, each Goal carries its discussion.
templ reportBody(r domain.Report, asOf time.Time, d discussion) {
	@reportActionItems(r.ActionItems, d)
	if r.Definition.Introduction != "" {
		<p data-testid="report-introduction">{ r.Definition.Introduction }</p>
	}
	@reportNarrative(r.Narrative)
	if len(r.Exceptions) == 0 && len(r.Lines) == 0 {
		<p data-testid="no-selected-goals">No Goals selected.</p>
	}
	if len(r.Exceptions) > 0 {
		<section data-testid="needs-attention">
			<h2>Needs attention</h2>
			for _, b := range r.Exceptions {
				@reportBlock(b, asOf, d)
			}
		</section>
	}
	if len(r.Lines) > 0 {
		<section data-testid="on-track-section">
			<h2>On track</h2>
			<div class="card">
				<table data-testid="on-track">
					<thead>
						<tr><th>Health</th><th>Goal</th><th>Owner</th><th>Due</th></tr>
					</thead>
					<tbody>
						for _, sg := range r.Lines {
							<tr data-testid="selected-goal" id={ fmt.Sprintf("goal-%d", sg.Goal.ID) }>
								<td>
									@healthBadge("selected-health", sg.Health)
								</td>
								<td><a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", sg.Goal.ID)) }>{ sg.Goal.Title }</a></td>
								<td data-testid="selected-owner">
									@person(sg.Goal.Owner)
								</td>
								<td>
									if !sg.Goal.DeliveryDate.IsZero() {
										<span data-testid="selected-due" class="num">{ fmtDate(sg.Goal.DeliveryDate) }</span>
									} else {
										<span class="muted">—</span>
									}
								</td>
							</tr>
							if d.Pub != nil {
								<tr>
									<td colspan="4">
										@goalDiscussion(sg.Goal.ID, d)
									</td>
								</tr>
							}
						}
					</tbody>
				</table>
			</div>
		</section>
	}
}

// narrativeCuration is the draft page's form for curating the narrative of the
// next publication: every Highlight in scope since the baseline, each with the
// section the author picks it into, and the author's own text for each
// section (CONTEXT.md: Highlight).
templ narrativeCuration(r domain.Report) {
	<section data-testid="report-curation" class="rp-body">
		<h2>Narrative</h2>
		<form data-testid="narrative-curation" class="card rp-form rp-card" method="post" action={ templ.SafeURL(fmt.Sprintf("/reports/%d/narrative", r.Definition.ID)) }>
			// A date the reader picked is kept when the draft reloads.
			if r.Previous.ID == 0 {
				<input type="hidden" name="baseline" value={ fmtDate(r.Baseline) }/>
			}
			if len(r.Highlights) == 0 {
				<p data-testid="no-highlights">No Highlights since { fmtDate(r.Baseline) }.</p>
			} else {
				<ul class="rp-list">
					for _, nh := range r.Highlights {
						<li data-testid="curation-highlight">
							<select name={ fmt.Sprintf("pick-%d", nh.Highlight.ID) }>
								<option value="" selected?={ nh.Section == "" }>Leave out</option>
								for _, section := range narrativeSections {
									<option value={ section } selected?={ nh.Section == section }>{ sectionHeading(section) }</option>
								}
							</select>
							{ " " }<strong>[{ nh.Highlight.Kind }]</strong>
							{ " " }{ nh.Highlight.Note }
							@highlightCredit(nh)
						</li>
					}
				</ul>
			}
			for _, section := range narrativeSections {
				<label class="field">
					<span>{ sectionHeading(section) }</span>
					<textarea name={ "text-" + section }>{ narrativeText(r, section) }</textarea>
				</label>
			}
			<div><button type="submit" class="btn">Save narrative</button></div>
		</form>
	</section>
}

// reportNarrative is a Report's Insights, Accomplishments, and Misses, in the
// serif face under label headings: the author's text and the Highlights they
// picked, each crediting the Goal's Owner. Sections with neither are left out.
templ reportNarrative(narrative []domain.NarrativeSection) {
	if len(narrative) > 0 {
		<section data-testid="report-narrative" class="card rp-narrative">
			for _, sec := range narrative {
				<h3 data-testid="narrative-section" class="label">{ sec.Heading() }</h3>
				if sec.Text != "" {
					<p data-testid="narrative-text">{ sec.Text }</p>
				}
				if len(sec.Highlights) > 0 {
					<ul>
						for _, nh := range sec.Highlights {
							<li data-testid="narrative-highlight">
								{ nh.Highlight.Note }
								@highlightCredit(nh)
							</li>
						}
					</ul>
				}
			}
		</section>
	}
}

// highlightCredit credits a Highlight to the Goal's Owner, naming the Goal.
templ highlightCredit(nh domain.NarrativeHighlight) {
	<span data-testid="highlight-credit" class="rp-credit">
		{ " — " }
		@person(nh.Highlight.Owner)
		{ ", " }
		<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", nh.GoalID)) }>{ nh.GoalTitle }</a>
	</span>
}

// reportBlock is an exception Goal's full MBR block, as a card: title, Owner,
// Lifecycle, and due date with its history struck through; Health and badges
// top right; So What, latest status, and Path to Green in a tinted box, marked
// Overdue when its target date passed before asOf; Milestones, Metrics against
// target, and the Rolled-up Health with the Owner's explanation. On a
// publication it ends with the Goal's discussion.
templ reportBlock(b domain.ReportBlock, asOf time.Time, d discussion) {
	<article data-testid="report-exception" class="card rp-card" id={ fmt.Sprintf("goal-%d", b.Goal.ID) }>
		<div class="rp-card-head">
			<div>
				<h3><a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", b.Goal.ID)) }>{ b.Goal.Title }</a></h3>
				<p class="small muted">
					<span data-testid="report-owner">
						@person(b.Goal.Owner)
					</span>
					{ " · " }{ b.Goal.Lifecycle }
					if !b.Goal.DeliveryDate.IsZero() {
						{ " · due " }
						<span data-testid="report-due">
							@struckDates(b.PriorDueDates)
							{ fmtDate(b.Goal.DeliveryDate) }
						</span>
					}
				</p>
			</div>
			<div class="rp-badges">
				@healthBadge("report-health", b.Health)
				for _, badge := range b.Badges {
					<span data-testid="report-badge" class={ "badge", badgeClass(badge) }>{ badge }</span>
				}
			</div>
		</div>
		<div data-testid="report-status-box" class={ "rp-tint", templ.KV("overdue", pathOverdueAt(b, asOf)) }>
			<p data-testid="report-so-what"><strong>So What:</strong> { b.Goal.SoWhat }</p>
			if b.Status != "" {
				<p data-testid="report-status"><strong>Status:</strong> { b.Status }</p>
			}
			if b.PathToGreen != "" {
				<p data-testid="report-path-to-green">
					<strong>Path to Green:</strong> { b.PathToGreen } (back to Green by { fmtDate(b.PathTargetDate) })
					if pathOverdueAt(b, asOf) {
						{ " " }<strong data-testid="path-overdue" class="badge r">Overdue</strong>
					}
				</p>
			}
		</div>
		if len(b.Milestones) > 0 {
			<div>
				<p class="label">Milestones</p>
				<ul data-testid="report-milestones">
					for _, m := range b.Milestones {
						<li data-testid="report-milestone">
							if m.Milestone.Status == domain.MilestoneRemoved {
								<del>{ m.Milestone.Name }</del>
							} else {
								{ m.Milestone.Name }
							}
							{ " — " }
							@struckDates(m.PriorDates)
							{ fmtDate(m.Milestone.TargetDate) }
							if m.New {
								{ " " }<span class="badge lc">New</span>
							}
							if m.Milestone.Status != domain.MilestonePlanned {
								{ " " }<span class="badge lc">{ m.Milestone.Status }</span>
							}
							if m.Milestone.RemovedReason != "" {
								<span>— { m.Milestone.RemovedReason }</span>
							}
						</li>
					}
				</ul>
			</div>
		}
		if len(b.Metrics) > 0 {
			<div>
				<p class="label">Metrics</p>
				<ul data-testid="report-metrics">
					for _, m := range b.Metrics {
						<li data-testid="report-metric">
							{ m.Metric.Name }:
							if m.Read {
								{ fmtNum(m.Current) }
							} else {
								no reading yet
							}
							{ " against a target of " }{ fmtNum(m.Metric.Target) } { m.Metric.Unit } by { fmtDate(m.Metric.TargetDate) }
							{ " (baseline " }{ fmtNum(m.Metric.Baseline) }, { m.Metric.Direction })
						</li>
					}
				</ul>
			</div>
		}
		if b.RolledUp.Present || b.RolledUp.StaleChildren > 0 {
			<p data-testid="report-rollup">
				if b.RolledUp.Present {
					<strong>Rolled-up Health:</strong>
					@healthBadge("rollup-health", b.RolledUp.Health)
				}
				@rolledUpStale(b.RolledUp)
				if b.Explanation != "" {
					<br/>
					<strong>Why the Health differs:</strong> { b.Explanation }
				}
			</p>
		}
		@goalDiscussion(b.Goal.ID, d)
	</article>
}

// healthBadge is a Health as a coloured badge, marked for print, or a dash
// when there is none yet.
templ healthBadge(testID, health string) {
	<span data-testid={ testID } class={ "badge", healthClass(health) }>
		@healthMark(health)
		{ reportHealth(health) }
	</span>
}

// healthMark marks a Health on a badge: the design system's coloured dot on
// screen, and on the print page, which hides the dot, a shape that survives
// black-and-white printing — ■ Red, ▲ Yellow, ● Green.
templ healthMark(health string) {
	<span class="dot"></span>
	if shape := healthShape(health); shape != "" {
		<span class="shape" aria-hidden="true">{ shape }</span>
	}
}

// healthShape is the shape the print page marks a Health with.
func healthShape(health string) string {
	switch health {
	case domain.HealthRed:
		return "■"
	case domain.HealthYellow:
		return "▲"
	case domain.HealthGreen:
		return "●"
	}
	return ""
}

// reportFontsURL loads the serif the print page reads in. Print sits outside
// DESIGN.md on purpose: it is set for black-and-white paper, not the screen.
const reportFontsURL = "https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap"

// healthClass is the badge colour for a Health; no Health yet is neutral.
func healthClass(health string) string {
	switch health {
	case domain.HealthRed:
		return "r"
	case domain.HealthYellow:
		return "y"
	case domain.HealthGreen:
		return "g"
	}
	return "lc"
}

// badgeClass is a report badge's colour: Stale in its own colour, Ownerless as
// prominent as Red, a New Date as a warning, and the rest neutral.
func badgeClass(badge string) string {
	switch badge {
	case domain.BadgeStale:
		return "st"
	case domain.BadgeOwnerless:
		return "r"
	case domain.BadgeNewDate:
		return "y"
	}
	return "lc"
}

// pathOverdueAt reports whether an Active exception's Path to Green had missed
// its target date as of asOf — the day it was published, or today on the
// draft (CONTEXT.md: Path to Green).
func pathOverdueAt(b domain.ReportBlock, asOf time.Time) bool {
	if b.Goal.Lifecycle != domain.LifecycleActive || b.PathTargetDate.IsZero() {
		return false
	}
	if b.Health != domain.HealthRed && b.Health != domain.HealthYellow {
		return false
	}
	return fmtDate(asOf.UTC()) > fmtDate(b.PathTargetDate)
}

// healthTile is one count on a Report's Health summary.
type healthTile struct {
	key, label, class string
	count             int
}

// healthTiles counts a Report's selected Goals by Health, and its Stale ones —
// only an exception block can be Stale, since a Stale Goal is an exception.
func healthTiles(r domain.Report) []healthTile {
	byHealth := map[string]int{}
	stale := 0
	for _, b := range r.Exceptions {
		byHealth[b.Health]++
		if slices.Contains(b.Badges, domain.BadgeStale) {
			stale++
		}
	}
	for _, sg := range r.Lines {
		byHealth[sg.Health]++
	}
	return []healthTile{
		{"red", domain.HealthRed, "r", byHealth[domain.HealthRed]},
		{"yellow", domain.HealthYellow, "y", byHealth[domain.HealthYellow]},
		{"green", domain.HealthGreen, "g", byHealth[domain.HealthGreen]},
		{"stale", domain.BadgeStale, "st", stale},
	}
}

// reportHealth renders a selected Goal's Health, or a dash when it has no Check-in
// yet (a Proposed Goal, or an Active one not yet checked in on).
func reportHealth(health string) string {
	if health == "" {
		return "—"
	}
	return health
}

// fmtPublished renders the instant a Report was published, to the minute.
func fmtPublished(t time.Time) string {
	return t.UTC().Format("2006-01-02 15:04 UTC")
}

// narrativeSections are a Report narrative's sections in the order it shows
// them.
var narrativeSections = []string{domain.HighlightInsight, domain.HighlightAccomplishment, domain.HighlightMiss}

// sectionHeading is a narrative section's title, e.g. "Insights".
func sectionHeading(section string) string {
	return domain.NarrativeSection{Kind: section}.Heading()
}

// narrativeText is the author's text for one section of a Report's narrative.
func narrativeText(r domain.Report, section string) string {
	for _, sec := range r.Narrative {
		if sec.Kind == section {
			return sec.Text
		}
	}
	return ""
}

// reportStyles are the Report pages' own rules on top of app.css: the reading
// column a publication is centred in, the Health tiles, the exception cards and
// their tinted status box, the discussion footer, the scrolling root-Goal
// picker, and draft columns that shrink to a phone's width rather than to the
// On track table's.
templ reportStyles() {
	<style>
		.shape{display:none}
		.grid-main-aside>*{min-width:0}
		.page>.rp-read{width:100%;max-width:880px;margin:0 auto;display:flex;flex-direction:column;gap:24px}
		.rp-head{display:flex;align-items:flex-end;justify-content:space-between;gap:24px;flex-wrap:wrap}
		.rp-head h1{margin:4px 0}
		.rp-actions{display:flex;gap:8px}
		.rp-tiles{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
		.rp-tile{padding:16px;display:flex;align-items:center;justify-content:space-between;gap:8px}
		.rp-count{font-size:24px}
		.rp-body{display:flex;flex-direction:column;gap:24px}
		.rp-body section{display:flex;flex-direction:column;gap:12px}
		.rp-list{list-style:none;margin:0;padding:0}
		.rp-list>li{padding:12px 24px;border-bottom:1px solid var(--color-border)}
		.rp-list>li:last-child{border-bottom:none}
		.rp-narrative{font-size:16px;line-height:1.7;padding:24px;color:var(--color-ink)}
		.rp-narrative .label{margin-top:12px}
		.rp-narrative .label:first-child{margin-top:0}
		.rp-narrative ul{margin:4px 0 0;padding-left:20px}
		.rp-credit{color:var(--color-ink-muted);font-size:13px}
		.rp-card{padding:24px;display:flex;flex-direction:column;gap:12px}
		.rp-card-head{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
		.rp-card-head h3{font-size:19px}
		.rp-badges{display:flex;gap:8px;flex-wrap:wrap;justify-content:flex-end}
		.rp-tint{background:var(--color-surface-alt);border-radius:var(--radius-md);padding:12px 16px;display:flex;flex-direction:column;gap:8px}
		.rp-tint.overdue{background:var(--health-r-bg)}
		.rp-card ul{margin:0;padding-left:20px}
		.rp-discussion{border-top:1px solid var(--color-border);padding-top:8px;display:flex;flex-wrap:wrap;gap:4px 16px;align-items:flex-start}
		.rp-discussion>details{flex:1 1 auto}
		.rp-discussion details>summary{min-height:32px;justify-content:flex-start;color:var(--color-primary-strong);font-weight:500}
		.rp-thread{border-left:1px solid var(--color-border);padding-left:12px;margin:8px 0;display:flex;flex-direction:column;gap:8px}
		.rp-reply{margin-left:24px}
		.rp-inline-form{display:flex;flex-wrap:wrap;gap:8px;align-items:flex-end}
		.rp-inline-form label{display:flex;flex-direction:column;gap:4px;font-size:13px;font-weight:600}
		.rp-cards{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
		.rp-cards>.rp-card{padding:16px 24px;gap:4px}
		.rp-picker{max-height:280px;overflow-y:auto;border:1px solid var(--color-border-strong);border-radius:var(--radius-md);background:var(--color-surface);padding:8px 12px;display:flex;flex-direction:column;gap:4px}
		.rp-form{display:flex;flex-direction:column;gap:16px}
		.rp-new{margin-top:12px}
		.rp-form fieldset:not(.rp-picker){border:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px}
		.rp-form legend{font-weight:600;font-size:13px;padding:0 0 8px}
		.rp-publish{padding:24px;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
		@media (max-width:900px){.rp-tiles{grid-template-columns:repeat(2,minmax(0,1fr))}}
	</style>
}
