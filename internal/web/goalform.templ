package web

import (
	"fmt"
	"strings"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// goalFormPage is the New goal page: a plain form that creates a Goal, Proposed
// or activated at once, and lands on it, so it works without script. It sits
// in the flat frame under its page header (goalFormHeader), a centred column
// of plain sections with hairlines between: the Title and Why it matters, then
// Delivery, How you'll know and More detail. Beside it, Ready to activate, a
// quiet rail holding the submit buttons, stays in view as the form scrolls,
// and on a narrow screen follows the column (DESIGN.md § Direction: Page
// shapes).
// Script posts the form to /goals/new/checklist on load and as it changes,
// filled in or not, and swaps Ready to activate for the one that comes back. A
// refused submit comes back with what was typed, a summary of every problem
// first, and each bad input marked with why. Finishing a Proposed Goal, it is
// the define page: the same form, filled in from the Goal, posting to
// /goals/<id>/define.
templ goalFormPage(current *domain.Account, v goalFormView) {
	@framedLayout(v.heading(), current, goalFormHeader(v)) {
		@itemEditorStyles()
		@goalFormStyles()
		<form
			data-testid="goal-form"
			class="gf-form"
			method="post"
			action={ templ.SafeURL(v.action()) }
		>
			@goalFormLiveChecklist(v)
			<div class="gf-main">
				@goalFormErrors(v)
				@goalFormWhat(v)
				@goalFormDelivery(v)
				@goalFormKnow(v)
				@goalFormMore(v)
			</div>
			@goalFormReady(v)
		</form>
	}
}

// goalFormHeader is the form's page header: New goal, or Finish defining
// under the Goal's title, which links back to it.
templ goalFormHeader(v goalFormView) {
	if v.Goal == nil {
		@pageHeader(pageHead{Title: v.heading()})
	} else {
		@pageHeader(pageHead{Parent: v.Goal.Title, ParentHref: fmt.Sprintf("/goals/%d", v.Goal.ID), Title: v.heading()})
	}
}

// goalFormLiveChecklist posts the form to its checklist URL on load and as it
// changes, swapping Ready to activate for the one that comes back.
// It sits inside the form rather than on it because htmx checks a form's
// required inputs before a request the form itself makes, so an empty Title
// or Why it matters would hold back the very section that says what's missing; posted
// from here, the enclosing form's values go as they are, while a real submit
// is still checked.
templ goalFormLiveChecklist(v goalFormView) {
	<div
		hidden
		hx-post={ v.checklistURL() }
		hx-trigger="load, change from:closest form, input delay:400ms from:closest form"
		hx-target={ "#" + goalFormReadyID }
		hx-swap="outerHTML"
		hx-sync="this:replace"
	></div>
}

// goalFormKnowID is the How you'll know section's id, which the checklist's
// Milestone or Metric item links to.
const goalFormKnowID = "know"

// goalFormReadyID is the Ready to activate section's id, which the form's live
// checklist swaps.
const goalFormReadyID = "goal-form-ready"

// goalFormReady is the Ready to activate section, sticky beside the form: how
// many of the activation checklist's items the form meets, as "n of m done"
// and a bar, each item's mark, ✓ or ○, with its done or to do for screen
// readers alone, and the submit buttons. Create and activate posts activate=1
// and is disabled while the live checklist is incomplete; Save as Proposed
// needs a Title and Why it matters, plus the delivery date when Dated is chosen. Save
// as Proposed comes first in the markup, so Enter in a text field saves as
// Proposed, while CSS order shows Create and activate first.
templ goalFormReady(v goalFormView) {
	{{ done, of := v.readyCount() }}
	<section data-testid="goal-form-ready" id={ goalFormReadyID } class="gf-section gf-ready" aria-labelledby="goal-form-ready-head">
		<h2 id="goal-form-ready-head">Ready to activate</h2>
		<p data-testid="goal-form-ready-count" class="muted small">{ fmt.Sprintf("%d of %d done", done, of) }</p>
		<progress class="gf-progress" value={ fmt.Sprint(done) } max={ fmt.Sprint(of) } aria-labelledby="goal-form-ready-head"></progress>
		<ul data-testid="activation-checklist" class="gf-checklist">
			for _, item := range v.activationFacts().checklist() {
				if item.Done {
					<li data-done="true" class="gf-check done">
						<span aria-hidden="true" class="gf-mark">✓</span>
						@goalFormCheckLabel(item)
						<span class="sr-only">done</span>
					</li>
				} else {
					<li data-done="false" class="gf-check">
						<span aria-hidden="true" class="gf-mark">○</span>
						@goalFormCheckLabel(item)
						<span class="sr-only">to do</span>
					</li>
				}
			}
		</ul>
		<div class="gf-actions">
			<button type="submit" class="btn">Save as Proposed</button>
			<button type="submit" id={ domain.InputActivate } name={ domain.InputActivate } value="1" class="btn primary gf-activate" disabled?={ v.activateDisabled() }>Create and activate</button>
		</div>
		<p class="muted small">Saving needs a Title and Why it matters, and a delivery date if Dated is chosen.</p>
		<a class="small gf-cancel" href={ v.cancelURL() }>Cancel</a>
	</section>
}

// goalFormCheckLabel is a checklist item's label, linked to the field or
// section that meets it, as the error summary links a refused input.
templ goalFormCheckLabel(item activationItem) {
	if item.Input != "" {
		<a href={ templ.SafeURL("#" + item.Input) }>{ item.Label }</a>
	} else {
		<span>{ item.Label }</span>
	}
}

// goalFormWhat opens the form with no heading of its own, the page header
// holding the page's <h1>: a muted line saying the Goal is Proposed until it's
// activated, then the Goal's Title, focused, as a heading-style input, and its
// Why it matters. Finishing a saved Goal, the Title is read-only and the Why it matters
// takes the focus.
templ goalFormWhat(v goalFormView) {
	<section data-testid="goal-form-what" class="gf-section gf-what">
		<p class="gf-page-line">Proposed until it's activated</p>
		<label class="field">
			<span class="sr-only">Title</span>
			<input
				type="text"
				class="gf-title"
				id={ domain.InputTitle }
				name={ domain.InputTitle }
				value={ v.Title }
				placeholder="Name the outcome"
				required
				if v.Goal == nil {
					autofocus
				} else {
					readonly
				}
				if v.bad(domain.InputTitle) != "" {
					aria-invalid="true"
					aria-describedby={ domain.InputTitle + "-error" }
				}
			/>
			@goalFormInputError(v, domain.InputTitle)
		</label>
		<label class="field">
			<span>Why it matters <span class="hint">· the customer problem, and what changes when this succeeds</span></span>
			<textarea
				id={ domain.InputWhyItMatters }
				name={ domain.InputWhyItMatters }
				required
				autofocus?={ v.Goal != nil }
				if v.bad(domain.InputWhyItMatters) != "" {
					aria-invalid="true"
					aria-describedby={ domain.InputWhyItMatters + "-error" }
				}
			>{ v.WhyItMatters }</textarea>
			@goalFormInputError(v, domain.InputWhyItMatters)
		</label>
	</section>
}

// goalFormDelivery is the "Delivery" section: the Kind, two tiles with neither
// chosen at first, the Dated one holding the delivery date a Dated Goal needs,
// and the Check-in cadence, one segmented control, Weekly at first. The
// delivery date shows once Dated is chosen and Custom's days once Custom is,
// by CSS :has, so a browser without it shows both always.
templ goalFormDelivery(v goalFormView) {
	<section data-testid="goal-form-delivery" class="gf-section gf-delivery">
		<h2>Delivery</h2>
		<fieldset id={ domain.InputKind } class="gf-group">
			<legend>Kind</legend>
			<div class="gf-segments">
				<div class="gf-tile">
					@kindChoice(v, domain.GoalDated, datedHelp)
					<label class="field gf-date">
						<span>Delivery date</span>
						<input
							type="date"
							id={ domain.InputDeliveryDate }
							name={ domain.InputDeliveryDate }
							value={ v.DeliveryDate }
							if v.bad(domain.InputDeliveryDate) != "" {
								aria-invalid="true"
								aria-describedby={ domain.InputDeliveryDate + "-error" }
							}
						/>
						@goalFormInputError(v, domain.InputDeliveryDate)
					</label>
				</div>
				<div class="gf-tile">
					@kindChoice(v, domain.GoalOngoing, ongoingHelp)
				</div>
			</div>
			@goalFormInputError(v, domain.InputKind)
		</fieldset>
		<fieldset class="gf-group gf-cadence">
			<legend>Check-in cadence</legend>
			<div class="gf-segctl">
				for _, c := range cadenceChips {
					<label class="gf-seg">
						<input type="radio" id={ "cadence-" + c.Value } name={ domain.InputCadence } value={ c.Value } checked?={ v.cadenceChosen() == c.Value }/>
						<span>{ c.Label }</span>
					</label>
				}
			</div>
			<label class="field gf-custom">
				<span>Days between Check-ins</span>
				<input
					type="number"
					id={ domain.InputCadence }
					name={ inputCadenceDays }
					value={ v.customDays() }
					min="1"
					step="1"
					inputmode="numeric"
					if v.bad(domain.InputCadence) != "" {
						aria-invalid="true"
						aria-describedby={ domain.InputCadence + "-error" }
					}
				/>
				@goalFormInputError(v, domain.InputCadence)
			</label>
		</fieldset>
	</section>
}

// kindChoice is a Kind tile's choice: the Kind and what it means. With :has,
// the native radio hides behind a dot the choice draws, empty or filled, and
// the tile around it takes a 2px primary edge and a fill once it's chosen.
templ kindChoice(v goalFormView, kind, means string) {
	<label class="gf-segment">
		<input
			type="radio"
			id={ "kind-" + strings.ToLower(kind) }
			name={ domain.InputKind }
			value={ kind }
			checked?={ v.Kind == kind }
			if v.bad(domain.InputKind) != "" {
				aria-invalid="true"
				aria-describedby={ domain.InputKind + "-error" }
			}
		/>
		<span><strong>{ kind }</strong> <span class="hint">{ means }</span></span>
	</label>
}

// goalFormKnow is the "How you'll know" section: beside its heading, what
// activation needs of it, a Metric alone once Ongoing is chosen (by CSS :has,
// so a browser without it shows the first line); then the Goal's Milestones
// and Metrics. Without script it shows a row each, those typed or one blank
// row of each. Script upgrades the rows to the item editor the Highlight
// editor's look shares: + Milestone and + Metric open an editor from its
// <template> below the items, Save makes it an item posting the row's fields
// as hidden inputs, and Edit and Remove change an item (goalFormRowsScript).
// The section carries the company's current year, for script to write an
// item's date as the app does.
templ goalFormKnow(v goalFormView) {
	<section data-testid="goal-form-know" id={ goalFormKnowID } class="gf-know" data-year={ v.year() }>
		<div class="gf-head-line">
			<h2>How you'll know</h2>
			<p class="muted small">
				<span class="gf-rule-any">At least one Milestone or Metric to activate</span>
				<span class="gf-rule-ongoing">At least one Metric to activate</span>
			</p>
		</div>
		@goalFormExisting(v)
		<h3 class="gf-know-head label" data-measure-label="milestones">Milestones</h3>
		<div data-testid="milestone-rows" class="gf-rows" data-rows="milestones">
			for i, m := range v.milestoneRows() {
				@milestoneRowFields(v, rowNames(domain.MilestoneInput, i), m)
			}
		</div>
		<template id="milestones-row">
			@milestoneRowFields(goalFormView{}, templateRowNames("milestones"), milestoneRow{})
		</template>
		<h3 class="gf-know-head label" data-measure-label="metrics">Metrics</h3>
		<div data-testid="metric-rows" class="gf-rows" data-rows="metrics">
			for i, m := range v.metricRows() {
				@metricRowFields(v, rowNames(domain.MetricInput, i), m)
			}
		</div>
		<template id="metrics-row">
			@metricRowFields(goalFormView{}, templateRowNames("metrics"), metricRow{})
		</template>
		<div class="gf-rows" data-measure-editors></div>
		<div class="gf-js-only gf-measure-add">
			<button type="button" class="btn quiet sm" data-add-row="milestones">+ Milestone</button>
			<button type="button" class="btn quiet sm" data-add-row="metrics">+ Metric</button>
		</div>
		@milestoneEditorTemplate()
		@metricEditorTemplate()
		@measureItemTemplate("milestones", "milestone-item")
		@measureItemTemplate("metrics", "metric-item")
	</section>
	@goalFormRowsScript()
}

// milestoneEditorTemplate is the editor script clones to add or edit a
// Milestone: Name and Date, two-thirds and one-third of the row, the editing
// marker that asks the checklist for it to be saved, and Save and Cancel.
// Its inputs are named as a row's are, numbered by script, so an editor still
// open at submit is sent like a row.
templ milestoneEditorTemplate() {
	{{ name := templateRowNames("milestones") }}
	<template id="milestones-editor">
		<div data-testid="milestone-editor" class="ie-editor" role="group" data-measure-editor>
			<h4 class="ie-editor-head" data-measure-heading>New Milestone</h4>
			<input type="hidden" name={ inputEditing } value="Milestone"/>
			<div class="gf-milestone-fields">
				@goalFormRowInput(goalFormView{}, "Name", "text", name("name"), "")
				@goalFormRowInput(goalFormView{}, "Date", "date", name("date"), "")
			</div>
			@measureEditorActions()
		</div>
	</template>
}

// metricEditorTemplate is the editor script clones to add or edit a Metric:
// Name, Unit, Baseline, Target, Target date, and the Direction that shows
// only while the target equals the baseline, then the editing marker, and
// Save and Cancel, as milestoneEditorTemplate's.
templ metricEditorTemplate() {
	{{ name := templateRowNames("metrics") }}
	<template id="metrics-editor">
		<div data-testid="metric-editor" class="ie-editor" role="group" data-measure-editor>
			<h4 class="ie-editor-head" data-measure-heading>New Metric</h4>
			<input type="hidden" name={ inputEditing } value="Metric"/>
			<div class="gf-metric-fields">
				@goalFormRowInput(goalFormView{}, "Name", "text", name("name"), "")
				@goalFormRowInput(goalFormView{}, "Unit", "text", name("unit"), "")
				@goalFormRowInput(goalFormView{}, "Baseline", "number", name("baseline"), "")
				@goalFormRowInput(goalFormView{}, "Target", "number", name("target"), "")
				@goalFormRowInput(goalFormView{}, "Target date", "date", name("target_date"), "")
				@metricDirectionField(goalFormView{}, name("direction"), "")
			</div>
			@measureEditorActions()
		</div>
	</template>
}

// measureEditorActions are a Milestone or Metric editor's Save, enabled by
// script once the server would take what's typed, and Cancel.
templ measureEditorActions() {
	<div class="ie-actions">
		<button type="button" class="btn primary sm" data-measure-save>Save</button>
		<button type="button" class="btn sm" data-measure-cancel>Cancel</button>
	</div>
}

// measureItemTemplate is a saved Milestone or Metric as script shows it: its
// name, a muted line with a Milestone's date or a Metric's "baseline → target
// unit by date", as goalFormExisting writes one, and Edit and Remove. Script
// adds the hidden inputs it posts.
templ measureItemTemplate(section, testID string) {
	<template id={ section + "-item" }>
		<div data-testid={ testID } class="ie-item">
			<p><strong data-testid="measure-item-name"></strong></p>
			<p data-testid="measure-item-detail" class="muted"></p>
			<div class="ie-actions">
				<button type="button" class="btn quiet sm" data-measure-edit>Edit</button>
				<button type="button" class="btn quiet sm" data-measure-remove>Remove</button>
			</div>
		</div>
	</template>
}

// goalFormExisting lists the Milestones and Metrics the Goal being finished
// already has, read-only: they're edited on the Goal page, and the rows below
// only add to them.
templ goalFormExisting(v goalFormView) {
	if len(v.ExistingMilestones) > 0 || len(v.ExistingMetrics) > 0 {
		<div data-testid="existing-measures" class="gf-existing">
			<p class="muted small">Already defined; edit these on the Goal's page.</p>
			<ul class="gf-list">
				for _, m := range v.ExistingMilestones {
					<li>Milestone: <strong>{ m.Name }</strong> <span class="muted small">{ v.Dates.date(m.TargetDate) }</span></li>
				}
				for _, m := range v.ExistingMetrics {
					<li>Metric: <strong>{ m.Name }</strong> <span class="muted small">{ fmt.Sprintf("%s → %s %s by %s", fmtNum(m.Baseline), fmtNum(m.Target), m.Unit, v.Dates.date(m.TargetDate)) }</span></li>
				}
			</ul>
		</div>
	}
}

// milestoneRowFields is one Milestone row: Name and Date.
templ milestoneRowFields(v goalFormView, name func(part string) string, m milestoneRow) {
	<div data-testid="milestone-row" class="gf-row">
		@goalFormRowInput(v, "Name", "text", name("name"), m.Name)
		@goalFormRowInput(v, "Date", "date", name("date"), m.Date)
	</div>
}

// metricRowFields is one Metric row: Name, Unit, Baseline, Target, Target
// date, and the Direction select that counts only when the target equals the
// baseline.
templ metricRowFields(v goalFormView, name func(part string) string, m metricRow) {
	<div data-testid="metric-row" class="gf-row" data-metric-row>
		@goalFormRowInput(v, "Name", "text", name("name"), m.Name)
		@goalFormRowInput(v, "Unit", "text", name("unit"), m.Unit)
		@goalFormRowInput(v, "Baseline", "number", name("baseline"), m.Baseline)
		@goalFormRowInput(v, "Target", "number", name("target"), m.Target)
		@metricDirectionField(v, name("direction"), m.Direction)
		@goalFormRowInput(v, "Target date", "date", name("target_date"), m.TargetDate)
	</div>
}

// metricDirectionField is a Metric's Direction select, which counts only when
// the target equals the baseline.
templ metricDirectionField(v goalFormView, input, direction string) {
	<label class="field" data-direction>
		<span>Direction <span class="hint">— when target equals baseline</span></span>
		<select
			id={ input }
			name={ input }
			if v.bad(input) != "" {
				aria-invalid="true"
				aria-describedby={ input + "-error" }
			}
		>
			<option value="" selected?={ direction == "" }>Choose…</option>
			<option value={ domain.MetricUp } selected?={ direction == domain.MetricUp }>up</option>
			<option value={ domain.MetricDown } selected?={ direction == domain.MetricDown }>down</option>
		</select>
		@goalFormInputError(v, input)
	</label>
}

// goalFormRowInput is one input of a row, marked with why it was refused.
templ goalFormRowInput(v goalFormView, label, kind, input, value string) {
	<label class="field">
		<span>{ label }</span>
		<input
			if kind == "number" {
				type="number"
				step="any"
			} else {
				type={ kind }
			}
			id={ input }
			name={ input }
			value={ value }
			if v.bad(input) != "" {
				aria-invalid="true"
				aria-describedby={ input + "-error" }
			}
		/>
		@goalFormInputError(v, input)
	</label>
}

// goalFormRowsScript marks the form gf-js and upgrades How you'll know's rows
// to the item editor, following the Highlight editor's rules
// (highlightEditorScript): each row with anything typed becomes a saved item,
// a blank one goes, and one holding a refused input becomes an open editor
// showing why. + Milestone and + Metric open an editor below the items,
// numbered past the rows the server rendered; Save, enabled once the server
// would take its shape, makes it an item at the end of its section, holding
// the row's fields as hidden inputs; Cancel drops a new editor or puts back
// the item it edits; Edit swaps an item for an editor in place, and Remove
// drops it. One editor is open at a time: while any is, the add and Edit
// buttons are disabled, the first carries goalFormEditorID, and Enter in it
// presses Save rather than submitting the form. Save, Cancel and Remove hand
// focus to the item's Edit or the add button, or, while another editor is
// still open, to that editor. Each section's label shows only while it has a
// saved item. Each change is posted to the live checklist, which asks for an
// open editor to be saved. A Metric's Direction shows only while its baseline
// equals its target, and posts only then.
templ goalFormRowsScript() {
	<script>
		(function () {
			var form = document.querySelector('[data-testid="goal-form"]');
			if (!form) return;
			form.classList.add("gf-js");
			var know = form.querySelector('[data-testid="goal-form-know"]');
			if (!know) return;
			var year = know.getAttribute("data-year");
			var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
			var parts = {
				milestones: ["name", "date"],
				metrics: ["name", "unit", "baseline", "target", "target_date", "direction"],
			};
			var noun = { milestones: "Milestone", metrics: "Metric" };
			var editors = know.querySelector("[data-measure-editors]");
			var next = {};
			Object.keys(parts).forEach(function (section) {
				var list = rows(section);
				next[section] = list.children.length;
				Array.prototype.slice.call(list.children).forEach(function (row) {
					var i = Number(row.querySelector("[name]").name.match(/\[(\d+)\]/)[1]);
					var values = {};
					var typed = false;
					parts[section].forEach(function (part) {
						values[part] = field(row, section, i, part).value;
						typed = typed || values[part].trim() !== "";
					});
					if (row.querySelector('[aria-invalid="true"]')) {
						var editor = openEditor(section, i, values, null);
						showErrors(row, editor, section, i);
						row.replaceWith(editor);
					} else if (typed) {
						row.replaceWith(item(section, i, values));
					} else {
						row.remove();
					}
				});
			});
			refresh();

			function rows(section) {
				return know.querySelector('[data-rows="' + section + '"]');
			}

			function addButton(section) {
				return know.querySelector('[data-add-row="' + section + '"]');
			}

			function field(el, section, i, part) {
				return el.querySelector('[name="' + section + "[" + i + "]." + part + '"]');
			}

			function clone(id) {
				return document.getElementById(id).content.firstElementChild.cloneNode(true);
			}

			// steady says a Metric's baseline and target are equal numbers,
			// when only the Direction chosen tells which way it should move.
			function steady(values) {
				var b = String(values.baseline).trim();
				var t = String(values.target).trim();
				return b !== "" && t !== "" && Number(b) === Number(t);
			}

			// showDate writes an ISO date as the app does: "Nov 7", or
			// "Nov 7, 2027" outside the company's current year.
			function showDate(iso) {
				var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(iso);
				if (!m) return iso;
				var shown = months[Number(m[2]) - 1] + " " + Number(m[3]);
				return m[1] === year ? shown : shown + ", " + m[1];
			}

			function showNumber(n) {
				return n.trim() === "" || isNaN(Number(n)) ? n : String(Number(n));
			}

			function detail(section, values) {
				if (section === "milestones") return showDate(values.date);
				return showNumber(values.baseline) + " → " + showNumber(values.target) + " " + values.unit + " by " + showDate(values.target_date);
			}

			function hidden(name, value) {
				var input = document.createElement("input");
				input.type = "hidden";
				input.name = name;
				input.value = value;
				return input;
			}

			// item is a saved Milestone or Metric, holding its row's fields as
			// hidden inputs: a Metric's direction only when it is steady.
			function item(section, i, values) {
				var el = clone(section + "-item");
				el.section = section;
				el.index = i;
				el.values = values;
				el.querySelector('[data-testid="measure-item-name"]').textContent = values.name;
				el.querySelector('[data-testid="measure-item-detail"]').textContent = detail(section, values);
				parts[section].forEach(function (part) {
					if (part === "direction" && !steady(values)) return;
					el.appendChild(hidden(section + "[" + i + "]." + part, values[part]));
				});
				return el;
			}

			// openEditor is an editor for the i-th of section, filled with
			// values; restore is the item Cancel puts back, null for a new one.
			function openEditor(section, i, values, restore) {
				var el = clone(section + "-editor");
				el.section = section;
				el.index = i;
				el.restore = restore;
				if (restore) el.querySelector("[data-measure-heading]").textContent = "Edit " + noun[section];
				el.querySelectorAll("[name], [id]").forEach(function (input) {
					["name", "id"].forEach(function (a) {
						if (input.hasAttribute(a)) input.setAttribute(a, input.getAttribute(a).replace("__i__", String(i)));
					});
				});
				parts[section].forEach(function (part) {
					field(el, section, i, part).value = values[part] || "";
				});
				return el;
			}

			// showErrors moves why each of row's inputs was refused onto the
			// editor's input of the same name.
			function showErrors(row, editor, section, i) {
				parts[section].forEach(function (part) {
					var was = field(row, section, i, part);
					if (was.getAttribute("aria-invalid") !== "true") return;
					var input = field(editor, section, i, part);
					input.setAttribute("aria-invalid", "true");
					input.setAttribute("aria-describedby", was.getAttribute("aria-describedby"));
					var why = row.querySelector('[id="' + was.getAttribute("aria-describedby") + '"]');
					if (why) input.after(why);
				});
			}

			function editorValues(el) {
				var values = {};
				parts[el.section].forEach(function (part) {
					values[part] = field(el, el.section, el.index, part).value;
				});
				return values;
			}

			// ready says the server would take what el holds: a Milestone
			// with a Name and Date, a Metric with each of its fields, numbers
			// for its baseline and target, and a Direction when they're equal.
			function ready(el) {
				var v = editorValues(el);
				var filled = function (part) {
					return v[part].trim() !== "";
				};
				if (el.section === "milestones") return filled("name") && filled("date");
				var numbers = !isNaN(Number(v.baseline)) && !isNaN(Number(v.target));
				return ["name", "unit", "baseline", "target", "target_date"].every(filled) && numbers && (!steady(v) || filled("direction"));
			}

			function refresh() {
				var open = know.querySelectorAll("[data-measure-editor]");
				know.querySelectorAll("[data-add-row], [data-measure-edit]").forEach(function (b) {
					b.disabled = open.length > 0;
				});
				open.forEach(function (el, n) {
					if (n === 0) el.id = "gf-editor";
					else el.removeAttribute("id");
					if (el.section === "metrics") {
						var equal = steady(editorValues(el));
						var direction = el.querySelector("[data-direction]");
						direction.hidden = !equal;
						direction.querySelector("select").disabled = !equal;
					}
					el.querySelector("[data-measure-save]").disabled = !ready(el);
				});
				know.querySelectorAll("[data-measure-label]").forEach(function (label) {
					label.hidden = !rows(label.getAttribute("data-measure-label")).querySelector(".ie-item");
				});
			}

			// changed refreshes the editors and posts the form to the live
			// checklist, which listens for the form's changes.
			function changed() {
				refresh();
				know.dispatchEvent(new Event("change", { bubbles: true }));
			}

			// nextEditor is the open editor after el, in document order,
			// wrapping to the first; null when el is the only one.
			function nextEditor(el) {
				var open = Array.prototype.filter.call(know.querySelectorAll("[data-measure-editor]"), function (o) {
					return o !== el;
				});
				var after = open.filter(function (o) {
					return el.compareDocumentPosition(o) & Node.DOCUMENT_POSITION_FOLLOWING;
				});
				return after[0] || open[0] || null;
			}

			// settle hands focus to el's Edit, or to section's add button
			// when there is no item to edit; while another editor is open,
			// which disables both, to following's first field instead.
			function settle(el, section, following) {
				var edit = el && el.querySelector("[data-measure-edit]");
				var target = edit || addButton(section);
				if (target.disabled && following) target = following.querySelector("input:not([type=hidden])");
				target.focus();
			}

			know.addEventListener("input", refresh);
			know.addEventListener("change", refresh);
			know.addEventListener("keydown", function (e) {
				var el = e.target.closest("[data-measure-editor]");
				if (!el || e.key !== "Enter" || !e.target.matches("input, select")) return;
				e.preventDefault();
				var save = el.querySelector("[data-measure-save]");
				if (!save.disabled) save.click();
			});
			know.addEventListener("click", function (e) {
				var add = e.target.closest("[data-add-row]");
				if (add) {
					if (add.disabled) return;
					var section = add.getAttribute("data-add-row");
					var editor = openEditor(section, next[section]++, {}, null);
					editors.appendChild(editor);
					changed();
					editor.querySelector("input:not([type=hidden])").focus();
					return;
				}
				var el = e.target.closest("[data-measure-editor], .ie-item");
				if (!el || !e.target.closest("button")) return;
				var following = nextEditor(el);
				if (e.target.closest("[data-measure-save]")) {
					if (!ready(el)) return;
					var saved = item(el.section, el.index, editorValues(el));
					if (el.parentElement === editors) {
						el.remove();
						rows(el.section).appendChild(saved);
					} else {
						el.replaceWith(saved);
					}
					changed();
					settle(saved, el.section, following);
				} else if (e.target.closest("[data-measure-cancel]")) {
					if (el.restore) el.replaceWith(el.restore);
					else el.remove();
					changed();
					settle(el.restore, el.section, following);
				} else if (e.target.closest("[data-measure-edit]")) {
					var editing = openEditor(el.section, el.index, el.values, el);
					el.replaceWith(editing);
					changed();
					editing.querySelector("input:not([type=hidden])").focus();
				} else if (e.target.closest("[data-measure-remove]")) {
					el.remove();
					changed();
					settle(null, el.section, following);
				}
			});
		})();
	</script>
}

// goalFormMore is the "More detail" section: Contributes to and Where it fits,
// optional, each a one-line row that opens in place. A closed row's inputs
// still post, so it works without script.
templ goalFormMore(v goalFormView) {
	<section data-testid="goal-form-more" class="gf-section gf-more">
		<h2>More detail <span class="muted">optional, and editable later</span></h2>
		<details data-testid="goal-form-parents-row" class="gf-more-row" open?={ v.contributesOpen() }>
			@goalFormMoreSummary("Contributes to", v.contributesNames(), "none")
			@goalFormParents(v)
		</details>
		if len(v.Dimensions) > 0 || len(v.Fields) > 0 {
			<details data-testid="goal-form-fits-row" class="gf-more-row" open?={ v.fitsOpen() }>
				@goalFormMoreSummary("Where it fits", v.fitsNames(), "not set")
				@goalFormFits(v)
			</details>
		}
	</section>
}

// goalFormMoreSummary is a More detail row's one line: its name, what it
// holds, by name, or empty when it holds nothing, and Set or Change. It's
// written as the page renders, so it doesn't follow the picker.
templ goalFormMoreSummary(name string, names []string, empty string) {
	<summary>
		<span class="gf-more-name">{ name }</span>
		if len(names) == 0 {
			<span class="muted gf-more-value">{ "· " + empty }</span>
			<span class="gf-more-action">Set</span>
		} else {
			<span class="muted gf-more-value">{ "· " + strings.Join(names, ", ") }</span>
			<span class="gf-more-action">Change</span>
		}
	</summary>
}

// goalFormParents is the Contributes to field: the Goals this one is to
// contribute to, none or several. Each picked parent is a chip holding its
// parent_id. Script searches the Goals by title as it is typed, picking a
// result adds its chip and × removes one; without script, a multiple select
// offers every Goal not picked. The hint names each Owner who'll be asked to
// accept.
templ goalFormParents(v goalFormView) {
	<fieldset data-testid="goal-form-parents" class="gf-parents">
		<legend class="sr-only">Contributes to</legend>
		<p class="muted small">Optional: the Goals this one contributes to. Yours link at once.</p>
		if len(v.Linked) > 0 {
			<ul data-testid="linked-parents" class="gf-list">
				for _, p := range v.Linked {
					<li>
						<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", p.Goal.ID)) }>{ p.Goal.Title }</a>
						if p.Pending {
							<span class="badge lc">Pending</span>
							<span class="muted small">{ "waiting on " + p.Goal.Owner.Label() }</span>
						}
					</li>
				}
			</ul>
		}
		<ul data-testid="parent-chips" id="parent-chips" class="gf-chips">
			for _, p := range v.Parents {
				@parentChip(p, v.bad(domain.ParentInput(p.Goal.ID)))
			}
		</ul>
		<div class="gf-js-only gf-search">
			<input
				type="search"
				id="parent-search"
				name="q"
				placeholder="Search Goals by title"
				autocomplete="off"
				aria-label="Search Goals to contribute to"
				aria-controls="parent-results"
				hx-get={ v.searchURL() }
				hx-trigger="input changed delay:300ms, search"
				hx-target="#parent-results"
				hx-swap="innerHTML"
				hx-sync="this:replace"
				hx-include="#parent-chips [name='parent_id']"
			/>
			<ul data-testid="parent-results" id="parent-results" class="gf-results" aria-live="polite"></ul>
		</div>
		<label class="field gf-no-js">
			<span>Pick any to contribute to <span class="hint">— hold Ctrl or ⌘ for several</span></span>
			<select data-testid="parent-select" id={ inputParentID } name={ inputParentID } multiple>
				for _, c := range v.Candidates {
					<option value={ fmt.Sprint(c.ID) }>{ c.Title }</option>
				}
			</select>
		</label>
		@goalFormInputError(v, inputParentID)
		<p data-testid="parent-hint" class="muted small" hidden?={ len(v.asked()) == 0 }>
			if len(v.asked()) > 0 {
				{ "Each Owner is asked to accept: " + strings.Join(v.asked(), ", ") + "." }
			}
		</p>
	</fieldset>
	@goalFormParentsScript()
}

// parentChip is a picked parent: its hidden parent_id, its Health badge (its
// Lifecycle when it has no Health), its title, and the × that removes it, or
// without script its Remove checkbox, which leaves it out on submit. It
// carries the label of the Owner picking it asks, for script to rebuild the
// hint from.
templ parentChip(p parentChoice, bad string) {
	<li
		data-testid="parent-chip"
		id={ domain.ParentInput(p.Goal.ID) }
		class="gf-chip"
		if p.Asks != "" {
			data-asks={ p.Asks }
		}
	>
		<input type="hidden" name={ inputParentID } value={ fmt.Sprint(p.Goal.ID) }/>
		@parentBadge(p)
		<span class="gf-chip-title">{ p.Goal.Title }</span>
		<button type="button" class="btn quiet sm gf-js-only" data-remove-chip aria-label={ "Remove " + p.Goal.Title } title={ "Remove " + p.Goal.Title }>×</button>
		<label class="gf-no-js small"><input type="checkbox" name={ inputRemoveParent } value={ fmt.Sprint(p.Goal.ID) }/> Remove</label>
		if bad != "" {
			<span data-testid="input-error" id={ domain.ParentInput(p.Goal.ID) + "-error" } class="gf-input-error">{ bad }</span>
		}
	</li>
}

// goalSearchResults are the Contributes to search's matches, each a button
// that picks it beside the <template> of the chip picking it adds.
templ goalSearchResults(matches []parentChoice) {
	if len(matches) == 0 {
		<li data-testid="parent-no-results" class="muted small">No Goals match.</li>
	}
	for _, p := range matches {
		<li data-testid="parent-result">
			<button type="button" class="gf-result" data-pick>
				@parentBadge(p)
				<span>{ p.Goal.Title }</span>
				<span class="muted small">{ p.Goal.Owner.Label() }</span>
			</button>
			<template>
				@parentChip(p, "")
			</template>
		</li>
	}
}

// parentBadge is a parent's Health, as the Goal page's sidebar shows a linked
// Goal's, or its Lifecycle when it has none.
templ parentBadge(p parentChoice) {
	if p.Health != "" {
		<span class={ "badge", healthClass(p.Health) }><span class="dot"></span>{ p.Health }</span>
	} else {
		<span class="badge lc">{ p.Goal.Lifecycle }</span>
	}
}

// goalFormParentsScript turns the Contributes to field to search: it sets the
// no-script select aside, keeps Enter in the search from submitting, adds a
// result's chip when it is picked, removes a chip at its ×, and rebuilds the
// hint from the chips' Owners each time they change.
templ goalFormParentsScript() {
	<script>
		(function () {
			var field = document.querySelector('[data-testid="goal-form-parents"]');
			if (!field) return;
			var chips = field.querySelector("#parent-chips");
			var search = field.querySelector("#parent-search");
			var results = field.querySelector("#parent-results");
			var hint = field.querySelector('[data-testid="parent-hint"]');
			var select = field.querySelector('[data-testid="parent-select"]');
			select.disabled = true;
			function rebuildHint() {
				var names = [];
				chips.querySelectorAll("[data-asks]").forEach(function (chip) {
					var name = chip.getAttribute("data-asks");
					if (names.indexOf(name) < 0) names.push(name);
				});
				hint.textContent = names.length ? "Each Owner is asked to accept: " + names.join(", ") + "." : "";
				hint.hidden = names.length === 0;
			}
			search.addEventListener("keydown", function (e) {
				if (e.key === "Enter") e.preventDefault();
			});
			field.addEventListener("click", function (e) {
				var pick = e.target.closest("[data-pick]");
				if (pick) {
					var result = pick.closest("li");
					chips.appendChild(result.querySelector("template").content.firstElementChild.cloneNode(true));
					result.remove();
					rebuildHint();
					search.focus();
					return;
				}
				var remove = e.target.closest("[data-remove-chip]");
				if (remove) {
					remove.closest("[data-testid='parent-chip']").remove();
					rebuildHint();
					search.focus();
				}
			});
		})();
	</script>
}

// goalFormFits is the Where it fits field: each Dimension still offered,
// a select when a Goal takes one of its values and checkboxes when it takes
// several, with an input to add a value when it's Extendable, then an input of
// each Field's type. Nothing here is needed to save, though its note names
// what activation needs, as the checklist does. Arriving with parents, the
// values they suggest come ticked; only what is still ticked is assigned.
// More detail shows it only when there are Dimensions or Fields.
templ goalFormFits(v goalFormView) {
	<fieldset data-testid="goal-form-fits" class="gf-section">
		<legend class="sr-only">Where it fits</legend>
		<p data-testid="goal-form-fits-note" class="muted small">
			{ v.fitsRequiredNote() }
			if v.Suggested {
				Values from the Goals it contributes to come ticked; untick any that don't fit.
			}
		</p>
		for _, d := range v.Dimensions {
			@goalFormDimension(v, d)
		}
		for _, f := range v.Fields {
			@goalFormField(v, f)
		}
	</fieldset>
}

// fitsRequiredNote opens Where it fits' note: optional, when no Dimension or
// Field is required, or else the required ones, named as the checklist names
// them (activationFacts skips a Retired one), and the rest optional when any
// are left.
func (v goalFormView) fitsRequiredNote() string {
	required := v.activationFacts().Required
	if len(required) == 0 {
		return "Optional: the Goal's Dimension values and Fields."
	}
	note := "Required: a value in "
	for i, r := range required {
		switch {
		case i == 0:
		case i == len(required)-1:
			note += " and in "
		default:
			note += ", in "
		}
		note += r.Name
	}
	note += "."
	if len(required) < len(v.Dimensions)+len(v.Fields) {
		note += " The rest are optional."
	}
	return note
}

// goalFormDimension is one Dimension of Where it fits, each value chosen
// posting its value_id: a select, None at first, when a Goal takes one value,
// and a checkbox each when it takes several. A Retired value shows only when
// it was posted.
templ goalFormDimension(v goalFormView, d domain.Dimension) {
	if d.TakesSeveral() {
		<fieldset id={ dimensionInput(d) } class="gf-group">
			<legend>{ d.Name }</legend>
			<div class="gf-picks">
				for _, val := range v.choices(d) {
					<label class="gf-pick">
						<input
							type="checkbox"
							id={ domain.ValueInput(val.ID) }
							name={ inputValueID }
							value={ fmt.Sprint(val.ID) }
							checked?={ v.Chosen[val.ID] }
							{ invalid(v.bad(domain.ValueInput(val.ID)), domain.ValueInput(val.ID))... }
						/>
						<span>{ valueOptionLabel(val) }</span>
					</label>
				}
			</div>
			for _, val := range v.choices(d) {
				@goalFormInputError(v, domain.ValueInput(val.ID))
			}
			@goalFormNewValue(v, d)
		</fieldset>
	} else {
		<div class="gf-group">
			<label class="field">
				<span>{ d.Name }</span>
				<select id={ dimensionInput(d) } name={ inputValueID } { invalid(v.badSelect(d), dimensionInput(d))... }>
					<option value="">None</option>
					for _, val := range v.choices(d) {
						<option value={ fmt.Sprint(val.ID) } selected?={ v.Chosen[val.ID] }>{ valueOptionLabel(val) }</option>
					}
				</select>
				if bad := v.badSelect(d); bad != "" {
					<span data-testid="input-error" id={ dimensionInput(d) + "-error" } class="gf-input-error">{ bad }</span>
				}
			</label>
			@goalFormNewValue(v, d)
		</div>
	}
}

// goalFormNewValue is an Extendable Dimension's "add a value" input: the value
// typed is added to its list, when it's new, and given to the Goal
// (CONTEXT.md: Extendable).
templ goalFormNewValue(v goalFormView, d domain.Dimension) {
	if d.Extendable() {
		{{ input := domain.NewValueInput(d.ID) }}
		<label class="field">
			<span class="hint">Add a { d.Name } value</span>
			<input type="text" id={ input } name={ input } value={ v.NewValues[d.ID] } { invalid(v.bad(input), input)... }/>
			@goalFormInputError(v, input)
		</label>
	}
}

// goalFormField is one Field of Where it fits: an input of its type, as the
// Goal page's fieldInput renders it, named for the Field.
templ goalFormField(v goalFormView, f domain.Field) {
	{{ input := domain.FieldInput(f.ID) }}
	<label class="field">
		<span>
			{ f.Name }
			if f.Type == domain.FieldNumber && f.Unit != "" {
				<span class="hint">({ f.Unit })</span>
			}
		</span>
		switch f.Type {
			case domain.FieldNumber:
				<input type="number" step="any" id={ input } name={ input } value={ v.FieldValues[f.ID] } { invalid(v.bad(input), input)... }/>
			case domain.FieldLongText:
				<textarea id={ input } name={ input } { invalid(v.bad(input), input)... }>{ v.FieldValues[f.ID] }</textarea>
			case domain.FieldDate:
				<input type="date" id={ input } name={ input } value={ v.FieldValues[f.ID] } { invalid(v.bad(input), input)... }/>
			default:
				<input type="text" id={ input } name={ input } value={ v.FieldValues[f.ID] } { invalid(v.bad(input), input)... }/>
		}
		@goalFormInputError(v, input)
	</label>
}

// goalFormErrors heads a refused submit: nothing was created, and each
// problem, linked to its input.
templ goalFormErrors(v goalFormView) {
	if len(v.Problems) > 0 {
		<div data-testid="goal-form-errors" class="alert r gf-errors" role="alert">
			if v.Goal == nil {
				<strong>The Goal wasn't created.</strong>
			} else {
				<strong>The Goal wasn't saved.</strong>
			}
			<ul>
				for _, p := range v.summary() {
					<li>
						if p.Input != "" {
							<a href={ templ.SafeURL("#" + p.Input) }>{ p.Message }</a>
						} else {
							{ p.Message }
						}
					</li>
				}
			</ul>
		</div>
	}
}

// goalFormInputError is why the named input was refused, beside it.
templ goalFormInputError(v goalFormView, input string) {
	if bad := v.bad(input); bad != "" {
		<span data-testid="input-error" id={ input + "-error" } class="gf-input-error">{ bad }</span>
	}
}

// goalFormStyles are the New goal page's own rules on top of app.css.
templ goalFormStyles() {
	<style>
		.gf-form{display:grid;grid-template-columns:minmax(0,720px) 240px;gap:40px;justify-content:center;align-items:start}
		.gf-main{display:flex;flex-direction:column;min-width:0}
		.gf-main>section{padding:24px 0;border-top:1px solid var(--color-border)}
		.gf-main>section:first-of-type{padding-top:0;border-top:0}
		.gf-form>.gf-ready{position:sticky;top:24px;gap:12px;padding-left:24px;border-left:1px solid var(--color-border)}
		.gf-ready p{margin:0}
		.gf-progress{appearance:none;display:block;width:100%;height:6px;border:0;border-radius:999px;background:var(--color-chip-bg);overflow:hidden}
		.gf-progress::-webkit-progress-bar{background:var(--color-chip-bg)}
		.gf-progress::-webkit-progress-value{background:var(--color-ink-muted)}
		.gf-progress::-moz-progress-bar{background:var(--color-ink-muted)}
		.gf-checklist{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
		.gf-check{position:relative;display:flex;gap:12px;align-items:flex-start}
		.gf-mark{flex:none;box-sizing:border-box;width:18px;height:18px;margin-top:4px;border:2px solid var(--color-border-strong);border-radius:50%;color:transparent;font-size:11px;font-weight:700;line-height:14px;text-align:center}
		.gf-check.done .gf-mark{border-color:var(--health-g-ink);background:var(--health-g-ink);color:var(--color-surface)}
		.gf-cancel{align-self:flex-start}
		@media (max-width:960px){
			.gf-form{grid-template-columns:minmax(0,720px);gap:0}
			.gf-form>.gf-ready{position:static;padding:24px 0 0;border-left:0;border-top:1px solid var(--color-border)}
		}
		.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;padding:0;border:0}
		.gf-errors{flex-direction:column;align-items:flex-start;gap:4px}
		.gf-errors ul{margin:0;padding-left:20px}
		.gf-errors a{color:inherit}
		.gf-input-error{display:block;font-size:13px;color:var(--color-danger-ink)}
		.gf-actions{display:flex;flex-direction:column;gap:8px}
		.gf-activate{order:-1}
		.gf-section{display:flex;flex-direction:column;gap:16px;border:0;padding:0;margin:0;min-width:0}
		.gf-head-line{display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:4px 16px}
		.gf-page-line{margin:0;font-size:13px;line-height:1.5;color:var(--color-ink-muted)}
		.gf-what .gf-title{font-weight:600;font-size:28px;line-height:1.2;letter-spacing:-0.02em;height:auto;padding:4px 0;border:0;border-bottom:1px solid var(--color-border-strong);border-radius:0;background:transparent}
		.gf-what .gf-title[aria-invalid=true]{border-bottom-color:var(--color-danger-ink)}
		.gf-delivery{gap:24px}
		.gf-group{display:flex;flex-direction:column;gap:8px;border:0;padding:0;margin:0;min-width:0}
		.gf-group>legend{font-weight:600;font-size:13px;padding:0;margin-bottom:8px}
		.gf-segments{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:start}
		.gf-tile{display:flex;flex-direction:column;min-width:0;border:1px solid var(--color-border);border-radius:var(--radius-md)}
		.gf-segment{position:relative;display:flex;align-items:flex-start;gap:8px;padding:12px 16px;cursor:pointer}
		.gf-segment .hint{display:block}
		.gf-tile .gf-date{padding:0 16px 16px 40px}
		.gf-picks{display:flex;flex-wrap:wrap;gap:8px}
		.gf-pick{position:relative;display:inline-flex;align-items:center;gap:8px;padding:4px 12px;border:1px solid var(--color-border);border-radius:999px;cursor:pointer}
		.gf-segctl{display:inline-flex;flex-wrap:wrap;align-self:flex-start;gap:4px;padding:4px;background:var(--color-chip-bg);border-radius:var(--radius-md)}
		.gf-seg{position:relative;display:flex;align-items:center;justify-content:center;gap:8px;min-height:22px;padding:0 12px;box-sizing:border-box;border:1px solid transparent;border-radius:var(--radius-sm);font-size:13px;font-weight:500;color:var(--color-ink-2);cursor:pointer;white-space:nowrap}
		.gf-delivery:not(:has(#kind-dated:checked)) .gf-date{display:none}
		.gf-cadence:not(:has(#cadence-custom:checked)) .gf-custom{display:none}
		.gf-custom input{max-width:160px}
		@supports selector(:has(*)){
			.gf-seg input,.gf-segment input,.gf-pick input{position:absolute;opacity:0;pointer-events:none}
			.gf-form:has(#kind-ongoing:checked) .gf-rule-any{display:none}
			.gf-form:has(#kind-ongoing:checked) .gf-rule-ongoing{display:inline}
			.gf-seg:has(input:checked){background:var(--color-canvas);border-color:var(--color-border-strong);color:var(--color-ink);font-weight:600}
			.gf-pick:has(input:checked){border-color:var(--color-primary);background:var(--color-primary-subtle)}
			.gf-tile{border:2px solid var(--color-border-strong)}
			.gf-tile:has(input:checked){border-color:var(--color-primary);background:var(--color-primary-subtle)}
			.gf-segment::before{content:"";flex:none;box-sizing:border-box;width:16px;height:16px;margin-top:4px;border:2px solid var(--color-border-strong);border-radius:50%}
			.gf-segment:has(input:checked)::before{border-color:var(--color-primary);background:radial-gradient(circle,var(--color-primary) 0 4px,transparent 4.5px)}
			.gf-tile:has(.gf-segment input:focus-visible),.gf-seg:has(input:focus-visible),label.gf-pick:has(input:focus-visible){outline:2px solid var(--color-focus);outline-offset:2px}
		}
		@media (max-width:600px){
			.gf-segments{grid-template-columns:minmax(0,1fr)}
			.gf-segctl{display:grid;grid-template-columns:1fr 1fr;align-self:stretch}
			.gf-seg{white-space:normal;text-align:center}
		}
		@media (pointer:coarse){.gf-seg{min-height:36px}}
		.gf-list{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:4px}
		.gf-existing{display:flex;flex-direction:column;gap:4px}
		.gf-know{display:flex;flex-direction:column;gap:12px;min-width:0}
		.gf-know-head{margin:4px 0 0;font-family:var(--font-body)}
		.gf-rule-ongoing{display:none}
		.gf-rows{display:flex;flex-direction:column;gap:12px}
		.gf-row{display:flex;flex-wrap:wrap;align-items:flex-start;gap:8px 12px}
		.gf-row .field{flex:1 1 140px;min-width:0}
		.gf-row .field input,.gf-row .field select{width:100%}
		.gf-form:not(.gf-js) .gf-js-only{display:none}
		.gf-rows:empty{display:none}
		.gf-measure-add{display:flex;flex-wrap:wrap;gap:8px}
		.gf-milestone-fields,.gf-metric-fields{display:grid;gap:8px 12px}
		.gf-milestone-fields{grid-template-columns:minmax(0,2fr) minmax(0,1fr)}
		.gf-metric-fields{grid-template-columns:repeat(2,minmax(0,1fr))}
		.gf-milestone-fields .field input,.gf-metric-fields .field input,.gf-metric-fields .field select{width:100%}
		@media (max-width:600px){
			.gf-milestone-fields,.gf-metric-fields{grid-template-columns:minmax(0,1fr)}
		}
		.gf-form.gf-js .gf-no-js{display:none}
		.gf-more{gap:0}
		.gf-more>h2{margin-bottom:8px}
		.gf-more>h2 .muted{margin-left:4px;font-weight:400}
		.gf-more-row+.gf-more-row{border-top:1px solid var(--color-border)}
		.gf-more-row>summary{min-height:48px;justify-content:flex-start;gap:4px;list-style:none}
		.gf-more-row>summary::-webkit-details-marker{display:none}
		.gf-more-name{flex:none;font-weight:600;color:var(--color-ink)}
		.gf-more-value{min-width:0;overflow-wrap:anywhere}
		.gf-more-action{flex:none;margin-left:auto;font-weight:600;color:var(--color-primary-strong)}
		.gf-more-row>fieldset{padding-bottom:16px}
		.gf-parents{display:flex;flex-direction:column;gap:8px;border:0;padding:0;margin:0;min-width:0}
		.gf-chips{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0;padding:0}
		.gf-chips:empty{display:none}
		.gf-chip{display:inline-flex;align-items:center;gap:8px;padding:4px 4px 4px 12px;border:1px solid var(--color-border);border-radius:999px}
		.gf-chip .gf-input-error{flex-basis:100%}
		.gf-search input{width:100%}
		.gf-results{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
		.gf-results:empty{display:none}
		.gf-result{display:flex;align-items:center;gap:8px;width:100%;text-align:left;background:none;border:0;padding:8px;border-radius:6px;cursor:pointer;color:inherit;font:inherit}
		.gf-result:hover,.gf-result:focus-visible{background:var(--color-surface-hover)}
		.gf-parents select[multiple]{width:100%;min-height:8em}
	</style>
}
