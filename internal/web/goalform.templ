package web

import (
	"fmt"
	"strings"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// goalFormPage is the New goal page: a plain form that creates a Goal, Proposed
// or activated at once, and lands on it, so it works without script. Beside it
// the Ready to activate card holds the submit buttons; script posts the form
// to /goals/new/checklist as it changes and swaps the card for the one that
// comes back. A refused submit comes back with what was typed, a summary of
// every problem first, and each bad input marked with why.
templ goalFormPage(current *domain.Account, v goalFormView) {
	@layout("New goal", current) {
		@goalFormStyles()
		<header data-testid="goal-form-head" class="page-head">
			<div>
				<h1>New goal</h1>
				<p class="muted">Say what the Goal is and why it matters.</p>
			</div>
		</header>
		<form
			data-testid="goal-form"
			class="gf-form"
			method="post"
			action="/goals/new"
			hx-post="/goals/new/checklist"
			hx-trigger="load, change, input delay:400ms"
			hx-target={ "#" + goalFormReadyID }
			hx-swap="outerHTML"
			hx-sync="this:replace"
		>
			<div class="card gf-main">
				@goalFormErrors(v)
				@goalFormWhat(v)
				@goalFormDelivery(v)
				@goalFormKnow(v)
				@goalFormParents(v)
				@goalFormFits(v)
			</div>
			@goalFormReady(v)
		</form>
	}
}

// goalFormReadyID is the Ready to activate card's id, which the form's live
// checklist swaps.
const goalFormReadyID = "goal-form-ready"

// goalFormReady is the Ready to activate card, sticky beside the form: how
// many of the activation checklist's items the form meets, as a bar and "n of
// m", each item done or missing, and the submit buttons. Create and activate
// posts activate=1 and is disabled while the live checklist is incomplete;
// Save as Proposed needs only a Title and So What.
templ goalFormReady(v goalFormView) {
	{{ done, of := v.readyCount() }}
	<aside data-testid="goal-form-ready" id={ goalFormReadyID } class="card gf-ready" aria-labelledby="goal-form-ready-head">
		<h2 id="goal-form-ready-head" class="gf-ready-head">Ready to activate</h2>
		<progress class="gf-progress" value={ fmt.Sprint(done) } max={ fmt.Sprint(of) } aria-labelledby="goal-form-ready-head"></progress>
		<p data-testid="goal-form-ready-count" class="muted small">{ fmt.Sprintf("%d of %d", done, of) }</p>
		<ul data-testid="activation-checklist" class="gf-checklist">
			for _, item := range v.activationFacts().checklist() {
				if item.Done {
					<li data-done="true" class="gf-check done"><span aria-hidden="true">✓</span> <span>{ item.Label }</span> <span class="muted small">done</span></li>
				} else {
					<li data-done="false" class="gf-check"><span aria-hidden="true">✗</span> <span>{ item.Label }</span> <span class="muted small">missing</span></li>
				}
			}
		</ul>
		<div class="gf-actions">
			<button type="submit" id={ domain.InputActivate } name={ domain.InputActivate } value="1" class="btn primary" disabled?={ v.activateDisabled() }>Create and activate</button>
			<button type="submit" class="btn">Save as Proposed</button>
		</div>
		<p class="muted small">Only Title and So What are needed to save.</p>
		<a class="small gf-cancel" href="/goals">Cancel</a>
	</aside>
}

// goalFormWhat is the "What and why" section: the Goal's Title, focused, and
// its So What.
templ goalFormWhat(v goalFormView) {
	<fieldset data-testid="goal-form-what" class="gf-section">
		<legend>What and why</legend>
		<label class="field">
			<span>Title</span>
			<input
				type="text"
				id={ domain.InputTitle }
				name={ domain.InputTitle }
				value={ v.Title }
				required
				autofocus
				if v.bad(domain.InputTitle) != "" {
					aria-invalid="true"
					aria-describedby={ domain.InputTitle + "-error" }
				}
			/>
			@goalFormInputError(v, domain.InputTitle)
		</label>
		<label class="field">
			<span>So What <span class="hint gf-hint">The customer problem, and what changes when this succeeds.</span></span>
			<textarea
				id={ domain.InputSoWhat }
				name={ domain.InputSoWhat }
				required
				if v.bad(domain.InputSoWhat) != "" {
					aria-invalid="true"
					aria-describedby={ domain.InputSoWhat + "-error" }
				}
			>{ v.SoWhat }</textarea>
			@goalFormInputError(v, domain.InputSoWhat)
		</label>
	</fieldset>
}

// goalFormDelivery is the "Delivery" section: the Kind, neither chosen at
// first, the delivery date a Dated Goal needs, and the Check-in cadence,
// Weekly at first. The delivery date shows once Dated is chosen and Custom's
// days once Custom is, by CSS :has, so a browser without it shows both always.
templ goalFormDelivery(v goalFormView) {
	<fieldset data-testid="goal-form-delivery" class="gf-section gf-delivery">
		<legend>Delivery</legend>
		<fieldset id={ domain.InputKind } class="gf-group">
			<legend>Kind</legend>
			<div class="gf-segments">
				@kindChoice(v, domain.GoalDated, "Has a delivery date; its Health is judged against that date and its Milestones.")
				@kindChoice(v, domain.GoalOngoing, "Has no delivery date; its Health is judged against its Metrics' targets.")
			</div>
			@goalFormInputError(v, domain.InputKind)
		</fieldset>
		<label class="field gf-date">
			<span>Delivery date</span>
			<input
				type="date"
				id={ domain.InputDeliveryDate }
				name={ domain.InputDeliveryDate }
				value={ v.DeliveryDate }
				if v.bad(domain.InputDeliveryDate) != "" {
					aria-invalid="true"
					aria-describedby={ domain.InputDeliveryDate + "-error" }
				}
			/>
			@goalFormInputError(v, domain.InputDeliveryDate)
		</label>
		<fieldset class="gf-group gf-cadence">
			<legend>Check-in cadence</legend>
			<div class="gf-picks">
				for _, c := range cadenceChips {
					<label class="gf-pick">
						<input type="radio" id={ "cadence-" + c.Value } name={ domain.InputCadence } value={ c.Value } checked?={ v.cadenceChosen() == c.Value }/>
						<span>{ c.Label }</span>
					</label>
				}
			</div>
			<label class="field gf-custom">
				<span>Days between Check-ins</span>
				<input
					type="number"
					id={ domain.InputCadence }
					name={ inputCadenceDays }
					value={ v.customDays() }
					min="1"
					step="1"
					inputmode="numeric"
					if v.bad(domain.InputCadence) != "" {
						aria-invalid="true"
						aria-describedby={ domain.InputCadence + "-error" }
					}
				/>
				@goalFormInputError(v, domain.InputCadence)
			</label>
		</fieldset>
	</fieldset>
}

// kindChoice is one segment of the Kind group: the Kind and what it means.
templ kindChoice(v goalFormView, kind, means string) {
	<label class="gf-pick gf-segment">
		<input
			type="radio"
			id={ "kind-" + strings.ToLower(kind) }
			name={ domain.InputKind }
			value={ kind }
			checked?={ v.Kind == kind }
			if v.bad(domain.InputKind) != "" {
				aria-invalid="true"
				aria-describedby={ domain.InputKind + "-error" }
			}
		/>
		<span><strong>{ kind }</strong> <span class="hint">{ means }</span></span>
	</label>
}

// goalFormKnow is the "How you'll know" section: the Goal's Milestones and
// Metrics, a row each. Without script it shows the rows typed, or one blank
// row of each; script adds a row from its <template> and removes one with ×,
// and shows a Metric's Direction only while its target equals its baseline.
templ goalFormKnow(v goalFormView) {
	<fieldset data-testid="goal-form-know" class="gf-know">
		<legend>How you'll know</legend>
		<p class="muted small">Milestones and Metrics are optional; a row left blank is ignored.</p>
		<h2 class="gf-know-head">Milestones</h2>
		<div data-testid="milestone-rows" class="gf-rows" data-rows="milestones">
			for i, m := range v.milestoneRows() {
				@milestoneRowFields(v, rowNames(domain.MilestoneInput, i), m)
			}
		</div>
		<template id="milestones-row">
			@milestoneRowFields(goalFormView{}, templateRowNames("milestones"), milestoneRow{})
		</template>
		<button type="button" class="btn quiet sm gf-js-only" data-add-row="milestones">+ Milestone</button>
		<h2 class="gf-know-head">Metrics</h2>
		<div data-testid="metric-rows" class="gf-rows" data-rows="metrics">
			for i, m := range v.metricRows() {
				@metricRowFields(v, rowNames(domain.MetricInput, i), m)
			}
		</div>
		<template id="metrics-row">
			@metricRowFields(goalFormView{}, templateRowNames("metrics"), metricRow{})
		</template>
		<button type="button" class="btn quiet sm gf-js-only" data-add-row="metrics">+ Metric</button>
	</fieldset>
	@goalFormRowsScript()
}

// milestoneRowFields is one Milestone row: Name and Date.
templ milestoneRowFields(v goalFormView, name func(part string) string, m milestoneRow) {
	<div data-testid="milestone-row" class="gf-row">
		@goalFormRowInput(v, "Name", "text", name("name"), m.Name)
		@goalFormRowInput(v, "Date", "date", name("date"), m.Date)
		@goalFormRemoveRow("Remove this Milestone")
	</div>
}

// metricRowFields is one Metric row: Name, Unit, Baseline, Target, Target
// date, and the Direction select that counts only when the target equals the
// baseline.
templ metricRowFields(v goalFormView, name func(part string) string, m metricRow) {
	<div data-testid="metric-row" class="gf-row" data-metric-row>
		@goalFormRowInput(v, "Name", "text", name("name"), m.Name)
		@goalFormRowInput(v, "Unit", "text", name("unit"), m.Unit)
		@goalFormRowInput(v, "Baseline", "number", name("baseline"), m.Baseline)
		@goalFormRowInput(v, "Target", "number", name("target"), m.Target)
		<label class="field" data-direction>
			<span>Direction <span class="hint">— when target equals baseline</span></span>
			<select
				id={ name("direction") }
				name={ name("direction") }
				if v.bad(name("direction")) != "" {
					aria-invalid="true"
					aria-describedby={ name("direction") + "-error" }
				}
			>
				<option value="" selected?={ m.Direction == "" }>Choose…</option>
				<option value={ domain.MetricUp } selected?={ m.Direction == domain.MetricUp }>up</option>
				<option value={ domain.MetricDown } selected?={ m.Direction == domain.MetricDown }>down</option>
			</select>
			@goalFormInputError(v, name("direction"))
		</label>
		@goalFormRowInput(v, "Target date", "date", name("target_date"), m.TargetDate)
		@goalFormRemoveRow("Remove this Metric")
	</div>
}

// goalFormRowInput is one input of a row, marked with why it was refused.
templ goalFormRowInput(v goalFormView, label, kind, input, value string) {
	<label class="field">
		<span>{ label }</span>
		<input
			if kind == "number" {
				type="number"
				step="any"
			} else {
				type={ kind }
			}
			id={ input }
			name={ input }
			value={ value }
			if v.bad(input) != "" {
				aria-invalid="true"
				aria-describedby={ input + "-error" }
			}
		/>
		@goalFormInputError(v, input)
	</label>
}

// goalFormRemoveRow is a row's ×, which only script can act on.
templ goalFormRemoveRow(label string) {
	<button type="button" class="btn quiet sm gf-js-only gf-remove" data-remove-row aria-label={ label } title={ label }>×</button>
}

// goalFormRowsScript adds a row by cloning its section's <template>, numbering
// its inputs past the rows already there, removes the row whose × is pressed,
// handing focus to its section's add button, and shows a Metric row's Direction only while its baseline and target are
// equal, leaving it out of the post otherwise.
templ goalFormRowsScript() {
	<script>
		(function () {
			var form = document.querySelector('[data-testid="goal-form"]');
			if (!form) return;
			form.classList.add("gf-js");
			var next = {};
			form.querySelectorAll("[data-rows]").forEach(function (list) {
				next[list.getAttribute("data-rows")] = list.children.length;
			});
			function steady(row) {
				var b = row.querySelector('[name$=".baseline"]').value;
				var t = row.querySelector('[name$=".target"]').value;
				var equal = b !== "" && t !== "" && Number(b) === Number(t);
				var direction = row.querySelector("[data-direction]");
				direction.hidden = !equal;
				direction.querySelector("select").disabled = !equal;
			}
			form.querySelectorAll("[data-metric-row]").forEach(steady);
			form.addEventListener("input", function (e) {
				var row = e.target.closest("[data-metric-row]");
				if (row) steady(row);
			});
			form.addEventListener("click", function (e) {
				var add = e.target.closest("[data-add-row]");
				if (add) {
					var section = add.getAttribute("data-add-row");
					var row = document.getElementById(section + "-row").content.firstElementChild.cloneNode(true);
					var i = String(next[section]++);
					row.querySelectorAll("[name], [id]").forEach(function (el) {
						["name", "id"].forEach(function (a) {
							if (el.hasAttribute(a)) el.setAttribute(a, el.getAttribute(a).replace("__i__", i));
						});
					});
					form.querySelector('[data-rows="' + section + '"]').appendChild(row);
					if (row.hasAttribute("data-metric-row")) steady(row);
					row.querySelector("input").focus();
					return;
				}
				var remove = e.target.closest("[data-remove-row]");
				if (remove) {
					var gone = remove.closest(".gf-row");
					var section = gone.parentElement.getAttribute("data-rows");
					gone.remove();
					form.querySelector('[data-add-row="' + section + '"]').focus();
				}
			});
		})();
	</script>
}

// goalFormParents is the Contributes to field: the Goals this one is to
// contribute to, none or several. Each picked parent is a chip holding its
// parent_id. Script searches the Goals by title as it is typed, picking a
// result adds its chip and × removes one; without script, a multiple select
// offers every Goal not picked. The hint names each Owner who'll be asked to
// accept.
templ goalFormParents(v goalFormView) {
	<fieldset data-testid="goal-form-parents" class="gf-parents">
		<legend>Contributes to</legend>
		<p class="muted small">Optional: the Goals this one contributes to. Yours link at once.</p>
		<ul data-testid="parent-chips" id="parent-chips" class="gf-chips">
			for _, p := range v.Parents {
				@parentChip(p, v.bad(domain.ParentInput(p.Goal.ID)))
			}
		</ul>
		<div class="gf-js-only gf-search">
			<input
				type="search"
				id="parent-search"
				name="q"
				placeholder="Search Goals by title"
				autocomplete="off"
				aria-label="Search Goals to contribute to"
				aria-controls="parent-results"
				hx-get="/goals/search"
				hx-trigger="input changed delay:300ms, search"
				hx-target="#parent-results"
				hx-include="#parent-chips [name='parent_id']"
			/>
			<ul data-testid="parent-results" id="parent-results" class="gf-results" aria-live="polite"></ul>
		</div>
		<label class="field gf-no-js">
			<span>Pick any to contribute to <span class="hint">— hold Ctrl or ⌘ for several</span></span>
			<select data-testid="parent-select" id={ inputParentID } name={ inputParentID } multiple>
				for _, c := range v.Candidates {
					<option value={ fmt.Sprint(c.ID) }>{ c.Title }</option>
				}
			</select>
		</label>
		@goalFormInputError(v, inputParentID)
		<p data-testid="parent-hint" class="muted small" hidden?={ len(v.asked()) == 0 }>
			if len(v.asked()) > 0 {
				{ "Each Owner is asked to accept: " + strings.Join(v.asked(), ", ") + "." }
			}
		</p>
	</fieldset>
	@goalFormParentsScript()
}

// parentChip is a picked parent: its hidden parent_id, its Health badge (its
// Lifecycle when it has no Health), its title, and the × that removes it. It
// carries the label of the Owner picking it asks, for script to rebuild the
// hint from.
templ parentChip(p parentChoice, bad string) {
	<li
		data-testid="parent-chip"
		id={ domain.ParentInput(p.Goal.ID) }
		class="gf-chip"
		if p.Asks != "" {
			data-asks={ p.Asks }
		}
	>
		<input type="hidden" name={ inputParentID } value={ fmt.Sprint(p.Goal.ID) }/>
		@parentBadge(p)
		<span class="gf-chip-title">{ p.Goal.Title }</span>
		<button type="button" class="btn quiet sm gf-js-only" data-remove-chip aria-label={ "Remove " + p.Goal.Title } title={ "Remove " + p.Goal.Title }>×</button>
		if bad != "" {
			<span data-testid="input-error" id={ domain.ParentInput(p.Goal.ID) + "-error" } class="gf-input-error">{ bad }</span>
		}
	</li>
}

// goalSearchResults are the Contributes to search's matches, each a button
// that picks it beside the <template> of the chip picking it adds.
templ goalSearchResults(matches []parentChoice) {
	if len(matches) == 0 {
		<li data-testid="parent-no-results" class="muted small">No Goals match.</li>
	}
	for _, p := range matches {
		<li data-testid="parent-result">
			<button type="button" class="gf-result" data-pick>
				@parentBadge(p)
				<span>{ p.Goal.Title }</span>
				<span class="muted small">{ p.Goal.Owner.Label() }</span>
			</button>
			<template>
				@parentChip(p, "")
			</template>
		</li>
	}
}

// parentBadge is a parent's Health, as the Goal page's sidebar shows a linked
// Goal's, or its Lifecycle when it has none.
templ parentBadge(p parentChoice) {
	if p.Health != "" {
		<span class={ "badge", healthClass(p.Health) }><span class="dot"></span>{ p.Health }</span>
	} else {
		<span class="badge lc">{ p.Goal.Lifecycle }</span>
	}
}

// goalFormParentsScript turns the Contributes to field to search: it sets the
// no-script select aside, keeps Enter in the search from submitting, adds a
// result's chip when it is picked, removes a chip at its ×, and rebuilds the
// hint from the chips' Owners each time they change.
templ goalFormParentsScript() {
	<script>
		(function () {
			var field = document.querySelector('[data-testid="goal-form-parents"]');
			if (!field) return;
			var chips = field.querySelector("#parent-chips");
			var search = field.querySelector("#parent-search");
			var results = field.querySelector("#parent-results");
			var hint = field.querySelector('[data-testid="parent-hint"]');
			var select = field.querySelector('[data-testid="parent-select"]');
			select.disabled = true;
			function rebuildHint() {
				var names = [];
				chips.querySelectorAll("[data-asks]").forEach(function (chip) {
					var name = chip.getAttribute("data-asks");
					if (names.indexOf(name) < 0) names.push(name);
				});
				hint.textContent = names.length ? "Each Owner is asked to accept: " + names.join(", ") + "." : "";
				hint.hidden = names.length === 0;
			}
			search.addEventListener("keydown", function (e) {
				if (e.key === "Enter") e.preventDefault();
			});
			field.addEventListener("click", function (e) {
				var pick = e.target.closest("[data-pick]");
				if (pick) {
					var result = pick.closest("li");
					chips.appendChild(result.querySelector("template").content.firstElementChild.cloneNode(true));
					result.remove();
					rebuildHint();
					search.focus();
					return;
				}
				var remove = e.target.closest("[data-remove-chip]");
				if (remove) {
					remove.closest("[data-testid='parent-chip']").remove();
					rebuildHint();
					search.focus();
				}
			});
		})();
	</script>
}

// goalFormFits is the "Where it fits" section: each Dimension still offered,
// a select when a Goal takes one of its values and checkboxes when it takes
// several, with an input to add a value when it's Extendable, then an input of
// each Field's type. Nothing here is needed to save. Arriving with parents, the
// values they suggest come ticked; only what is still ticked is assigned.
templ goalFormFits(v goalFormView) {
	if len(v.Dimensions) > 0 || len(v.Fields) > 0 {
		<fieldset data-testid="goal-form-fits" class="gf-section">
			<legend>Where it fits</legend>
			<p class="muted small">
				Optional: the Goal's Dimension values and Fields.
				if v.Suggested {
					Values from the Goals it contributes to come ticked; untick any that don't fit.
				}
			</p>
			for _, d := range v.Dimensions {
				@goalFormDimension(v, d)
			}
			for _, f := range v.Fields {
				@goalFormField(v, f)
			}
		</fieldset>
	}
}

// goalFormDimension is one Dimension of Where it fits, each value chosen
// posting its value_id: a select, None at first, when a Goal takes one value,
// and a checkbox each when it takes several. A Retired value shows only when
// it was posted.
templ goalFormDimension(v goalFormView, d domain.Dimension) {
	if d.TakesSeveral() {
		<fieldset id={ dimensionInput(d) } class="gf-group">
			<legend>{ d.Name }</legend>
			<div class="gf-picks">
				for _, val := range v.choices(d) {
					<label class="gf-pick">
						<input
							type="checkbox"
							id={ domain.ValueInput(val.ID) }
							name={ inputValueID }
							value={ fmt.Sprint(val.ID) }
							checked?={ v.Chosen[val.ID] }
							{ invalid(v.bad(domain.ValueInput(val.ID)), domain.ValueInput(val.ID))... }
						/>
						<span>{ valueOptionLabel(val) }</span>
					</label>
				}
			</div>
			for _, val := range v.choices(d) {
				@goalFormInputError(v, domain.ValueInput(val.ID))
			}
			@goalFormNewValue(v, d)
		</fieldset>
	} else {
		<div class="gf-group">
			<label class="field">
				<span>{ d.Name }</span>
				<select id={ dimensionInput(d) } name={ inputValueID } { invalid(v.badSelect(d), dimensionInput(d))... }>
					<option value="">None</option>
					for _, val := range v.choices(d) {
						<option value={ fmt.Sprint(val.ID) } selected?={ v.Chosen[val.ID] }>{ valueOptionLabel(val) }</option>
					}
				</select>
				if bad := v.badSelect(d); bad != "" {
					<span data-testid="input-error" id={ dimensionInput(d) + "-error" } class="gf-input-error">{ bad }</span>
				}
			</label>
			@goalFormNewValue(v, d)
		</div>
	}
}

// goalFormNewValue is an Extendable Dimension's "add a value" input: the value
// typed is added to its list, when it's new, and given to the Goal
// (CONTEXT.md: Extendable).
templ goalFormNewValue(v goalFormView, d domain.Dimension) {
	if d.Extendable() {
		{{ input := domain.NewValueInput(d.ID) }}
		<label class="field">
			<span class="hint">Add a { d.Name } value</span>
			<input type="text" id={ input } name={ input } value={ v.NewValues[d.ID] } { invalid(v.bad(input), input)... }/>
			@goalFormInputError(v, input)
		</label>
	}
}

// goalFormField is one Field of Where it fits: an input of its type, as the
// Goal page's fieldInput renders it, named for the Field.
templ goalFormField(v goalFormView, f domain.Field) {
	{{ input := domain.FieldInput(f.ID) }}
	<label class="field">
		<span>
			{ f.Name }
			if f.Type == domain.FieldNumber && f.Unit != "" {
				<span class="hint">({ f.Unit })</span>
			}
		</span>
		switch f.Type {
			case domain.FieldNumber:
				<input type="number" step="any" id={ input } name={ input } value={ v.FieldValues[f.ID] } { invalid(v.bad(input), input)... }/>
			case domain.FieldLongText:
				<textarea id={ input } name={ input } { invalid(v.bad(input), input)... }>{ v.FieldValues[f.ID] }</textarea>
			case domain.FieldDate:
				<input type="date" id={ input } name={ input } value={ v.FieldValues[f.ID] } { invalid(v.bad(input), input)... }/>
			default:
				<input type="text" id={ input } name={ input } value={ v.FieldValues[f.ID] } { invalid(v.bad(input), input)... }/>
		}
		@goalFormInputError(v, input)
	</label>
}

// goalFormErrors heads a refused submit: nothing was created, and each
// problem, linked to its input.
templ goalFormErrors(v goalFormView) {
	if len(v.Problems) > 0 {
		<div data-testid="goal-form-errors" class="alert r gf-errors" role="alert">
			<strong>The Goal wasn't created.</strong>
			<ul>
				for _, p := range v.summary() {
					<li>
						if p.Input != "" {
							<a href={ templ.SafeURL("#" + p.Input) }>{ p.Message }</a>
						} else {
							{ p.Message }
						}
					</li>
				}
			</ul>
		</div>
	}
}

// goalFormInputError is why the named input was refused, beside it.
templ goalFormInputError(v goalFormView, input string) {
	if bad := v.bad(input); bad != "" {
		<span data-testid="input-error" id={ input + "-error" } class="gf-input-error">{ bad }</span>
	}
}

// goalFormStyles are the New goal page's own rules on top of app.css.
templ goalFormStyles() {
	<style>
		.gf-form{display:grid;grid-template-columns:minmax(0,640px) 280px;gap:24px;align-items:start}
		.gf-main{display:flex;flex-direction:column;gap:16px;min-width:0}
		.gf-ready{position:sticky;top:24px;display:flex;flex-direction:column;gap:12px}
		.gf-ready p{margin:0}
		.gf-ready-head{font-size:16px;margin:0}
		.gf-progress{appearance:none;display:block;width:100%;height:8px;border:0;border-radius:999px;background:var(--color-surface-alt);overflow:hidden}
		.gf-progress::-webkit-progress-bar{background:var(--color-surface-alt)}
		.gf-progress::-webkit-progress-value{background:var(--color-ink-muted)}
		.gf-progress::-moz-progress-bar{background:var(--color-ink-muted)}
		.gf-checklist{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:8px}
		.gf-check{display:flex;gap:8px;align-items:baseline}
		.gf-check>span:first-child{width:16px;font-weight:600;color:var(--health-r-ink)}
		.gf-check.done>span:first-child{color:var(--health-g-ink)}
		.gf-check .muted{margin-left:auto}
		.gf-cancel{align-self:flex-start}
		@media (max-width:960px){
			.gf-form{grid-template-columns:minmax(0,1fr)}
			.gf-ready{position:static}
		}
		.gf-errors{flex-direction:column;align-items:flex-start;gap:4px}
		.gf-errors ul{margin:0;padding-left:20px}
		.gf-errors a{color:inherit}
		.gf-input-error{display:block;font-size:13px;color:var(--color-danger-ink)}
		.gf-actions{display:flex;flex-direction:column;gap:8px}
		.gf-section{display:flex;flex-direction:column;gap:16px;border:0;padding:0;margin:0;min-width:0}
		.gf-section>legend{font-weight:600;padding:0;margin-bottom:4px}
		.gf-hint{display:block}
		.gf-group{display:flex;flex-direction:column;gap:8px;border:0;padding:0;margin:0;min-width:0}
		.gf-group>legend{font-weight:600;font-size:13px;padding:0;margin-bottom:8px}
		.gf-segments{display:grid;grid-template-columns:1fr 1fr;gap:8px}
		.gf-picks{display:flex;flex-wrap:wrap;gap:8px}
		.gf-pick{position:relative;display:inline-flex;align-items:center;gap:8px;padding:4px 12px;border:1px solid var(--color-border);border-radius:999px;cursor:pointer}
		.gf-segment{align-items:flex-start;padding:8px 12px;border-radius:6px}
		.gf-segment .hint{display:block}
		.gf-delivery:not(:has(#kind-dated:checked)) .gf-date{display:none}
		.gf-cadence:not(:has(#cadence-custom:checked)) .gf-custom{display:none}
		.gf-custom input{max-width:160px}
		@supports selector(:has(*)){
			.gf-pick input{position:absolute;opacity:0;pointer-events:none}
			.gf-pick:has(input:checked){border-color:var(--color-primary);background:var(--color-primary-subtle)}
			label.gf-pick:has(input:focus-visible){outline:2px solid var(--color-focus);outline-offset:2px}
		}
		.gf-know{display:flex;flex-direction:column;gap:12px;border:0;padding:0;margin:0;min-width:0}
		.gf-know legend{font-weight:600;padding:0;margin-bottom:4px}
		.gf-know-head{font-size:14px;margin:4px 0 0}
		.gf-rows{display:flex;flex-direction:column;gap:12px}
		.gf-row{display:flex;flex-wrap:wrap;align-items:flex-start;gap:8px 12px}
		.gf-row .field{flex:1 1 140px;min-width:0}
		.gf-row .field input,.gf-row .field select{width:100%}
		.gf-remove{align-self:flex-end}
		.gf-form:not(.gf-js) .gf-js-only{display:none}
		.gf-know .gf-js-only[data-add-row]{align-self:flex-start}
		.gf-form.gf-js .gf-no-js{display:none}
		.gf-parents{display:flex;flex-direction:column;gap:8px;border:0;padding:0;margin:0;min-width:0}
		.gf-parents legend{font-weight:600;padding:0;margin-bottom:4px}
		.gf-chips{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0;padding:0}
		.gf-chips:empty{display:none}
		.gf-chip{display:inline-flex;align-items:center;gap:8px;padding:4px 4px 4px 12px;border:1px solid var(--color-border);border-radius:999px}
		.gf-chip .gf-input-error{flex-basis:100%}
		.gf-search input{width:100%}
		.gf-results{list-style:none;margin:0;padding:0;display:flex;flex-direction:column}
		.gf-results:empty{display:none}
		.gf-result{display:flex;align-items:center;gap:8px;width:100%;text-align:left;background:none;border:0;padding:8px;border-radius:6px;cursor:pointer;color:inherit;font:inherit}
		.gf-result:hover,.gf-result:focus-visible{background:var(--color-surface-hover)}
		.gf-parents select[multiple]{width:100%;min-height:8em}
	</style>
}
