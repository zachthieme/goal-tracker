package web

import (
	"fmt"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// pendingLinksPage lists the link requests awaiting the current Account's
// decision as the Owner of each request's parent Goal, a row each with accept
// and reject actions. toast, when set, offers Undo for the request just
// rejected. It sits in the flat frame: its title in the page header, and the
// requests a plain section of hairline rows (DESIGN.md § Components:
// Sections).
templ pendingLinksPage(current *domain.Account, pending []domain.Link, toast *toast) {
	@framedLayout("Pending links", current, pageHeader(pageHead{Title: "Pending links"})) {
		@pendingStyles()
		<section class="pd-section">
			<div>
				<h2>Link requests</h2>
				<p class="muted">Goals asking to contribute to yours. Accept one to link it into the graph.</p>
			</div>
			<ul data-testid="pending-links" class="pd-list">
				if len(pending) == 0 {
					<li data-testid="no-pending-links" class="pd-row muted">No pending requests.</li>
				}
				for _, l := range pending {
					<li data-testid="pending-link" class="pd-row">
						<div class="pd-what">
							<p>
								<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", l.Child.ID)) }>{ l.Child.Title }</a>
								<span class="muted">
									{ "(Owner " }
									@person(l.Child.Owner)) wants to contribute to
								</span>
								<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", l.Parent.ID)) }>{ l.Parent.Title }</a>
							</p>
							if l.Note != "" {
								<blockquote data-testid="pending-link-note" class="pd-note">{ l.Note }</blockquote>
							}
						</div>
						<div class="pd-actions">
							@acceptReject(fmt.Sprintf("/links/%d", l.ID))
						</div>
					</li>
				}
			</ul>
		</section>
		@toastNotice(toast)
	}
}

// linkRefusedPage says, inside the normal page, why removing a link was
// refused, with a link back to the Goal page the Remove was on.
templ linkRefusedPage(current *domain.Account, reason, back string) {
	@layout("Can't remove link", current) {
		<div class="message-page">
			<h1>Can't remove link</h1>
			<p data-testid="link-refused">{ reason }</p>
			<p><a href={ templ.SafeURL(back) }>Back</a></p>
		</div>
	}
}

// pendingStyles are the rules the Pending links and Pending handoffs pages share
// on top of app.css: a section of hairline rows, the decision buttons at the
// right.
templ pendingStyles() {
	<style>
		.pd-section{display:flex;flex-direction:column;gap:12px}
		.pd-list{list-style:none;margin:0;padding:0;border-top:1px solid var(--color-border)}
		.pd-row{min-height:44px;padding:12px 0;border-bottom:1px solid var(--color-border);box-sizing:border-box;display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
		.pd-what{display:flex;flex-direction:column;gap:8px;min-width:0;flex:1}
		.pd-note{margin:0;padding-left:12px;border-left:1px solid var(--color-border);color:var(--color-ink-muted)}
		.pd-actions{display:flex;gap:8px;flex:none}
		.pd-actions form{margin:0}
	</style>
}
