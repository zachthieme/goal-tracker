package web

import (
	"fmt"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// goalRef links to a Goal by its title.
templ goalRef(g domain.Goal) {
	<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a>
}

// scheduleConflict names a child due later than the parent it contributes to,
// with both delivery dates as dates shows them.
templ scheduleConflict(c domain.ScheduleConflict, dates displayDates) {
	@goalRef(c.Child)
	<span>(due { dates.date(c.Child.DeliveryDate) }) contributes to </span>
	@goalRef(c.Parent)
	<span>(due { dates.date(c.Parent.DeliveryDate) })</span>
}

// haltedParent names a child whose parent is On Hold or Cancelled.
templ haltedParent(hp domain.HaltedParent) {
	@goalRef(hp.Child)
	<span>contributes to </span>
	@goalRef(hp.Parent)
	<span>, which is { hp.Parent.Lifecycle }</span>
}

// goalSignalsStyles stacks the Goal page's signal banners, strip on strip
// with no gap, as the other banners above the title run. It lives beside the
// banners rather than in goalPageStyles, rendered only when they are.
templ goalSignalsStyles() {
	<style>
		.gp-signals{display:flex;flex-direction:column}
	</style>
}

// goalSignals flags, at the top of a Goal's page, the graph signals that touch
// it, one banner each. It renders nothing when the graph flags nothing.
templ goalSignals(signals domain.GoalSignals, dates displayDates) {
	if signals.Unlinked || len(signals.ScheduleConflicts) > 0 || len(signals.HaltedParents) > 0 {
		@goalSignalsStyles()
		<section data-testid="goal-signals" aria-label="Graph signals" class="gp-signals">
			if signals.Unlinked {
				<p data-testid="goal-unlinked" class="alert lc" role="alert"><strong>Unlinked</strong><span>this Active Goal contributes to no other Goal and isn't Top-level.</span></p>
			}
			for _, c := range signals.ScheduleConflicts {
				<p data-testid="goal-schedule-conflict" class="alert lc" role="alert">
					<strong>Schedule conflict</strong>
					<span>
						@scheduleConflict(c, dates)
					</span>
				</p>
			}
			for _, hp := range signals.HaltedParents {
				<p data-testid="goal-halted-parent" class="alert lc" role="alert">
					<strong>Parent { hp.Parent.Lifecycle }</strong>
					<span>
						@haltedParent(hp)
					</span>
				</p>
			}
		</section>
	}
}
