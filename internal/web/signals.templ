package web

import (
	"fmt"

	"github.com/zachthieme/goal-tracker/internal/domain"
)

// topLevelControl lets an Admin mark a Goal as one of the org's root outcomes,
// or unmark it (CONTEXT.md: Top-level Goal).
templ topLevelControl(g domain.Goal) {
	<section data-testid="mark-top-level">
		<h2>Top-level Goal</h2>
		<form method="post" action={ templ.SafeURL(fmt.Sprintf("/goals/%d/top-level", g.ID)) }>
			if g.TopLevel {
				<input type="hidden" name="top_level" value="false"/>
				<button type="submit">Unmark Top-level</button>
			} else {
				<input type="hidden" name="top_level" value="true"/>
				<button type="submit">Mark Top-level</button>
			}
		</form>
	</section>
}

// graphSignalsPage lists the risks the Goal graph flags on its own, so
// leadership sees them without anyone reporting them (CONTEXT.md: Unaligned).
templ graphSignalsPage(current *domain.Account, signals domain.GraphSignals) {
	@layout("Graph signals", current) {
		<h1>Graph signals</h1>
		<p>Risks the Goal graph flags that nobody reported.</p>
		<section data-testid="unaligned-section">
			<h2>Unaligned Goals</h2>
			<p>Active Goals that contribute to no other Goal and aren't Top-level.</p>
			<ul data-testid="unaligned-goals">
				if len(signals.Unaligned) == 0 {
					<li data-testid="no-unaligned">No Unaligned Goals.</li>
				}
				for _, g := range signals.Unaligned {
					<li data-testid="unaligned-goal">
						@goalRef(g)
						<span>— Owner { g.Owner.Email }</span>
					</li>
				}
			</ul>
		</section>
		<section data-testid="schedule-conflicts-section">
			<h2>Schedule conflicts</h2>
			<p>Goals due later than a Goal they contribute to.</p>
			<ul data-testid="schedule-conflicts">
				if len(signals.ScheduleConflicts) == 0 {
					<li data-testid="no-schedule-conflicts">No schedule conflicts.</li>
				}
				for _, c := range signals.ScheduleConflicts {
					<li data-testid="schedule-conflict">
						@scheduleConflict(c)
					</li>
				}
			</ul>
		</section>
		<section data-testid="halted-parents-section">
			<h2>Parent On Hold or Cancelled</h2>
			<p>Goals contributing to a Goal that is On Hold or Cancelled.</p>
			<ul data-testid="halted-parents">
				if len(signals.HaltedParents) == 0 {
					<li data-testid="no-halted-parents">No Goals under an On Hold or Cancelled parent.</li>
				}
				for _, hp := range signals.HaltedParents {
					<li data-testid="halted-parent">
						@haltedParent(hp)
					</li>
				}
			</ul>
		</section>
		<p><a href="/goals">Back to Goals</a></p>
	}
}

// freshnessSignalsPage is the Stale list, with the Goals whose Path to Green is
// overdue beside it: missing updates and stalled recoveries surface as
// prominently as Red (CONTEXT.md: Stale, Path to Green).
templ freshnessSignalsPage(current *domain.Account, signals domain.FreshnessSignals) {
	@layout("Freshness signals", current) {
		<h1>Freshness signals</h1>
		<p>Missing updates and stalled recoveries.</p>
		<section data-testid="stale-section">
			<h2>Stale Goals</h2>
			<p>Active Goals whose last Check-in, or activation if they have none, is older than their cadence.</p>
			<ul data-testid="stale-goals">
				if len(signals.Stale) == 0 {
					<li data-testid="no-stale">No Stale Goals.</li>
				}
				for _, gf := range signals.Stale {
					<li data-testid="stale-goal">
						@goalRef(gf.Goal)
						<span>— Owner { gf.Goal.Owner.Email } — </span>
						@staleSince(gf)
					</li>
				}
			</ul>
		</section>
		<section data-testid="overdue-paths-section">
			<h2>Path to Green overdue</h2>
			<p>Active Goals past their Path to Green's target date that still aren't Green.</p>
			<ul data-testid="overdue-paths">
				if len(signals.OverduePaths) == 0 {
					<li data-testid="no-overdue-paths">No overdue Paths to Green.</li>
				}
				for _, gf := range signals.OverduePaths {
					<li data-testid="overdue-path">
						@goalRef(gf.Goal)
						<span>— Owner { gf.Goal.Owner.Email } — </span>
						@pathOverdue(gf.Freshness)
					</li>
				}
			</ul>
		</section>
		<p><a href="/goals">Back to Goals</a></p>
	}
}

// staleSince says how long a Stale Goal has gone without an update, against its
// cadence.
templ staleSince(gf domain.GoalFreshness) {
	<span>
		{ fmt.Sprintf("last updated %d days ago (cadence every %d days)", gf.Freshness.DaysSince, gf.Goal.CadenceDays) }
	</span>
}

// pathOverdue names the target date a Path to Green has missed.
templ pathOverdue(f domain.Freshness) {
	<span>{ fmt.Sprintf("meant to be back to Green by %s", fmtDate(f.PathTargetDate)) }</span>
}

// goalRef links to a Goal by its title.
templ goalRef(g domain.Goal) {
	<a href={ templ.SafeURL(fmt.Sprintf("/goals/%d", g.ID)) }>{ g.Title }</a>
}

// scheduleConflict names a child due later than the parent it contributes to,
// with both delivery dates.
templ scheduleConflict(c domain.ScheduleConflict) {
	@goalRef(c.Child)
	<span>(due { fmtDate(c.Child.DeliveryDate) }) contributes to </span>
	@goalRef(c.Parent)
	<span>(due { fmtDate(c.Parent.DeliveryDate) })</span>
}

// haltedParent names a child whose parent is On Hold or Cancelled.
templ haltedParent(hp domain.HaltedParent) {
	@goalRef(hp.Child)
	<span>contributes to </span>
	@goalRef(hp.Parent)
	<span>, which is { hp.Parent.Lifecycle }</span>
}

// goalSignals flags, at the top of a Goal's page, the graph signals that touch
// it. It renders nothing when the graph flags nothing.
templ goalSignals(signals domain.GoalSignals) {
	if signals.Unaligned || len(signals.ScheduleConflicts) > 0 || len(signals.HaltedParents) > 0 {
		<section data-testid="goal-signals" role="alert">
			<h2>Graph signals</h2>
			<ul>
				if signals.Unaligned {
					<li data-testid="goal-unaligned"><strong>Unaligned</strong> — this Active Goal contributes to no other Goal and isn't Top-level.</li>
				}
				for _, c := range signals.ScheduleConflicts {
					<li data-testid="goal-schedule-conflict">
						<strong>Schedule conflict</strong> —
						@scheduleConflict(c)
					</li>
				}
				for _, hp := range signals.HaltedParents {
					<li data-testid="goal-halted-parent">
						<strong>Parent { hp.Parent.Lifecycle }</strong> —
						@haltedParent(hp)
					</li>
				}
			</ul>
		</section>
	}
}

// goalFreshness flags, at the top of a Goal's page, a Goal that is Stale or
// whose Path to Green is overdue. It renders nothing for a fresh Goal.
templ goalFreshness(g domain.Goal, f domain.Freshness) {
	if f.Stale {
		<p data-testid="goal-stale" role="alert">
			<strong>Stale</strong> — { fmt.Sprintf("no Check-in for %d days on a %d-day cadence.", f.DaysSince, g.CadenceDays) }
		</p>
	}
	if f.PathToGreenOverdue {
		<p data-testid="goal-path-overdue" role="alert">
			<strong>Path to Green overdue</strong> — { fmt.Sprintf("this Goal was meant to be back to Green by %s.", fmtDate(f.PathTargetDate)) }
		</p>
	}
}

// rolledUpStale says, beside the Rolled-up Health, how many Active children are
// Stale. It never changes the color, and renders nothing when none are.
templ rolledUpStale(r domain.RolledUpHealth) {
	if r.StaleChildren > 0 {
		· <span data-testid="goal-rollup-stale">{ fmt.Sprintf("%d of %d Stale", r.StaleChildren, r.ActiveChildren) }</span>
	}
}
